--- /dev/null
+++ b/.github/actions/prepare-paired-checkout/action.yml
@@ -0,0 +1,83 @@
+name: Prepare paired Umpire checkout
+description: Check out one exact Umpire revision beside Temporal and create an isolated parent Go workspace.
+
+inputs:
+  repository:
+    description: Umpire owner/repository with confirmed access from this job.
+    required: true
+  revision:
+    description: Published, admitted full Umpire commit SHA paired with this Temporal revision.
+    required: true
+  token:
+    description: Explicit credential authorized to read the selected Umpire repository.
+    required: true
+
+outputs:
+  umpire-root:
+    description: Absolute sibling Umpire checkout path.
+    value: ${{ steps.prepare.outputs.umpire-root }}
+  go-workspace:
+    description: Absolute parent go.work path.
+    value: ${{ steps.prepare.outputs.go-workspace }}
+
+runs:
+  using: composite
+  steps:
+    - name: Admit checkout inputs and unused destinations
+      shell: bash
+      env:
+        UMPIRE_REPOSITORY: ${{ inputs.repository }}
+        UMPIRE_REVISION: ${{ inputs.revision }}
+        UMPIRE_READ_TOKEN: ${{ inputs.token }}
+      run: |
+        set -euo pipefail
+        if [[ ! "$UMPIRE_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ||
+           [[ ! "$UMPIRE_REVISION" =~ ^[0-9a-f]{40}$ ]] ||
+           [[ -z "$UMPIRE_READ_TOKEN" ]]; then
+          echo '::error::Provide an accessible Umpire repository, an admitted full commit SHA and an authorized read credential.'
+          exit 1
+        fi
+        parent=$(cd "$GITHUB_WORKSPACE/.." && pwd -P)
+        for destination in "$parent/umpire" "$parent/go.work" "$parent/go.work.sum" "$GITHUB_WORKSPACE/.umpire-paired-checkout"; do
+          if [[ -e "$destination" || -L "$destination" ]]; then
+            printf '::error::Paired checkout destination already exists; preserve it and select a clean runner: %s\n' "$destination"
+            exit 1
+          fi
+        done
+
+    - name: Check out the admitted Umpire source
+      uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+      with:
+        repository: ${{ inputs.repository }}
+        ref: ${{ inputs.revision }}
+        token: ${{ inputs.token }}
+        path: .umpire-paired-checkout
+        persist-credentials: false
+
+    - name: Place the sibling checkout and select local Go modules
+      id: prepare
+      shell: bash
+      env:
+        UMPIRE_REVISION: ${{ inputs.revision }}
+      run: |
+        set -euo pipefail
+        parent=$(cd "$GITHUB_WORKSPACE/.." && pwd -P)
+        staged="$GITHUB_WORKSPACE/.umpire-paired-checkout"
+        [[ "$(git -C "$staged" rev-parse HEAD)" = "$UMPIRE_REVISION" ]]
+        for source in Cargo.toml scripts/xtask.sh hosts/go/go.mod reference/kettle/go.mod; do
+          [[ -f "$staged/$source" ]]
+        done
+        [[ ! -e "$parent/umpire" && ! -L "$parent/umpire" ]]
+        [[ ! -e "$parent/go.work" && ! -L "$parent/go.work" ]]
+        [[ ! -e "$parent/go.work.sum" && ! -L "$parent/go.work.sum" ]]
+        mv "$staged" "$parent/umpire"
+        (
+          cd "$parent"
+          unset GOWORK
+          go work init "$GITHUB_WORKSPACE" "$parent/umpire/hosts/go" "$parent/umpire/reference/kettle" "$GITHUB_WORKSPACE/model/temporal/hosts/go"
+        )
+        printf 'GOWORK=%s/go.work\n' "$parent" >> "$GITHUB_ENV"
+        printf 'umpire-root=%s/umpire\ngo-workspace=%s/go.work\n' "$parent" "$parent" >> "$GITHUB_OUTPUT"
+        printf 'Temporal revision: %s\n' "$(git -C "$GITHUB_WORKSPACE" rev-parse HEAD)"
+        printf 'Umpire revision: %s\n' "$(git -C "$parent/umpire" rev-parse HEAD)"
+        GOWORK="$parent/go.work" go env GOWORK
