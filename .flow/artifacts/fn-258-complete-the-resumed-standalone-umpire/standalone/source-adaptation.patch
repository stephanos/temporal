+    fs::write(framework.join("Cargo.lock"), "global input\n")?;
+    let (paths, _) = changes(&options, &system)?;
+    assert_eq!(
+        graph
+            .select(&options, paths)?
+            .workspaces
+            .into_iter()
+            .flat_map(|workspace| workspace.packages)
+            .collect::<BTreeSet<_>>(),
+        BTreeSet::from(["core".into(), "fixtures".into(), "activity".into(), "other".into()])
+    );
+    Ok(())
+}
+
+#[test]
+fn independent_repository_bases_belong_to_the_admitted_caller() -> TestResult {
+    let root = tempfile::tempdir()?;
+    let (framework, system, mut options, _) = repositories(root.path())?;
+    fs::write(system.join("other/src/lib.rs"), "committed caller edit\n")?;
+    commit(&system)?;
+    options.base = Some("HEAD~1".into());
+    let (paths, reasons) = changes(&options, &system.join("other"))?;
+    assert_eq!(paths, vec![system.join("other/src/lib.rs")]);
+    assert!(
+        reasons.contains(&format!(
+            "Git repository {}: effective BASE HEAD~1 (caller)",
+            system.display()
+        ))
+    );
+    assert!(
+        reasons.contains(&format!("Git repository {}: effective BASE HEAD", framework.display()))
+    );
+    // HEAD~1 exists only in the caller; it must never be interpreted in its sibling.
+    assert!(changes(&options, &framework).is_err());
+    for base in ["missing-base", "--help"] {
+        options.base = Some(base.into());
+        let error = changes(&options, &system).err().ok_or("invalid BASE was accepted")?;
+        assert!(error.to_string().contains(base));
+        assert!(error.to_string().contains(&system.display().to_string()));
+    }
+    options.base = Some("HEAD".into());
+    assert!(changes(&options, root.path()).is_err());
+    let outside = root.path().join("outside");
+    fs::create_dir(&outside)?;
+    git(&outside, &["init", "--quiet"])?;
+    let error = changes(&options, &outside).err().ok_or("unadmitted caller was accepted")?;
+    assert!(error.to_string().contains("BASE ownership is ambiguous"));
+    Ok(())
+}
+
+#[test]
+fn one_repository_keeps_base_semantics_without_caller_ownership() -> TestResult {
+    let root = tempfile::tempdir()?;
+    let (framework, system, mut options, _) = repositories(root.path())?;
+    options.workspaces = vec![framework.clone(), framework.join("core")];
+    fs::write(framework.join("core/src/lib.rs"), "committed edit\n")?;
+    commit(&framework)?;
+    options.base = Some("HEAD~1".into());
+    let (paths, reasons) = changes(&options, &system)?;
+    assert_eq!(paths, changed(&framework, &OsString::from("HEAD~1"))?);
+    assert!(reasons.is_empty());
+    options.base = Some("missing-base".into());
+    assert!(changes(&options, &system).is_err());
+    Ok(())
+}
