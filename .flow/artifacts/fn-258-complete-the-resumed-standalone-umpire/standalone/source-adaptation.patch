+# Keep command semantics in the native framework tools.
+UMPIRE_XTASK = helper=$$(/bin/bash "$(CURDIR)/scripts/xtask.sh") && "$$helper"
+
+.PHONY: check fmt update time validate
+check:
+	@$(UMPIRE_XTASK) gate
+
+fmt:
+	@$(UMPIRE_XTASK) fmt
+
+update:
+	@$(UMPIRE_XTASK) update
+
+time:
+	@$(UMPIRE_XTASK) time
+
+validate:
+	@$(UMPIRE_XTASK) validate
