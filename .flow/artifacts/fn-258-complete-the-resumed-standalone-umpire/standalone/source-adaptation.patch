+fn repository(root: &Path) -> Result<PathBuf> {
+    let repository = captured(&mut git(root, &["rev-parse", "--show-toplevel"]))?;
+    let repository = repository.strip_suffix(b"\n").unwrap_or(&repository);
+    Ok(PathBuf::from(OsString::from_vec(repository.to_vec())).canonicalize()?)
+}
+
+fn changes(options: &Options, caller: &Path) -> Result<(Vec<PathBuf>, BTreeSet<String>)> {
+    let repositories =
+        options.workspaces.iter().map(|root| repository(root)).collect::<Result<BTreeSet<_>>>()?;
+    let multiple = repositories.len() > 1;
+    let caller_repository = if multiple {
+        let root = repository(caller).map_err(|error| {
+            Error::Invalid(format!("quick cannot resolve caller Git repository: {error}"))
+        })?;
+        if !repositories.contains(&root) {
+            return Err(Error::Invalid(format!(
+                "quick caller Git repository {} is not an explicit workspace repository; BASE ownership is ambiguous",
+                root.display()
+            )));
+        }
+        Some(root)
+    } else {
+        None
+    };
+    let mut paths = BTreeSet::new();
+    let mut reasons = BTreeSet::new();
+    for root in repositories {
+        let base = if !multiple || caller_repository.as_ref() == Some(&root) {
+            options.base.as_deref().unwrap_or_default()
+        } else {
+            std::ffi::OsStr::new("HEAD")
+        };
+        paths.extend(changed(&root, base).map_err(|error| {
+            Error::Invalid(format!(
+                "quick BASE {} in Git repository {}: {error}",
+                base.to_string_lossy(),
+                root.display()
+            ))
+        })?);
+        if multiple {
+            reasons.insert(format!(
+                "Git repository {}: effective BASE {}{}",
+                root.display(),
+                base.to_string_lossy(),
+                if caller_repository.as_ref() == Some(&root) { " (caller)" } else { "" }
+            ));
+        }
+    }
+    Ok((paths.into_iter().collect(), reasons))
+}
