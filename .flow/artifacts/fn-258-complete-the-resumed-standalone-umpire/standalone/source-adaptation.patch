+name: Umpire
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: umpire-${{ github.head_ref || github.run_id }}
+  cancel-in-progress: true
+
+jobs:
+  framework:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    env:
+      CARGO_TARGET_DIR: ${{ runner.temp }}/umpire-target
+      UMPIRE_BACKENDS: require
+    steps:
+      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+      - uses: jdx/mise-action@dba19683ed58901619b14f395a24841710cb4925 # v4.1.0
+        with:
+          version: "2026.10.11"
+          sha256: "f9612efcddda0ae55b62d3b6f82a6c860d5b54ebee0807d4f1a1d578055e1607"
+          cache: false
+      - name: Install pinned Rust components and target
+        run: |
+          mise exec -- rustup component add rustfmt clippy rust-src rust-analyzer
+          mise exec -- rustup target add wasm32-wasip1
+      - name: Run required TLC and standalone validation
+        run: make validate
+      - name: Test release arithmetic and behavior
+        run: mise exec -- cargo test --workspace --release --locked
+      - name: Require generated sources to remain clean
+        run: git diff --exit-code
