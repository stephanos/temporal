\" {\nmodel/umpire/catalog/syntax/src/derive.rs:657:        format!(\"::umpire_runtime::google::protobuf::{message}\")\nmodel/umpire/catalog/syntax/src/derive.rs:667:/// Stable snake-case name used for catalog factories.\nmodel/umpire/catalog/syntax/src/derive.rs:669:    format_ident!(\"{}\", snake(&name.to_string()))\nmodel/umpire/catalog/syntax/src/derive.rs:673:    let camel = field\nmodel/umpire/catalog/syntax/src/derive.rs:682:    format!(\"{}.{camel}Entry\", parent.value())\nmodel/umpire/catalog/syntax/src/derive.rs:740:fn parse_also(input: ParseStream<'_>) -> syn::Result<ApiAttributes> {\nmodel/umpire/catalog/syntax/src/derive.rs:756:    let mut attributes: ApiAttributes = if body.is_empty() {\nmodel/umpire/catalog/syntax/src/derive.rs:757:        ApiAttributes::default()\n//! Descriptor-driven request mutations with catalog predictions and actual-wire classification.\n\nuse crate::{\n    KettleServiceMethod as Method, api,\n    config::{self, Limits},\n    kettle_request_fields, mutate_kettle_request,\n    wire::umpire::reference::kettle::v1 as k,\n};\nuse prost::Message;\nuse std::{collections::BTreeSet, fmt::Write};\nuse umpire_catalog::{\n    Expectation, GapReport, MutationApplicability, ProbeResult, Violation, WireCase,\n    mutation_entries, wire_cases,\n};\nuse umpire_runtime::annotations::{ProbeCase, ProbeExpectation, ProbeObservation, ProbeResponse};\n\ntype Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\n\nstruct Entry {\n    method: Method,\n    prerequisite: &'static str,\n    case: WireCase,\n}\n\nimpl Entry {\n    fn id(&self) -> String {\n        format!(\"generic::{}::{}\", self.method.name(), self.case.id())\n    }\n\n    fn prepare(&self, baseline: bool) -> Result<(ProbeCase, Vec<u8>, Vec<Violation>)> {\n        let (state, refusal) = match &self.case.applicability {\n            MutationApplicability::Applicable => (0, String::new()),\n            MutationApplicability::NotApplicable(reason) => (1, reason.clone()),\n            MutationApplicability::Refused(reason) => (2, reason.clone()),\n            MutationApplicability::Unchanged => {\n                (3, \"mutation leaves the baseline unchanged\".into())\n            }\n        };\n        let mut metadata = ProbeCase {\n            id: self.id(),\n            method: method(self.method),\n            prerequisite: self.prerequisite.into(),\n            generic: true,\n            applicability: state,\n            refusal,\n            ..Default::default()\n        };\n        if state != 0 {\n            return Ok((metadata, Vec::new(), Vec::new()));\n        }\n        let original = baseline_bytes(self.method);\n        if !api::request_findings(self.method, &original, \"room\")?.is_empty() {\n            return Err(\"invalid Kettle probe baseline\".into());\n        }\n        if baseline {\n            return Ok((metadata, original, Vec::new()));\n        }\n        let Ok(bytes) = mutate_kettle_request(\n            self.method,\n            &original,\n            &self.case.field.path,\n            &self.case.mutation,\n        ) else {\n            metadata.applicability = 2;\n            metadata.refusal = \"typed mutation construction refused\".into();\n            return Ok((metadata, Vec::new(), Vec::new()));\n        };\n        if bytes == original {\n            metadata.applicability = 3;\n            metadata.refusal = \"mutation leaves the baseline unchanged\".into();\n            return Ok((metadata, Vec::new(), Vec::new()));\n        }\n        let mut findings = api::request_findings(self.method, &bytes, \"room\")?;\n        findings.sort_by_key(|v| (v.path.clone(), v.constraint.clone(), v.fields.clone()));\n        findings.dedup();\n        findings.retain(|v| {\n            v.expected.as_ref().is_some_and(|e| !matches!(e.expectation, Expectation::Unobservable))\n        });\n        if findings.is_empty()\n            && self.prerequisite != \"empty\"\nmodel/temporal/feature/activity/proof_checks.rs:17:fn replace_code(source: &str, from: &str, to: &str) -> String {\nmodel/umpire/dev/fixtures/fixtures/world_fairness/tests.rs:36:fn replace_once(source: &str, from: &str, to: &str) -> String {\nmodel/temporal/feature/activity/policy_checks.rs:365:fn replace_once(source: &str, from: &str, to: &str) -> String {\nmodel/temporal/feature/activity/policy_checks.rs:594:fn replace_in(source: &str, start: &str, end: &str, from: &str, to: &str) -> String {\nmodel/umpire/front/src/declare/action.rs:33:    let mut errors = Errors(None);\nmodel/umpire/front/src/declare/action.rs:78:    errors.finish()?;\nmodel/umpire/front/src/declare/action.rs:82:struct Errors(Option<syn::Error>);\nmodel/umpire/front/src/declare/action.rs:83:impl Errors {\nmodel/umpire/front/src/declare/action.rs:90:    fn finish(self) -> syn::Result<()> {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cd temporal && sed -n '70,305p' model/umpire/catalog/syntax/src/derive.rs && sed -n '805,849p' model/temporal/annotate/syntax/src/realize.rs && sed -n '630,690p' model/umpire/catalog/syntax/src/derive.rs && sed -n '1,145p' model/umpire/catalog/build/src/services.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cd temporal && sed -n '70,305p' model/umpire/catalog/syntax/src/derive.rs && sed -n '805,849p' model/temporal/annotate/syntax/src/realize.rs && sed -n '630,690p' model/umpire/catalog/syntax/src/derive.rs && sed -n '1,145p' model/umpire/catalog/build/src/services.rs\"","aggregated_output":"    /// Cannot be observed with a request probe.\n    Unobservable,\n}\n\n/// Parsed helper attributes; shared with descriptor and compiler consumers.\n#[derive(Debug, Clone, Default)]\npub struct ApiAttributes {\n    /// Caller-owned context type.\n    pub context: Option<Path>,\n    /// Root of generated protobuf modules.\n    pub api: Option<Path>,\n    /// Typed supplemental response mirror.\n    pub response_checks: Option<Path>,\n    /// Message direction and protobuf name.\n    pub direction: Option<(bool, LitStr)>,\n    /// Explicit prost type override.\n    pub proto_type: Option<Path>,\n    /// Excludes a second mirror from exhaustive ownership.\n    pub supplemental: bool,\n    /// Constraint expressions, including dynamic config constants.\n    pub constraints: Vec<(Ident, Expr)>,\n    /// Builtin annotation consequences.\n    pub tags: Vec<Tag>,\n    /// Server expectation.\n    pub expected: Option<ApiExpectation>,\n    /// Presence rules declared on this attribute line.\n    pub rules: Vec<(Ident, Vec<Ident>)>,\n    /// Module with typed view/set functions.\n    pub via: Option<Path>,\n    /// Exhaustive oneof alternatives and protobuf names.\n    pub variants: Vec<(Ident, LitStr)>,\n    /// Supplemental kind intents on this field.\n    pub also: Vec<ApiAttributes>,\n    /// Supplemental kind name.\n    pub also_kind: Option<Ident>,\n}\n\nfn set_once<T>(slot: &mut Option<T>, value: T, span: Span, label: &str) -> syn::Result<()> {\n    if slot.is_some() {\n        return Err(syn::Error::new(span, format!(\"duplicate {label}\")));\n    }\n    *slot = Some(value);\n    Ok(())\n}\n\nfn names(input: ParseStream<'_>) -> syn::Result<Vec<Ident>> {\n    let body;\n    syn::parenthesized!(body in input);\n    Ok(Punctuated::<Ident, Token![,]>::parse_terminated(&body)?.into_iter().collect())\n}\n\nimpl syn::parse::Parse for ApiAttributes {\n    fn parse(input: ParseStream<'_>) -> syn::Result<Self> {\n        let mut result = Self::default();\n        while !input.is_empty() {\n            let key = input.call(Ident::parse_any)?;\n            let span = key.span();\n            match key.to_string().as_str() {\n                \"request\" | \"response\" => {\n                    input.parse::<Token![=]>()?;\n                    set_once(\n                        &mut result.direction,\n                        (key == \"request\", input.parse()?),\n                        span,\n                        \"message direction\",\n                    )?;\n                }\n                \"context\" | \"api\" => {\n                    input.parse::<Token![=]>()?;\n                    let slot = if key == \"context\" { &mut result.context } else { &mut result.api };\n                    set_once(slot, input.parse()?, span, &key.to_string())?;\n                }\n                \"type\" => {\n                    input.parse::<Token![=]>()?;\n                    set_once(&mut result.proto_type, input.parse()?, span, \"type\")?;\n                }\n                \"supplemental\" => result.supplemental = true,\n                \"via\" => {\n                    input.parse::<Token![=]>()?;\n                    set_once(&mut result.via, input.parse()?, span, \"via\")?;\n                }\n                \"response_checks\" => {\n                    input.parse::<Token![=]>()?;\n                    set_once(&mut result.response_checks, input.parse()?, span, \"response_checks\")?;\n                }\n                \"rejects\" => {\n                    let expected = parse_rejection(input, span)?;\n                    set_once(&mut result.expected, expected, span, \"expectation\")?;\n                }\n                \"accepts\" | \"unobservable\" => {\n                    let expected = if key == \"accepts\" {\n                        ApiExpectation::Accepts\n                    } else {\n                        ApiExpectation::Unobservable\n                    };\n                    set_once(&mut result.expected, expected, span, \"expectation\")?;\n                }\n                \"required\" | \"requires\" | \"excludes\" | \"any_of\" | \"one_of\" => {\n                    result.rules.push((key, names(input)?));\n                }\n                \"oneof\" => {\n                    result.variants.extend(oneof_variants(input)?);\n                }\n                \"also\" => {\n                    let attributes = parse_also(input)?;\n                    result.also.push(attributes);\n                }\n                \"ignored\" => {\n                    input.parse::<Token![=]>()?;\n                    result.tags.push(Tag {\n                        name: Ident::new(\"Ignored\", span),\n                        argument: Some(Lit::Str(input.parse()?)),\n                    });\n                }\n                \"decided\" | \"observed\" | \"idempotency_key\" | \"monotone\" | \"immutable\" => {\n                    let name = match key.to_string().as_str() {\n                        \"decided\" => \"Decided\",\n                        \"observed\" => \"Observed\",\n                        \"idempotency_key\" => \"IdempotencyKey\",\n                        \"monotone\" => \"Monotone\",\n                        _ => \"Immutable\",\n                    };\n                    result.tags.push(Tag { name: Ident::new(name, span), argument: None });\n                }\n                \"cached\" | \"eventually_consistent\" => {\n                    input.parse::<Token![=]>()?;\n                    result.tags.push(Tag {\n                        name: Ident::new(\n                            if key == \"cached\" { \"Cached\" } else { \"EventuallyConsistent\" },\n                            span,\n                        ),\n                        argument: Some(input.parse()?),\n                    });\n                }\n                \"min_len\" | \"max_len\" | \"min_bytes\" | \"max_bytes\" | \"prefix\" | \"suffix\"\n                | \"contains\" | \"gt\" | \"gte\" | \"lt\" | \"lte\" | \"min_items\" | \"max_items\"\n                | \"unique\" | \"defined_only\" => {\n                    input.parse::<Token![=]>()?;\n                    result.constraints.push((key, input.parse()?));\n                }\n                _ => return Err(syn::Error::new(span, \"unknown catalog attribute\")),\n            }\n            if !input.is_empty() {\n                input.parse::<Token![,]>()?;\n            }\n        }\n        Ok(result)\n    }\n}\n\nfn oneof_variants(input: ParseStream<'_>) -> syn::Result<Vec<(Ident, LitStr)>> {\n    let body;\n    syn::parenthesized!(body in input);\n    let mut variants = Vec::new();\n    while !body.is_empty() {\n        let variant = body.parse()?;\n        body.parse::<Token![=]>()?;\n        variants.push((variant, body.parse()?));\n        if !body.is_empty() {\n            body.parse::<Token![,]>()?;\n        }\n    }\n    Ok(variants)\n}\n\nfn attributes(attrs: &[Attribute]) -> syn::Result<Vec<ApiAttributes>> {\n    attrs\n        .iter()\n        .filter(|attr| attr.path().is_ident(\"rule\") || attr.path().is_ident(\"mirror\"))\n        .map(|attr| {\n            let parsed: ApiAttributes = attr.parse_args()?;\n            let mapping = parsed.context.is_some()\n                || parsed.api.is_some()\n                || parsed.direction.is_some()\n                || parsed.proto_type.is_some()\n                || parsed.supplemental\n                || parsed.response_checks.is_some()\n                || parsed.via.is_some()\n                || !parsed.tags.is_empty()\n                || !parsed.variants.is_empty()\n                || !parsed.also.is_empty();\n            let rule = parsed.expected.is_some()\n                || !parsed.constraints.is_empty()\n                || !parsed.rules.is_empty();\n            if attr.path().is_ident(\"rule\") && mapping {\n                return Err(syn::Error::new_spanned(\n                    attr,\n                    \"mapping attributes belong in #[mirror]\",\n                ));\n            }\n            if attr.path().is_ident(\"mirror\") && rule {\n                return Err(syn::Error::new_spanned(\n                    attr,\n                    \"validation attributes belong in #[rule]\",\n                ));\n            }\n            Ok(parsed)\n        })\n        .collect()\n}\n\nfn merge(mut lines: Vec<ApiAttributes>) -> syn::Result<ApiAttributes> {\n    let mut result = ApiAttributes::default();\n    for mut line in lines.drain(..) {\n        for (target, value, label) in [\n            (&mut result.context, line.context.take(), \"context\"),\n            (&mut result.api, line.api.take(), \"api\"),\n            (&mut result.response_checks, line.response_checks.take(), \"response_checks\"),\n            (&mut result.via, line.via.take(), \"via\"),\n            (&mut result.proto_type, line.proto_type.take(), \"type\"),\n        ] {\n            if let Some(value) = value {\n                set_once(target, value, Span::call_site(), label)?;\n            }\n        }\n        if let Some(value) = line.direction.take() {\n            set_once(&mut result.direction, value, Span::call_site(), \"message direction\")?;\n        }\n        if let Some(value) = line.expected.take() {\n            set_once(&mut result.expected, value, Span::call_site(), \"expectation\")?;\n        }\n        result.supplemental |= line.supplemental;\n        result.constraints.extend(line.constraints);\n        result.tags.extend(line.tags);\n        result.rules.extend(line.rules);\n        result.variants.extend(line.variants);\n        result.also.extend(line.also);\n    }\n    Ok(result)\n}\n\nfn documentation(attrs: &[Attribute]) -> String {\n    attrs\n        .iter()\n        .filter_map(|attr| {\n            if !attr.path().is_ident(\"doc\") {\n\nstruct ProposalHandler {\n    name: Ident,\n    matches: Option<Ident>,\n    polling: Option<Ident>,\n}\n\nfn proposal_handler(name: &Ident, attribute: &Attribute) -> syn::Result<ProposalHandler> {\n    let mut handler = ProposalHandler { name: name.clone(), matches: None, polling: None };\n    if matches!(attribute.meta, syn::Meta::Path(_)) {\n        return Ok(handler);\n    }\n    let options = attribute.parse_args_with(\n        syn::punctuated::Punctuated::<syn::MetaNameValue, Token![,]>::parse_terminated,\n    )?;\n    for option in options {\n        let slot = if option.path.is_ident(\"matches\") {\n            &mut handler.matches\n        } else if option.path.is_ident(\"continue_polling\") {\n            &mut handler.polling\n        } else {\n            return Err(syn::Error::new(option.path.span(), \"unknown proposal hook\"));\n        };\n        let syn::Expr::Path(value) = option.value else {\n            return Err(syn::Error::new(\n                option.value.span(),\n                \"proposal hook requires a method name\",\n            ));\n        };\n        let name = value\n            .path\n            .get_ident()\n            .ok_or_else(|| syn::Error::new(value.span(), \"proposal hook requires a method name\"))?;\n        if slot.replace(name.clone()).is_some() {\n            return Err(syn::Error::new(option.path.span(), \"duplicate proposal hook\"));\n        }\n    }\n    Ok(handler)\n}\n\nfn proposal_dispatch(model: &Path, handler: &ProposalHandler) -> TokenStream {\n    let name = &handler.name;\n    let matches = handler.matches.as_ref().map(|name| quote! {\n        fn matches(&self, request: &::umpire_runtime::google::protobuf::Any, observation: &::umpire_runtime::google::protobuf::Any)\n            -> Result<(), ::umpire_runtime::protocol::Refusal> { self.#name(request, observation) }\n}\n\nfn snake(name: &str) -> String {\n    let chars: Vec<char> = name.chars().collect();\n    let mut result = String::new();\n    for (index, ch) in chars.iter().enumerate() {\n        if ch.is_uppercase()\n            && index > 0\n            && (chars[index - 1].is_lowercase()\n                || chars[index - 1].is_ascii_digit()\n                || chars.get(index + 1).is_some_and(|next| next.is_lowercase()))\n        {\n            result.push('_');\n        }\n        result.extend(ch.to_lowercase());\n    }\n    result\n}\n\nfn inferred_type(proto: &LitStr, api: &Path) -> syn::Result<Path> {\n    let name = proto.value();\n    let mut parts: Vec<_> = name.split('.').collect();\n    let message = parts\n        .pop()\n        .ok_or_else(|| syn::Error::new(proto.span(), \"missing protobuf message name\"))?;\n    let package = parts.join(\"::\");\n    let path = if package == \"google::protobuf\" {\n        format!(\"::umpire_runtime::google::protobuf::{message}\")\n    } else {\n        {\n            let root = quote::quote!(#api).to_string();\n            format!(\"{root}::{package}::{message}\")\n        }\n    };\n    syn::parse_str(&path).map_err(|_| syn::Error::new(proto.span(), \"invalid protobuf name\"))\n}\n\n/// Stable snake-case name used for catalog factories.\npub fn factory_name(name: &Ident) -> Ident {\n    format_ident!(\"{}\", snake(&name.to_string()))\n}\n\npub(crate) fn map_entry_proto(parent: &LitStr, field: &Ident) -> String {\n    let camel = field\n        .unraw()\n        .to_string()\n        .split('_')\n        .map(|part| {\n            let mut chars = part.chars();\n            chars.next().map_or_else(String::new, |head| head.to_uppercase().chain(chars).collect())\n        })\n        .collect::<String>();\n    format!(\"{}.{camel}Entry\", parent.value())\n}\n\npub(crate) fn secret_map(ty: &Type) -> syn::Result<bool> {\n    let segment = marker(ty)?;\n    if segment.ident == \"Map\"\n        && let syn::PathArguments::AngleBracketed(arguments) = &segment.arguments\n        && let Some(syn::GenericArgument::Type(value)) = arguments.args.last()\n    {\n//! Descriptor-backed service method and annotation dispatch generation.\n\nuse std::{collections::BTreeSet, fmt::Write};\n\nuse prost::Message;\nuse quote::ToTokens;\nuse umpire_catalog_syntax::{\n    descriptor::{Coverage, Disposition},\n    services::Classification,\n};\nuse umpire_runtime::google::protobuf::FileDescriptorSet;\n\n/// Generated service identities and Rust surface names.\npub struct Config<'a> {\n    /// Fully qualified protobuf service name.\n    pub service: &'a str,\n    /// Absolute Rust crate or module path for public type inventory.\n    pub rust_type_root: &'a str,\n    /// Rust root used inside exported dispatch macros.\n    pub macro_type_root: &'a str,\n    /// Generated method enum name.\n    pub method_enum: &'a str,\n    /// Generated method information struct name.\n    pub method_info: &'a str,\n    /// Generated ordered method inventory constant.\n    pub methods_const: &'a str,\n    /// Exported annotation dispatch macro name.\n    pub dispatch_macro: &'a str,\n    /// Exported action binding macro name.\n    pub bind_macro: &'a str,\n}\n\n/// Generate the method inventory and exhaustive action binding macros.\npub fn generate(\n    bytes: &[u8],\n    coverage: &Coverage,\n    classifications: &[Classification],\n    config: &Config<'_>,\n) -> Result<String, String> {\n    let descriptors = FileDescriptorSet::decode(bytes).map_err(|error| error.to_string())?;\n    let (package, name) =\n        config.service.rsplit_once('.').ok_or(\"service must be fully qualified\")?;\n    let service = descriptors\n        .file\n        .iter()\n        .filter(|file| file.package.as_deref() == Some(package))\n        .flat_map(|file| &file.service)\n        .find(|service| service.name.as_deref() == Some(name))\n        .ok_or_else(|| format!(\"missing service descriptor: {}\", config.service))?;\n    let service_name = config.service;\n    let annotated: BTreeSet<_> =\n        coverage.messages.iter().map(|message| message.name.trim_start_matches('.')).collect();\n    let out_of_scope: BTreeSet<_> = classifications\n        .iter()\n        .flat_map(|classification| &classification.coverage.methods)\n        .filter(|method| matches!(method.disposition, Disposition::OutOfScope(_)))\n        .map(|method| method.name.as_str())\n        .collect();\n    // A mirrored message means some feature validates this RPC, so it must claim it.\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        if out_of_scope.contains(name)\n            && [&method.input_type, &method.output_type]\n                .into_iter()\n                .flatten()\n                .any(|message| annotated.contains(message.trim_start_matches('.')))\n        {\n            return Err(format!(\n                \"annotated RPC is out of scope: {service_name}.{name} has mirrored messages but \\\n                 no Action or Observed classification\"\n            ));\n        }\n    }\n    let method_enum = config.method_enum;\n    let method_info = config.method_info;\n    let mut output = template(\n        config,\n        \"/// Every RPC in descriptor source order.\\n\\\n         #[derive(Clone, Copy, Debug, Eq, PartialEq)]\\n\\\n         pub enum CatalogServiceMethod {\\n\",\n    );\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        writeln!(output, \"/// `{service_name}.{name}`.\\n{name},\")\n            .map_err(|error| error.to_string())?;\n    }\n    output.push_str(&template(config,\"}\\nimpl CatalogServiceMethod {\\n/// Original protobuf method name.\\npub const fn name(self) -> &'static str { match self {\\n\"));\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        writeln!(output, \"Self::{name} => {name:?},\").map_err(|error| error.to_string())?;\n    }\n    output.push_str(\"}}\\n/// Parse an original protobuf method name.\\npub fn parse(name: &str) -> Option<Self> { match name {\\n\");\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        writeln!(output, \"{name:?} => Some(Self::{name}),\").map_err(|error| error.to_string())?;\n    }\n    output.push_str(&template(\n        config,\n        \"_ => None,\\n}}\\n}\\n\\\n        /// One upstream method and its generated Rust message types.\\n\\\n        #[derive(Clone, Copy, Debug, Eq, PartialEq)]\\n\\\n        pub struct CatalogServiceMethodInfo {\\n\\\n        /// The method identity.\\npub method: CatalogServiceMethod,\\n\\\n        /// Fully qualified Rust request type path.\\npub request_type: &'static str,\\n\\\n        /// Fully qualified Rust response type path.\\npub response_type: &'static str,\\n}\\n\\\n        /// Source-ordered request and response types.\\n\\\n        pub const CATALOG_SERVICE_METHODS: &[CatalogServiceMethodInfo] = &[\\n\",\n    ));\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        let request = public_type(\n            method.input_type.as_deref().ok_or(\"missing request type\")?,\n            config.rust_type_root,\n        );\n        let response = public_type(\n            method.output_type.as_deref().ok_or(\"missing response type\")?,\n            config.rust_type_root,\n        );\n        writeln!(output, \"{method_info} {{ method: {method_enum}::{name}, request_type: {request:?}, response_type: {response:?} }},\").map_err(|error| error.to_string())?;\n    }\n    output.push_str(\"];\");\n    emit_bindings(&mut output, classifications, config)?;\n    output.push_str(&template(config,\"\\n/// Dispatch only declared annotation message types.\\n#[macro_export]\\nmacro_rules! dispatch_catalog_annotations {\\n($method:expr, $response:expr, $ty:ident, $body:block, $fallback:expr) => { match ($method, $response) {\\n\"));\n    for method in &service.method {\n        let name = method.name.as_deref().ok_or(\"unnamed service method\")?;\n        for (response, ty) in [(false, &method.input_type), (true, &method.output_type)] {\n            let ty = ty.as_deref().ok_or(\"missing method message type\")?;\n            if annotated.contains(ty.trim_start_matches('.')) {\n                let path = public_type(ty, config.macro_type_root);\n                writeln!(\n                    output,\n                    \"($crate::{method_enum}::{name}, {response}) => {{ type $ty = {path}; $body }},\"\n                )\n                .map_err(|error| error.to_string())?;\n            }\n        }\n    }\n    output.push_str(\"_ => $fallback,\\n}};\\n}\\n\");\n    Ok(output)\n}\n\nfn public_type(proto: &str, root: &str) -> String {\n    format!(\"{root}::{}\", proto.trim_start_matches('.').replace('.', \"::\"))\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cd temporal && sed -n '140,250p' model/umpire/reference/kettle/kettle_annotations_test.go && cat model/umpire/protocol/runtime/guests/caught-panic/{Cargo.toml,src/bin/panic-control-reports.rs} && cat model/umpire/dev/fixtures/Cargo.toml && cat model/umpire/backends/apalache/Cargo.toml && cat model/umpire/dev/testing/src/lib.rs && cat model/umpire/dev/testing/tests/external_consumers.rs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cd temporal && sed -n '140,250p' model/umpire/reference/kettle/kettle_annotations_test.go && cat model/umpire/protocol/runtime/guests/caught-panic/{Cargo.toml,src/bin/panic-control-reports.rs} && cat model/umpire/dev/fixtures/Cargo.toml && cat model/umpire/backends/apalache/Cargo.toml && cat model/umpire/dev/testing/src/lib.rs && cat model/umpire/dev/testing/tests/external_consumers.rs\"","aggregated_output":"\t\t\t\t\tdefault:\n\t\t\t\t\t\tt.Fatalf(\"unsupported probe prerequisite: %q\", testCase.Prerequisite)\n\t\t\t\t\t}\n\t\t\t\t\tprepared, err := model.Probe(witness.ctx, witness.host, &kettlev1.ProbeRequest{Operation: kettlev1.ProbeRequest_PREPARE, CaseId: testCase.Id, Baseline: baseline, KettleId: \"room\"})\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tif prepared.Method != testCase.Method || len(prepared.Cases) != 1 || prepared.Cases[0].Id != testCase.Id {\n\t\t\t\t\t\tt.Fatalf(\"prepared probe changed identity: %v\", prepared)\n\t\t\t\t\t}\n\t\t\t\t\tobservation, err := witness.dispatchProbe(prepared.Cases[0], prepared)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\tt.Fatal(err)\n\t\t\t\t\t}\n\t\t\t\t\tif baseline {\n\t\t\t\t\t\tif !observation.Accepted {\n\t\t\t\t\t\t\tt.Fatalf(\"valid baseline rejected: %v\", observation)\n\t\t\t\t\t\t}\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tobservations = append(observations, observation)\n\t\t\t\t})\n\t\t\t}\n\t\t})\n\t}\n\tif len(observations) != len(inventory.Cases) {\n\t\tt.Fatal(\"every probe must produce one actual observation or explicit local refusal\")\n\t}\n\tclassifyCtx, cancel := context.WithTimeout(t.Context(), 30*time.Second)\n\tdefer cancel()\n\treport, err := model.Probe(classifyCtx, r.host, &kettlev1.ProbeRequest{Operation: kettlev1.ProbeRequest_CLASSIFY, Observations: observations})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif report.Fails || !strings.Contains(report.Report, \"Unverifiable\") {\n\t\tt.Fatalf(\"healthy gap report must pass and retain Unverifiable: %s\", report.Report)\n\t}\n\tkettleAnnotationGolden(t, \"gaps.txt\", report.Report)\n}\n\nfunc kettleAnnotationGolden(t *testing.T, name, actual string) {\n\tt.Helper()\n\tpath := \"expected/\" + name\n\tif name == \"gaps.txt\" && os.Getenv(\"UMPIRE_UPDATE_KETTLE_GAPS\") == \"1\" || name == \"mutants.snap.txt\" && os.Getenv(\"UMPIRE_UPDATE_KETTLE_MUTANTS\") == \"1\" {\n\t\tif err := os.WriteFile(path, []byte(actual), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\texpected, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif actual != string(expected) {\n\t\tt.Fatalf(\"Kettle %s differs:\\n%s\", name, actual)\n\t}\n}\n[package]\nname = \"umpire-caught-panic-guest\"\ndescription = \"Caught checker defect ABI control\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lib]\nname = \"caught_panic_control\"\ncrate-type = [\"cdylib\"]\n\n[dependencies]\numpire-runtime.workspace = true\numpire-dsl.workspace = true\nprost.workspace = true\n\n[lints.rust]\nunsafe_code = \"deny\"\nmissing_docs = \"warn\"\nunused_qualifications = \"warn\"\nunreachable_pub = \"warn\"\nrust_2018_idioms = { level = \"warn\", priority = -1 }\n\n[lints.clippy]\nall = { level = \"warn\", priority = -1 }\npedantic = { level = \"warn\", priority = -1 }\nmodule_name_repetitions = \"allow\"\nmust_use_candidate = \"allow\"\nmissing_errors_doc = \"allow\"\nmissing_panics_doc = \"allow\"\nunwrap_used = \"warn\"\nexpect_used = \"warn\"\ndbg_macro = \"warn\"\ntodo = \"warn\"\nprint_stdout = \"warn\"\nprint_stderr = \"warn\"\n//! Native responses for comparison with actual Wasm checker defects.\n\n#[path = \"../../../../tests/support/panic.rs\"]\nmod control;\n\nuse prost::Message;\nuse std::{error::Error, fs, path::PathBuf};\nuse umpire_runtime::protocol;\n\nfn main() -> Result<(), Box<dyn Error>> {\n    let output = PathBuf::from(std::env::args_os().nth(1).ok_or(\"missing output directory\")?);\n    fs::create_dir_all(&output)?;\n    for (name, mode, golden) in [\n        (\n            \"effect_panic\",\n            control::support::Mode::EffectPanic,\n            include_str!(\n                \"../../../../../../backends/native/tests/fixtures/effect_panic/expected/report.snap.txt\"\n            ),\n        ),\n        (\n            \"effect_overflow\",\n            control::support::Mode::Overflow,\n            include_str!(\n                \"../../../../../../backends/native/tests/fixtures/effect_overflow/expected/report.snap.txt\"\n            ),\n        ),\n    ] {\n        let mut model = control::model(mode);\n        let response = model.dispatch(1, &protocol::ExploreRequest { budget: 3 }.encode_to_vec());\n        let Some(protocol::response::Outcome::Explore(report)) = &response.outcome else {\n            return Err(format!(\"{name}: exploration refused: {response:?}\").into());\n        };\n        assert_eq!(report.report, golden, \"{name}: native report changed\");\n        fs::write(output.join(format!(\"{name}.pb\")), response.encode_to_vec())?;\n    }\n    Ok(())\n}\n[package]\nname = \"umpire-fixtures\"\ndescription = \"Shared end-to-end Umpire Model fixtures\"\nversion.workspace = true\nedition.workspace = true\npublish = false\nlicense.workspace = true\nrust-version.workspace = true\nautotests = false\n\n[[test]]\nname = \"fixtures\"\npath = \"fixtures.rs\"\n\n[[test]]\nname = \"interpreted\"\npath = \"interpreted.rs\"\n\n[lints]\nworkspace = true\n\n[dev-dependencies]\numpire.workspace = true\numpire-checker.workspace = true\numpire-testing.workspace = true\numpire-tla.workspace = true\numpire-tlc.workspace = true\nimbl.workspace = true\n\n[package]\nname = \"umpire-apalache\"\ndescription = \"Pinned bounded safety checks for source-lifted Umpire Models\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lints]\nworkspace = true\n\n[dependencies]\numpire-backend-process.workspace = true\numpire-tla.workspace = true\numpire-checker.workspace = true\numpire-dsl.workspace = true\nserde.workspace = true\nserde_json.workspace = true\n\n[dev-dependencies]\numpire.workspace = true\nimbl.workspace = true\n//! Shared fixture discovery and golden runner for Umpire's tests.\n\npub mod backend;\npub mod boundary;\npub mod discovery;\n\nmod bound;\nmod interpreted;\nmod render;\nmod runner;\n\npub use bound::{Bound, Declared, bound};\n#[doc(hidden)]\npub use interpreted::probe as __interpreted_probe;\npub use interpreted::{Agreement, compare, interpreted};\n\npub use render::{add_paths, render, render_rows};\npub use runner::{\n    CHECKER, Consumer, ExternalConsumer, SUITE, run, run_at, run_at_skipping,\n    run_at_skipping_with_external,\n};\n\n/// Deterministic relative golden paths and their payloads.\npub type Files = std::collections::BTreeMap<String, String>;\n/// A fixture or test failure.\npub type TestResult = Result<(), Box<dyn std::error::Error>>;\n/// The files produced by one fixture.\npub type RunResult = Result<Files, Box<dyn std::error::Error>>;\n/// A named fixture producer discovered by its owning crate's build script.\npub type Fixture = (&'static str, fn() -> RunResult);\n\n/// The emitted module of the Model `world`'s `#[machine]` embeds, read for `source`; a World\n/// without one, or of another source, refuses at the source.\n///\n/// # Errors\n/// Returns the lifter's diagnostic.\npub fn lift(\n    embedded: Option<&umpire_dsl::__lifted::Embedded>,\n    source: &std::path::Path,\n) -> Result<Module, String> {\n    umpire_tla::Lift::embedded(embedded, source)\n        .and_then(|lifted| umpire_tla::Tla::emit(&lifted))\n        .map_err(|diagnostic| diagnostic.to_string())\n}\n\n/// Checks the emitted module of `world` with TLC against its native exploration.\n///\n/// # Errors\n/// Returns any lift, checker or backend failure, or a disagreement.\npub fn check<M: umpire_dsl::Machine>(\n    world: &M,\n    embedded: Option<&umpire_dsl::__lifted::Embedded>,\n    folder: &std::path::Path,\n    source: &std::path::Path,\n    run: fn() -> RunResult,\n) -> RunResult {\n    let module = lift(embedded, source)?;\n    backend::check_machine(world, &module, folder, &run()?)\n}\n\n#[doc(hidden)]\npub use umpire_tla::Module;\n\n/// Finds the Model a concrete World's `#[machine]` embeds, if it has one.\n#[doc(hidden)]\npub mod __probe {\n    use std::marker::PhantomData;\n    use umpire_dsl::__lifted::{Embedded, Lifts};\n\n    pub struct Probe<M>(PhantomData<M>);\n    pub const fn of<M>(_: &M) -> Probe<M> {\n        Probe(PhantomData)\n    }\n    pub trait Embeds {\n        fn embedded(self) -> Option<Embedded>;\n    }\n    impl<M: Lifts> Embeds for &Probe<M> {\n        fn embedded(self) -> Option<Embedded> {\n            Some(M::__umpire_lifted())\n        }\n    }\n    pub trait Unembedded {\n        fn embedded(self) -> Option<Embedded>;\n    }\n    impl<M> Unembedded for &&Probe<M> {\n        fn embedded(self) -> Option<Embedded> {\n            None\n        }\n    }\n}\n\n/// Define a fixture's lift hooks for `world`: `lifted(source)` emits the Model its\n/// `#[machine]` embeds, and `check(folder, source, run)` checks it with TLC. The fixture\n/// runner calls both; `fixture!` defines them for its World. Also defines `interpreted()`, the\n/// differential check of [`interpreted`](crate::interpreted) under the default state budget.\n#[macro_export]\nmacro_rules! lifted {\n    ($world:expr) => {\n        $crate::__lift_hooks!($world);\n        $crate::__interpreted_hook!($world, $crate::Checker::BUDGET);\n    };\n}\n\n#[doc(hidden)]\n#[macro_export]\nmacro_rules! __lift_hooks {\n    ($world:expr) => {\n        #[allow(dead_code)]\n        pub(crate) fn lifted(\n            source: &::std::path::Path,\n        ) -> ::core::result::Result<$crate::Module, ::std::string::String> {\n            $crate::lift($crate::__embedded!($world).as_ref(), source)\n        }\n        #[allow(dead_code)]\n        pub(crate) fn check(\n            folder: &::std::path::Path,\n            source: &::std::path::Path,\n            run: fn() -> $crate::RunResult,\n        ) -> $crate::RunResult {\n            $crate::check(&$world, $crate::__embedded!($world).as_ref(), folder, source, run)\n        }\n    };\n}\n\n/// `interpreted()`: the differential check of `world` when its `#[machine]` module was\n/// admitted, otherwise `None`.\n#[doc(hidden)]\n#[macro_export]\nmacro_rules! __interpreted_hook {\n    ($world:expr, $budget:expr $(, $negative:expr)?) => {\n        #[allow(dead_code)]\n        pub(crate) fn interpreted() -> ::core::result::Result<\n            ::core::option::Option<$crate::Agreement>,\n            ::std::boxed::Box<dyn ::std::error::Error>,\n        > {\n            #[allow(unused_imports)]\n            use $crate::__interpreted_probe::{Admitted as _, Unadmitted as _};\n            (&$crate::__probe::of(&$world)).interpreted(\n                || $world,\n                $budget,\n                None $(.or(Some(($negative, $negative))))?,\n            )\n        }\n    };\n}\n\n#[doc(hidden)]\n#[macro_export]\nmacro_rules! __embedded {\n    ($world:expr) => {{\n        #[allow(unused_imports)]\n        use $crate::__probe::{Embeds as _, Unembedded as _};\n        (&$crate::__probe::of(&$world)).embedded()\n    }};\n}\n\n/// Define a golden producer, optionally with a negative claim and additional files.\n/// `fixture!(world, budget, negative, extra = files)` evaluates `files` once after\n/// the checker reports and refuses paths that would replace an existing output.\n/// `fixture!(World = selected, budget, negative)` names a declared World's type and also\n/// defines `bound()`, which hands that one World to the lifter as values, and\n/// `bound_for(world)`, the same hook for another World of the Model. Either form defines the\n/// lift hooks of [`lifted!`].\n#[macro_export]\nmacro_rules! fixture {\n    ($ty:ident = $world:expr, $budget:expr $(, $negative:expr)?) => {\n        pub(crate) fn bound() -> $crate::Bound<$ty> {\n            bound_for($world)\n        }\n        #[allow(dead_code)]\n        pub(crate) fn bound_for(world: $ty) -> $crate::Bound<$ty> {\n            $crate::bound(world, $budget, None $(.or(Some($negative)))?)\n        }\n        pub(crate) fn run() -> $crate::RunResult {\n            bound().run()\n        }\n        $crate::__interpreted_hook!($world, $budget $(, $negative)?);\n        #[allow(dead_code)]\n        pub(crate) fn lifted(source: &::std::path::Path) -> ::core::result::Result<$crate::Module, ::std::string::String> {\n            bound().lift(source)\n        }\n        #[allow(dead_code)]\n        pub(crate) fn check(\n            folder: &::std::path::Path,\n            _source: &::std::path::Path,\n            _run: fn() -> $crate::RunResult,\n        ) -> $crate::RunResult {\n            bound().check(folder)\n        }\n    };\n    ($world:expr, $budget:expr) => {\n        $crate::__lift_hooks!($world);\n        $crate::__interpreted_hook!($world, $budget);\n        pub(crate) fn run() -> $crate::RunResult {\n            Ok($crate::render(&$crate::Checker::explore(&$world, $budget)?)?)\n        }\n    };\n    ($world:expr, $budget:expr, $negative:expr) => {\n        $crate::fixture!($world, $budget, $negative, extra = $crate::Files::new());\n    };\n    ($world:expr, $budget:expr, $negative:expr, extra = $extra:expr) => {\n        $crate::__lift_hooks!($world);\n        $crate::__interpreted_hook!($world, $budget, $negative);\n        pub(crate) fn run() -> $crate::RunResult {\n            let mut files = $crate::render(&$crate::Checker::explore(&$world, $budget)?)?;\n            let negative = $crate::Checker::refuted(&$world, $negative)?;\n            let report = negative.verify_all()?;\n            files.insert(\"negative_report.txt\".into(), report.to_string());\n            $crate::add_paths(&mut files, report);\n            let extra: $crate::Files = $extra;\n            for (file, content) in extra {\n                if files.contains_key(&file) {\n                    return Err(format!(\"duplicate fixture output: {file}\").into());\n                }\n                files.insert(file, content);\n            }\n            Ok(files)\n        }\n    };\n}\n\n#[doc(hidden)]\npub use umpire_checker::Checker;\n//! External artifact ownership preserves native golden validation.\n\nuse std::{fs, path::Path, process::Command};\nuse umpire_testing::{ExternalConsumer, Files, TestResult, run_at_skipping_with_external};\n\nconst LIVE: ExternalConsumer =\n    ExternalConsumer { name: \"TestLiveArtifact\", fixture: \"control\", expected: \"live.txt\" };\n\n#[test]\nfn external_runner_child() -> TestResult {\n    let Ok(root) = std::env::var(\"UMPIRE_EXTERNAL_ROOT\") else { return Ok(()) };\n    run_at_skipping_with_external(\n        Path::new(&root),\n        vec![(\"control\", || Ok(Files::from([(\"report.txt\".into(), \"native\\n\".into())])))],\n        &[umpire_testing::CHECKER],\n        &[],\n        &[LIVE],\n    )\n}\n\nfn with_fixture(name: &str, check: impl FnOnce(&Path, &Path) -> TestResult) -> TestResult {\n    let root = std::env::temp_dir().join(format!(\"umpire-external-{name}-{}\", std::process::id()));\n    let expected = root.join(\"control/expected\");\n    fs::create_dir_all(&expected)?;\n    fs::write(root.join(\"control/model.rs\"), \"\")?;\n    fs::write(expected.join(\"report.snap.txt\"), \"native\\n\")?;\n    fs::write(expected.join(\"live.txt\"), \"live proof\\n\")?;\n    let result = check(&root, &expected);\n    fs::remove_dir_all(root)?;\n    result\n}\n\n#[test]\nfn external_artifact_is_unchanged_during_native_update_and_compare() -> TestResult {\n    with_fixture(\"preserve\", |root, expected| {\n        for update in [\"always\", \"no\"] {\n            let result = Command::new(std::env::current_exe()?)\n                .args([\"--exact\", \"external_runner_child\", \"--nocapture\"])\n                .env(\"UMPIRE_EXTERNAL_ROOT\", root)\n                .env(\"INSTA_UPDATE\", update)\n                .output()?;\n            assert!(result.status.success(), \"{}\", String::from_utf8_lossy(&result.stderr));\n            let diagnostic = String::from_utf8_lossy(&result.stderr);\n            assert!(diagnostic.contains(\"TestLiveArtifact\"), \"{diagnostic}\");\n            assert!(diagnostic.contains(\"no execution or comparison evidence\"), \"{diagnostic}\");\n            assert_eq!(fs::read(expected.join(\"live.txt\"))?, b\"live proof\\n\");\n            assert!(!expected.join(\"live.snap\").exists());\n        }\n        Ok(())\n    })\n}\n\n#[test]\nfn external_declarations_refuse_invalid_ownership_and_paths() -> TestResult {\n    with_fixture(\"invalid\", |root, expected| {\n        for (fixture, artifact, name, diagnostic) in [\n            (\"absent\", \"live.txt\", \"TestLiveArtifact\", \"unknown external fixture\"),\n            (\"control\", \"absent.txt\", \"TestLiveArtifact\", \"missing external artifact\"),\n            (\"control\", \"live.txt\", \"\", \"invalid external consumer\"),\n            (\"control\", \"../live.txt\", \"TestLiveArtifact\", \"invalid external artifact\"),\n            (\"control\", \"./live.txt\", \"TestLiveArtifact\", \"invalid external artifact\"),\n            (\"control\", \"nested/live.txt\", \"TestLiveArtifact\", \"invalid external artifact\"),\n            (\"control\", \"live.snap.txt\", \"TestLiveArtifact\", \"invalid external artifact\"),\n            (\"control\", \"report.txt\", \"TestLiveArtifact\", \"external artifact has native consumer\"),\n        ] {\n            let error = run_at_skipping_with_external(\n                root,\n                vec![(\"control\", || Ok(Files::new()))],\n                &[umpire_testing::CHECKER],\n                &[],\n                &[ExternalConsumer { name, fixture, expected: artifact }],\n            )\n            .err()\n            .ok_or(\"invalid ownership passed\")?;\n            assert!(error.to_string().contains(diagnostic), \"{fixture}/{artifact}: {error}\");\n        }\n        let error = run_at_skipping_with_external(\n            root,\n            vec![(\"control\", || Ok(Files::new()))],\n            &[umpire_testing::CHECKER],\n            &[],\n            &[LIVE, LIVE],\n        )\n        .err()\n        .ok_or(\"duplicate external ownership passed\")?;\n        assert!(error.to_string().contains(\"duplicate external artifact\"), \"{error}\");\n        fs::write(expected.join(\"unknown.txt\"), \"unknown\\n\")?;\n        let error = run_at_skipping_with_external(\n            root,\n            vec![(\"control\", || Ok(Files::new()))],\n            &[umpire_testing::CHECKER],\n            &[],\n            &[LIVE],\n        )\n        .err()\n        .ok_or(\"unknown golden passed\")?;\n        assert!(error.to_string().contains(\"expected file has no consumer\"), \"{error}\");\n        fs::remove_file(expected.join(\"unknown.txt\"))?;\n        let error = run_at_skipping_with_external(\n            root,\n            vec![(\"control\", || Ok(Files::from([(\"live.txt\".into(), \"forged\\n\".into())])))],\n            &[umpire_testing::CHECKER],\n            &[],\n            &[LIVE],\n        )\n        .err()\n        .ok_or(\"native producer supplied external evidence\")?;\n        assert!(error.to_string().contains(\"native producer emitted external artifact\"), \"{error}\");\n        assert_eq!(fs::read(expected.join(\"live.txt\"))?, b\"live proof\\n\");\n        fs::remove_file(expected.join(\"report.snap.txt\"))?;\n        let error = run_at_skipping_with_external(\n            root,\n            vec![(\"control\", || panic!(\"external-only fixture ran native producer\"))],\n            &[umpire_testing::CHECKER],\n            &[],\n            &[LIVE],\n        )\n        .err()\n        .ok_or(\"external-only fixture bypassed native golden requirement\")?;\n        assert!(\n            error.to_string().contains(\"fixture has no consumer-owned expected files\"),\n            \"{error}\"\n        );\n        Ok(())\n    })\n}\n","exit_code":0,"status":"completed"}}
