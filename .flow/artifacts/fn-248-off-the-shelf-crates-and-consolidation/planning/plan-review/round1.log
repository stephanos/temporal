{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cd temporal && sed -n '1,245p' model/umpire/backends/apalache/src/decode.rs && sed -n '1270,1330p' Makefile && cat model/temporal/api/codegen.rs && sed -n '270,400p' model/umpire/dev/testing/src/runner.rs\"","aggregated_output":"//! Bounded conversion of pinned ITF wire values into the shared typed assignment contract.\nuse serde::de::{self, Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};\nuse std::{\n    collections::{BTreeMap, BTreeSet},\n    fmt,\n};\nuse umpire_tla::{\n    Refusal,\n    values::{Schema, State, TraceState, Type, Value},\n};\n\nconst BYTES: usize = 4 * 1024 * 1024;\nconst ITEMS: usize = 100_000;\nconst DEPTH: usize = 64;\n\n/// A complete ITF trace with fixed, explicitly declared World parameters.\n#[derive(Clone, Debug)]\npub struct Itf {\n    /// Selected World parameters, constant throughout the trace.\n    pub parameters: State,\n    /// Complete typed states and exact emitted observers.\n    pub states: Vec<TraceState>,\n}\n\n// An object visitor must see keys before a JSON map could silently overwrite them.\nstruct Json(serde_json::Value);\nimpl<'de> Deserialize<'de> for Json {\n    fn deserialize<D: Deserializer<'de>>(decoder: D) -> Result<Self, D::Error> {\n        struct Strict;\n        impl<'de> Visitor<'de> for Strict {\n            type Value = Json;\n            fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n                f.write_str(\"strict JSON\")\n            }\n            fn visit_bool<E: de::Error>(self, v: bool) -> Result<Json, E> {\n                Ok(Json(v.into()))\n            }\n            fn visit_i64<E: de::Error>(self, v: i64) -> Result<Json, E> {\n                Ok(Json(v.into()))\n            }\n            fn visit_u64<E: de::Error>(self, v: u64) -> Result<Json, E> {\n                Ok(Json(v.into()))\n            }\n            fn visit_f64<E: de::Error>(self, _: f64) -> Result<Json, E> {\n                Err(E::custom(\"ITF floating point value\"))\n            }\n            fn visit_str<E: de::Error>(self, v: &str) -> Result<Json, E> {\n                Ok(Json(v.into()))\n            }\n            fn visit_unit<E: de::Error>(self) -> Result<Json, E> {\n                Err(E::custom(\"ITF null value\"))\n            }\n            fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<Json, A::Error> {\n                let mut values = Vec::new();\n                while let Some(Json(value)) = seq.next_element()? {\n                    if values.len() >= ITEMS {\n                        return Err(de::Error::custom(\"ITF collection limit\"));\n                    }\n                    values.push(value);\n                }\n                Ok(Json(values.into()))\n            }\n            fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Json, A::Error> {\n                let mut values = serde_json::Map::new();\n                while let Some(key) = map.next_key::<String>()? {\n                    if values.len() >= ITEMS || values.contains_key(&key) {\n                        return Err(de::Error::custom(\"ITF duplicate key or collection limit\"));\n                    }\n                    let Json(value) = map.next_value()?;\n                    values.insert(key, value);\n                }\n                Ok(Json(values.into()))\n            }\n        }\n        decoder.deserialize_any(Strict)\n    }\n}\n\nfn refuse(message: impl Into<String>) -> Refusal {\n    Refusal(format!(\"ITF: {}\", message.into()))\n}\nfn object(v: &serde_json::Value) -> Result<&serde_json::Map<String, serde_json::Value>, Refusal> {\n    v.as_object().ok_or_else(|| refuse(\"expected object\"))\n}\nfn array(v: &serde_json::Value) -> Result<&[serde_json::Value], Refusal> {\n    v.as_array().map(Vec::as_slice).ok_or_else(|| refuse(\"expected array\"))\n}\nfn get<'a>(v: &'a serde_json::Value, key: &str) -> Result<&'a serde_json::Value, Refusal> {\n    object(v)?.get(key).ok_or_else(|| refuse(format!(\"missing {key}\")))\n}\nfn keys(v: &serde_json::Value, required: &[&str], optional: &[&str]) -> Result<(), Refusal> {\n    let map = object(v)?;\n    if required.iter().any(|key| !map.contains_key(*key))\n        || map\n            .keys()\n            .any(|key| !required.contains(&key.as_str()) && !optional.contains(&key.as_str()))\n    {\n        return Err(refuse(\"missing or undeclared object field\"));\n    }\n    Ok(())\n}\nfn names(v: &serde_json::Value) -> Result<BTreeSet<&str>, Refusal> {\n    let values = array(v)?;\n    let names: BTreeSet<_> = values\n        .iter()\n        .map(|v| v.as_str().ok_or_else(|| refuse(\"non-string declaration\")))\n        .collect::<Result<_, _>>()?;\n    if names.len() != values.len() {\n        return Err(refuse(\"duplicate declaration\"));\n    }\n    Ok(names)\n}\n\n/// Decode a pinned-release witness, rejecting undeclared data and excessive input before parsing.\npub fn decode_itf(\n    raw: &str,\n    schema: &Schema,\n    parameters: &BTreeMap<String, Type>,\n    length: usize,\n) -> Result<Itf, Refusal> {\n    budget(raw)?;\n    schema.validate_assignment()?;\n    if parameters\n        .keys()\n        .any(|key| schema.fields.contains_key(key) || schema.observers.contains_key(key))\n    {\n        return Err(refuse(\"parameter collides with variable\"));\n    }\n    let Json(root) = serde_json::from_str::<Json>(raw).map_err(|e| refuse(e.to_string()))?;\n    keys(&root, &[\"#meta\", \"vars\", \"states\"], &[\"params\"])?;\n    let meta = get(&root, \"#meta\")?;\n    keys(meta, &[\"format\"], &[\"format-description\", \"description\", \"varTypes\", \"version\"])?;\n    if get(meta, \"format\")?.as_str() != Some(\"ITF\") {\n        return Err(refuse(\"unknown format\"));\n    }\n    if object(meta)?.contains_key(\"version\") {\n        return Err(refuse(\"pinned ITF declares no version\"));\n    }\n    for key in [\"format-description\", \"description\"] {\n        if let Some(v) = meta.get(key)\n            && !v.is_string()\n        {\n            return Err(refuse(\"invalid metadata text\"));\n        }\n    }\n    let expected: BTreeSet<_> =\n        schema.fields.keys().chain(schema.observers.keys()).map(String::as_str).collect();\n    if names(get(&root, \"vars\")?)? != expected {\n        return Err(refuse(\"variable declarations differ\"));\n    }\n    if let Some(types) = meta.get(\"varTypes\")\n        && (object(types)?.keys().map(String::as_str).collect::<BTreeSet<_>>() != expected\n            || schema.fields.iter().chain(&schema.observers).any(|(name, kind)| {\n                types.get(name).and_then(serde_json::Value::as_str)\n                    != Some(wire_type(kind).as_str())\n            }))\n    {\n        return Err(refuse(\"variable type declarations differ\"));\n    }\n    let declared = root.get(\"params\").map(names).transpose()?.unwrap_or_default();\n    if declared != parameters.keys().map(String::as_str).collect() {\n        return Err(refuse(\"parameter declarations differ\"));\n    }\n    let rows = array(get(&root, \"states\")?)?;\n    if rows.is_empty() || rows.len() > 10_000 || rows.len().saturating_sub(1) > length {\n        return Err(refuse(\"state count outside bound\"));\n    }\n    let mut fixed = None;\n    let mut states = Vec::new();\n    for (index, row) in rows.iter().enumerate() {\n        let meta = get(row, \"#meta\")?;\n        keys(meta, &[\"index\"], &[])?;\n        if get(meta, \"index\")?.as_u64().and_then(|i| usize::try_from(i).ok()) != Some(index) {\n            return Err(refuse(\"nonconsecutive state positions\"));\n        }\n        let mut assignment = State::new();\n        let mut selected = State::new();\n        for (name, raw) in object(row)? {\n            if name == \"#meta\" {\n                continue;\n            }\n            let kind = parameters\n                .get(name)\n                .or_else(|| schema.fields.get(name))\n                .or_else(|| schema.observers.get(name))\n                .ok_or_else(|| refuse(format!(\"undeclared state field {name}\")))?;\n            let value = value(raw, kind)?;\n            if parameters.contains_key(name) {\n                selected.insert(name.clone(), value);\n            } else {\n                assignment.insert(name.clone(), value);\n            }\n        }\n        if selected.len() != parameters.len() {\n            return Err(refuse(\"missing World parameter\"));\n        }\n        if fixed.as_ref().is_some_and(|p| p != &selected) {\n            return Err(refuse(\"World parameter changed\"));\n        }\n        fixed = Some(selected);\n        states.push(schema.project_assignment(assignment)?);\n    }\n    Ok(Itf { parameters: fixed.unwrap_or_default(), states })\n}\n\nfn wire_type(kind: &Type) -> String {\n    match kind {\n        Type::Bool => \"Bool\".into(),\n        Type::Int { .. } | Type::OptionalInt { .. } => \"Int\".into(),\n        Type::Text | Type::Enum(_) => \"Str\".into(),\n        Type::Tuple(types) if types.is_empty() => \"Seq(Int)\".into(),\n        Type::Tuple(types) => {\n            format!(\"<<{}>>\", types.iter().map(wire_type).collect::<Vec<_>>().join(\", \"))\n        }\n        Type::Seq(inner) => format!(\"Seq({})\", wire_type(inner)),\n        Type::Set(inner) => format!(\"Set({})\", wire_type(inner)),\n        Type::Record(fields) => format!(\n            \"{{ {} }}\",\n            fields\n                .iter()\n                .map(|(name, kind)| format!(\"{name}: {}\", wire_type(kind)))\n                .collect::<Vec<_>>()\n                .join(\", \")\n        ),\n    }\n}\n\nfn budget(raw: &str) -> Result<(), Refusal> {\n    if raw.len() > BYTES {\n        return Err(refuse(\"byte limit\"));\n    }\n    let (mut depth, mut items, mut string, mut escaped) = (0usize, 0usize, false, false);\n    for b in raw.bytes() {\n        if string {\n            if escaped {\n                escaped = false;\n            } else if b == b'\\\\' {\n                escaped = true;\n            } else if b == b'\"' {\n                string = false;\n            }\n        } else {\n            match b {\n                b'\"' => {\n                    string = true;\nRUST_MODEL_CARGO := cd model && mise exec -- cargo\nRUST_MODEL_STEP = $(if $(filter 1,$(UMPIRE_TIME_STEPS)),/bin/bash $(CURDIR)/model/scripts/time-gate.sh --step $(1),)\n\n.PHONY: model-check model-fmt model-update model-time model-validate\nmodel-check: $(PROTOC_GEN_GO) $(PROTOC_GEN_GO_GRPC) $(API_BINPB)\n\t@printf $(COLOR) \"Check model (fmt, clippy, docs, tests)...\"\n\t@if [ \"$${UMPIRE_BACKENDS:-}\" = require ]; then printf '%s\\n' 'TLC backend required: real source-lifted agreement and semantic controls'; else printf '%s\\n' 'TLC backend skipped: no execution/agreement evidence; use UMPIRE_BACKENDS=require'; fi\n\t@if [ \"$${UMPIRE_APALACHE:-}\" = require ]; then printf '%s\\n' 'Apalache backend required: real bounded checks and replay controls'; helper=$$(/bin/bash \"$(CURDIR)/model/scripts/xtask.sh\") && \"$$helper\" fetch-apalache \"$(CURDIR)\"; else printf '%s\\n' 'Apalache backend skipped until fn-211 resumes; use UMPIRE_APALACHE=require'; fi\n\t@$(call RUST_MODEL_STEP,temporal-guest-freshness) /bin/bash \"$(CURDIR)/model/scripts/guest-freshness.sh\" umpire-temporal-guest \"$(CURDIR)/model/temporal/hosts/go/umpire_temporal_guest.wasm\"\n\t@$(call RUST_MODEL_STEP,retired-names) /bin/bash $(CURDIR)/model/scripts/retired-names.sh\n\t@$(call RUST_MODEL_STEP,timing-controls) /bin/bash $(CURDIR)/model/scripts/test-time-gate.sh\n\t@$(call RUST_MODEL_STEP,guest-build-controls) python3 -m unittest discover -s $(CURDIR)/model/scripts/tests -p 'test_*.py'\n\t@$(call RUST_MODEL_STEP,capability-controls) /bin/bash $(CURDIR)/model/scripts/test-capabilities.sh\n\t@cd model && $(call RUST_MODEL_STEP,source-boundary) mise exec -- cargo test -p umpire-temporal-tests --test boundary --quiet\n\t@$(call RUST_MODEL_STEP,protobuf-freshness) /bin/bash $(CURDIR)/model/scripts/proto-go.sh --check\n\t@$(call RUST_MODEL_STEP,kettle-protobuf-freshness) /bin/bash $(CURDIR)/model/scripts/proto-kettle-go.sh --check\n\t@$(call RUST_MODEL_STEP,temporal-protobuf-freshness) /bin/bash $(CURDIR)/model/scripts/proto-temporal-go.sh --check\n\t@cd model && $(call RUST_MODEL_STEP,fmt) mise exec -- cargo fmt --all --check\n\t@cd model && $(call RUST_MODEL_STEP,clippy) mise exec -- cargo clippy --workspace --all-targets --all-features -- -D warnings\n\t@cd model && $(call RUST_MODEL_STEP,docs) env RUSTDOCFLAGS=\"-D warnings\" mise exec -- cargo doc --workspace --no-deps --quiet\n\t@cd model && $(call RUST_MODEL_STEP,tests) mise exec -- cargo test --workspace --quiet\n\t@cd model && $(call RUST_MODEL_STEP,wasm32-wasip1) mise exec -- cargo build --target wasm32-wasip1 -p umpire-dsl -p umpire-checker --quiet\n\t@cd model && $(call RUST_MODEL_STEP,core-wasm-clippy) mise exec -- cargo clippy --target wasm32-wasip1 -p umpire-dsl -p umpire-checker --lib --locked -- -D warnings\n\t@$(call RUST_MODEL_STEP,wasm-guest) /bin/bash $(CURDIR)/model/scripts/tests/build-guests.sh\n\t@cd model && target=\"$${CARGO_TARGET_DIR:-$$PWD/target}\" && case \"$$target\" in /*) ;; *) target=\"$$PWD/$$target\" ;; esac && UMPIRE_WASM=\"$$target/wasm32-wasip1/guest/umpire_stock_guest.wasm\" UMPIRE_KETTLE_WASM=\"$$target/wasm32-wasip1/guest/umpire_kettle_guest.wasm\" UMPIRE_STATEFUL_WASM=\"$$target/wasm32-wasip1/guest/stateful_control.wasm\" UMPIRE_CAUGHT_PANIC_WASM=\"$$target/wasm32-wasip1/guest/caught_panic_control.wasm\" UMPIRE_OVERFLOW_WASM=\"$$target/wasm32-wasip1/guest/overflow_control.wasm\" UMPIRE_PANIC_NATIVE=\"$$target/panic-native\" CGO_ENABLED=0 $(call RUST_MODEL_STEP,go-host) mise exec -- go -C \"$$PWD/umpire/hosts/go\" test -tags test_dep -count=1 ./...\n\t@cd model && target=\"$${CARGO_TARGET_DIR:-$$PWD/target}\" && case \"$$target\" in /*) ;; *) target=\"$$PWD/$$target\" ;; esac && UMPIRE_WASM=\"$$target/wasm32-wasip1/guest/umpire_stock_guest.wasm\" UMPIRE_KETTLE_WASM=\"$$target/wasm32-wasip1/guest/umpire_kettle_guest.wasm\" UMPIRE_STATEFUL_WASM=\"$$target/wasm32-wasip1/guest/stateful_control.wasm\" UMPIRE_CAUGHT_PANIC_WASM=\"$$target/wasm32-wasip1/guest/caught_panic_control.wasm\" UMPIRE_OVERFLOW_WASM=\"$$target/wasm32-wasip1/guest/overflow_control.wasm\" UMPIRE_PANIC_NATIVE=\"$$target/panic-native\" CGO_ENABLED=0 $(call RUST_MODEL_STEP,kettle-go-host) mise exec -- go -C \"$$PWD/umpire/reference/kettle\" test -tags test_dep -count=1 ./...\n\t@cd model && CGO_ENABLED=0 $(call RUST_MODEL_STEP,temporal-go-host) mise exec -- go -C \"$$PWD/temporal/hosts/go\" test -tags test_dep -count=1 ./...\n\nmodel-fmt:\n\t@$(RUST_MODEL_CARGO) fmt --all\n\nmodel-update:\n\t@printf $(COLOR) \"Update model golden files (insta, trybuild)...\"\n\t@cd model && INSTA_UPDATE=always TRYBUILD=overwrite mise exec -- cargo test --workspace --quiet\n\nmodel-time:\n\t@printf $(COLOR) \"Time the model feedback loop (fn-210 R30)...\"\n\t@$(CURDIR)/model/scripts/time-gate.sh\n\nmodel-validate:\n\t@$(MAKE) UMPIRE_BACKENDS=require model-time\n//! API closure generation with shared protocol imports.\nuse std::{io, path::Path};\npub(crate) fn generate(\n    config: &mut prost_build::Config,\n    upstream: &Path,\n    schema: &Path,\n    include: &Path,\n) -> io::Result<()> {\n    config\n        .extern_path(\".umpire.realization.v1\", \"::umpire_runtime::realization\")\n        .extern_path(\".umpire.annotations.v1\", \"::umpire_runtime::annotations\");\n    umpire_catalog_build::codegen::generate(\n        config,\n        upstream,\n        schema,\n        &[include, &include.join(\"../../umpire/protocol/proto\")],\n    )\n}\n            continue;\n        }\n        let [metadata, payload, pending_metadata, pending_payload] =\n            golden_files(&expected.join(&logical));\n        if !metadata.is_file() || !payload.is_file() {\n            return Err(format!(\"skipped backend has incomplete golden: {}\", path.display()).into());\n        }\n        if pending_metadata.exists() || pending_payload.exists() {\n            return Err(format!(\"skipped backend has pending golden: {}\", path.display()).into());\n        }\n        artifacts.extend([metadata, payload]);\n    }\n    Ok(artifacts)\n}\n\nfn logical_file(path: &Path, root: &Path) -> Result<String, Box<dyn std::error::Error>> {\n    let relative = path.strip_prefix(root)?.to_string_lossy().replace('\\\\', \"/\");\n    let (stem, extension) = if let Some(stem) =\n        relative.strip_suffix(\".snap.new\").or_else(|| relative.strip_suffix(\".snap\"))\n    {\n        let metadata = fs::read_to_string(path)?;\n        let extension = metadata\n            .lines()\n            .find_map(|line| line.strip_prefix(\"extension: \"))\n            .ok_or_else(|| format!(\"invalid binary snapshot metadata: {}\", path.display()))?;\n        (stem.to_owned(), extension.to_owned())\n    } else if let Some((stem, extension)) =\n        relative.split_once(\".snap.new.\").or_else(|| relative.split_once(\".snap.\"))\n    {\n        (stem.to_owned(), extension.to_owned())\n    } else {\n        return Ok(relative);\n    };\n    let stem = if extension == \"txt\" {\n        &stem\n    } else {\n        stem.strip_suffix(&format!(\"@{extension}\")).unwrap_or(&stem)\n    };\n    Ok(format!(\"{stem}.{extension}\"))\n}\n\nfn golden_files(path: &Path) -> [PathBuf; 4] {\n    let extension = path.extension().and_then(|s| s.to_str()).unwrap_or(\"txt\");\n    let metadata = if extension == \"txt\" {\n        path.with_extension(\"snap\")\n    } else {\n        path.with_file_name(format!(\n            \"{}@{extension}.snap\",\n            path.file_stem().unwrap_or_default().to_string_lossy()\n        ))\n    };\n    [\n        metadata.clone(),\n        metadata.with_extension(format!(\"snap.{extension}\")),\n        metadata.with_extension(\"snap.new\"),\n        metadata.with_extension(format!(\"snap.new.{extension}\")),\n    ]\n}\n\nfn snapshot(path: &Path, content: &str) -> crate::TestResult {\n    let parent = path.parent().ok_or(\"golden has no parent\")?;\n    let [metadata, payload, _, _] = golden_files(path);\n    if std::env::var(\"INSTA_UPDATE\").as_deref() == Ok(\"always\") {\n        fs::create_dir_all(parent)?;\n    } else {\n        fs::read(&payload).map_err(|error| {\n            format!(\"fixture has no readable golden {}: {error}\", payload.display())\n        })?;\n        if !metadata.is_file() {\n            return Err(format!(\"fixture has no snapshot metadata: {}\", path.display()).into());\n        }\n    }\n    let mut settings = insta::Settings::clone_current();\n    settings.set_snapshot_path(parent);\n    settings.set_prepend_module_to_snapshot(false);\n    settings.set_omit_expression(true);\n    let file = path.file_name().and_then(|name| name.to_str()).ok_or(\"invalid golden file name\")?;\n    let extension =\n        path.extension().and_then(|name| name.to_str()).ok_or(\"golden has no extension\")?;\n    if extension != \"txt\" {\n        settings.set_snapshot_suffix(extension);\n    }\n    let name = file;\n    settings.bind(|| {\n        insta::assert_binary_snapshot!(&name, content.as_bytes().to_vec());\n    });\n    Ok(())\n}\n\nfn collect_files(root: &Path, files: &mut Vec<PathBuf>) -> std::io::Result<()> {\n    if !root.exists() {\n        return Ok(());\n    }\n    for entry in fs::read_dir(root)? {\n        let entry = entry?;\n        let path = entry.path();\n        if entry.file_type()?.is_dir() {\n            collect_files(&path, files)?;\n        } else {\n            files.push(path);\n        }\n    }\n    Ok(())\n}\n","exit_code":0,"status":"completed"}}
