{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cd temporal && cat model/umpire/protocol/runtime/{build.rs,Cargo.toml,src/any.rs,src/lib.rs} && cat model/umpire/reference/kettle/build.rs model/temporal/api/build.rs && rg -n 'model-validate|model-check:|model-time:|model-check-|model-wasm|model-go|guest-closure|closure' Makefile model/README.md model/deny.toml\"","aggregated_output":"//! Generate shared protocols and well-known types.\n\nfn main() -> std::io::Result<()> {\n    let schema = \"../proto/umpire/model/v1/model.proto\";\n    println!(\"cargo:rerun-if-changed={schema}\");\n    println!(\"cargo:rerun-if-changed=../proto/umpire/realization/v1/realization.proto\");\n    println!(\"cargo:rerun-if-changed=../proto/umpire/annotations/v1/annotations.proto\");\n    let mut config = prost_build::Config::new();\n    config\n        .enable_type_names()\n        .type_name_domain([\".\"], \"type.googleapis.com\")\n        .compile_well_known_types()\n        .include_file(\"protocol.rs\")\n        .disable_comments([\".google.protobuf\"]);\n    config.compile_protos(\n        &[\n            schema,\n            \"../proto/umpire/realization/v1/realization.proto\",\n            \"../proto/umpire/annotations/v1/annotations.proto\",\n            \"google/protobuf/any.proto\",\n            \"google/protobuf/api.proto\",\n            \"google/protobuf/descriptor.proto\",\n            \"google/protobuf/duration.proto\",\n            \"google/protobuf/empty.proto\",\n            \"google/protobuf/field_mask.proto\",\n            \"google/protobuf/source_context.proto\",\n            \"google/protobuf/struct.proto\",\n            \"google/protobuf/timestamp.proto\",\n            \"google/protobuf/type.proto\",\n            \"google/protobuf/wrappers.proto\",\n        ],\n        &[\"../proto\"],\n    )\n}\n[package]\nname = \"umpire-runtime\"\ndescription = \"Model protocol, transactional realization dispatch and core-wasm ABI\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lib]\ncrate-type = [\"rlib\"]\n\n[dependencies]\numpire-dsl.workspace = true\numpire-checker.workspace = true\nprost.workspace = true\n\n[build-dependencies]\nprost-build.workspace = true\n\n[lints.rust]\nmissing_docs = \"warn\"\nunsafe_code = \"deny\"\nunused_qualifications = \"warn\"\nunreachable_pub = \"warn\"\nrust_2018_idioms = { level = \"warn\", priority = -1 }\n\n[lints.clippy]\nall = { level = \"warn\", priority = -1 }\npedantic = { level = \"warn\", priority = -1 }\nmodule_name_repetitions = \"allow\"\nmust_use_candidate = \"allow\"\nmissing_errors_doc = \"allow\"\nmissing_panics_doc = \"allow\"\nunwrap_used = \"warn\"\nexpect_used = \"warn\"\ndbg_macro = \"warn\"\ntodo = \"warn\"\nprint_stdout = \"warn\"\nprint_stderr = \"warn\"\nuse prost::Name;\n\nuse crate::{google::protobuf::Any, protocol::Refusal};\n\nimpl Any {\n    /// Encode a message using its generated canonical type URL.\n    pub fn pack<T: Name>(value: &T) -> Self {\n        Self { type_url: T::type_url(), value: value.encode_to_vec() }\n    }\n\n    /// Admit the exact canonical type URL before decoding a message.\n    pub fn unpack<T: Name + Default>(&self) -> Result<T, Refusal> {\n        if self.type_url.is_empty() {\n            return Err(Refusal::malformed(\"Any type URL is missing\"));\n        }\n        if self.type_url != T::type_url() {\n            return Err(Refusal::unsupported(\"unsupported Any type URL\"));\n        }\n        T::decode(self.value.as_slice()).map_err(|error| Refusal::malformed(error.to_string()))\n    }\n\n    /// Require an explicitly present payload.\n    pub fn required(value: Option<Self>) -> Result<Self, Refusal> {\n        value.ok_or_else(|| Refusal::malformed(\"required Any payload is missing\"))\n    }\n}\n//! Generated Model protocol, transactional dispatch, and bounded core-wasm ABI.\n#![cfg(not(test))]\n\nmod abi;\n#[path = \"annotations.rs\"]\nmod annotation_dispatch;\nmod any;\n#[path = \"realization.rs\"]\nmod envelopes;\nmod refusal;\nmod runtime;\nmod stock;\n\n/// Generated core contract and shared well-known types.\n#[allow(missing_docs, unreachable_pub, clippy::all, clippy::pedantic)]\nmod generated {\n    include!(concat!(env!(\"OUT_DIR\"), \"/protocol.rs\"));\n}\n\npub use abi::Guest;\npub use annotation_dispatch::{AnnotationRuntime, probe_recipe};\npub use envelopes::{Observed, callback, reply};\npub use generated::{\n    google,\n    umpire::{\n        annotations::v1 as annotations, model::v1 as protocol, realization::v1 as realization,\n    },\n};\npub use runtime::{\n    AnswerPlan, Candidate, Projection, Proposal, Realize, Runtime, Transaction, Transition,\n};\npub use stock::Model;\n\nimpl protocol::Refusal {\n    /// Construct a refusal with a stable protocol code.\n    pub fn new(code: protocol::RefusalCode, message: impl Into<String>) -> Self {\n        Self { code: code as i32, message: message.into() }\n    }\n\n    /// Refuse malformed input.\n    pub fn malformed(message: impl Into<String>) -> Self {\n        Self::new(protocol::RefusalCode::MalformedRequest, message)\n    }\n\n    /// Refuse a well-formed but unsupported input.\n    pub fn unsupported(message: impl Into<String>) -> Self {\n        Self::new(protocol::RefusalCode::Unsupported, message)\n    }\n}\n\n/// A dispatcher whose effects remain private until its response is published.\npub trait Dispatch {\n    /// Owned prospective changes, without imposing Clone on Model outcomes or facts.\n    type Transaction;\n\n    /// Computes a response and its optional effects without changing the current run.\n    fn prepare(\n        &self,\n        method: u32,\n        request: &[u8],\n    ) -> (protocol::Response, Option<Self::Transaction>);\n\n    /// Installs already validated effects after successful response publication.\n    fn commit(&mut self, transaction: Self::Transaction);\n}\n//! Generate the reference service and enforce the shared catalog descriptor closure.\nuse std::{env, fs, io, path::PathBuf};\n\nfn main() -> io::Result<()> {\n    let out =\n        PathBuf::from(env::var_os(\"OUT_DIR\").ok_or_else(|| io::Error::other(\"OUT_DIR missing\"))?);\n    let descriptor = out.join(\"kettle.binpb\");\n    for schema in [\"proto/kettle/v1/kettle.proto\", \"proto/kettle/v1/probe.proto\"] {\n        println!(\"cargo:rerun-if-changed={schema}\");\n    }\n    prost_build::Config::new()\n        .enable_type_names()\n        .type_name_domain([\".\"], \"type.googleapis.com\")\n        .compile_well_known_types()\n        .btree_map([\".\"])\n        .extern_path(\".google.protobuf\", \"::umpire_runtime::google::protobuf\")\n        .extern_path(\".umpire.annotations.v1\", \"::umpire_runtime::annotations\")\n        .file_descriptor_set_path(&descriptor)\n        .compile_protos(\n            &[\"proto/kettle/v1/kettle.proto\", \"proto/kettle/v1/probe.proto\"],\n            &[\"proto\", \"../../protocol/proto\"],\n        )?;\n    let root = PathBuf::from(\n        env::var_os(\"CARGO_MANIFEST_DIR\").ok_or_else(|| io::Error::other(\"manifest missing\"))?,\n    );\n    let (coverage, classifications) = umpire_catalog_build::coverage::check(\n        &root,\n        &descriptor,\n        \"umpire.reference.kettle.v1.KettleService\",\n        \"KettleServiceMethod\",\n    )?;\n    let bytes = fs::read(&descriptor)?;\n    fs::write(\n        out.join(\"services.rs\"),\n        umpire_catalog_build::services::generate(\n            &bytes,\n            &coverage,\n            &classifications,\n            &umpire_catalog_build::services::Config {\n                service: \"umpire.reference.kettle.v1.KettleService\",\n                rust_type_root: \"crate::wire\",\n                macro_type_root: \"$crate::wire\",\n                method_enum: \"KettleServiceMethod\",\n                method_info: \"KettleServiceMethodInfo\",\n                methods_const: \"KETTLE_SERVICE_METHODS\",\n                dispatch_macro: \"dispatch_kettle_annotations\",\n                bind_macro: \"bind_kettle_action\",\n            },\n        )\n        .map_err(io::Error::other)?,\n    )?;\n    fs::write(\n        out.join(\"wire_schema.rs\"),\n        umpire_catalog_build::wire_schema::generate(\n            &bytes,\n            &umpire_catalog_build::wire_schema::Config {\n                service: \"umpire.reference.kettle.v1.KettleService\",\n                rust_type_root: \"crate::wire\",\n                method_enum: \"KettleServiceMethod\",\n                fields_function: \"kettle_request_fields\",\n                mutate_function: \"mutate_kettle_request\",\n                request_roots: &[\n                    \"Fill\",\n                    \"Heat\",\n                    \"Pour\",\n                    \"Describe\",\n                    \"PollHeating\",\n                    \"RespondHeating\",\n                ],\n            },\n        )\n        .map_err(io::Error::other)?,\n    )?;\n    Ok(())\n}\n//! Generate the upstream descriptor closure with shared well-known types.\n\nuse std::{\n    env, fs, io,\n    path::{Path, PathBuf},\n    process::Command,\n};\n\nmod codegen;\nmod services;\nmod wire_schema;\n\nfn main() -> io::Result<()> {\n    let root = PathBuf::from(\n        env::var_os(\"CARGO_MANIFEST_DIR\")\n            .ok_or_else(|| io::Error::other(\"CARGO_MANIFEST_DIR is missing\"))?,\n    )\n    .join(\"../../..\");\n    let upstream = root.join(\"proto/api.binpb\");\n    for input in [\"Makefile\", \"go.mod\", \"go.sum\", \"cmd/tools/getproto\", \"proto/internal\"] {\n        println!(\"cargo:rerun-if-changed={}\", root.join(input).display());\n    }\n    if !Command::new(\"make\").current_dir(&root).arg(\"proto/api.binpb\").status()?.success() {\n        return Err(io::Error::other(\"make proto/api.binpb failed\"));\n    }\n    let schema = \"../proto/umpire/temporal/v1/temporal.proto\";\n    println!(\"cargo:rerun-if-changed={}\", upstream.display());\n    println!(\"cargo:rerun-if-changed={schema}\");\n    println!(\"cargo:rerun-if-changed=../proto/umpire/temporal/v1/probe.proto\");\n    println!(\"cargo:rerun-if-changed=../proto/umpire/temporal/v1/activity.proto\");\n    let linked = PathBuf::from(\n        env::var_os(\"OUT_DIR\").ok_or_else(|| io::Error::other(\"OUT_DIR is missing\"))?,\n    )\n    .join(\"annotation-api.binpb\");\n    if !Command::new(\"sh\")\n        .current_dir(&root)\n        .arg(\"cmd/tools/getproto/run.sh\")\n        .arg(\"--linked-api\")\n        .arg(&upstream)\n        .arg(\"--out\")\n        .arg(&linked)\n        .status()?\n        .success()\n    {\n        return Err(io::Error::other(\"linking annotation API descriptors failed\"));\n    }\n    let (coverage, classifications) = umpire_catalog_build::coverage::check(\n        &root.join(\"model/temporal\"),\n        &linked,\n        \"temporal.api.workflowservice.v1.WorkflowService\",\n        \"WorkflowServiceMethod\",\n    )?;\n    let descriptors = fs::read(&linked)?;\n    fs::write(\n        linked.with_file_name(\"services.rs\"),\n        services::generate(&descriptors, &coverage, &classifications).map_err(io::Error::other)?,\n    )?;\n    fs::write(\n        linked.with_file_name(\"wire_schema.rs\"),\n        wire_schema::generate(&descriptors).map_err(io::Error::other)?,\n    )?;\n\n    codegen::generate(\n        &mut prost_build::Config::new(),\n        &upstream,\n        Path::new(schema),\n        Path::new(\"../proto\"),\n    )\n}\nmodel/README.md:79:make model-validate # one TLC-required full gate, then one edited-checker benchmark\nmodel/README.md:97:the activity Model and goldens, generated upstream API closure, realization, guest and\nmodel/README.md:151:`model-validate` forces TLC-required `model-time` through environment/Make conflicts; add\nmodel/README.md:399:per state inside a Model method), a closure over the state, or a state. `..` is any number of\nmodel/README.md:470:closure, including timeoutless Worlds. Registered countdown laws establish the spanning\nmodel/README.md:484:shared closure laws. Fn-221 adds a rejected cancel self-loop at each of the four terminal\nmodel/README.md:518:closure is compiled natively and for WASM, with generated well-known types owned once\nmodel/README.md:519:by `umpire_runtime::google::protobuf`. The closure's file count is not a schema invariant.\nmodel/README.md:545:exact selected-World fairness support the activity policy. The retained retry, closure,\nmodel/README.md:839:make model-validate\nmodel/README.md:929:Phase access, rejection and closure laws are admitted together (fn-227.11). `impl\nmodel/README.md:993:closure. The executor integration and Driver hold mechanics follow in fn-243 task 2; at this\nMakefile:700:.PHONY: model-compiler-inputs model-check-changed\nMakefile:703:model-check-changed:\nMakefile:746:lint-model-check:\nMakefile:1273:.PHONY: model-check model-fmt model-update model-time model-validate\nMakefile:1274:model-check: $(PROTOC_GEN_GO) $(PROTOC_GEN_GO_GRPC) $(API_BINPB)\nMakefile:1305:model-time:\nMakefile:1309:model-validate:\n","exit_code":0,"status":"completed"}}
