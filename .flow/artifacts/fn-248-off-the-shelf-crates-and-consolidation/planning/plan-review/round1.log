al artifact: {}\", path.display()).into());\n249:                format!(\"missing external artifact or unsafe path: {}\", path.display()).into()\n253:            \"external artifact {}: requires {}; no execution or comparison evidence from native runner\",\n261:fn skipped_files(\n264:    consumer: &Consumer,\n269:        if !consumer.owns(&logical) {\n272:        let [metadata, payload, pending_metadata, pending_payload] =\n277:        if pending_metadata.exists() || pending_payload.exists() {\n278:            return Err(format!(\"skipped backend has pending golden: {}\", path.display()).into());\n285:fn logical_file(path: &Path, root: &Path) -> Result<String, Box<dyn std::error::Error>> {\n288:        relative.strip_suffix(\".snap.new\").or_else(|| relative.strip_suffix(\".snap\"))\n294:            .ok_or_else(|| format!(\"invalid binary snapshot metadata: {}\", path.display()))?;\n297:        relative.split_once(\".snap.new.\").or_else(|| relative.split_once(\".snap.\"))\n311:fn golden_files(path: &Path) -> [PathBuf; 4] {\n324:        metadata.with_extension(\"snap.new\"),\n325:        metadata.with_extension(format!(\"snap.new.{extension}\")),\n329:fn snapshot(path: &Path, content: &str) -> crate::TestResult {\n339:            return Err(format!(\"fixture has no snapshot metadata: {}\", path.display()).into());\n343:    settings.set_snapshot_path(parent);\n344:    settings.set_prepend_module_to_snapshot(false);\n350:        settings.set_snapshot_suffix(extension);\n354:        insta::assert_binary_snapshot!(&name, content.as_bytes().to_vec());\n359:fn collect_files(root: &Path, files: &mut Vec<PathBuf>) -> std::io::Result<()> {\n","exit_code":0,"status":"completed"}}
