{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cd temporal && cat model/umpire/{catalog/Cargo.toml,author/suite/Cargo.toml,backends/native/Cargo.toml} && sed -n '1,170p' model/umpire/catalog/src/value.rs && sed -n '1,150p' model/umpire/author/suite/src/pattern_search.rs && cat model/umpire/reference/kettle/probes.rs && sed -n '310,380p' model/temporal/realization/src/probes/generic.rs\"","aggregated_output":"[package]\nname = \"umpire-catalog\"\ndescription = \"Typed annotation catalogs, validation, generation and inspection\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lints]\nworkspace = true\n\n[dependencies]\nprost.workspace = true\numpire-runtime.workspace = true\numpire-catalog-macros.workspace = true\n\n[dev-dependencies]\ninsta.workspace = true\ntrybuild.workspace = true\n[package]\nname = \"umpire-suite\"\ndescription = \"A Model's own tests: authored examples replayed through the Model\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lints]\nworkspace = true\n\n[dependencies]\numpire-dsl.workspace = true\numpire-checker.workspace = true\nthiserror.workspace = true\n\n[dev-dependencies]\numpire.workspace = true\numpire-testing.workspace = true\n[package]\nname = \"umpire-checker\"\ndescription = \"Umpire native checker: explore, verify_all, refuted\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lints]\nworkspace = true\n\n[dependencies]\numpire-dsl.workspace = true\nindexmap.workspace = true\nrustc-hash.workspace = true\nfixedbitset.workspace = true\npetgraph.workspace = true\nthiserror.workspace = true\n\n[dev-dependencies]\nproptest.workspace = true\ntrybuild.workspace = true\numpire-testing.workspace = true\n//! Native typed values and deterministic generation.\n\nuse crate::{BytesRules, Kind, NumberRules, RepeatedRules, StringRules, kind::number_name};\nuse std::fmt;\n\n/// Stable `SplitMix64` stream; no operating-system randomness is consulted.\n#[derive(Clone, Debug)]\npub struct Rng(u64);\n\nimpl Rng {\n    /// Starts a deterministic stream.\n    pub const fn new(seed: u64) -> Self {\n        Self(seed)\n    }\n    /// Draws the next integer.\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);\n        let mut value = self.0;\n        value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n        value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n        value ^ (value >> 31)\n    }\n}\n\n/// Refusal to construct a conforming typed value.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum GenerationError {\n    /// This wire carrier cannot represent the requested mutation.\n    InapplicableMutation,\n    /// A projected message was not a valid protobuf encoding.\n    InvalidEncoding,\n    /// Secrets must come from the caller.\n    ExternalSecret,\n    /// The kind does not apply to this Rust type.\n    UnsupportedType,\n    /// No value satisfies the declared constraints.\n    ImpossibleConstraints,\n    /// Construction exceeds the bounded generator's size or search limit.\n    SizeLimit,\n}\n\nimpl fmt::Display for GenerationError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"{self:?}\")\n    }\n}\nimpl std::error::Error for GenerationError {}\n\n/// Direct typed operations on a Rust field. Adapters may implement this for local message types.\npub trait FieldValue: Clone + Default + PartialEq + 'static {\n    /// Constructs a negative candidate; the catalog verifies its actual finding.\n    fn negative(\n        &self,\n        kind: &Kind,\n        _repeated: Option<&RepeatedRules>,\n        constraint: &str,\n        rng: &mut Rng,\n    ) -> Result<Self, GenerationError> {\n        Self::generate(&crate::negative::negative_kind(kind, constraint)?, rng)\n    }\n    /// Whether the field's Rust type can carry this kind.\n    fn supports(kind: &Kind) -> bool;\n    /// Constraint names specialized to the field's numeric carrier.\n    fn constraints(kind: &Kind) -> Vec<&'static str> {\n        kind.constraints()\n    }\n    /// JSON-Schema-style presence: nondefault scalar, nonempty sequence, or present optional.\n    fn present(&self) -> bool;\n    /// Constraint names violated by this value, without its contents.\n    fn violations(&self, kind: &Kind) -> Vec<&'static str>;\n    /// Constructs a value or explicitly refuses.\n    fn generate(kind: &Kind, rng: &mut Rng) -> Result<Self, GenerationError>;\n    /// Constructs a present candidate for the message's presence-rule search.\n    fn generate_present(kind: &Kind, rng: &mut Rng) -> Result<Self, GenerationError> {\n        let value = Self::generate(kind, rng)?;\n        if value.present() { Ok(value) } else { Err(GenerationError::ImpossibleConstraints) }\n    }\n    /// Whether this field supports repeated constraints.\n    fn is_repeated() -> bool {\n        false\n    }\n    /// Violated repeated constraints.\n    fn repeated_violations(&self, _rules: &RepeatedRules) -> Vec<&'static str> {\n        Vec::new()\n    }\n    /// Generates a repeated field; scalar fields refuse.\n    /// Exhausted bounded sampling returns `SizeLimit`, not a proof of impossible constraints.\n    fn generate_repeated(\n        _kind: &Kind,\n        _rules: &RepeatedRules,\n        _rng: &mut Rng,\n    ) -> Result<Self, GenerationError> {\n        Err(GenerationError::UnsupportedType)\n    }\n}\n\nconst MAX_GENERATED_LEN: usize = 4096;\n\nfn text_violations(value: &str, rules: &StringRules, identifier: bool) -> Vec<&'static str> {\n    let mut result = Vec::new();\n    let min = rules.min_len.unwrap_or(0).max(usize::from(identifier));\n    let len = value.chars().count();\n    if len < min {\n        result.push(\"string.min_len\");\n    }\n    if rules.max_len.is_some_and(|max| len > max) {\n        result.push(\"string.max_len\");\n    }\n    if rules.min_bytes.is_some_and(|min| value.len() < min) {\n        result.push(\"string.min_bytes\");\n    }\n    if rules.max_bytes.is_some_and(|max| value.len() > max) {\n        result.push(\"string.max_bytes\");\n    }\n    if rules.prefix.as_ref().is_some_and(|prefix| !value.starts_with(prefix)) {\n        result.push(\"string.prefix\");\n    }\n    if rules.suffix.as_ref().is_some_and(|suffix| !value.ends_with(suffix)) {\n        result.push(\"string.suffix\");\n    }\n    if rules.contains.as_ref().is_some_and(|part| !value.contains(part)) {\n        result.push(\"string.contains\");\n    }\n    result\n}\n\nfn bytes_violations(len: usize, rules: &BytesRules) -> Vec<&'static str> {\n    let mut result = Vec::new();\n    if rules.min_len.is_some_and(|min| len < min) {\n        result.push(\"bytes.min_len\");\n    }\n    if rules.max_len.is_some_and(|max| len > max) {\n        result.push(\"bytes.max_len\");\n    }\n    result\n}\n\nfn generated_len(min: usize, max: Option<usize>) -> Result<usize, GenerationError> {\n    if max.is_some_and(|max| min > max) {\n        return Err(GenerationError::ImpossibleConstraints);\n    }\n    if min > MAX_GENERATED_LEN {\n        return Err(GenerationError::SizeLimit);\n    }\n    Ok(min)\n}\n\nfn sampled_len(min: usize, max: Option<usize>, rng: &mut Rng) -> Result<usize, GenerationError> {\n    generated_len(min, max)?;\n    let max = max.unwrap_or_else(|| min.saturating_add(16)).min(MAX_GENERATED_LEN);\n    let span = u64::try_from(max - min + 1).map_err(|_| GenerationError::SizeLimit)?;\n    Ok(min + usize::try_from(rng.next_u64() % span).map_err(|_| GenerationError::SizeLimit)?)\n}\n\nfn random_character(max_bytes: usize, rng: &mut Rng) -> char {\n    let count = match max_bytes {\n        1 => 0x80,\n        2 => 0x800,\n        3 => 0xf800,\n        _ => 0x10_f800,\n    };\n    let index = u32::try_from(rng.next_u64() % count).unwrap_or(0);\n    let scalar = if index >= 0xd800 { index + 0x800 } else { index };\n    char::from_u32(scalar).unwrap_or('\\0')\n}\n\nfn uuid(value: &str) -> bool {\n    value.len() == 36\n        && value.bytes().enumerate().all(|(i, byte)| {\n            if matches!(i, 8 | 13 | 18 | 23) { byte == b'-' } else { byte.is_ascii_hexdigit() }\n//! Typed pattern matching over retained checker rows.\n\nuse std::{\n    collections::{HashMap, VecDeque},\n    panic::{AssertUnwindSafe, catch_unwind},\n};\n\nuse umpire_checker::{Path, PathStep, StateId, Transition};\nuse umpire_dsl::{Alternative, Gap, Machine, PathNode, Waypoint};\n\nuse crate::Refusal;\n\nconst SEARCH_LIMIT: usize = 1_000_000;\n\npub(crate) struct Witness<M: Machine> {\n    pub(crate) trace: Path<M::State, M::Action>,\n    pub(crate) rows: Vec<(StateId, usize)>,\n}\n\npub(crate) struct Graph<'a, M: Machine> {\n    explored: &'a umpire_checker::Result<M>,\n    states: Vec<&'a M::State>,\n    rows: Vec<Vec<&'a Transition<M>>>,\n    frontier: usize,\n}\n\n#[derive(Clone, Copy, Debug, Hash, PartialEq, Eq)]\nstruct Position {\n    state: StateId,\n    next: usize,\n    age: u32,\n    depth: usize,\n}\n\nstruct Label {\n    position: Position,\n    distance: usize,\n    parent: Option<(usize, Option<usize>)>,\n}\n\nstruct Arc {\n    target: usize,\n    row: Option<usize>,\n}\n\npub(crate) struct Rng(u64);\n\nimpl Rng {\n    pub(crate) const fn new(seed: u64) -> Self {\n        Self(seed)\n    }\n\n    pub(crate) fn index(&mut self, len: usize) -> usize {\n        assert!(len > 0);\n        self.0 = self.0.wrapping_add(0x9e37_79b9_7f4a_7c15);\n        let mut value = self.0;\n        value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);\n        value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);\n        value ^= value >> 31;\n        usize::try_from(value % u64::try_from(len).unwrap_or(u64::MAX)).unwrap_or(0)\n    }\n}\n\nimpl<'a, M: Machine> Graph<'a, M> {\n    pub(crate) fn new(explored: &'a umpire_checker::Result<M>) -> Result<Self, Refusal> {\n        let states: Vec<_> = explored.states().map(|(_, state)| state).collect();\n        let rows: Vec<Vec<_>> = explored\n            .states()\n            .map(|(id, _)| explored.rows(id).map(Iterator::collect))\n            .collect::<Result<_, _>>()?;\n        let mut frontier = usize::MAX;\n        if explored.counts.cut {\n            frontier = 0;\n            for edges in &rows {\n                if let Some(row) = edges.iter().find(|row| row.target.is_none()) {\n                    let depth = explored.path_to(row.source)?.steps.len() + 1;\n                    frontier = if frontier == 0 { depth } else { frontier.min(depth) };\n                }\n            }\n        }\n        Ok(Self { explored, states, rows, frontier })\n    }\n\n    fn nodes(\n        alternative: &Alternative<M::State, M::Action, M::Outcome>,\n        prefix: bool,\n    ) -> Vec<PathNode<M::State, M::Action, M::Outcome>> {\n        let mut nodes = Vec::with_capacity(alternative.nodes.len() + usize::from(prefix));\n        if prefix {\n            nodes.push(PathNode::Gap { gap: Gap::Any, exclude: None });\n        }\n        nodes.extend(alternative.nodes.iter().cloned());\n        nodes\n    }\n\n    fn judge(\n        &self,\n        index: usize,\n        state: StateId,\n        predicate: impl FnOnce() -> bool,\n    ) -> Result<bool, Refusal> {\n        catch_unwind(AssertUnwindSafe(predicate)).map_err(|error| Refusal::Predicate {\n            waypoint: index,\n            state: self.states[state.0].to_string(),\n            failure: error\n                .downcast_ref::<&str>()\n                .copied()\n                .or_else(|| error.downcast_ref::<String>().map(String::as_str))\n                .unwrap_or(\"non-string panic payload\")\n                .into(),\n        })\n    }\n\n    fn ordinals(nodes: &[PathNode<M::State, M::Action, M::Outcome>]) -> Vec<usize> {\n        let mut ordinal = 0;\n        std::iter::once(0)\n            .chain(nodes.iter().map(|node| {\n                ordinal += usize::from(matches!(node, PathNode::State(_)));\n                ordinal\n            }))\n            .collect()\n    }\n\n    fn successors(\n        &self,\n        nodes: &[PathNode<M::State, M::Action, M::Outcome>],\n        ordinals: &[usize],\n        position: Position,\n        edges: bool,\n    ) -> Result<Vec<(Position, Option<usize>)>, Refusal> {\n        let Some(node) = nodes.get(position.next) else { return Ok(Vec::new()) };\n        let mut next = Vec::new();\n        let advance = Position { next: position.next + 1, age: 0, ..position };\n        let waypoint = ordinals[position.next];\n        match node {\n            PathNode::State(state) => {\n                if self.judge(waypoint, position.state, || {\n                    state.judge(self.states[position.state.0])\n                })? {\n                    next.push((advance, None));\n                }\n            }\n            PathNode::Action { action, outcome, .. } if edges => {\n                for (ordinal, row) in self.rows[position.state.0].iter().enumerate() {\n                    let Some(state) = row.target else { continue };\n                    if row.action == **action\n                        && self.judge(waypoint, position.state, || {\n                            outcome.as_ref().is_none_or(|predicate| predicate(&row.emitted.0))\n                        })?\n                    {\n//! Descriptor-driven request mutations with catalog predictions and actual-wire classification.\n\nuse crate::{\n    KettleServiceMethod as Method, api,\n    config::{self, Limits},\n    kettle_request_fields, mutate_kettle_request,\n    wire::umpire::reference::kettle::v1 as k,\n};\nuse prost::Message;\nuse std::{collections::BTreeSet, fmt::Write};\nuse umpire_catalog::{\n    Expectation, GapReport, MutationApplicability, ProbeResult, Violation, WireCase,\n    mutation_entries, wire_cases,\n};\nuse umpire_runtime::annotations::{ProbeCase, ProbeExpectation, ProbeObservation, ProbeResponse};\n\ntype Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;\n\nstruct Entry {\n    method: Method,\n    prerequisite: &'static str,\n    case: WireCase,\n}\n\nimpl Entry {\n    fn id(&self) -> String {\n        format!(\"generic::{}::{}\", self.method.name(), self.case.id())\n    }\n\n    fn prepare(&self, baseline: bool) -> Result<(ProbeCase, Vec<u8>, Vec<Violation>)> {\n        let (state, refusal) = match &self.case.applicability {\n            MutationApplicability::Applicable => (0, String::new()),\n            MutationApplicability::NotApplicable(reason) => (1, reason.clone()),\n            MutationApplicability::Refused(reason) => (2, reason.clone()),\n            MutationApplicability::Unchanged => {\n                (3, \"mutation leaves the baseline unchanged\".into())\n            }\n        };\n        let mut metadata = ProbeCase {\n            id: self.id(),\n            method: method(self.method),\n            prerequisite: self.prerequisite.into(),\n            generic: true,\n            applicability: state,\n            refusal,\n            ..Default::default()\n        };\n        if state != 0 {\n            return Ok((metadata, Vec::new(), Vec::new()));\n        }\n        let original = baseline_bytes(self.method);\n        if !api::request_findings(self.method, &original, \"room\")?.is_empty() {\n            return Err(\"invalid Kettle probe baseline\".into());\n        }\n        if baseline {\n            return Ok((metadata, original, Vec::new()));\n        }\n        let Ok(bytes) = mutate_kettle_request(\n            self.method,\n            &original,\n            &self.case.field.path,\n            &self.case.mutation,\n        ) else {\n            metadata.applicability = 2;\n            metadata.refusal = \"typed mutation construction refused\".into();\n            return Ok((metadata, Vec::new(), Vec::new()));\n        };\n        if bytes == original {\n            metadata.applicability = 3;\n            metadata.refusal = \"mutation leaves the baseline unchanged\".into();\n            return Ok((metadata, Vec::new(), Vec::new()));\n        }\n        let mut findings = api::request_findings(self.method, &bytes, \"room\")?;\n        findings.sort_by_key(|v| (v.path.clone(), v.constraint.clone(), v.fields.clone()));\n        findings.dedup();\n        findings.retain(|v| {\n            v.expected.as_ref().is_some_and(|e| !matches!(e.expectation, Expectation::Unobservable))\n        });\n        if findings.is_empty()\n            && self.prerequisite != \"empty\"\n            && (self.case.field.path.ends_with(\".kettle_id\")\n                || self.case.field.path.ends_with(\".enabled\")\n                || self.case.field.path.ends_with(\".action\"))\n        {\n            metadata.applicability = 2;\n            metadata.refusal = \"mutation changes a stateful prerequisite\".into();\n            return Ok((metadata, Vec::new(), Vec::new()));\n        }\n        metadata.predictions = findings\n            .iter()\n            .enumerate()\n            .map(|(index, finding)| {\n                let mut expected = ProbeExpectation {\n                    id: format!(\n                        \"{}::prediction:{index}:{}:{}\",\n                        self.id(),\n                        finding.path,\n                        finding.constraint\n                    ),\n                    ..Default::default()\n                };\n                let Some(declared) = &finding.expected else {\n                    unreachable!(\"filtered expectation\")\n                };\n                match &declared.expectation {\n                    Expectation::Accepts => expected.accepts = true,\n                    Expectation::RejectsCode(code) => expected.code = *code as i32,\n                    Expectation::RejectsAnyStatus => {}\n                    Expectation::Rejects { code, message_pattern, details_type } => {\n                        expected.code = *code;\n                        expected.message_pattern.clone_from(message_pattern);\n                        expected.details_type = details_type.clone().unwrap_or_default();\n                    }\n                    Expectation::Unobservable => unreachable!(),\n                }\n                expected\n            })\n            .collect();\n        Ok((metadata, bytes, findings))\n    }\n\n    fn classify(&self, observation: &ProbeObservation) -> Result<GapReport> {\n        let (canonical, _, findings) = self.prepare(false)?;\n        if observation.applicability != canonical.applicability\n            || observation.refusal != canonical.refusal\n            || observation.prediction_count as usize != canonical.predictions.len()\n            || observation.predictions.len() != canonical.predictions.len()\n            || observation.message_matches\n            || !observation.details_type.is_empty()\n        {\n            return Err(\"observation diverges from prepared Kettle probe\".into());\n        }\n        let mut case = self.case.clone();\n        if canonical.applicability != 0 {\n            if observation.accepted || observation.code != 0 {\n                return Err(\"local mutation has a fabricated server response\".into());\n            }\n            case.applicability = match canonical.applicability {\n                1 => MutationApplicability::NotApplicable(canonical.refusal),\n                2 => MutationApplicability::Refused(canonical.refusal),\n                3 => MutationApplicability::Unchanged,\n                _ => return Err(\"unknown applicability\".into()),\n            };\n            return Ok(GapReport {\n                entries: mutation_entries(&case, &[], ProbeResult::Unverifiable)?,\n            });\n        }\n        if observation.accepted && observation.code != 0\n            || !observation.accepted && !matches!(observation.code, 3 | 5..=11 | 16)\n        {\n            return Err(\"invalid or inconclusive Kettle server response\".into());\n        }\n        let result = |matched, details| {\n            if observation.accepted {\n                ProbeResult::Accepted\n            } else {\n                ProbeResult::Rejected {\n                    code: observation.code,\n                    message_matches: matched,\n                    details_type: details,\n                }\n            }\n        };\n        let mut indices = BTreeSet::new();\n        let mut predictions = Vec::new();\n        for observed in &observation.predictions {\n            let index = observed.index as usize;\n            if !indices.insert(index)\n                || canonical.predictions.get(index).is_none_or(|v| v.id != observed.prediction_id)\n                || observed.details_type.len() > 512\n            {\n                return Err(\"invalid Kettle prediction correlation\".into());\n            }\n            predictions.push((\n                findings[index].clone(),\n                result(\n                    observed.message_matches,\n                    (!observed.details_type.is_empty()).then(|| observed.details_type.clone()),\n                ),\n            ));\n        }\n        Ok(GapReport { entries: mutation_entries(&case, &predictions, result(false, None))? })\n    }\n}\n\nfn entries() -> Vec<Entry> {\n    let mut entries = Vec::new();\n    let limits = Limits::default();\n    let bounds = [\n        Limits::for_kettle(\"compact\").get(&config::MAX_TAGS),\n        limits.get(&config::MAX_TAGS),\n        limits.get(&config::MAX_KETTLE_ID_BYTES),\n        60,\n    ];\n    for (method, prerequisite) in [\n        (Method::Fill, \"empty\"),\n        (Method::Heat, \"filled\"),\n        (Method::Pour, \"filled\"),\n        (Method::Describe, \"filled\"),\n        (Method::PollHeating, \"heating\"),\n        (Method::RespondHeating, \"heating\"),\n    ] {\n        for case in wire_cases(&kettle_request_fields(method), &bounds) {\n            entries.push(Entry { method, prerequisite, case });\n        }\n    }\n    entries.sort_by_key(Entry::id);\n    entries\n}\n\nfn method(method: Method) -> String {\n    format!(\"/umpire.reference.kettle.v1.KettleService/{}\", method.name())\n}\n\nfn baseline_bytes(method: Method) -> Vec<u8> {\n    let id = \"room\".to_string();\n    match method {\n        Method::Fill => k::FillRequest {\n            kettle_id: id,\n            idempotency_key: \"12345678-1234-4234-8234-123456789abc\".into(),\n            options: Some(k::fill_request::FillOptions {\n                water_kind: 1,\n                source: Some(k::fill_request::fill_options::Source::Tap(\"tap\".into())),\n                labels: [(\"origin\".into(), \"local\".into())].into_iter().collect(),\n                tags: vec![\"clean\".into()],\n                timeout: Some(umpire_runtime::google::protobuf::Duration { seconds: 1, nanos: 0 }),\n                ..Default::default()\n            }),\n        }\n        .encode_to_vec(),\n        Method::Heat => k::HeatRequest { kettle_id: id, enabled: true }.encode_to_vec(),\n        Method::Pour => k::PourRequest { kettle_id: id }.encode_to_vec(),\n        Method::Describe => k::DescribeRequest { kettle_id: id }.encode_to_vec(),\n        Method::PollHeating => k::PollHeatingRequest { kettle_id: id }.encode_to_vec(),\n        Method::RespondHeating => {\n            k::RespondHeatingRequest { kettle_id: id, action: 1 }.encode_to_vec()\n        }\n        Method::ListKettles | Method::ResetKettle => unreachable!(\"out-of-scope probe method\"),\n    }\n}\n\n/// Prepare descriptor mutations or classify the complete set of actual server observations.\npub fn run(request: &k::ProbeRequest) -> Result<ProbeResponse> {\n    if !request.kettle_id.is_empty() && request.kettle_id != \"room\" {\n        return Err(\"Kettle probe context must use the canonical room kettle\".into());\n    }\n    let entries = entries();\n    match request.operation {\n        0 => Ok(ProbeResponse {\n            cases: entries.iter().map(|v| v.prepare(false).map(|v| v.0)).collect::<Result<_>>()?,\n            ..Default::default()\n        }),\n        1 => {\n            let entry =\n                entries.iter().find(|e| e.id() == request.case_id).ok_or(\"unknown Kettle probe\")?;\n            let (case, message, _) = entry.prepare(request.baseline)?;\n            Ok(ProbeResponse {\n                method: case.method.clone(),\n                cases: vec![case],\n                message,\n                ..Default::default()\n            })\n        }\n        2 => {\n            let actual: BTreeSet<_> =\n                request.observations.iter().map(|v| v.case_id.as_str()).collect();\n            let expected: BTreeSet<_> = entries.iter().map(Entry::id).collect();\n            if actual.len() != request.observations.len()\n                || actual.len() != expected.len()\n                || !expected.iter().all(|id| actual.contains(id.as_str()))\n            {\n                return Err(\"incomplete, duplicate or unknown Kettle probe observations\".into());\n            }\n            let mut response = ProbeResponse::default();\n            for entry in entries {\n                let observed = request\n                    .observations\n                    .iter()\n                    .find(|v| v.case_id == entry.id())\n                    .ok_or(\"missing Kettle observation\")?;\n                let report = entry.classify(observed)?;\n                response.fails |= report.fails();\n                writeln!(response.report, \"Generic case: {}\", entry.id())?;\n                write!(response.report, \"{report}\")?;\n            }\n            Ok(response)\n        }\n        3 => Ok(ProbeResponse {\n            report: api::catalog::coverage(&Limits::default())?,\n            ..Default::default()\n        }),\n        _ => Err(\"unknown Kettle probe operation\".into()),\n    }\n}\n                        && self.prediction_id(entry) == prediction.prediction_id\n                })\n                .ok_or(\"unknown, stale or foreign prediction identity\")?;\n            predictions.push((\n                declared.target.violation.clone(),\n                result(\n                    prediction.message_matches,\n                    (!prediction.details_type.is_empty()).then(|| prediction.details_type.clone()),\n                ),\n            ));\n        }\n        Ok(mutation_entries(&case, &predictions, result(false, None))?)\n    }\n}\n\nfn same_violation(left: &Violation, right: &Violation) -> bool {\n    let mut left_fields = left.fields.clone();\n    let mut right_fields = right.fields.clone();\n    left_fields.sort();\n    right_fields.sort();\n    left.path == right.path\n        && left.constraint == right.constraint\n        && left_fields == right_fields\n        && left.expected == right.expected\n}\n\nfn compatible_state(actual: i32, refusal: &str, expected: &ProbeCase) -> bool {\n    if actual == expected.applicability && refusal == expected.refusal {\n        return true;\n    }\n    expected.predictions.is_empty()\n        && matches!(expected.applicability, 0 | 3)\n        && ((actual == 0 && refusal.is_empty())\n            || (actual == 3 && refusal == \"mutation leaves the baseline unchanged\"))\n}\n\nfn applicability(value: &MutationApplicability) -> (ProbeApplicability, String) {\n    match value {\n        MutationApplicability::Applicable => (ProbeApplicability::Applicable, String::new()),\n        MutationApplicability::NotApplicable(reason) => {\n            (ProbeApplicability::NotApplicable, reason.clone())\n        }\n        MutationApplicability::Refused(reason) => (ProbeApplicability::Refused, reason.clone()),\n        MutationApplicability::Unchanged => {\n            (ProbeApplicability::Unchanged, \"mutation leaves the baseline unchanged\".into())\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::Result;\n\n    #[test]\n    fn canonical_metadata_is_lazy_and_reused() -> Result<()> {\n        let strict = super::super::inventory()?;\n        let entries = super::build_inventory()?;\n        assert!(entries.iter().all(|entry| entry.canonical.get().is_none()));\n        let entry = entries\n            .iter()\n            .find(|entry| {\n                entry.id().contains(\"DescribeActivityExecutionRequest.activity_id:mutation.empty\")\n            })\n            .ok_or(\"missing canonical mutation\")?;\n        assert!(entry.canonical.get().is_none());\n        assert_eq!(\n            entry.canonical(&[]).err().ok_or(\"missing canonical validation refusal\")?.to_string(),\n            \"generic mutation predicts an unregistered catalog claim\"\n        );\n        assert!(entry.canonical.get().is_none());\n        let canonical = entry.canonical(strict)?;\n","exit_code":0,"status":"completed"}}
