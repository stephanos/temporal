[],\n  \"id\": \"fn-248-off-the-shelf-crates-and-consolidation.3\",\n  \"priority\": 2,\n  \"spec\": \"fn-248-off-the-shelf-crates-and-consolidation\",\n  \"spec_path\": \".flow/tasks/fn-248-off-the-shelf-crates-and-consolidation.3.md\",\n  \"status\": \"todo\",\n  \"title\": \"IR child traversal: ExprKind children and children_mut\",\n  \"updated_at\": \"2026-10-25T00:14:18.355027Z\"\n}\n{\n  \"assignee\": null,\n  \"claim_note\": \"\",\n  \"claimed_at\": null,\n  \"created_at\": \"2026-10-24T22:03:33.299645Z\",\n  \"depends_on\": [],\n  \"id\": \"fn-248-off-the-shelf-crates-and-consolidation.4\",\n  \"priority\": 3,\n  \"spec\": \"fn-248-off-the-shelf-crates-and-consolidation\",\n  \"spec_path\": \".flow/tasks/fn-248-off-the-shelf-crates-and-consolidation.4.md\",\n  \"status\": \"todo\",\n  \"title\": \"heck, darling and quote in the macro and build crates\",\n  \"updated_at\": \"2026-10-25T00:14:21.764338Z\"\n}\n{\n  \"assignee\": null,\n  \"claim_note\": \"\",\n  \"claimed_at\": null,\n  \"created_at\": \"2026-10-24T22:03:33.908997Z\",\n  \"depends_on\": [],\n  \"id\": \"fn-248-off-the-shelf-crates-and-consolidation.5\",\n  \"priority\": 3,\n  \"spec\": \"fn-248-off-the-shelf-crates-and-consolidation\",\n  \"spec_path\": \".flow/tasks/fn-248-off-the-shelf-crates-and-consolidation.5.md\",\n  \"status\": \"todo\",\n  \"title\": \"thiserror and prost-types in runtime, catalog and DSL; remove enum-iterator\",\n  \"updated_at\": \"2026-10-25T00:14:22.263767Z\"\n}\n{\n  \"assignee\": null,\n  \"claim_note\": \"\",\n  \"claimed_at\": null,\n  \"created_at\": \"2026-10-24T22:03:34.545911Z\",\n  \"depends_on\": [],\n  \"id\": \"fn-248-off-the-shelf-crates-and-consolidation.6\",\n  \"priority\": 3,\n  \"spec\": \"fn-248-off-the-shelf-crates-and-consolidation\",\n  \"spec_path\": \".flow/tasks/fn-248-off-the-shelf-crates-and-consolidation.6.md\",\n  \"status\": \"todo\",\n  \"title\": \"Serde-derived ITF envelope in the Apalache back end\",\n  \"updated_at\": \"2026-10-25T00:14:22.766236Z\"\n}\n{\n  \"assignee\": null,\n  \"claim_note\": \"\",\n  \"claimed_at\": null,\n  \"created_at\": \"2026-10-25T00:14:15.556398Z\",\n  \"depends_on\": [\n    \"fn-248-off-the-shelf-crates-and-consolidation.1\",\n    \"fn-248-off-the-shelf-crates-and-consolidation.2\",\n    \"fn-248-off-the-shelf-crates-and-consolidation.3\",\n    \"fn-248-off-the-shelf-crates-and-consolidation.4\",\n    \"fn-248-off-the-shelf-crates-and-consolidation.5\",\n    \"fn-248-off-the-shelf-crates-and-consolidation.6\"\n  ],\n  \"id\": \"fn-248-off-the-shelf-crates-and-consolidation.7\",\n  \"priority\": null,\n  \"spec\": \"fn-248-off-the-shelf-crates-and-consolidation\",\n  \"spec_path\": \".flow/tasks/fn-248-off-the-shelf-crates-and-consolidation.7.md\",\n  \"status\": \"todo\",\n  \"title\": \"Join crate-consolidation lanes and validate current snapshots and guests once\",\n  \"updated_at\": \"2026-10-25T00:14:21.201402Z\"\n}\nmodel/Cargo.toml:26:    \"umpire/catalog/syntax\",\nmodel/Cargo.toml:36:    \"temporal/annotate/syntax\",\nmodel/Cargo.toml:55:umpire-catalog-syntax = { version = \"0.0.1\", path = \"umpire/catalog/syntax\" }\nmodel/Cargo.toml:59:umpire-checker = { version = \"0.0.1\", path = \"umpire/backends/native\" }\nmodel/Cargo.toml:73:umpire-temporal-annotate-syntax = { version = \"0.0.1\", path = \"temporal/annotate/syntax\" }\nmodel/Cargo.toml:83:enum-iterator = \"2.3\"\nmodel/Cargo.toml:85:thiserror = \"2.0\"\nmodel/Cargo.toml:90:serde = \"1.0\"\nmodel/Cargo.toml:91:serde_json = \"1.0\"\nmodel/Cargo.toml:92:toml = { version = \"=1.1.8\", default-features = false, features = [\"std\", \"parse\", \"serde\"] }\nmodel/Cargo.toml:101:syn = { version = \"3\", features = [\"full\", \"visit\", \"extra-traits\"] }\nmodel/Cargo.toml:105:prettyplease = \"0.3\"\nmodel/Cargo.toml:136:overflow-checks = true\nmodel/Cargo.toml:139:overflow-checks = true  # fn-210 R11: same arithmetic answer in every profile\nmodel/Cargo.toml:140:debug = 1          # symbols for profiling the checker\nmodel/Cargo.toml:150:overflow-checks = true\nmodel/deny.toml:1:# cargo-deny policy: run `cargo deny check` when the tool is installed (needs network for advisories).\nmodel/deny.toml:6:multiple-versions = \"warn\"   # enum-iterator-derive keeps syn 2 beside syn 3 (known)\nmodel/deny.toml:14:  { name = \"deluxe\", reason = \"no release since 2023; use darling\" },\n//! Actual pinned-release safety and checked-arithmetic controls, never native-edge emission.\nuse std::{\n    fs,\n    path::{Path, PathBuf},\n};\nuse umpire_apalache::{Apalache, Confirmation, Replay, native_bound};\nuse umpire_dsl::Machine;\n#[allow(unreachable_pub, reason = \"the canonical fixture is also included by public host crates\")]\n#[path = \"../../../dev/fixtures/fixtures/sample_kettle/model.rs\"]\nmod selected_kettle;\nuse umpire_tla::{Lift, Tla};\nconst KETTLE: &str = include_str!(\"../../../dev/fixtures/fixtures/sample_kettle/model.rs\");\n// Apalache stays out of `UMPIRE_BACKENDS=require` until fn-211 resumes; opt in separately.\nfn required() -> bool {\n    std::env::var(\"UMPIRE_APALACHE\").as_deref() == Ok(\"require\")\n}\nfn evidence_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../../..\").join(\".flow/tmp/apalache-controls\")\n}\nfn retain(\n    label: &str,\n    module: &umpire_tla::Module,\n    result: &umpire_apalache::Bounded,\n) -> Result<(), Box<dyn std::error::Error>> {\n    let root = evidence_root().join(label);\n    fs::create_dir_all(&root)?;\n    fs::write(root.join(format!(\"{}.tla\", module.name)), &module.tla)?;\n    fs::write(root.join(\"output.txt\"), result.output())?;\n    for (i, trace) in result.traces().iter().enumerate() {\n        fs::write(root.join(format!(\"trace-{i}.itf.json\")), trace)?;\n    }\n    Ok(())\n}\n#[test]\nfn real_kettle_checks_source_safety_and_history() -> Result<(), Box<dyn std::error::Error>> {\n    if !required() {\n        return Ok(());\n    }\n    let root = Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../../..\");\n    let tool = Apalache::discover(&root)?;\n    let native = umpire_checker::Checker::explore(\n        &selected_kettle::kettle::world(),\n        umpire_checker::Checker::BUDGET,\n    )?;\n    let length = native_bound(native.counts)?;\n    assert_eq!(\n        (native.counts.reached, native.counts.depth, native.counts.cut, length),\n        (283, 62, false, 63)\n    );\n    fs::create_dir_all(evidence_root())?;\n    fs::write(\n        evidence_root().join(\"kettle-native-bound.json\"),\n        format!(\n            \"{{\\\"reached\\\":{},\\\"depth\\\":{},\\\"cut\\\":{},\\\"transition_bound\\\":{length}}}\\n\",\n            native.counts.reached, native.counts.depth, native.counts.cut\n        ),\n    )?;\n    let module = Tla::safety(&Lift::parse(\"kettle.rs\", KETTLE)?)?;\n    for p in module\n        .metadata\n        .invariants\n        .iter()\n        .chain(&module.metadata.postconditions)\n        .chain(&module.metadata.arithmetic)\n    {\n        let result = tool.check(&module, &p.operator, length)?;\n        retain(&format!(\"kettle-{}\", p.operator), &module, &result)?;\n        assert!(!result.violated()?, \"{}: {}\", p.name, result.output());\n    }\n    Ok(())\n}\n\n#[path = \"fixtures/arithmetic.rs\"]\nmod authored;\n#[test]\nfn real_arithmetic_faults_are_reachable_and_guards_remain_total()\n-> Result<(), Box<dyn std::error::Error>> {\n    use umpire_tla::{Binding, Concrete, Literal};\n    let root = Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../../..\");\n    let tool = if required() { Some(Apalache::discover(&root)?) } else { None };\n    for (mode, start, divisor, fails) in [\n        (0, 127, 1, true),\n        (1, 127, 1, true),\n        (2, 1, 0, true),\n        (3, 1, 0, true),\n        (4, -128, -1, true),\n        (5, -128, -1, true),\n        (6, 1, 0, false),\n        (7, 1, 0, false),\n        (8, 1, 0, true),\n        (9, 1, 0, true),\n        (10, 1, 0, false),\n    ] {\n        let world = authored::arithmetic::World::new(\n            mode,\n            if mode == 4 || mode == 5 { 0 } else { start },\n            if mode == 4 || mode == 5 { 0 } else { divisor },\n        );\n        let native = umpire_checker::Checker::explore(&world, 10)?.verify_all()?.to_string();\n        let arithmetic = native.contains(\"overflow\")\n            || native.contains(\"divide by zero\")\n            || native.contains(\"remainder with a divisor of zero\");\n        assert_eq!(arithmetic, fails, \"mode {mode}: {native}\");\n        let Some(tool) = &tool else { continue };\n        let module = Tla::safety(\n            &Lift::parse(\"arithmetic.rs\", include_str!(\"fixtures/arithmetic.rs\"))?.bind(\n                &Binding {\n                    world: vec![\n                        (\"mode\".into(), Literal::Int(mode.into())),\n                        (\n                            \"start\".into(),\n                            Literal::Int(if mode == 4 || mode == 5 { 0 } else { start.into() }),\n                        ),\n                        (\n                            \"divisor\".into(),\n                            Literal::Int(if mode == 4 || mode == 5 { 0 } else { divisor.into() }),\n                        ),\n                    ],\n                    starts: vec![vec![\n                        (\"value\".into(), Literal::Int(start.into())),\n                        (\"divisor\".into(), Literal::Int(divisor.into())),\n                        (\"done\".into(), Literal::Bool(false)),\n                    ]],\n                    actions: vec![Concrete { action: \"User::Calculate\".into(), fields: vec![] }],\n                },\n            )?,\n        )?;\n        for length in if matches!(mode, 0 | 8) { vec![0, 1] } else { vec![1] } {\n            let result = tool.check(&module, \"ArithmeticSafe\", length)?;\n            let expected = fails && (length > 0 || mode == 8);\n[package]\nname = \"umpire-catalog-syntax\"\ndescription = \"Shared catalo