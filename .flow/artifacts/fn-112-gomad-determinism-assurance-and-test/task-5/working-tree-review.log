rpose|active|draw follows target operation or deterministic scheduler decision\n   160\tboth|runtime/time.go|method.updateHeap|rand|value|1|reference|none|active|matching field or local value; no draw\n   161\tboth|runtime/time.go|package|rand|value|1|reference|none|active|matching field or local value; no draw\n   162\tboth|sync/pool.go|method.Put|runtime_randn|call|1|target-ordered|process-purpose|active|draw follows target operation or deterministic scheduler decision\n   163\tboth|sync/pool.go|package|runtime_randn|linkname:runtime.randn|1|reference|wrapper|active|reviewed linkname binding and target\n   164\tboth|sync/pool.go|runtime_randn|runtime_randn|declaration|1|reference|wrapper|active|reviewed draw helper declaration\n   165\tboth|unique/canonmap.go|newCanonMap|runtime_rand|call|1|target-ordered|process-purpose|active|draw follows target operation or deterministic scheduler decision\n   166\tboth|unique/canonmap.go|package|runtime_rand|linkname:runtime.rand|1|reference|wrapper|active|reviewed linkname binding and target\n   167\tboth|unique/canonmap.go|runtime_rand|runtime_rand|declaration|1|reference|wrapper|active|reviewed draw helper declaration\n   168\t`\n   169\t\n   170\tfunc parseReviewedDrawReferences(t *testing.T) map[string]drawReference {\n   171\t\tt.Helper()\n   172\t\treviewed := make(map[string]drawReference)\n   173\t\tfor _, line := range strings.Split(strings.TrimSpace(reviewedDrawReferences), \"\\n\") {\n   174\t\t\tif line == \"\" {\n   175\t\t\t\tcontinue\n   176\t\t\t}\n   177\t\t\tfields := strings.Split(line, \"|\")\n   178\t\t\tif len(fields) != 10 {\n   179\t\t\t\tt.Fatalf(\"invalid draw inventory row %q\", line)\n   180\t\t\t}\n   181\t\t\tcount, err := strconv.Atoi(fields[5])\n   182\t\t\tif err != nil || count <= 0 {\n   183\t\t\t\tt.Fatalf(\"invalid draw inventory count %q\", line)\n   184\t\t\t}\n   185\t\t\tplatforms := []string{fields[0]}\n   186\t\t\tif fields[0] == \"both\" {\n   187\t\t\t\tplatforms = gomadversion.SupportedPlatforms[:]\n   188\t\t\t}\n   189\t\t\tfor _, platform := range platforms {\n   190\t\t\t\tref := drawReference{platform, fields[1], fields[2], fields[3], fields[4], count, fields[6], fields[7], fields[8], fields[9]}\n   191\t\t\t\tif _, duplicate := reviewed[ref.key()]; duplicate {\n   192\t\t\t\t\tt.Fatalf(\"duplicate draw inventory row %s\", ref.key())\n   193\t\t\t\t}\n   194\t\t\t\tif ref.class == \"\" || ref.stream == \"\" || ref.reachability == \"\" || ref.reason == \"\" {\n   195\t\t\t\t\tt.Fatalf(\"incomplete draw inventory row %s\", ref.key())\n   196\t\t\t\t}\n   197\t\t\t\tif !slices.Contains([]string{\"target-ordered\", \"host-timed\", \"reference\"}, ref.class) ||\n   198\t\t\t\t\t!slices.Contains([]string{\"process-purpose\", \"M-local\", \"wrapper\", \"none\"}, ref.stream) ||\n   199\t\t\t\t\t!slices.Contains([]string{\"active\", \"disabled\", \"contract-excluded\", \"blocked\"}, ref.reachability) {\n   200\t\t\t\t\tt.Fatalf(\"invalid draw inventory classification %s\", ref.key())\n   201\t\t\t\t}\n   202\t\t\t\tif ref.class == \"host-timed\" && ref.reachability == \"active\" && ref.stream != \"M-local\" {\n   203\t\t\t\t\tt.Fatalf(\"active host-timed draw must use an M-local stream: %s\", ref.key())\n   204\t\t\t\t}\n   205\t\t\t\tif ref.reachability == \"blocked\" && !strings.Contains(ref.reason, \"collector edit prohibited\") {\n   206\t\t\t\t\tt.Fatalf(\"blocked draw needs its policy blocker: %s\", ref.key())\n   207\t\t\t\t}\n   208\t\t\t\treviewed[ref.key()] = ref\n   209\t\t\t}\n   210\t\t}\n   211\t\treturn reviewed\n   212\t}\n   213\t\n   214\tfunc TestPatchedRuntimeDrawReferencesAreReviewed(t *testing.T) {\n   215\t\tgot, err := runtimeDrawReferences(builtGOROOT(t))\n   216\t\tif err != nil {\n   217\t\t\tt.Fatal(err)\n   218\t\t}\n   219\t\tproblems := drawInventoryProblems(got, parseReviewedDrawReferences(t))\n   220\t\tif len(problems) != 0 {\n   221\t\t\tt.Fatalf(\"patched runtime draw inventory drifted; review every reference:\\n%s\", strings.Join(problems, \"\\n\"))\n   222\t\t}\n   223\t}\n   224\t\n   225\tfunc TestDrawInventoryRejectsUnclassifiedReference(t *testing.T) {\n   226\t\troot := t.TempDir()\n   227\t\tdirectory := filepath.Join(root, \"src\", \"runtime\")\n   228\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n   229\t\t\tt.Fatal(err)\n   230\t\t}\n   231\t\tif err := os.WriteFile(filepath.Join(directory, \"inventory_scratch.go\"), []byte(\"package runtime\\nfunc unreviewedDraw() { cheaprand() }\\n\"), 0o600); err != nil {\n   232\t\t\tt.Fatal(err)\n   233\t\t}\n   234\t\taliasDirectory := filepath.Join(root, \"src\", \"drawalias\")\n   235\t\tif err := os.MkdirAll(aliasDirectory, 0o700); err != nil {\n   236\t\t\tt.Fatal(err)\n   237\t\t}\n   238\t\tif err := os.WriteFile(filepath.Join(aliasDirectory, \"alias.go\"), []byte(\"package drawalias\\n//go:linkname renamedDraw runtime.rand\\nfunc renamedDraw() uint64\\n\"), 0o600); err != nil {\n   239\t\t\tt.Fatal(err)\n   240\t\t}\n   241\t\tif err := os.WriteFile(filepath.Join(aliasDirectory, \"use.go\"), []byte(\"package drawalias\\nvar borrowedDraw = renamedDraw\\nfunc useDraw() { renamedDraw() }\\n\"), 0o600); err != nil {\n   242\t\t\tt.Fatal(err)\n   243\t\t}\n   244\t\tgot, err := runtimeDrawReferences(root)\n   245\t\tif err != nil {\n   246\t\t\tt.Fatal(err)\n   247\t\t}\n   248\t\tproblems := drawInventoryProblems(got, map[string]drawReference{})\n   249\t\tif !slices.ContainsFunc(problems, func(problem string) bool {\n   250\t\t\treturn strings.Contains(problem, \"unreviewed draw reference: darwin/arm64 runtime/inventory_scratch.go unreviewedDraw cheaprand call\")\n   251\t\t}) {\n   252\t\t\tt.Fatalf(\"scratch draw did not fail closed: %v\", problems)\n   253\t\t}\n   254\t\tif !slices.ContainsFunc(problems, func(problem string) bool {\n   255\t\t\treturn strings.Contains(problem, \"unreviewed draw reference: darwin/arm64 drawalias/use.go useDraw renamedDraw call\")\n   256\t\t}) {\n   257\t\t\tt.Fatalf(\"aliased linkname draw did not fail closed: %v\", problems)\n   258\t\t}\n   259\t\tif !slices.ContainsFunc(problems, func(problem string) bool {\n   260\t\t\treturn strings.Contains(problem, \"unreviewed draw reference: darwin/arm64 drawalias/use.go package renamedDraw value\")\n   261\t\t}) {\n   262\t\t\tt.Fatalf(\"aliased function value did not fail closed: %v\", problems)\n   263\t\t}\n   264\t}\n   265\t\n   266\tfunc drawInventoryProblems(got map[string]int, reviewed map[string]drawReference) []string {\n   267\t\tvar problems []string\n   268\t\tfor key, count := range got {\n   269\t\t\treference, found := reviewed[key]\n   270\t\t\tif !found {\n   271\t\t\t\tproblems = append(problems, fmt.Sprintf(\"unreviewed draw reference: %s (%d)\", key, count))\n   272\t\t\t} else if reference.count != count {\n   273\t\t\t\tproblems = append(problems, fmt.Sprintf(\"draw reference count changed: %s = %d, reviewed %d\", key, count, reference.count))\n   274\t\t\t}\n   275\t\t}\n   276\t\tfor key := range reviewed {\n   277\t\t\tif _, found := got[key]; !found {\n   278\t\t\t\tproblems = append(problems, \"reviewed draw reference disappeared: \"+key)\n   279\t\t\t}\n   280\t\t}\n   281\t\tslices.Sort(problems)\n   282\t\treturn problems\n   283\t}\n   284\t\n   285\tvar drawSymbols = strings.Fields(\"bootstrapRand rand rand32 randn cheaprand cheaprand64 cheaprandu64 cheaprandn legacy_fastrand legacy_fastrand64 legacy_fastrandn gomadRuntimeRand gomadRuntimeCheapRand gomadHostCheapRand gomadHostCheapRandN gomadLockProfileStart gomadTimerRand gomadChoiceRunqSeeded gomadChoiceRunnextSeeded gomadChoiceShuffleSeeded gomadChoiceSelectSeeded gomadChoiceRandom gomadClockTickDraw runtime_rand runtime_randn\")\n   286\t\n   287\tfunc runtimeDrawReferences(goRoot string) (map[string]int, error) {\n   288\t\treferences := map[string]int{}\n   289\t\tsourceRoot := filepath.Join(goRoot, \"src\")\n   290\t\tfor _, platform := range gomadversion.SupportedPlatforms {\n   291\t\t\tgoos, goarch, _ := strings.Cut(platform, \"/\")\n   292\t\t\tcontext := build.Default\n   293\t\t\tcontext.GOROOT, context.GOOS, context.GOARCH, context.CgoEnabled = goRoot, goos, goarch, false\n   294\t\t\tvar tags []string\n   295\t\t\tfor _, tag := range context.ToolTags {\n   296\t\t\t\tif tag != \"goexperiment.greenteagc\" {\n   297\t\t\t\t\ttags = append(tags, tag)\n   298\t\t\t\t}\n   299\t\t\t}\n   300\t\t\tcontext.ToolTags = tags\n   301\t\t\ttype sourceFile struct {\n   302\t\t\t\tfile       *ast.File\n   303\t\t\t\trelative   string\n   304\t\t\t\tpackageKey string\n   305\t\t\t}\n   306\t\t\tvar sources []sourceFile\n   307\t\t\taliasesByPackage := map[string]map[string]string{}\n   308\t\t\terr := filepath.WalkDir(sourceRoot, func(path string, entry fs.DirEntry, err error) error {\n   309\t\t\t\tif err != nil {\n   310\t\t\t\t\treturn err\n   311\t\t\t\t}\n   312\t\t\t\tname := entry.Name()\n   313\t\t\t\tif entry.IsDir() {\n   314\t\t\t\t\tif name == \"testdata\" || name == \"vendor\" || path == filepath.Join(sourceRoot, \"cmd\") {\n   315\t\t\t\t\t\treturn filepath.SkipDir\n   316\t\t\t\t\t}\n   317\t\t\t\t\treturn nil\n   318\t\t\t\t}\n   319\t\t\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n   320\t\t\t\t\treturn nil\n   321\t\t\t\t}\n   322\t\t\t\tmatch, err := context.MatchFile(filepath.Dir(path), name)\n   323\t\t\t\tif err != nil {\n   324\t\t\t\t\treturn err\n   325\t\t\t\t}\n   326\t\t\t\tif !match && !strings.Contains(name, \"greenteagc\") {\n   327\t\t\t\t\treturn nil\n   328\t\t\t\t}\n   329\t\t\t\tfileSet := token.NewFileSet()\n   330\t\t\t\tfile, err := parser.ParseFile(fileSet, path, nil, parser.ParseComments)\n   331\t\t\t\tif err != nil {\n   332\t\t\t\t\treturn err\n   333\t\t\t\t}\n   334\t\t\t\trelative, err := filepath.Rel(sourceRoot, path)\n   335\t\t\t\tif err != nil {\n   336\t\t\t\t\treturn err\n   337\t\t\t\t}\n   338\t\t\t\trel := filepath.ToSlash(relative)\n   339\t\t\t\tpackageKey := filepath.