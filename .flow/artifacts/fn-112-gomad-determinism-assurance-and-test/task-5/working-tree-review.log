)\n  3741\t\t\t\t\t}\n  3742\t\t\t\t\tif runqputbatch(pp, &q, gomadBatchHost); !q.empty() {\n  3743\t\t\t\t\t\tthrow(\"Couldn't put Gs into empty local runq\")\n  3744\t\t\t\t\t}\n  3745\t\t\t\t\tacquirep(pp)\n  3746\t\t\t\t\tmp.becomeSpinning()\n  3747\t\t\t\t\treturn gp, false, false\n  3748\t\t\t\t}\n  3749\t\t\t}\n  3750\t\t\tunlock(&sched.lock)\n  3751\t\n  3752\t\t\tpp := checkRunqsNoP(allpSnapshot, idlepMaskSnapshot)\n  4095\t// and clears glist. If there is no current P, they are added to the\n  4096\t// global queue, and up to npidle M's are started to run them.\n  4097\t// Otherwise, for each idle P, this adds a G to the global queue\n  4098\t// and starts an M. Any remaining G's are added to the current P's\n  4099\t// local run queue.\n  4100\t// This may temporarily acquire sched.lock.\n  4101\t// Can run concurrently with GC.\n  4102\tfunc injectglist(glist *gList) {\n  4103\t\tif glist.empty() {\n  4104\t\t\treturn\n  4105\t\t}\n  4106\t\n  4107\t\t// Mark all the goroutines as runnable before we put them\n  4108\t\t// on the run queues.\n  4109\t\tvar tail *g\n  4110\t\ttrace := traceAcquire()\n  4111\t\tfor gp := glist.head.ptr(); gp != nil; gp = gp.schedlink.ptr() {\n  4112\t\t\ttail = gp\n  4113\t\t\tcasgstatus(gp, _Gwaiting, _Grunnable)\n  4114\t\t\tif trace.ok() {\n  4115\t\t\t\ttrace.GoUnpark(gp, 0)\n  4116\t\t\t}\n  4117\t\t}\n  4118\t\tif trace.ok() {\n  4119\t\t\ttraceRelease(trace)\n  4120\t\t}\n  4121\t\n  4122\t\t// Turn the gList into a gQueue.\n  4123\t\tq := gQueue{glist.head, tail.guintptr(), glist.size}\n  4124\t\t*glist = gList{}\n  4125\t\n  4126\t\tstartIdle := func(n int32) {\n  4127\t\t\tfor ; n > 0; n-- {\n  4128\t\t\t\tmp := acquirem() // See comment in startm.\n  4129\t\t\t\tlock(&sched.lock)\n  4130\t\n  4131\t\t\t\tpp, _ := pidlegetSpinning(0)\n  4132\t\t\t\tif pp == nil {\n  4133\t\t\t\t\tunlock(&sched.lock)\n  4134\t\t\t\t\treleasem(mp)\n  4135\t\t\t\t\tbreak\n  4136\t\t\t\t}\n  4137\t\n  4138\t\t\t\tstartm(pp, false, true)\n  4139\t\t\t\tunlock(&sched.lock)\n  4140\t\t\t\treleasem(mp)\n  4141\t\t\t}\n  4142\t\t}\n  4143\t\n  4144\t\tpp := getg().m.p.ptr()\n  4145\t\tif pp == nil {\n  4146\t\t\tn := q.size\n  4147\t\t\tlock(&sched.lock)\n  4148\t\t\tglobrunqputbatch(&q)\n  4149\t\t\tunlock(&sched.lock)\n  4150\t\t\tstartIdle(n)\n  4151\t\t\treturn\n  4152\t\t}\n  4153\t\n  4154\t\tvar globq gQueue\n  4155\t\tnpidle := sched.npidle.Load()\n  4156\t\tfor ; npidle > 0 && !q.empty(); npidle-- {\n  4157\t\t\tg := q.pop()\n  4158\t\t\tglobq.pushBack(g)\n  4159\t\t}\n  4160\t\tif !globq.empty() {\n  4161\t\t\tn := globq.size\n  4162\t\t\tlock(&sched.lock)\n  4163\t\t\tglobrunqputbatch(&globq)\n  4164\t\t\tunlock(&sched.lock)\n  4165\t\t\tstartIdle(n)\n  4166\t\t}\n  4167\t\n  4168\t\tif runqputbatch(pp, &q, gomadBatchHost); !q.empty() {\n  4169\t\t\tlock(&sched.lock)\n  4170\t\t\tglobrunqputbatch(&q)\n  4171\t\t\tunlock(&sched.lock)\n  4172\t\t}\n  4173\t\n  4174\t\t// Some P's might have become idle after we loaded `sched.npidle`\n  4175\t\t// but before any goroutines were added to the queue, which could\n  4176\t\t// lead to idle P's when there is work available in the global queue.\n  4177\t\t// That could potentially last until other goroutines become ready\n  7780\t\tunlock(&sched.lock)\n  7781\t\treturn true\n  7782\t}\n  7783\t\n  7784\t// runqputbatch tries to put all the G's on q on the local runnable queue.\n  7785\t// If the local runq is full the input queue still contains unqueued Gs.\n  7786\t// Executed only by the owner P.\n  7787\tfunc runqputbatch(pp *p, q *gQueue, origin gomadBatchOrigin) {\n  7788\t\tif q.empty() {\n  7789\t\t\treturn\n  7790\t\t}\n  7791\t\th := atomic.LoadAcq(&pp.runqhead)\n  7792\t\tt := pp.runqtail\n  7793\t\tn := uint32(0)\n  7794\t\tfor !q.empty() && t-h < uint32(len(pp.runq)) {\n  7795\t\t\tgp := q.pop()\n  7796\t\t\tpp.runq[t%uint32(len(pp.runq))].set(gp)\n  7797\t\t\tt++\n  7798\t\t\tn++\n  7799\t\t}\n  7800\t\n  7801\t\tif randomizeScheduler {\n  7802\t\t\toff := func(o uint32) uint32 {\n  7803\t\t\t\treturn (pp.runqtail + o) % uint32(len(pp.runq))\n  7804\t\t\t}\n  7805\t\t\tmp := getg().m\n  7806\t\t\tpreviousHostDrawScope := mp.gomadHostDrawScope\n  7807\t\t\tif gomadDiagnosticEnabled && origin == gomadBatchHost {\n  7808\t\t\t\tmp.gomadHostDrawScope = true\n  7809\t\t\t}\n  7810\t\t\tfor i := uint32(1); i < n; i++ {\n  7811\t\t\t\tvar j uint32\n  7812\t\t\t\tif origin == gomadBatchHost {\n  7813\t\t\t\t\tj = gomadHostCheapRandN(i + 1)\n  7814\t\t\t\t} else {\n  7815\t\t\t\t\tj = gomadChoiceShuffleSeeded(i + 1)\n  7816\t\t\t\t}\n  7817\t\t\t\tpp.runq[off(i)], pp.runq[off(j)] = pp.runq[off(j)], pp.runq[off(i)]\n  7818\t\t\t}\n  7819\t\t\tmp.gomadHostDrawScope = previousHostDrawScope\n  7820\t\t}\n  7821\t\n  7822\t\tatomic.StoreRel(&pp.runqtail, t)\n  7823\t\n  7824\t\treturn\n  7825\t}\n  7826\t\n  7827\t// Get g from local runnable queue.\n  7828\t// If inheritTime is true, gp should inherit the remaining time in the\n  7829\t// current time slice. Otherwise, it should start a new time slice.\n  7830\t// Executed only by the owner P.\n  7831\tfunc runqget(pp *p) (gp *g, inheritTime bool) {\n  7832\t\t// If there's a runnext, it's the next G to run.\n  7833\t\tnext := pp.runnext\n  7834\t\t// If the runnext is non-0 and the CAS fails, it could only have been stolen by another P,\n  7835\t\t// because other Ps can race to set runnext to 0, but only the current P can set it to non-0.\n  7836\t\t// Hence, there's no need to retry this CAS if it fails.\n  7837\t\tif next != 0 && pp.runnext.cas(next, 0) {\n  7838\t\t\treturn next.ptr(), true\n  7839\t\t}\n  7840\t\n  7841\t\tif gomadEnabled && gomaxprocs == 1 {\n  7842\t\t\th := atomic.LoadAcq(&pp.runqhead)\n  7843\t\t\tt := pp.runqtail\n","exit_code":0,"status":"completed"}}
