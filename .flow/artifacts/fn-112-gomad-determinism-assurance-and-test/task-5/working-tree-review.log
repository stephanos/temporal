e\\\") }\\n\", live: true},\n    36\t\t\t{name: \"init\", source: \"package main\\nimport \\\"os/exec\\\"\\nfunc init() { _ = exec.Command(\\\"true\\\") }\\nfunc main() {}\\n\", live: true},\n    37\t\t\t{name: \"function-value\", source: \"package main\\nimport \\\"os/exec\\\"\\nfunc main() { call := exec.Command; _ = call(\\\"true\\\") }\\n\", live: true},\n    38\t\t\t{name: \"interface\", source: \"package main\\nimport \\\"os/exec\\\"\\ntype runner interface { run() }\\ntype commandRunner struct{}\\nfunc (commandRunner) run() { _ = exec.Command(\\\"true\\\") }\\nfunc main() { var value runner = commandRunner{}; value.run() }\\n\", live: true},\n    39\t\t\t{name: \"reflection\", source: \"package main\\nimport (\\\"os/exec\\\"; \\\"reflect\\\")\\ntype commandRunner struct{}\\nfunc (commandRunner) Run() { _ = exec.Command(\\\"true\\\") }\\nfunc main() { reflect.ValueOf(commandRunner{}).MethodByName(\\\"Run\\\").Call(nil) }\\n\", live: true},\n    40\t\t\t{name: \"inlining\", source: \"package main\\nimport \\\"os/exec\\\"\\nfunc invoke() { _ = exec.Command(\\\"true\\\") }\\nfunc main() { invoke() }\\n\", live: true},\n    41\t\t} {\n    42\t\t\tt.Run(test.name, func(t *testing.T) {\n    43\t\t\t\ttarget := buildLiveCapabilityFixture(t, goCommand, buildKey, test.source)\n    44\t\t\t\trecord, err := Read(target, expectation)\n    45\t\t\t\tif err != nil {\n    46\t\t\t\t\tt.Fatal(err)\n    47\t\t\t\t}\n    48\t\t\t\tif got := hasCapability(record.Manifest.Facts, \"import:os/exec\"); got != test.live {\n    49\t\t\t\t\tt.Fatalf(\"import:os/exec live = %t, want %t; owners = %v\", got, test.live, capabilityOwners(record.Manifest.Facts, \"import:os/exec\"))\n    50\t\t\t\t}\n    51\t\t\t})\n    52\t\t}\n    53\t}\n    54\t\n    55\tfunc TestPinnedToolchainGuardsReachableForbiddenImport(t *testing.T) {\n    56\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n    57\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n    58\t\t}\n    59\t\tmoduleRoot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n    60\t\tif err != nil {\n    61\t\t\tt.Fatal(err)\n    62\t\t}\n    63\t\tgoCommand := filepath.Join(moduleRoot, \".toolchain\", \"bin\", \"go\")\n    64\t\tgoRoot := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOROOT\"))\n    65\t\tbuildKey := filepath.Base(goRoot)\n    66\t\tgoVersion := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOVERSION\"))\n    67\t\ttarget := buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n    68\timport (\"fmt\"; \"os/exec\")\n    69\tfunc main() { _ = exec.Command(\"true\"); fmt.Println(\"after\") }\n    70\t`)\n    71\t\trecord, err := Read(target, Expectation{GoVersion: goVersion, ToolchainBuildKey: buildKey, GOOS: runtime.GOOS, GOARCH: runtime.GOARCH})\n    72\t\tif err != nil {\n    73\t\t\tt.Fatal(err)\n    74\t\t}\n    75\t\tif !hasFact(record.Manifest.Facts, FactKindGuard, \"import:os/exec\") || hasFact(record.Manifest.Facts, FactKindCapability, \"import:os/exec\") {\n    76\t\t\tt.Fatalf(\"guarded facts = %#v\", record.Manifest.Facts)\n    77\t\t}\n    78\t\tif output, err := exec.Command(target).CombinedOutput(); err != nil || string(output) != \"after\\n\" {\n    79\t\t\tt.Fatalf(\"native guarded target = %v: %s\", err, output)\n    80\t\t}\n    81\t\tcommand := exec.Command(target)\n    82\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n    83\t\toutput, err := command.CombinedOutput()\n    84\t\tif err == nil || !strings.Contains(string(output), \"GOMAD_CAPABILITY_DENIED\") || strings.Contains(string(output), \"after\") {\n    85\t\t\tt.Fatalf(\"Gomad guarded target = %v: %s\", err, output)\n    86\t\t}\n    87\t\n    88\t\ttarget = buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n    89\timport (\"fmt\"; \"os/exec\")\n    90\tfunc main() { _ = (&exec.Cmd{}).Run(); fmt.Println(\"after\") }\n    91\t`)\n    92\t\tcommand = exec.Command(target)\n    93\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n    94\t\toutput, err = command.CombinedOutput()\n    95\t\tif err == nil || !strings.Contains(string(output), \"GOMAD_CAPABILITY_DENIED\") || strings.Contains(string(output), \"after\") {\n    96\t\t\tt.Fatalf(\"Gomad guarded method target = %v: %s\", err, output)\n    97\t\t}\n    98\t}\n    99\t\n   100\tfunc TestPinnedToolchainAllowsPureForbiddenPackageInitializationHelper(t *testing.T) {\n   101\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n   102\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n   103\t\t}\n   104\t\tmoduleRoot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n   105\t\tif err != nil {\n   106\t\t\tt.Fatal(err)\n   107\t\t}\n   108\t\tgoCommand := filepath.Join(moduleRoot, \".toolchain\", \"bin\", \"go\")\n   109\t\tgoRoot := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOROOT\"))\n   110\t\tbuildKey := filepath.Base(goRoot)\n   111\t\ttarget := buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   112\timport (\"fmt\"; _ \"syscall\")\n   113\tfunc main() { fmt.Println(\"after\") }\n   114\t`)\n   115\t\tcommand := exec.Command(target)\n   116\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n   117\t\toutput, err := command.CombinedOutput()\n   118\t\tif err != nil || string(output) != \"after\\n\" {\n   119\t\t\tt.Fatalf(\"Gomad initialized syscall package = %v: %s\", err, output)\n   120\t\t}\n   121\t\n   122\t\ttarget = buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   123\timport (\"fmt\"; \"syscall\")\n   124\tfunc main() { var limit syscall.Rlimit; _ = syscall.Getrlimit(syscall.RLIMIT_NOFILE, &limit); fmt.Println(\"after\") }\n   125\t`)\n   126\t\tcommand = exec.Command(target)\n   127\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n   128\t\toutput, err = command.CombinedOutput()\n   129\t\tif err == nil || !strings.Contains(string(output), \"GOMAD_CAPABILITY_DENIED\") || strings.Contains(string(output), \"after\") {\n   130\t\t\tt.Fatalf(\"Gomad callable syscall capability = %v: %s\", err, output)\n   131\t\t}\n   132\t\n   133\t\ttarget = buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   134\timport \"syscall\"\n   135\tfunc main() { _, _ = syscall.Write(9, []byte(\"escape\")) }\n   136\t`)\n   137\t\tcommand = exec.Command(target)\n   138\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n   139\t\toutput, err = command.CombinedOutput()\n   140\t\tif err == nil || !strings.Contains(string(output), \"GOMAD_CAPABILITY_DENIED\") {\n   141\t\t\tt.Fatalf(\"Gomad raw descriptor write = %v: %s\", err, output)\n   142\t\t}\n   143\t}\n   144\t\n   145\tfunc TestPinnedToolchainAllowsPureSyscallErrorHelpers(t *testing.T) {\n   146\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n   147\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n   148\t\t}\n   149\t\tmoduleRoot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n   150\t\tif err != nil {\n   151\t\t\tt.Fatal(err)\n   152\t\t}\n   153\t\tgoCommand := filepath.Join(moduleRoot, \".toolchain\", \"bin\", \"go\")\n   154\t\tgoRoot := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOROOT\"))\n   155\t\tbuildKey := filepath.Base(goRoot)\n   156\t\ttarget := buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   157\timport (\"fmt\"; \"io/fs\"; \"syscall\")\n   158\tfunc main() {\n   159\t    fmt.Printf(\"%q %t %t %t\\n\", syscall.ENOENT.Error(), syscall.ENOENT.Is(fs.ErrNotExist), syscall.EINTR.Temporary(), syscall.ETIMEDOUT.Timeout())\n   160\t}\n   161\t`)\n   162\t\tcommand := exec.Command(target)\n   163\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n   164\t\toutput, err := command.CombinedOutput()\n   165\t\tif err != nil || string(output) != `\"no such file or directory\" true true true\n   166\t` {\n   167\t\t\tt.Fatalf(\"Gomad pure syscall error helpers = %v: %s\", err, output)\n   168\t\t}\n   169\t}\n   170\t\n   171\tfunc TestPinnedToolchainUsesDeterministicEnvironment(t *testing.T) {\n   172\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n   173\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n   174\t\t}\n   175\t\tmoduleRoot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n   176\t\tif err != nil {\n   177\t\t\tt.Fatal(err)\n   178\t\t}\n   179\t\tgoCommand := filepath.Join(moduleRoot, \".toolchain\", \"bin\", \"go\")\n   180\t\tgoRoot := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOROOT\"))\n   181\t\tbuildKey := filepath.Base(goRoot)\n   182\t\ttarget := buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   183\timport (\"fmt\"; \"os\")\n   184\tfunc main() {\n   185\t    before, beforeOK := os.LookupEnv(\"GOMAD3_HOST_ONLY\")\n   186\t    seed, seedOK := os.LookupEnv(\"GOMADSEED\")\n   187\t    if err := os.Setenv(\"GOMAD3_HOST_ONLY\", \"modeled\"); err != nil { panic(err) }\n   188\t    modeled, modeledOK := os.LookupEnv(\"GOMAD3_HOST_ONLY\")\n   189\t    if err := os.Unsetenv(\"GOMAD3_HOST_ONLY\"); err != nil { panic(err) }\n   190\t    _, afterOK := os.LookupEnv(\"GOMAD3_HOST_ONLY\")\n   191\t    fmt.Printf(\"%q %t %q %t %q %t %t\\n\", before, beforeOK, seed, seedOK, modeled, modeledOK, afterOK)\n   192\t}\n   193\t`)\n   194\t\tcommand := exec.Command(target)\n   195\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\", \"GOMAD3_HOST_ONLY=host\")\n   196\t\toutput, err := command.CombinedOutput()\n   197\t\tif err != nil || string(output) != `\"\" false \"\" false \"modeled\" true false\n   198\t` {\n   199\t\t\tt.Fatalf(\"Gomad deterministic environment = %v: %s\", err, output)\n   200\t\t}\n   201\t}\n   202\t\n   203\tfunc TestPinnedToolchainGuardsReachableDeniedBoundary(t *testing.T) {\n   204\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n   205\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n   206\t\t}\n   207\t\tmoduleRoot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"..\"))\n   208\t\tif err != nil {\n   209\t\t\tt.Fatal(err)\n   210\t\t}\n   211\t\tgoCommand := filepath.Join(moduleRoot, \".toolchain\", \"bin\", \"go\")\n   212\t\tgoRoot := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOROOT\"))\n   213\t\tbuildKey := filepath.Base(goRoot)\n   214\t\tgoVersion := strings.TrimSpace(runToolchainCommand(t, moduleRoot, goCommand, \"env\", \"GOVERSION\"))\n   215\t\ttarget := buildGuardedCapabilityFixture(t, goCommand, buildKey, `package main\n   216\timport (\"fmt\"; \"net\")\n   217\tfunc main() { _, _ = net.InterfaceAddrs(); fmt.Println(\"after\") }\n   218\t`)\n   219\t\trecord, err := Read(target, Expectation{GoVersion: goVersion, ToolchainBuildKey: buildKey, GOOS: runtime.GOOS, GOARCH: runtime.GOARCH})\n   220\t\tif err != nil {\n   221\t\t\tt.Fatal(err)\n   222\t\t}\n   223\t\tif !hasFact(record.Manifest.Facts, FactKindGuard, \"network.interface-addresses\") || hasFact(record.Manifest.Facts, FactKindBoundary, \"network.interface-addresses\") {\n   224\t\t\tt.Fatalf(\"guarded boundary owners = %v; objdump:\\n%s\", capabilityOwners(record.Manifest.Facts, \"network.interface-addresses\"), runToolchainCommand(t, filepath.Dir(target), goCommand, \"tool\", \"objdump\", \"-s\", \"net.InterfaceAddrs\", target))\n   225\t\t}\n   226\t\tif output, err := exec.Command(target).CombinedOutput(); err != nil || string(output) != \"after\\n\" {\n   227\t\t\tt.Fatalf(\"native guarded boundary target = %v: %s\", err, output)\n   228\t\t}\n   229\t\tcommand := exec.Command(target)\n   230\t\tcommand.Env = append(os.Environ(), \"GOMADSEED=1\")\n   231\t\toutput, err := command.CombinedOutput()\n   232\t\tif err == nil || !strings.Contains(string(output), \"GOMAD_CAPABILITY_DENIED\") || strings.Contains(string(output), \"after\") {\n   233\t\t\tt.Fatalf(\"Gomad guarded boundary target = %v: %s\", err, output)\n   234\t\t}\n   235\t}\n   236\t\n   237\tfunc TestPinnedToolchainDoesNotGuardModeledUnsupportedBoundary(t *testing.T) {\n   238\t\tif runtime.GOOS != \"darwin\" || runtime.GOARCH != \"arm64\" {\n   239\t\t\tt.Skip(\"live capability records are supported only on darwin/arm64\")\n   240\t\t}\n     1\tpackage conformance\n     2\t\n     3\timport (\n     4\t\t\"context\"\n     5\t\t\"crypto/sha256\"\n     6\t\t\"errors\"\n     7\t\t\"fmt\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"regexp\"\n    11\t\t\"slices\"\n    12\t\t\"sort\"\n    13\t\t\"strconv\"\n    14\t\t\"strings\"\n    15\t\t\"time\"\n    16\t\n    17\t\t\"go.temporal.io/server/tools/gomad3/internal/hostexec\"\n    18\t)\n    19\t\n    20\tvar randomLinePattern = regexp.MustCompile(`^[0-9a-f]{16} [0-9a-f]{8}$`)\n    21\tvar goTestDurationPattern = regexp.MustCompile(`(?m)^(ok[[:space:]]+[^[:space:]]+)[[:space:]]+[0-9.]+s$`)\n    22\t\n    23\ttype runtimeCase struct {\n    24\t\tname        string\n    25\t\trequest     hostexec.Request\n    26\t\twantExit    int\n    27\t\tacceptExits []int // further statuses that pass, for an experiment whose outcome is evidence\n    28\t\twantTimeout bool\n    29\t\toracle      func(hostexec.Result) error\n    30\t}\n    31\t\n    32\ttype runtimeCampaign struct {\n    33\t\tctx         context.Context\n    34\t\tconfig      Config\n    35\t\tgoRoot      string\n    36\t\ttestdata    string\n    37\t\texecWrapper string\n    38\t\tworkspace   string\n    39\t\trun         func(context.Context, hostexec.Request) (hostexec.Result, error)\n    40\t\treport      *Report\n    41\t}\n    42\t\n    43\tfunc runRuntimeCampaign(\n    44\t\tctx context.Context,\n    45\t\tconfig Config,\n    46\t\tgoRoot string,\n    47\t\trun func(context.Context, hostexec.Request) (hostexec.Result, error),\n    48\t\treport *Report,\n    49\t) (returnedErr error) {\n    50\t\tworkspace, err := os.MkdirTemp(filepath.Join(config.Root, \".toolchain\"), \"runtime-test-*\")\n    51\t\tif err != nil {\n    52\t\t\treturn fmt.Errorf(\"create runtime test workspace: %w\", err)\n    53\t\t}\n    54\t\tdefer func() {\n    55\t\t\treturnedErr = errors.Join(returnedErr, os.RemoveAll(workspace))\n    56\t\t}()\n    57\t\tcampaign := runtimeCampaign{\n    58\t\t\tctx: ctx, config: config, goRoot: goRoot, testdata: filepath.Join(config.Root, \"internal\", \"gomadtool\", \"conformance\", \"testdata\"),\n    59\t\t\texecWrapper: filepath.Join(config.Root, \"internal\", \"gomadtool\", \"conformance\", \"scripts\", \"exec.sh\"), workspace: workspace, run: run, report: report,\n    60\t\t}\n    61\t\tif err := campaign.validateInstallation(); err != nil {\n    62\t\t\treturn err\n    63\t\t}\n    64\t\treturn campaign.execute()\n    65\t}\n    66\t\n    67\tfunc (campaign *runtimeCampaign) runCase(planned runtimeCase) (hostexec.Result, error) {\n    68\t\tresult, runErr := campaign.run(campaign.ctx, planned.request)\n    69\t\treturn campaign.finishCase(planned, result, runErr)\n    70\t}\n    71\t\n    72\tfunc (campaign *runtimeCampaign) finishCase(planned runtimeCase, result hostexec.Result, runErr error) (hostexec.Result, error) {\n    73\t\tcaseResult := CaseResult{\n    74\t\t\tTier: \"test-runtime\", Name: planned.name, ExitCode: result.ExitCode,\n    75\t\t\tTimedOut: result.WatchdogTimeout, Signaled: result.Termination == hostexec.TerminationSignal,\n    76\t\t\tStdout: append([]byte(nil), result.Stdout.Bytes...), Stderr: append([]byte(nil), result.Stderr.Bytes...),\n    77\t\t\tTruncated: result.Stdout.Truncated || result.Stderr.Truncated,\n    78\t\t}\n    79\t\tif planned.wantTimeout {\n    80\t\t\tcaseResult.Passed = runErr == nil && result.WatchdogTimeout && !caseResult.Truncated\n    81\t\t} else {\n    82\t\t\texitAccepted := result.ExitCode == planned.wantExit || slices.Contains(planned.acceptExits, result.ExitCode)\n    83\t\t\tcaseResult.Passed = runErr == nil && !result.WatchdogTimeout && !caseResult.Signaled &&\n    84\t\t\t\tresult.Termination == hostexec.TerminationExit && exitAccepted && !caseResult.Truncated\n    85\t\t}\n    86\t\tif caseResult.Passed && planned.oracle != nil {\n    87\t\t\tif oracleErr := planned.oracle(result); oracleErr != nil {\n    88\t\t\t\tcaseResult.Passed = false\n    89\t\t\t\trunErr = oracleErr\n    90\t\t\t}\n    91\t\t}\n    92\t\tcampaign.report.Cases = append(campaign.report.Cases, caseResult)\n    93\t\tif runErr != nil {\n    94\t\t\treturn result, fmt.Errorf(\"run gomad3 fixture %s: %w\", planned.name, runErr)\n    95\t\t}\n    96\t\tif !caseResult.Passed {\n    97\t\t\treturn result, fmt.Errorf(\"gomad3 fixture %s failed with status %d: %s%s\", planned.name, result.ExitCode, result.Stdout.Bytes, result.Stderr.Bytes)\n    98\t\t}\n    99\t\treturn result, nil\n   100\t}\n   101\t\n   102\tfunc (campaign *runtimeCampaign) request(command []string, dir string, timeout time.Duration, unset []string, values ...string) hostexec.Request {\n   103\t\tfor _, argument := range command {\n   104\t\t\tif len(command) > 0 && command[0] == campaign.config.Go && strings.HasPrefix(argument, \"-exec\") {\n   105\t\t\t\tunset = append(unset, \"GOEXPERIMENT\")\n   106\t\t\t\tvalues = append(values, \"GOEXPERIMENT=nogreenteagc\")\n   107\t\t\t\tbreak\n   108\t\t\t}\n   109\t\t}\n   110\t\treturn hostexec.Request{\n   111\t\t\tCommand: command, Dir: dir, Env: append(filterEnvironment(os.Environ(), unset...), values...), Timeout: timeout,\n   112\t\t\tTerminateGrace: fixtureTerminationGrace, OutputLimit: fixtureOutputLimit,\n   113\t\t}\n   114\t}\n   115\t\n   116\tfunc (campaign *runtimeCampaign) command(name string, command []string, dir string, timeout time.Duration, unset []string, values ...string) (hostexec.Result, error) {\n   117\t\treturn campaign.runCase(runtimeCase{name: name, request: campaign.request(command, dir, timeout, unset, values...)})\n   118\t}\n   119\t\n   120\tfunc (campaign *runtimeCampaign) expectedExit(name string, command []string, dir string, timeout time.Duration, wantExit int, oracle func(hostexec.Result) error, unset []string, values ...string) error {\n   121\t\t_, err := campaign.runCase(runtimeCase{\n   122\t\t\tname: name, request: campaign.request(command, dir, timeout, unset, values...), wantExit: wantExit, oracle: oracle,\n   123\t\t})\n   124\t\treturn err\n   125\t}\n   126\t\n   127\tfunc (campaign *runtimeCampaign) expectedTimeout(name string, command []string, dir string, timeout time.Duration, unset []string, values ...string) error {\n   128\t\t_, err := campaign.runCase(runtimeCase{\n   129\t\t\tname: name, request: campaign.request(command, dir, timeout, unset, values...), wantTimeout: true,\n   130\t\t})\n   131\t\treturn err\n   132\t}\n   133\t\n   134\tfunc (campaign *runtimeCampaign) validateInstallation() error {\n   135\t\tkey, err := os.ReadFile(filepath.Join(campaign.config.Root, \".toolchain\", \"build-key\"))\n   136\t\tif err != nil {\n   137\t\t\treturn fmt.Errorf(\"read gomad3 build key: %w\", err)\n   138\t\t}\n   139\t\texpectedRoot := filepath.Join(campaign.config.Root, \".toolchain\", \"builds\", strings.TrimSpace(string(key)))\n   140\t\tif campaign.goRoot != expectedRoot {\n   141\t\t\treturn fmt.Errorf(\"gomad3 stable path is stale: expected %s, got %s\", expectedRoot, campaign.goRoot)\n   142\t\t}\n   143\t\toverlayRoot := os.Getenv(\"GOMAD3_OVERLAY_DIR\")\n   144\t\tif overlayRoot == \"\" {\n   145\t\t\toverlayRoot = filepath.Join(campaign.config.Root, \"toolchain\", \"runtime\", \"overlay\")\n   146\t\t}\n   147\t\treturn filepath.WalkDir(overlayRoot, func(path string, entry os.DirEntry, visitErr error) error {\n   148\t\t\tif visitErr != nil {\n   149\t\t\t\treturn visitErr\n   150\t\t\t}\n   151\t\t\tif entry.IsDir() {\n   152\t\t\t\treturn nil\n   153\t\t\t}\n   154\t\t\trelative, err := filepath.Rel(overlayRoot, path)\n   155\t\t\tif err != nil {\n   156\t\t\t\treturn err\n  