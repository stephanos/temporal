{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cat model/dev/xtask/src/{lib.rs,main.rs,support.rs}; cat model/dev/xtask/README.md; cat model/dev/xtask/Cargo.toml; cat model/umpire/backends/process/Cargo.toml'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -c 'cat model/dev/xtask/src/{lib.rs,main.rs,support.rs}; cat model/dev/xtask/README.md; cat model/dev/xtask/Cargo.toml; cat model/umpire/backends/process/Cargo.toml'","aggregated_output":"//! Host-only native development tools.\n\npub mod apalache_pins;\npub mod compiler;\n/// SHA-pinned installer with private staging and serialized publication.\npub mod fetch_apalache;\npub mod guest;\npub mod lock;\npub mod retired_names;\npub mod support;\n\n/// A native tool failure. Compiler exit statuses are returned separately.\n#[derive(Debug, thiserror::Error)]\npub enum Error {\n    /// An operating-system operation failed.\n    #[error(transparent)]\n    Io(#[from] std::io::Error),\n    /// Native JSON decoding failed.\n    #[error(transparent)]\n    Json(#[from] serde_json::Error),\n    /// Native TOML decoding failed.\n    #[error(transparent)]\n    Toml(#[from] toml::de::Error),\n    /// A driver contract was violated.\n    #[error(\"{0}\")]\n    Invalid(String),\n}\n\n/// Result returned by native tool operations.\npub type Result<T> = std::result::Result<T, Error>;\n//! Native development command dispatcher.\nuse std::{\n    env,\n    ffi::OsStr,\n    io::{self, Read, Write},\n    path::Path,\n};\n\nfn run() -> xtask::Result<i32> {\n    let mut argv = env::args_os();\n    if argv.next().as_deref().and_then(|p| Path::new(p).file_name())\n        == Some(OsStr::new(\"guest-rustc\"))\n    {\n        return xtask::compiler::run(argv.collect());\n    }\n    let mut arguments = argv;\n    match arguments.next().as_deref() {\n        Some(command) if command == OsStr::new(\"fetch-apalache\") => {\n            let root = if let Some(root) = arguments.next() {\n                std::path::PathBuf::from(root)\n            } else {\n                let current = env::current_dir()?;\n                current\n                    .ancestors()\n                    .find(|path| path.join(\"model/Cargo.toml\").is_file())\n                    .unwrap_or(&current)\n                    .to_owned()\n            };\n            if arguments.next().is_some() {\n                return Err(xtask::Error::Invalid(\n                    \"usage: cargo xtask fetch-apalache [workspace-root]\".into(),\n                ));\n            }\n            let path = xtask::fetch_apalache::install(Path::new(&root))?;\n            io::stdout().write_all(path.as_os_str().as_encoded_bytes())?;\n            io::stdout().write_all(b\"\\n\")?;\n            Ok(0)\n        }\n        Some(command) if command == OsStr::new(\"guest\") => {\n            xtask::guest::run(&arguments.collect::<Vec<_>>(), false)\n        }\n        Some(command) if command == OsStr::new(\"guest-freshness\") => {\n            xtask::guest::run(&arguments.collect::<Vec<_>>(), true)\n        }\n        Some(command) if command == OsStr::new(\"guest-lock\") => {\n            let paths: Vec<_> = arguments.collect();\n            if paths.len() != 2 {\n                return Err(xtask::Error::Invalid(\"usage: cargo xtask guest-lock <Cargo.lock> <directory> (metadata JSON on stdin)\".into()));\n            }\n            let mut metadata = Vec::new();\n            io::stdin().read_to_end(&mut metadata)?;\n            let path = xtask::lock::publish(&metadata, Path::new(&paths[0]), Path::new(&paths[1]))?;\n            io::stdout().write_all(path.as_os_str().as_encoded_bytes())?;\n            io::stdout().write_all(b\"\\n\")?;\n            Ok(0)\n        }\n        Some(command) if command == OsStr::new(\"guest-rustc\") => {\n            xtask::compiler::run(arguments.collect())\n        }\n        Some(command) if command == OsStr::new(\"retired-names\") => {\n            let pattern = arguments.next();\n            if pattern.is_none() || arguments.next().is_some() {\n                return Ok(2);\n            }\n            Ok(xtask::retired_names::run(\n                pattern.as_deref().unwrap_or_default(),\n                io::stdin().lock(),\n                io::stdout().lock(),\n            ))\n        }\n        _ => Err(xtask::Error::Invalid(\n            \"commands: fetch-apalache, guest, guest-freshness, guest-lock, guest-rustc, retired-names\".into(),\n        )),\n    }\n}\n\nfn main() {\n    let status = match run() {\n        Ok(status) => status,\n        Err(error) => {\n            let _ = writeln!(io::stderr(), \"xtask: {error}\");\n            1\n        }\n    };\n    std::process::exit(status);\n}\n//! Deterministic encoding and atomic publication shared by native tools.\nuse serde::Serialize;\nuse sha2::{Digest, Sha256};\nuse std::{\n    fs::{self, File, OpenOptions},\n    io::Write,\n    path::{Path, PathBuf},\n    sync::atomic::{AtomicU64, Ordering},\n};\n\n/// Native identity and sidecar version. Old Python records are deliberately rejected.\npub const SCHEMA: u32 = 2;\n\n/// Hash bytes in-process as lowercase SHA-256.\npub fn hash(bytes: &[u8]) -> String {\n    let digest = Sha256::digest(bytes);\n    let mut output = String::with_capacity(64);\n    for byte in digest {\n        use std::fmt::Write;\n        let _ = write!(output, \"{byte:02x}\");\n    }\n    output\n}\n\n/// Validate the digest representation used by the native schema.\npub fn valid_hash(value: &str) -> bool {\n    value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))\n}\n\n/// Encode through `serde_json`'s default sorted Map, including nested objects.\npub fn canonical(value: &impl Serialize) -> crate::Result<Vec<u8>> {\n    Ok(serde_json::to_vec(&serde_json::to_value(value)?)?)\n}\n\n/// Publish complete bytes by sibling rename, cleaning only our own temporary file.\npub fn publish(path: &Path, bytes: &[u8]) -> crate::Result<()> {\n    static NEXT: AtomicU64 = AtomicU64::new(0);\n    let parent = path.parent().filter(|p| !p.as_os_str().is_empty()).unwrap_or(Path::new(\".\"));\n    fs::create_dir_all(parent)?;\n    let mut name = path\n        .file_name()\n        .ok_or_else(|| crate::Error::Invalid(\"publication needs a filename\".into()))?\n        .to_os_string();\n    name.push(format!(\".{}.{}.tmp\", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));\n    let temporary = parent.join(name);\n    let mut file = OpenOptions::new().write(true).create_new(true).open(&temporary)?;\n    let result = (|| {\n        file.write_all(bytes)?;\n        file.sync_all()?;\n        drop(file);\n        fs::rename(&temporary, path)\n    })();\n    if let Err(error) = result {\n        match fs::remove_file(&temporary) {\n            Ok(()) => (),\n            Err(cleanup) if cleanup.kind() == std::io::ErrorKind::NotFound => (),\n            Err(cleanup) => {\n                return Err(crate::Error::Invalid(format!(\n                    \"publication failed: {error}; temporary cleanup failed: {cleanup}\"\n                )));\n            }\n        }\n        return Err(error.into());\n    }\n    Ok(())\n}\n\n/// Serialize compilers sharing a sidecar so a failed writer cannot remove a peer's record.\n/// The persistent lock inode must remain in place across invocations.\npub struct SidecarLease {\n    _file: File,\n    path: PathBuf,\n}\n\nimpl SidecarLease {\n    /// Acquire the output's lock and reject non-regular or replaced lock files.\n    #[cfg(unix)]\n    pub fn acquire(path: &Path) -> crate::Result<Self> {\n        use std::os::unix::fs::MetadataExt;\n        let parent =\n            path.parent().ok_or_else(|| crate::Error::Invalid(\"sidecar needs a parent\".into()))?;\n        fs::create_dir_all(parent)?;\n        let mut lock = path.as_os_str().to_os_string();\n        lock.push(\".lock\");\n        let lock = PathBuf::from(lock);\n        let file =\n            OpenOptions::new().read(true).write(true).create(true).truncate(false).open(&lock)?;\n        let verify = || -> crate::Result<()> {\n            let actual = fs::symlink_metadata(&lock)?;\n            let opened = file.metadata()?;\n            if !actual.is_file() || actual.dev() != opened.dev() || actual.ino() != opened.ino() {\n                return Err(crate::Error::Invalid(\n                    \"sidecar lock is not a stable regular file\".into(),\n                ));\n            }\n            Ok(())\n        };\n        verify()?;\n        file.lock()?;\n        verify()?;\n        Ok(Self { _file: file, path: path.to_owned() })\n    }\n\n    /// Remove a failed compiler's record while still holding its output lock.\n    pub fn remove(&self) -> crate::Result<()> {\n        match fs::remove_file(&self.path) {\n            Ok(()) => Ok(()),\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),\n            Err(error) => Err(error.into()),\n        }\n    }\n}\n# Native development tools\n\nBuild this host-only tool before setting guest compilation flags:\n\n```sh\ncd model\nmise exec -- cargo build -p xtask --bin xtask --profile dev --locked\nmise exec -- cargo xtask guest-lock Cargo.lock build/identities < metadata.json\n```\n\nThe alias selects the development profile; callers must bootstrap without a guest `--target`, `RUSTC_WRAPPER`, `RUSTFLAGS` or `CARGO_ENCODED_RUSTFLAGS`. Subsequent compiler invocations call the built native executable directly as `xtask guest-rustc <rustc> <arguments...>`. They never launch Cargo recursively. `model/scripts/xtask.sh` now owns bootstrap and prints the absolute executable path under `<target>/xtask-bootstrap/debug/xtask`. Guest launchers copy that native executable atomically as `guest-rustc`, which dispatches by argv[0] before parsing command arguments.\n\n`guest <crate> <output> [--check]` builds or compares a guest. `guest-freshness <crate> <output>` validates pinned tools, metadata, Rust sources and target readiness before comparing. Both run from `model/`; shell callers use `guest.sh` and `guest-freshness.sh` to preserve caller-relative output paths. Missing tools fail for every CI value. See [GUEST_BUILDS.md](../../GUEST_BUILDS.md) for native JSON admission, statuses and bootstrap environment.\n\n`guest-lock <Cargo.lock> <directory>` reads Cargo metadata JSON from stdin. It emits the published map's OS path followed by a newline. Publication uses a sibling temporary file, complete write and atomic rename. Its content-derived filename isolates different lock maps sharing a target directory. The native map contains `schema: 2` and `closures`, an object from `name version` to a lowercase SHA-256 string or null for ambiguous coordinates. Each digest covers native schema, lock version, sorted portable name/version/source coordinates, checksums, and every reachable non-development edge, including build and platform-conditional edges. Metadata's feature-unified graph is authoritative; host-only additions that enable shared optional edges may intentionally affect a closure. Checkout-bearing Cargo IDs never enter its digest.\n\n`guest-rustc` accepts raw OS arguments, passes probes and ordinary host compilation through, and normalizes wasm32-wasip1 and proc-macro identities. It inherits the environment and jobserver descriptors. `UMPIRE_GUEST_PREVIOUS_WRAPPER`, when nonempty, executes before the compiler. Existing `UMPIRE_GUEST_{WORKSPACE,SYSROOT,CARGO_HOME,TARGET,LOCK,COMPILER}` and Cargo package/manifest/OUT_DIR environment values supply the compilation context. A successful target compilation replaces Cargo's metadata hash with its native portable identity while retaining Cargo's output filename; native macro arguments remain intact. Sidecars publish before the child starts for Cargo pipelining. A per-output file lock serializes publication, child completion and failure cleanup; persistent lock files must stay in place. Launch or compiler failure removes the sidecar. Compiler exit statuses pass through, with Unix signals represented as 128 + signal; driver errors return 1 with an `xtask:` diagnostic.\n\nNative schema 2 intentionally replaces Python identity JSON, hash inputs, sidecars, formatting and diagnostics. Old schema-1 sidecars are invalid; guest orchestration invalidates its cache using the native binary, lockfile and compiler hashes. Sidecars contain `schema`, `identity` and transitive `host_variants`; hashes are exactly 64 lowercase hex digits. Compiler identity inputs preserve arbitrary Unix OS bytes without lossy Unicode conversion. Paths are lexically normalized under declared roots, with component-boundary matching. Host paths and Cargo host metadata are excluded from portable identity; dependency identities and native-macro collision detection remain mandatory. Standard-library exemptions require wasm, Cargo's build-std marker and either pinned sysroot sources or matching entries in rust-src's library lockfile.\n\nSerialization passes through plain serde_json `Value` so nested object keys use the default BTreeMap ordering. `preserve_order` is disabled workspace-wide. SHA-256 uses in-process sha2 0.11. Native TOML is exactly the admitted toml 1.1.8+spec-1.1.0 with only std/parse/serde requested by xtask. Other existing workspace consumers retain their pre-existing TOML features. No unbounded feature or Python grammar, number, date, recursion, escaping or diagnostic-order emulation is provided. JSON/TOML parse and schema failures are errors; native parser resource limits apply. Current workspace Cargo, mise and Rust toolchain documents and the installed rust-src lockfile are controls in the focused native corpus.\n\nRun the task's focused controls:\n\n```sh\ncd model\nmise exec -- cargo test -p xtask --locked\nmise exec -- cargo clippy -p xtask --all-targets -- -D warnings\n```\n\nThe canonical workspace gate will own these tests once, without a second package invocation. The conductor owns final joined-input guest publication, two-clean-build reproducibility, committed-asset freshness, host parity and the integrated TLC/Apalache pipeline. Linux process controls cannot establish native macOS loader behavior; inherited loader bytes are checked on the available host, with native macOS execution unclaimed.\n\n`retired-names <POSIX ERE>` reads the raw `git grep -n -z` stream: NUL-terminated\npath, NUL-terminated nonempty ASCII decimal line number, then a newline-terminated\nline (the last line may end at EOF). Paths and line contents preserve arbitrary bytes.\nEach forbidden record prints `path:number:line` with a final newline. An empty stream\nreturns 0, forbidden matches return 1, and malformed records or I/O/launch failures\nreturn 2. External grep failures propagate their exit code; a signal returns 2.\n\nThe author facade's test-directory token is exempt only at path/token boundaries.\nThe native boundary grammar uses ASCII whitespace and the existing punctuation\nboundaries; Python's Unicode whitespace classification is not part of this native\nbyte-stream contract (owner's 2026-10-24 native grammar amendment). After replacing\nexempt tokens, external `grep -E -q -- <pattern>` rechecks the remaining line using\nPOSIX ERE syntax. This detects a forbidden token beside an exempt token and keeps\nPOSIX character classes. The shell resolves the compiled tool once through\n`scripts/xtask.sh`; `UMPIRE_XTASK` can select an absolute prebuilt executable for\nisolated caller controls. `cargo test -p xtask --test retired_names --locked` covers\nthe stream contract, active spellings, historical exclusions and tool failures.\n\n## Apalache installer\n\n`fetch-apalache [workspace-root]` admits the official pinned Apalache jar. The\noptional root defaults to the enclosing repository root identified by\n`model/Cargo.toml`, or to the current directory outside a checkout. The root\ncontains `model/`; missing cache components are created. Success\nprints the absolute jar path followed by a newline and exits 0. Failures exit 1\nwith `xtask: <native error>` on stderr; curl can also write its own diagnostics.\nPaths are OS arguments, including non-UTF-8 paths on Unix. No Python diagnostic,\nexception type or output encoding compatibility is promised.\n\nThe installer requires curl and Unix filesystem admission. It stores the jar at\n`model/build/apalache/apalache-<version>/lib/apalache.jar`, locks a persistent\nregular `.install.lock` using `File::lock()`, and refuses symlink components,\nwrong existing jars and partial installations. Download and validation use a\nprivate 0700 staging directory. The archive hash is checked before gzip/tar\nparsing, the exact regular jar member is hashed before publication, and the\nvalidated directory is renamed into place while holding the lock. Staging is\nremoved on success and failure. Installation pins live only in\n`src/apalache_pins.rs`, included by the runtime backend as well as xtask.\nThe production command accepts no URL, version, archive or hash overrides.\n[package]\nname = \"xtask\"\ndescription = \"Host-only native development tools for Umpire\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[lints]\nworkspace = true\n\n[dependencies]\nserde = { workspace = true, features = [\"derive\"] }\nserde_json.workspace = true\nthiserror.workspace = true\ntoml.workspace = true\nsha2.workspace = true\ntar.workspace = true\nflate2.workspace = true\nlibc.workspace = true\ntempfile.workspace = true\n\n[[bin]]\nname = \"identity-compiler-fixture\"\npath = \"tests/identity/compiler_fixture.rs\"\ntest = false\nbench = false\n[package]\nname = \"umpire-backend-process\"\ndescription = \"Shared bounded backend process execution and workspace scratch support\"\nversion.workspace = true\nedition.workspace = true\npublish.workspace = true\nlicense.workspace = true\nrust-version.workspace = true\n\n[dependencies]\nthiserror.workspace = true\nlibc.workspace = true\nrustix.workspace = true\ntempfile.workspace = true\n\n[[bin]]\nname = \"umpire-process-fixture\"\npath = \"tests/fixtures/process_fixture.rs\"\ntest = false\n\n[lints.rust]\nmissing_docs = \"warn\"\nunsafe_code = \"deny\"\nunused_qualifications = \"warn\"\nunreachable_pub = \"warn\"\nrust_2018_idioms = { level = \"warn\", priority = -1 }\n\n[lints.clippy]\nall = { level = \"warn\", priority = -1 }\npedantic = { level = \"warn\", priority = -1 }\nmodule_name_repetitions = \"allow\"\nmust_use_candidate = \"allow\"\nmissing_errors_doc = \"allow\"\nmissing_panics_doc = \"allow\"\nunwrap_used = \"warn\"\nexpect_used = \"warn\"\ndbg_macro = \"warn\"\ntodo = \"warn\"\nprint_stdout = \"warn\"\nprint_stderr = \"warn\"\n","exit_code":0,"status":"completed"}}
