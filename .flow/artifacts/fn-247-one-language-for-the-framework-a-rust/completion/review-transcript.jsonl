nsafe extern \"C\" fn(*mut libc::pollfd, libc::nfds_t, libc::c_int) -> libc::c_int;\n#[cfg(target_os = \"macos\")]\ntype Wait4 = unsafe extern \"C\" fn(\n    libc::pid_t,\n    *mut libc::c_int,\n    libc::c_int,\n    *mut libc::rusage,\n) -> libc::pid_t;\n#[cfg(target_os = \"macos\")]\ntype Sigprocmask =\n    unsafe extern \"C\" fn(libc::c_int, *const libc::sigset_t, *mut libc::sigset_t) -> libc::c_int;\n\n#[cfg(target_os = \"macos\")]\ntype CancelState = unsafe extern \"C\" fn(libc::c_int) -> libc::c_int;\n\n// Resolution occurs in the parent. Children only load existing function pointers\n// and the existing errno cell, even when their consumer linked with lazy binding.\nmacro_rules! resolve {\n    ($name:expr, $direct:path, $kind:ty) => {{\n        #[cfg(target_feature = \"crt-static\")]\n        {\n            $direct as $kind\n        }\n        #[cfg(not(target_feature = \"crt-static\"))]\n        {\n            let address = libc::dlsym(libc::RTLD_DEFAULT, $name.as_ptr());\n            if address.is_null() {\n                return Err(io::Error::other(format!(\n                    \"cannot resolve backend syscall {}\",\n                    $name.to_string_lossy()\n                )));\n            }\n            std::mem::transmute::<*mut libc::c_void, $kind>(address)\n        }\n    }};\n}\n\npub(super) struct Api {\n    pub(super) errno: *mut libc::c_int,\n    setpgid: Setpgid,\n    sigaction: Sigaction,\n    dup2: Dup2,\n    kill: Kill,\n    setsid: Setsid,\n    chdir: Chdir,\n    execve: Execve,\n    setrlimit: Setrlimit,\n    exit: Exit,\n    #[cfg(target_os = \"linux\")]\n    syscall: RawSyscall,\n    #[cfg(target_os = \"linux\")]\n    prctl: Prctl,\n    #[cfg(target_os = \"linux\")]\n    lseek: Lseek,\n    #[cfg(target_os = \"macos\")]\n    fork: Setsid,\n    #[cfg(target_os = \"macos\")]\n    cancel_state: CancelState,\n    #[cfg(target_os = \"macos\")]\n    read: Read,\n    #[cfg(target_os = \"macos\")]\n    write: Write,\n    #[cfg(target_os = \"ma