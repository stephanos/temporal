le and not os.read(sys.stdin.fileno(), 1):\n                break\n        status = child.poll()\n    finally:\n        # The child session is disjoint from the supervisor and its Rust owner.\n        try:\n            os.killpg(child.pid, signal.SIGKILL)\n        except ProcessLookupError:\n            pass\n        child.wait()\n        if sys.platform.startswith(\"linux\"):\n            while True:\n                try:\n                    pid, _ = os.waitpid(-1, os.WNOHANG)\n                except ChildProcessError:\n                    break\n                if pid == 0:\n                    # Reap even descendants that started another process group.\n                    with open(f\"/proc/self/task/{os.getpid()}/children\", encoding=\"ascii\") as source:\n                        children = source.read()\n                    for descendant in children.split():\n                        try:\n                            os.kill(int(descendant), signal.SIGKILL)\n                        except ProcessLookupError:\n                            pass\n                    time.sleep(.005)\n    if stopping is not None:\n        return 128 + stopping\n    return 125 if status is None else status if status >= 0 else 128 - status\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\ndiff --git a/model/umpire/backends/apalache/src/lib.rs b/model/umpire/backends/apalache/src/lib.rs\nindex 5b496d263c..388806ae1c 100644\n--- a/model/umpire/backends/apalache/src/lib.rs\n+++ b/model/umpire/backends/apalache/src/lib.rs\n@@ -10,16 +10,10 @@ use std::{\n     process::Command,\n     time::Duration,\n };\n-use umpire_tla::{\n-    Limits, Refusal,\n-    process::{Scratch, java_command, pinned_java, run_process},\n-};\n-/// Selected official release.\n-pub const VERSION: &str = \"0.62.4\";\n-/// SHA-256 of the versioned official release archive.\n-pub const ARCHIVE_SHA256: &str = \"b781b53bba32fac14ac2e02b0332e1dc2edc64cb7b850c0608d8142cc7aa2ef4\";\n-/// SHA-256 of its unmodified as