{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -c \"sed -n '1,120p' model/umpire/backends/process/tests/process.rs; sed -n '220,332p' model/umpire/backends/process/tests/process.rs; sed -n '438,507p' model/umpire/backends/process/tests/process.rs; sed -n '830,1009p' model/umpire/backends/process/src/syscall.rs; cat .flow/artifacts/fn-247-one-language-for-the-framework-a-rust/task6/joined/source-binding.json\"","aggregated_output":"//! Compatibility controls for native backend process ownership.\n#![forbid(unsafe_code)]\nuse std::{\n    fs,\n    path::{Path, PathBuf},\n    process::{Command, Stdio},\n    sync::{\n        Arc,\n        atomic::{AtomicBool, Ordering},\n    },\n    thread,\n    time::{Duration, Instant},\n};\nuse umpire_backend_process::{\n    Limits, Refusal, Scratch, bounded_text, java_command, run_process, run_process_cancelled,\n};\n\nconst FIXTURE: &str = env!(\"CARGO_BIN_EXE_umpire-process-fixture\");\n\nfn root() -> Result<PathBuf, Refusal> {\n    Ok(Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../../../..\").canonicalize()?)\n}\nfn fixture(mode: &str) -> Command {\n    let mut command = Command::new(FIXTURE);\n    command.arg(mode);\n    command\n}\nfn join(worker: thread::JoinHandle<()>) -> Result<(), Refusal> {\n    worker.join().map_err(|_| Refusal(\"control thread panicked\".into()))\n}\nfn wait_ready(path: &Path) -> bool {\n    let start = Instant::now();\n    while start.elapsed() < Duration::from_secs(5) {\n        if fs::read_to_string(path).is_ok_and(|text| text.split_whitespace().count() >= 2) {\n            return true;\n        }\n        thread::sleep(Duration::from_millis(5));\n    }\n    false\n}\nstruct TreeCleanup(PathBuf);\nimpl Drop for TreeCleanup {\n    fn drop(&mut self) {\n        if let Ok(pids) = fs::read_to_string(&self.0) {\n            for pid in pids.split_whitespace() {\n                let _ = Command::new(\"kill\")\n                    .args([\"-KILL\", pid])\n                    .stdout(Stdio::null())\n                    .stderr(Stdio::null())\n                    .status();\n            }\n        }\n    }\n}\nfn assert_reaped(pids: &Path) -> Result<(), Refusal> {\n    for pid in fs::read_to_string(pids)?.split_whitespace() {\n        assert!(\n            !Path::new(\"/proc\").join(pid).exists(),\n            \"owned pid {pid} not reaped before fallback cleanup\"\n        );\n    }\n    Ok(())\n}\n\n#[test]\nfn cold_native_execution_does_not_need_python_or_a_sibling_supervisor() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let mut command = fixture(\"echo\");\n    command.env(\"PATH\", \"\");\n    let (status, output) =\n        run_process(&mut command, scratch.path(), \"native\", Limits::default(), None)?;\n    assert!(status.success());\n    assert_eq!(output, \"native\\n\");\n    scratch.finish(Ok(()))\n}\n\n#[test]\nfn direct_helper_timeout_retains_output_and_cleans_scratch() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let failure = run_process_cancelled(\n        &mut fixture(\"started\"),\n        scratch.path(),\n        \"direct\",\n        Limits { timeout: Duration::from_secs(1), ..Limits::default() },\n        None,\n        &AtomicBool::new(false),\n    )\n    .err()\n    .ok_or_else(|| Refusal(\"direct helper exceeded timeout\".into()))?;\n    assert!(failure.refusal.0.contains(\"limit\"));\n    assert_eq!(failure.output, \"started\\n\");\n    let path = scratch.path().to_path_buf();\n    scratch.finish::<_, Refusal>(Ok(()))?;\n    assert!(!path.exists());\n    Ok(())\n}\n\n#[test]\n#[cfg(target_os = \"linux\")]\nfn timeout_cleans_descendants_before_return() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let pids = scratch.path().join(\"pids\");\n    let _cleanup = TreeCleanup(pids.clone());\n    let mut command = fixture(\"tree\");\n    command.arg(&pids).arg(scratch.path().join(\"supervisor\"));\n    let limits = Limits { timeout: Duration::from_secs(1), ..Limits::default() };\n    assert!(run_process(&mut command, scratch.path(), \"tree\", limits, None).is_err());\n    assert_reaped(&pids)?;\n    scratch.finish(Ok(()))\n}\n\n#[test]\n#[cfg(target_os = \"linux\")]\nfn cancellation_reaps_descendants_in_separate_sessions_and_closes_stdin() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let pids = scratch.path().join(\"pids\");\n    let _cleanup = TreeCleanup(pids.clone());\n    let mut command = fixture(\"tree\");\n    command.arg(&pids).arg(scratch.path().join(\"supervisor\"));\n    let cancelled = Arc::new(AtomicBool::new(false));\n        .err()\n        .ok_or_else(|| Refusal(\"malformed or oversized output admitted\".into()))?;\n        assert!(failure.output.len() as u64 <= limit);\n        assert_eq!(failure.output, expected);\n        if label == \"utf8\" {\n            assert!(failure.refusal.0.contains(\"non-UTF8\"));\n            assert_eq!(fs::read(scratch.path().join(\"utf8.stdout\"))?, [255]);\n        }\n    }\n    scratch.finish(Ok(()))\n}\n\n#[test]\nfn parent_allocator_threads_do_not_deadlock_forked_supervisors() -> Result<(), Refusal> {\n    let stop = Arc::new(AtomicBool::new(false));\n    let workers: Vec<_> = (0..4)\n        .map(|_| {\n            let stop = stop.clone();\n            thread::spawn(move || {\n                while !stop.load(Ordering::Relaxed) {\n                    let values: Vec<_> =\n                        (0..128).map(|i| format!(\"allocation-{i}-{}\", \"x\".repeat(100))).collect();\n                    std::hint::black_box(values);\n                }\n            })\n        })\n        .collect();\n    let spawning = {\n        let stop = stop.clone();\n        thread::spawn(move || -> Result<(), Refusal> {\n            while !stop.load(Ordering::Relaxed) {\n                if !Command::new(\"true\").status()?.success() {\n                    return Err(Refusal(\"concurrent spawn failed\".into()));\n                }\n            }\n            Ok(())\n        })\n    };\n    let result = (|| {\n        let runs: Vec<_> = (0..4)\n            .map(|_| {\n                thread::spawn(|| -> Result<(), Refusal> {\n                    let scratch = Scratch::new(&root()?)?;\n                    for index in 0..12 {\n                        let (status, output) = run_process(\n                            &mut fixture(\"echo\"),\n                            scratch.path(),\n                            &format!(\"stress-{index}\"),\n                            Limits { timeout: Duration::from_secs(5), ..Limits::default() },\n                            None,\n                        )?;\n                        assert!(status.success());\n                        assert_eq!(output, \"native\\n\");\n                    }\n                    scratch.finish(Ok(()))\n                })\n            })\n            .collect();\n        for run in runs {\n            run.join().map_err(|_| Refusal(\"fork stress panicked\".into()))??;\n        }\n        Ok(())\n    })();\n    stop.store(true, Ordering::Relaxed);\n    for worker in workers {\n        join(worker)?;\n    }\n    spawning.join().map_err(|_| Refusal(\"spawn stress panicked\".into()))??;\n    result\n}\n\n#[test]\nfn bounded_reads_dump_and_scratch_fail_closed() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let text = scratch.path().join(\"text\");\n    fs::write(&text, \"abcd\")?;\n    assert_eq!(bounded_text(&text, 4)?, \"abcd\");\n    assert!(bounded_text(&text, 3).is_err());\n    let link = scratch.path().join(\"link\");\n    std::os::unix::fs::symlink(&text, &link)?;\n    assert!(bounded_text(&link, 4).is_err());\n    assert!(bounded_text(scratch.path(), 4).is_err());\n    let invalid = scratch.path().join(\"invalid\");\n    fs::write(&invalid, [255])?;\n    assert!(bounded_text(&invalid, 4).is_err());\n    let fifo = scratch.path().join(\"dump-fifo\");\n    assert!(Command::new(\"mkfifo\").arg(&fifo).status()?.success());\n    assert!(bounded_text(&fifo, 4).is_err());\n    let deep = scratch.path().join(\"deep\");\n    let mut directory = deep.clone();\n    for _ in 0..66 {\n        fs::create_dir(&directory)?;\n        directory.push(\"d\");\n    }\n    let wide = scratch.path().join(\"wide\");\n    fs::create_dir(&wide)?;\n    for index in 0..4096 {\n        fs::write(wide.join(index.to_string()), [])?;\n    }\n    for (label, dump) in [\n        (\"dump-budget\", &text),\n        (\"dump-link\", &link),\n        (\"dump-fifo\", &fifo),\n        (\"dump-depth\", &deep),\n        (\"dump-entries\", &wide),\n    ] {\n        assert!(\n            run_process(\n                &mut fixture(\"echo\"),\n                scratch.path(),\n                label,\n                Limits { dump_bytes: 3, ..Limits::default() },\n                Some(dump)\nfn owner_group_and_direct_supervisor_termination_reap_owned_tree() -> Result<(), Refusal> {\n    for mode in [\"owner-group\", \"owner-group-kill\", \"supervisor\"] {\n        let scratch = Scratch::new(&root()?)?;\n        let output = fixture(\"lifecycle-harness\").arg(mode).arg(scratch.path()).output()?;\n        assert!(output.status.success(), \"{mode}: {}\", String::from_utf8_lossy(&output.stderr));\n        assert_reaped(&scratch.path().join(\"pids\"))?;\n        scratch.finish::<_, Refusal>(Ok(()))?;\n    }\n    Ok(())\n}\n\n#[test]\n#[cfg(target_os = \"linux\")]\nfn owner_death_terminates_and_reaps_separate_session_descendants() -> Result<(), Refusal> {\n    let scratch = Scratch::new(&root()?)?;\n    let output = fixture(\"lifecycle-harness\").arg(\"owner-eof\").arg(scratch.path()).output()?;\n    assert!(output.status.success(), \"{}\", String::from_utf8_lossy(&output.stderr));\n    assert_eq!(output.stderr, b\"\");\n    assert_reaped(&scratch.path().join(\"pids\"))?;\n    scratch.finish(Ok(()))\n}\n\n#[test]\nfn launch_status_and_prepared_command_contracts_are_preserved() -> Result<(), Refusal> {\n    use std::os::unix::fs::PermissionsExt;\n    let scratch = Scratch::new(&root()?)?;\n    let nonexec = scratch.path().join(\"not-executable\");\n    fs::write(&nonexec, \"not executable\")?;\n    fs::set_permissions(&nonexec, fs::Permissions::from_mode(0o600))?;\n    let missing = scratch.path().join(\"missing-executable\");\n    for (label, executable) in [(\"missing\", &missing), (\"nonexec\", &nonexec)] {\n        let (status, _) = run_process(\n            &mut Command::new(executable),\n            scratch.path(),\n            label,\n            Limits::default(),\n            None,\n        )?;\n        assert_eq!(status.code(), Some(1), \"{label}\");\n    }\n    let mut missing_cwd = fixture(\"echo\");\n    missing_cwd.current_dir(scratch.path().join(\"missing-directory\"));\n    let failure = run_process(&mut missing_cwd, scratch.path(), \"cwd\", Limits::default(), None)\n        .err()\n        .ok_or_else(|| Refusal(\"missing working directory was admitted\".into()))?;\n    assert!(failure.0.contains(\"cannot spawn cwd\"), \"{failure}\");\n    std::os::unix::fs::symlink(FIXTURE, scratch.path().join(\"tool\"))?;\n    for (index, program) in [\"tool\", \"./tool\"].into_iter().enumerate() {\n        let mut command = Command::new(program);\n        command\n            .args([\"argv-env\", \"space ' \\\" unicode λ\"])\n            .current_dir(scratch.path())\n            .env(\"PATH\", \".\")\n            .env(\"UMPIRE_PROCESS_VALUE\", \"prepared\")\n            .env(\"UMPIRE_PROCESS_REMOVED\", \"present\")\n            .env_remove(\"UMPIRE_PROCESS_REMOVED\");\n        let (status, output) = run_process(\n            &mut command,\n            scratch.path(),\n            &format!(\"prepare-{index}\"),\n            Limits::default(),\n            None,\n        )?;\n        assert!(status.success());\n        assert_eq!(output, \"arg:space ' \\\" unicode λ\\nvalue:prepared\\nremoved:true\\n\");\n    }\n    scratch.finish(Ok(()))\n}\n\n#[test]\n        if unsafe { prevent_descendants(&api) } { Ok(()) } else { Err(io::Error::last_os_error()) }\n    }\n\n    #[allow(dead_code)]\n    pub(crate) fn parent_identity() -> (u32, bool) {\n        process::getppid().map_or((0, false), |parent| {\n            (parent.as_raw_pid().cast_unsigned(), process::getpgid(Some(parent)) == Ok(parent))\n        })\n    }\n\n    #[cfg(target_os = \"linux\")]\n    #[allow(dead_code)]\n    pub(crate) fn set_subreaper() -> io::Result<()> {\n        process::set_child_subreaper(Some(Pid::INIT)).map_err(Into::into)\n    }\n\n    #[cfg(target_os = \"linux\")]\n    #[allow(dead_code)]\n    pub(crate) fn reap_owned_children() -> io::Result<()> {\n        loop {\n            match process::wait(WaitOptions::empty()) {\n                Ok(_) | Err(rustix::io::Errno::INTR) => {}\n                Err(rustix::io::Errno::CHILD) => return Ok(()),\n                Err(error) => return Err(error.into()),\n            }\n        }\n    }\n\n    #[cfg(target_os = \"linux\")]\n    #[allow(dead_code)]\n    pub(crate) fn poison_atfork_child() -> io::Result<()> {\n        unsafe extern \"C\" fn poison() {\n            // SAFETY: a callback reached after an unintended libc fork must not\n            // return to the test; _exit is async-signal-safe and never unwinds.\n            unsafe { libc::_exit(99) }\n        }\n        // SAFETY: the callback is a static function; the isolated fixture never\n        // calls libc fork again and exits immediately after its control.\n        let result = unsafe { libc::pthread_atfork(None, None, Some(poison)) };\n        if result == 0 { Ok(()) } else { Err(io::Error::from_raw_os_error(result)) }\n    }\n\n    #[cfg(test)]\n    mod tests {\n        use super::*;\n        use std::{\n            fs, thread,\n            time::{Duration, Instant},\n        };\n\n        #[test]\n        fn duplicated_descriptors_are_private_and_close_on_exec() -> io::Result<()> {\n            let file = File::open(\"/dev/null\")?;\n            let descriptor = duplicate(&file)?;\n            assert!(descriptor.as_raw_fd() >= 10);\n            assert!(rustix::io::fcntl_getfd(&descriptor)?.contains(rustix::io::FdFlags::CLOEXEC));\n            Ok(())\n        }\n\n        #[test]\n        fn close_limit_retains_descriptors_above_lowered_soft_limit() -> io::Result<()> {\n            const CONTROL: &str = \"UMPIRE_CLOSE_LIMIT_CONTROL\";\n            if std::env::var_os(CONTROL).is_none() {\n                let output = Command::new(std::env::current_exe()?)\n                    .args([\"--exact\", \"syscall::supported::tests::close_limit_retains_descriptors_above_lowered_soft_limit\"])\n                    .env(CONTROL, \"1\").output()?;\n                assert!(\n                    output.status.success(),\n                    \"{}{}\",\n                    String::from_utf8_lossy(&output.stdout),\n                    String::from_utf8_lossy(&output.stderr)\n                );\n                return Ok(());\n            }\n            let file = File::open(\"/dev/null\")?;\n            let high = rustix::io::fcntl_dupfd_cloexec(&file, 128)?;\n            let prior = process::getrlimit(Resource::Nofile);\n            process::setrlimit(Resource::Nofile, process::Rlimit { current: Some(64), ..prior })?;\n            assert!(close_limit()? > high.as_raw_fd());\n            Ok(())\n        }\n\n        #[test]\n        fn supervisor_owner_eof_returns_125() -> io::Result<()> {\n            let directory =\n                std::env::temp_dir().join(format!(\"umpire-owner-eof-{}\", std::process::id()));\n            fs::create_dir(&directory)?;\n            let out = File::create(directory.join(\"stdout\"))?;\n            let err = File::create(directory.join(\"stderr\"))?;\n            let mut command = Command::new(\"/bin/sleep\");\n            command.arg(\"60\");\n            let mut running = Running::spawn(&command, &directory, &out, &err)?;\n            drop(running.owner.take());\n            let deadline = Instant::now() + Duration::from_secs(5);\n            let result = loop {\n                if let Some(status) = running.try_wait()? {\n                    break status.code();\n                }\n                assert!(Instant::now() < deadline, \"supervisor ignored owner EOF\");\n                thread::sleep(Duration::from_millis(5));\n            };\n            assert_eq!(result, Some(125));\n            drop(running);\n            fs::remove_dir_all(directory)\n        }\n\n        #[test]\n        #[cfg(target_os = \"linux\")]\n        fn raw_clone_prefix_preserves_flags_and_null_stack() {\n            let flags = libc::c_long::from(libc::SIGCHLD);\n            assert_eq!([clone_prefix(false), clone_prefix(true)], [(flags, 0), (0, flags)]);\n        }\n\n        #[test]\n        #[cfg(target_os = \"linux\")]\n        fn raw_clone_normalizes_sparc_child_identity() {\n            assert_eq!(\n                [clone_pid(42, 42, 43), clone_pid(43, 42, 42), clone_pid(-1, 42, 42)],\n                [0, 43, -1]\n            );\n        }\n\n        #[test]\n        fn supervisor_retains_first_stop_signal() {\n            STOP_SIGNAL.store(0, Ordering::Relaxed);\n            request_stop(libc::SIGTERM);\n            request_stop(libc::SIGINT);\n            assert_eq!(STOP_SIGNAL.load(Ordering::Relaxed), libc::SIGTERM);\n            STOP_SIGNAL.store(0, Ordering::Relaxed);\n        }\n    }\n}\n\n#[cfg(any(target_os = \"linux\", target_os = \"macos\"))]\n#[allow(unused_imports)]\npub(crate) use supported::Running;\n#[cfg(any(target_os = \"linux\", target_os = \"macos\"))]\n#[allow(unused_imports)]\npub(crate) use supported::{parent_identity, restrict_descendants};\n#[cfg(target_os = \"linux\")]\n#[allow(unused_imports)]\npub(crate) use supported::{poison_atfork_child, reap_owned_children, set_subreaper};\n\n#[cfg(not(any(target_os = \"linux\", target_os = \"macos\")))]\npub(crate) struct Running;\n#[cfg(not(any(target_os = \"linux\", target_os = \"macos\")))]\nimpl Running {\n    pub(crate) fn spawn(_: &Command, _: &Path, _: &File, _: &File) -> io::Result<Self> {\n        platform_policy(std::env::consts::OS, 0, 0)?;\n        Ok(Self)\n    }\n    pub(crate) fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {\n        platform_policy(std::env::consts::OS, 0, 0)?;\n        Ok(None)\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::platform_policy;\n\n    #[test]\n    fn all_darwin_helpers_prevent_process_creation() {\n        assert!(platform_policy(\"macos\", 501, 501).is_ok());\n        for (uid, euid) in [(0, 501), (501, 0), (0, 0)] {\n            assert!(\n                platform_policy(\"macos\", uid, euid)\n                    .is_err_and(|e| e.to_string().contains(\"non-root\"))\n            );\n        }\n        assert!(platform_policy(\"linux\", 0, 0).is_ok());\n    }\n\n    #[test]\n    fn unsupported_platform_is_an_explicit_refusal() {\n        assert!(platform_policy(\"unsupported\", 501, 501).is_err_and(|e| {\n            e.to_string() == \"backend process ownership supports Linux and macOS only\"\n        }));\n    }\n}\n{\n  \"joined_commit\": \"523d131d2cf992b04a43b4d595ea0f1a434f44b6\",\n  \"lane_commit\": \"17bce75e1cbd28bb7e6939a869ee961c0df784a7\",\n  \"identical_cargo_sha256\": {\n    \"model/Cargo.toml\": \"b542ece56408c2fca813396382f0c3a478bc93a725d860632afb9ecc54192f8c\",\n    \"model/Cargo.lock\": \"0eea0a3a9f36feb826c4cbdedd614c1c0ae73b99b17632e26a6dea57a98e083a\",\n    \"model/dev/xtask/Cargo.toml\": \"ef4f3de834fecc331a6e624e563e2c7129831d2005cde6ba8df8610262ebc108\"\n  },\n  \"joined_source_sha256\": {\n    \"model/scripts/xtask.sh\": \"50308f89737d063642bb50d85b32ef3d397a767ed9a24a8690c9190ab03e815d\",\n    \"model/dev/xtask/src/main.rs\": \"0255fd049f0fd36202fefad0af63009ec7d12120d9d356f35cf576cbeef930c2\",\n    \"model/dev/xtask/src/lib.rs\": \"4a3ff81a61aa70e407112804f29113704cd94242ffabaad7196c01132b6209ff\",\n    \"model/dev/xtask/src/fetch_apalache.rs\": \"b39b2347aaf752dfaa04