{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -c 'cat model/dev/xtask/src/fetch_apalache.rs; cat model/dev/xtask/src/retired_names.rs'","aggregated_output":"// SHA-pinned Apalache admission, without extracting archive paths to disk.\nuse crate::{\n    Error, Result,\n    apalache_pins::{ARCHIVE_SHA256, JAR_SHA256, VERSION},\n    support::hash,\n};\nuse std::{\n    fs::{self, File, OpenOptions},\n    io::Read,\n    path::{Path, PathBuf},\n    process::Command,\n};\n\nstruct Pins {\n    version: &'static str,\n    archive: String,\n    jar: String,\n}\n\n/// Install the official pinned assembly, or validate an existing installation.\n/// The root is the repository directory containing `model/`.\npub fn install(root: &Path) -> Result<PathBuf> {\n    install_with(\n        root,\n        &Pins { version: VERSION, archive: ARCHIVE_SHA256.into(), jar: JAR_SHA256.into() },\n        |archive| {\n            let status = Command::new(\"curl\").args([\"--proto\", \"=https\", \"--tlsv1.2\", \"--fail\", \"--location\", \"--retry\", \"2\", \"--max-time\", \"180\"])\n            .arg(format!(\"https://github.com/apalache-mc/apalache/releases/download/v{VERSION}/apalache-{VERSION}.tgz\"))\n            .arg(\"-o\").arg(archive).status()?;\n            if !status.success() {\n                return Err(Error::Invalid(format!(\"Apalache download failed: {status}\")));\n            }\n            Ok(())\n        },\n    )\n}\n\nfn refuse(message: &str) -> Error {\n    Error::Invalid(format!(\"Apalache {message}\"))\n}\n\nfn directory(path: &Path) -> Result<()> {\n    match fs::create_dir(path) {\n        Ok(()) => (),\n        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => (),\n        Err(error) => return Err(error.into()),\n    }\n    if !fs::symlink_metadata(path)?.is_dir() || fs::canonicalize(path)? != path {\n        return Err(refuse(\"build root contains a symlink or escapes workspace\"));\n    }\n    Ok(())\n}\n\n#[cfg(unix)]\nfn lock(cache: &Path) -> Result<File> {\n    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};\n    let path = cache.join(\".install.lock\");\n    let file = OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(false)\n        .mode(0o600)\n        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)\n        .open(&path)?;\n    let verify = || -> Result<()> {\n        let opened = file.metadata()?;\n        let named = fs::symlink_metadata(&path)?;\n        if !opened.is_file()\n            || !named.is_file()\n            || opened.dev() != named.dev()\n            || opened.ino() != named.ino()\n        {\n            return Err(refuse(\"lock is not a stable regular file\"));\n        }\n        Ok(())\n    };\n    verify()?;\n    file.lock()?;\n    verify()?;\n    Ok(file)\n}\n\n#[cfg(not(unix))]\nfn lock(_: &Path) -> Result<File> {\n    Err(refuse(\"installer requires Unix path admission\"))\n}\n\nfn validate_paths(cache: &Path, destination: &Path) -> Result<()> {\n    if fs::canonicalize(cache)? != cache {\n        return Err(refuse(\"cache changed during admission\"));\n    }\n    for path in\n        [destination.to_owned(), destination.join(\"lib\"), destination.join(\"lib/apalache.jar\")]\n    {\n        match fs::symlink_metadata(path) {\n            Ok(metadata) if metadata.is_symlink() => {\n                return Err(refuse(\"installation is a symlink\"));\n            }\n            Ok(_) => (),\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => (),\n            Err(error) => return Err(error.into()),\n        }\n    }\n    Ok(())\n}\n\nfn contents(payload: &[u8], pins: &Pins) -> Result<Vec<u8>> {\n    if hash(payload) != pins.archive {\n        return Err(refuse(\"archive integrity mismatch\"));\n    }\n    let decoder = flate2::read::GzDecoder::new(payload);\n    let mut archive = tar::Archive::new(decoder);\n    let wanted = format!(\"apalache-{}/lib/apalache.jar\", pins.version);\n    for entry in archive.entries()? {\n        let mut entry = entry?;\n        if entry.path()?.as_ref() != Path::new(&wanted) {\n            continue;\n        }\n        if !entry.header().entry_type().is_file() {\n            return Err(refuse(\"jar is not a regular archive member\"));\n        }\n        let mut bytes = Vec::new();\n        entry.read_to_end(&mut bytes)?;\n        if hash(&bytes) != pins.jar {\n            return Err(refuse(\"extracted jar integrity mismatch\"));\n        }\n        return Ok(bytes);\n    }\n    Err(refuse(\"archive is missing the jar member\"))\n}\n\nfn install_with(\n    root: &Path,\n    pins: &Pins,\n    download: impl FnOnce(&Path) -> Result<()>,\n) -> Result<PathBuf> {\n    let root = fs::canonicalize(root)?;\n    let mut cache = root;\n    for part in [\"model\", \"build\", \"apalache\"] {\n        cache.push(part);\n        directory(&cache)?;\n    }\n    let _lease = lock(&cache)?;\n    let destination = cache.join(format!(\"apalache-{}\", pins.version));\n    let jar = destination.join(\"lib/apalache.jar\");\n    validate_paths(&cache, &destination)?;\n    if jar.is_file() {\n        if hash(&fs::read(&jar)?) != pins.jar {\n            return Err(refuse(\"jar integrity mismatch\"));\n        }\n        return Ok(jar);\n    }\n    if destination.try_exists()? {\n        return Err(refuse(\"partial installation\"));\n    }\n    let mut builder = tempfile::Builder::new();\n    builder.prefix(\"install-\");\n    #[cfg(unix)]\n    {\n        use std::os::unix::fs::PermissionsExt;\n        builder.permissions(fs::Permissions::from_mode(0o700));\n    }\n    let staging = builder.tempdir_in(&cache)?;\n    let result = (|| {\n        let archive = staging.path().join(\"release.tgz\");\n        download(&archive)?;\n        let bytes = contents(&fs::read(archive)?, pins)?;\n        let private = staging.path().join(\"validated\");\n        fs::create_dir(&private)?;\n        fs::create_dir(private.join(\"lib\"))?;\n        crate::support::publish(&private.join(\"lib/apalache.jar\"), &bytes)?;\n        validate_paths(&cache, &destination)?;\n        if destination.try_exists()? {\n            return Err(refuse(\"cache changed during admission\"));\n        }\n        fs::rename(private, &destination)?;\n        Ok(jar)\n    })();\n    let cleanup = staging.close();\n    match (result, cleanup) {\n        (Ok(path), Ok(())) => Ok(path),\n        (Err(error), Ok(())) => Err(error),\n        (_, Err(error)) => Err(refuse(&format!(\"staging cleanup failed: {error}\"))),\n    }\n}\n//! Filter `git grep -n -z` records, exempting author-facade test paths.\nuse std::{\n    ffi::OsStr,\n    io::{self, BufRead, Write},\n    process::{Command, Stdio},\n};\n\nfn exempt(line: &[u8]) -> Vec<u8> {\n    let token = b\"author/umpire/tests\";\n    let mut probe = Vec::with_capacity(line.len());\n    let mut offset = 0;\n    while offset < line.len() {\n        let before = offset == 0\n            || line[offset - 1].is_ascii_whitespace()\n            || b\"/\\\"'`=([{ \".contains(&line[offset - 1]);\n        let end = offset + token.len();\n        if before\n            && line[offset..].starts_with(token)\n            && (end == line.len()\n                || line[end].is_ascii_whitespace()\n                || b\"/\\\"'`)]}\".contains(&line[end]))\n        {\n            probe.extend_from_slice(b\"author/umpire/facade_checks\");\n            offset = end;\n        } else {\n            probe.push(line[offset]);\n            offset += 1;\n        }\n    }\n    probe\n}\n\nfn field(input: &mut impl BufRead, label: &str) -> io::Result<Vec<u8>> {\n    let mut bytes = Vec::new();\n    input.read_until(0, &mut bytes)?;\n    if bytes.pop() != Some(0) {\n        return Err(io::Error::new(\n            io::ErrorKind::InvalidData,\n            format!(\"missing {label} separator\"),\n        ));\n    }\n    Ok(bytes)\n}\n\n/// Return 0 for exempt/empty input, 1 for forbidden matches, 2 for malformed\n/// records or I/O failure, and the external grep failure status otherwise.\n/// Records retain raw path/line bytes; facade-token boundaries use ASCII whitespace.\npub fn run(pattern: &OsStr, mut input: impl BufRead, mut output: impl Write) -> i32 {\n    match filter(pattern, &mut input, &mut output) {\n        Ok(status) => status,\n        Err(error) => {\n            let _ = writeln!(io::stderr(), \"retired-name filtering failed: {error}\");\n            2\n        }\n    }\n}\n\nfn filter(pattern: &OsStr, input: &mut impl BufRead, output: &mut impl Write) -> io::Result<i32> {\n    let mut found = false;\n    while !input.fill_buf()?.is_empty() {\n        let path = field(input, \"path\")?;\n        let number = field(input, \"line number\")?;\n        if number.is_empty() || !number.iter().all(u8::is_ascii_digit) {\n            return Err(io::Error::new(io::ErrorKind::InvalidData, \"invalid grep line number\"));\n        }\n        let mut line = Vec::new();\n        input.read_until(b'\\n', &mut line)?;\n        if line.last() == Some(&b'\\n') {\n            line.pop();\n        }\n        let mut probe = exempt(&line);\n        if probe != line {\n            probe.push(b'\\n');\n            let mut child = Command::new(\"grep\")\n                .args([OsStr::new(\"-E\"), OsStr::new(\"-q\"), OsStr::new(\"--\"), pattern])\n                .stdin(Stdio::piped())\n                .spawn()?;\n            let write = child\n                .stdin\n                .take()\n                .ok_or_else(|| io::Error::other(\"missing grep stdin\"))\n                .and_then(|mut stdin| stdin.write_all(&probe));\n            let status = child.wait()?;\n            let code = status.code().unwrap_or(2);\n            if code != 0 && code != 1 {\n                return Ok(code);\n            }\n            if let Err(error) = write\n                && error.kind() != io::ErrorKind::BrokenPipe\n            {\n                return Err(error);\n            }\n            if code == 1 {\n                continue;\n            }\n        }\n        for bytes in [path.as_slice(), b\":\", number.as_slice(), b\":\", line.as_slice(), b\"\\n\"] {\n            output.write_all(bytes)?;\n        }\n        found = true;\n    }\n    Ok(i32::from(found))\n}\n","exit_code":0,"status":"completed"}}
