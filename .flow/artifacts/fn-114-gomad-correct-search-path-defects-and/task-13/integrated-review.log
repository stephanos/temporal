{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tools/gomad3/internal/gomadtool/conformance/runtime_owned.go | sed -n '1,180p'\"","aggregated_output":"     1\tpackage conformance\n     2\t\n     3\timport (\n     4\t\t\"crypto/sha256\"\n     5\t\t\"encoding/binary\"\n     6\t\t\"encoding/json\"\n     7\t\t\"fmt\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"slices\"\n    11\t\t\"strconv\"\n    12\t\n    13\t\t\"go.temporal.io/server/tools/gomad3/choice\"\n    14\t)\n    15\t\n    16\tfunc (campaign *runtimeCampaign) requireRuntimeOwned(fixture string) error {\n    17\t\tvar evidence []map[string]any\n    18\t\tfor _, mode := range []string{\"two\", \"zero\", \"one\", \"busy\"} {\n    19\t\t\tvar runs []choiceRun\n    20\t\t\tusers := map[[sha256.Size]byte]bool{}\n    21\t\t\troot := sha256.Sum256([]byte(\"gomad3-choice-goroutine-root/v1\"))\n    22\t\t\tfor seed := 1; seed <= 32; seed++ {\n    23\t\t\t\trun, err := campaign.runChoiceMode(\"runtime-owned-\"+mode+\"-\"+strconv.Itoa(seed), fixture, strconv.Itoa(seed), nil, choice.ModeRecord, 0, mode)\n    24\t\t\t\tif err != nil {\n    25\t\t\t\t\treturn err\n    26\t\t\t\t}\n    27\t\t\t\twant := \"[64 64]\"\n    28\t\t\t\tif mode == \"zero\" {\n    29\t\t\t\t\twant = \"[0 0]\"\n    30\t\t\t\t}\n    31\t\t\t\tif mode == \"one\" {\n    32\t\t\t\t\twant = \"[64 0]\"\n    33\t\t\t\t}\n    34\t\t\t\tif mode == \"busy\" {\n    35\t\t\t\t\twant = \"runtime 64\\n[64 64]\"\n    36\t\t\t\t}\n    37\t\t\t\tif run.transcript != want {\n    38\t\t\t\t\treturn fmt.Errorf(\"runtime-owned %s seed %d output %q, want %q\", mode, seed, run.transcript, want)\n    39\t\t\t\t}\n    40\t\t\t\tdecisions := 0\n    41\t\t\t\tfor _, record := range run.trace.Records {\n    42\t\t\t\t\tif record.Kind != choice.KindRunnable {\n    43\t\t\t\t\t\tcontinue\n    44\t\t\t\t\t}\n    45\t\t\t\t\tdecisions++\n    46\t\t\t\t\tfor ordinal := uint64(1); ordinal <= 8; ordinal++ {\n    47\t\t\t\t\t\tvar encoded [8]byte\n    48\t\t\t\t\t\tbinary.BigEndian.PutUint64(encoded[:], ordinal)\n    49\t\t\t\t\t\tidentity := sha256.Sum256(append([]byte(\"gomad3-choice-goroutine-runtime/v1\"), encoded[:]...))\n    50\t\t\t\t\t\tif identity == record.SelectedIdentity {\n    51\t\t\t\t\t\t\treturn fmt.Errorf(\"%s seed %d decision %d selected runtime ordinal %d\", mode, seed, record.Ordinal, ordinal)\n    52\t\t\t\t\t\t}\n    53\t\t\t\t\t}\n    54\t\t\t\t\tif record.SelectedIdentity != root {\n    55\t\t\t\t\t\tusers[record.SelectedIdentity] = true\n    56\t\t\t\t\t}\n    57\t\t\t\t}\n    58\t\t\t\tif (mode == \"zero\" || mode == \"one\") && decisions != 0 {\n    59\t\t\t\t\treturn fmt.Errorf(\"%s seed %d recorded %d decisions\", mode, seed, decisions)\n    60\t\t\t\t}\n    61\t\t\t\tif (mode == \"two\" || mode == \"busy\") && decisions == 0 {\n    62\t\t\t\t\treturn fmt.Errorf(\"%s seed %d exposed no user branching\", mode, seed)\n    63\t\t\t\t}\n    64\t\t\t\tevidence = append(evidence, map[string]any{\"mode\": mode, \"seed\": seed, \"decisions\": decisions, \"trace_sha256\": fmt.Sprintf(\"%x\", run.trace.SHA256)})\n    65\t\t\t\truns = append(runs, run)\n    66\t\t\t}\n    67\t\t\tif mode == \"zero\" || mode == \"one\" {\n    68\t\t\t\tfor _, run := range runs[1:] {\n    69\t\t\t\t\tif !slices.Equal(run.trace.Bytes, runs[0].trace.Bytes) {\n    70\t\t\t\t\t\treturn fmt.Errorf(\"%s deterministic picks changed their trace\", mode)\n    71\t\t\t\t\t}\n    72\t\t\t\t}\n    73\t\t\t\tcontinue\n    74\t\t\t}\n    75\t\t\tif len(users) != 2 {\n    76\t\t\t\treturn fmt.Errorf(\"%s selected %d non-root goroutine identities, want the two user goroutines\", mode, len(users))\n    77\t\t\t}\n    78\t\t\tallowed := [][sha256.Size]byte{root}\n    79\t\t\tfor identity := range users {\n    80\t\t\t\tallowed = append(allowed, identity)\n    81\t\t\t}\n    82\t\t\tsets := map[[sha256.Size]byte]bool{}\n    83\t\t\tfor mask := 1; mask < 1<<len(allowed); mask++ {\n    84\t\t\t\tvar subset [][sha256.Size]byte\n    85\t\t\t\tfor index, identity := range allowed {\n    86\t\t\t\t\tif mask&(1<<index) != 0 {\n    87\t\t\t\t\t\tsubset = append(subset, identity)\n    88\t\t\t\t\t}\n    89\t\t\t\t}\n    90\t\t\t\tif len(subset) < 2 {\n    91\t\t\t\t\tcontinue\n    92\t\t\t\t}\n    93\t\t\t\tdigest, err := choice.AlternativeSetDigest(subset)\n    94\t\t\t\tif err != nil {\n    95\t\t\t\t\treturn err\n    96\t\t\t\t}\n    97\t\t\t\tsets[digest] = true\n    98\t\t\t}\n    99\t\t\tfor _, run := range runs {\n   100\t\t\t\tfor _, record := range run.trace.Records {\n   101\t\t\t\t\tif record.Kind == choice.KindRunnable && !sets[record.AlternativeSetDigest] {\n   102\t\t\t\t\t\treturn fmt.Errorf(\"%s decision %d offered an identity beyond main and the two user goroutines\", mode, record.Ordinal)\n   103\t\t\t\t\t}\n   104\t\t\t\t}\n   105\t\t\t}\n   106\t\t\tidentity, err := campaign.choiceIdentity(fixture)\n   107\t\t\tif err != nil {\n   108\t\t\t\treturn err\n   109\t\t\t}\n   110\t\t\tplan, err := choice.ProjectReplayPlan(runs[0].trace, identity)\n   111\t\t\tif err != nil {\n   112\t\t\t\treturn err\n   113\t\t\t}\n   114\t\t\treplaySeed := \"2\"\n   115\t\t\tif mode == \"busy\" {\n   116\t\t\t\treplaySeed = \"1\"\n   117\t\t\t}\n   118\t\t\treplayed, err := campaign.runChoiceMode(\"runtime-owned-\"+mode+\"-replay\", fixture, replaySeed, &plan, choice.ModeReplay, 0, mode)\n   119\t\t\tif err != nil {\n   120\t\t\t\treturn err\n   121\t\t\t}\n   122\t\t\tif replayed.transcript != runs[0].transcript || !slices.Equal(replayed.trace.Bytes, runs[0].trace.Bytes) {\n   123\t\t\t\treturn fmt.Errorf(\"%s replay changed its trace\", mode)\n   124\t\t\t}\n   125\t\t\tprefix, err := choice.BuildRankPrefix(plan, 0, (plan.Decisions[0].Selected+1)%plan.Decisions[0].Alternatives)\n   126\t\t\tif err != nil {\n   127\t\t\t\treturn err\n   128\t\t\t}\n   129\t\t\tif _, err := campaign.runChoiceMode(\"runtime-owned-\"+mode+\"-prefix\", fixture, \"1\", &prefix, choice.ModePrefix, 0, mode); err != nil {\n   130\t\t\t\treturn err\n   131\t\t\t}\n   132\t\t}\n   133\t\tdata, err := json.MarshalIndent(evidence, \"\", \"  \")\n   134\t\tif err != nil {\n   135\t\t\treturn err\n   136\t\t}\n   137\t\treturn os.WriteFile(filepath.Join(campaign.workspace, \"runtime-owned.json\"), append(data, '\\n'), 0o600)\n   138\t}\n","exit_code":0,"status":"completed"}}
