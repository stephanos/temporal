 error { return err.Err }\n    47\tfunc invalidPinInput(err error) error            { return &InvalidPinImpactInput{Err: err} }\n    48\t\n    49\tfunc (report PinImpact) Invalidated() bool {\n    50\t\tfor _, pin := range report.Pins {\n    51\t\t\tif pin.Status == \"invalidated\" || pin.Status == \"unknown\" {\n    52\t\t\t\treturn true\n    53\t\t\t}\n    54\t\t}\n    55\t\treturn false\n    56\t}\n    57\t\n    58\tfunc (report PinImpact) CanonicalJSON() ([]byte, error) { return canonicaljson.CanonicalJSON(report) }\n    59\t\n    60\ttype pinModule struct {\n    61\t\tversion, sum string\n    62\t\treplaced     bool\n    63\t}\n    64\ttype pinModules struct {\n    65\t\tfile    *modfile.File\n    66\t\tmodules map[string]pinModule\n    67\t\tdigest  string\n    68\t}\n    69\t\n    70\tfunc readPinModules(path string) (pinModules, error) {\n    71\t\tcontents, err := os.ReadFile(path)\n    72\t\tif err != nil {\n    73\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"cannot read input go.mod\"))\n    74\t\t}\n    75\t\tparsed, err := modfile.Parse(\"go.mod\", contents, nil)\n    76\t\tif err != nil {\n    77\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"invalid input go.mod\"))\n    78\t\t}\n    79\t\tsums, err := os.ReadFile(strings.TrimSuffix(path, filepath.Ext(path)) + \".sum\")\n    80\t\tif err != nil {\n    81\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"cannot read input go.sum\"))\n    82\t\t}\n    83\t\tknownSums := make(map[string]string)\n    84\t\tfor _, line := range strings.Split(string(sums), \"\\n\") {\n    85\t\t\tfields := strings.Fields(line)\n    86\t\t\tif len(fields) == 0 {\n    87\t\t\t\tcontinue\n    88\t\t\t}\n    89\t\t\tif len(fields) != 3 {\n    90\t\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"invalid input go.sum\"))\n    91\t\t\t}\n    92\t\t\tkey := fields[0] + \"@\" + fields[1]\n    93\t\t\tif _, exists := knownSums[key]; exists {\n    94\t\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"duplicate input go.sum identity\"))\n    95\t\t\t}\n    96\t\t\tknownSums[key] = fields[2]\n    97\t\t}\n    98\t\tresult := pinModules{file: parsed, modules: make(map[string]pinModule), digest: fmt.Sprintf(\"sha256:%x\", sha256.Sum256(append(append(append([]byte{}, contents...), 0), sums...)))}\n    99\t\tfor _, req := range parsed.Require {\n   100\t\t\tif _, found := result.modules[req.Mod.Path]; found {\n   101\t\t\t\treturn pinModules{}, invalidPinInput(errors.New(\"duplicate module requirement\"))\n   102\t\t\t}\n   103\t\t\tmodule := pinModule{version: req.Mod.Version, sum: knownSums[req.Mod.Path+\"@\"+req.Mod.Version]}\n   104\t\t\tfor _, replacement := range parsed.Replace {\n   105\t\t\t\tif replacement.Old.Path == req.Mod.Path {\n   106\t\t\t\t\tmodule.replaced = true\n   107\t\t\t\t}\n   108\t\t\t}\n   109\t\t\tresult.modules[req.Mod.Path] = module\n   110\t\t}\n   111\t\treturn result, nil\n   112\t}\n   113\t\n   114\tfunc modulePinStatus(module, version, sum string, candidate, baseline pinModules) (string, string) {\n   115\t\tactual, present := candidate.modules[module]\n   116\t\tif !present {\n   117\t\t\tif _, existed := baseline.modules[module]; existed {\n   118\t\t\t\treturn \"invalidated\", \"module_removed\"\n   119\t\t\t}\n   120\t\t\treturn \"not_selected\", \"module_absent\"\n   121\t\t}\n   122\t\tif actual.replaced {\n   123\t\t\treturn \"invalidated\", \"module_replaced\"\n   124\t\t}\n   125\t\tif actual.version != version {\n   126\t\t\treturn \"invalidated\", \"version_changed\"\n   127\t\t}\n   128\t\tif actual.sum == \"\" {\n   129\t\t\treturn \"unknown\", \"module_sum_missing\"\n   130\t\t}\n   131\t\tif actual.sum != sum {\n   132\t\t\treturn \"invalidated\", \"sum_changed\"\n   133\t\t}\n   134\t\treturn \"unaffected\", \"exact_module_identity\"\n   135\t}\n   136\t\n   137\tfunc ReadPinImpact(root, candidatePath, baselinePath string) (PinImpact, error) {\n   138\t\tcandidate, err := readPinModules(candidatePath)\n   139\t\tif err != nil {\n   140\t\t\treturn PinImpact{}, err\n   141\t\t}\n   142\t\tbaseline, err := readPinModules(baselinePath)\n   143\t\tif err != nil {\n   144\t\t\treturn PinImpact{}, err\n   145\t\t}\n   146\t\tif candidate.file.Go == nil || baseline.file.Go == nil || candidate.file.Go.Version != baseline.file.Go.Version {\n   147\t\t\treturn PinImpact{}, invalidPinInput(errors.New(\"Go directive changes require the upgrade dossier\"))\n   148\t\t}\n   149\t\tcandidateToolchain, baselineToolchain := \"\", \"\"\n   150\t\tif candidate.file.Toolchain != nil {\n   151\t\t\tcandidateToolchain = candidate.file.Toolchain.Name\n   152\t\t}\n   153\t\tif baseline.file.Toolchain != nil {\n   154\t\t\tbaselineToolchain = baseline.file.Toolchain.Name\n   155\t\t}\n   156\t\tif candidateToolchain != baselineToolchain {\n   157\t\t\treturn PinImpact{}, invalidPinInput(errors.New(\"toolchain directive changes require the upgrade dossier\"))\n   158\t\t}\n   159\t\treport := PinImpact{Schema: \"gomad3.pin-impact/v1\", CandidateSHA256: candidate.digest, BaselineSHA256: baseline.digest, Pins: []PinResult{}}\n   160\t\tfor _, identity := range deterministicio.Default().Adapters() {\n   161\t\t\tstatus, reason := modulePinStatus(identity.Module, identity.Version, identity.Sum, candidate, baseline)\n   162\t\t\treport.Pins = append(report.Pins, PinResult{Class: \"adapter\", ID: identity.Module, Module: identity.Module, Version: identity.Version, Sum: identity.Sum, Platforms: gomadversion.SupportedPlatforms[:], Status: status, Reason: reason})\n   163\t\t}\n   164\t\tpacks, err := compatibility.PinEvidence()\n   165\t\tif err != nil {\n   166\t\t\treturn PinImpact{}, errors.New(\"cannot load compatibility pack pins\")\n   167\t\t}\n   168\t\tfor _, pack := range packs {\n   169\t\t\trelevant := activationVersionsMatch(pack.Activation, candidate) || activationVersionsMatch(pack.Activation, baseline)\n   170\t\t\tactivationStatus, activationReason := \"unaffected\", \"exact_module_identity\"\n   171\t\t\tif relevant {\n   172\t\t\t\tfor _, module := range pack.Activation {\n   173\t\t\t\t\tstatus, reason := modulePinStatus(module.Path, module.Version, module.Sum, candidate, baseline)\n   174\t\t\t\t\tif status == \"invalidated\" || status == \"unknown\" {\n   175\t\t\t\t\t\tactivationStatus, activationReason = status, reason\n   176\t\t\t\t\t\tbreak\n   177\t\t\t\t\t}\n   178\t\t\t\t}\n   179\t\t\t}\n   180\t\t\tfor _, rule := range pack.Rules {\n   181\t\t\t\tstatus, reason := \"not_selected\", \"pack_variant_unselected\"\n   182\t\t\t\tif relevant && (moduleVersionMatches(rule.Module, candidate) || moduleVersionMatches(rule.Module, baseline)) {\n   183\t\t\t\t\tstatus, reason = modulePinStatus(rule.Module.Path, rule.Module.Version, rule.Module.Sum, candidate, baseline)\n   184\t\t\t\t\tif activationStatus != \"unaffected\" {\n   185\t\t\t\t\t\tstatus, reason = activationStatus, \"activation_\"+activationReason\n   186\t\t\t\t\t}\n   187\t\t\t\t}\n   188\t\t\t\treport.Pins = append(report.Pins, PinResult{Class: \"pack_rule\", ID: pack.ID + \":\" + rule.ImportPath, Module: rule.Module.Path, Version: rule.Module.Version, Sum: rule.Module.Sum, Platforms: pack.Governance.Platforms, SourceSetSHA256: rule.SourceSetSHA256, Status: status, Reason: reason})\n   189\t\t\t}\n   190\t\t}\n   191\t\truntimePins, err := readRuntimePins(root)\n   192\t\tif err != nil {\n   193\t\t\treturn PinImpact{}, err\n   194\t\t}\n   195\t\treport.Pins = append(report.Pins, runtimePins...)\n   196\t\tsort.Slice(report.Pins, func(i, j int) bool {\n   197\t\t\tif report.Pins[i].Class != report.Pins[j].Class {\n   198\t\t\t\treturn report.Pins[i].Class < report.Pins[j].Class\n   199\t\t\t}\n   200\t\t\treturn report.Pins[i].ID < report.Pins[j].ID\n   201\t\t})\n   202\t\treturn report, nil\n   203\t}\n   204\t\n   205\tfunc activationVersionsMatch(activation []compatibility.ModuleEvidence, modules pinModules) bool {\n   206\t\tfor _, module := range activation {\n   207\t\t\tif !moduleVersionMatches(module, modules) {\n   208\t\t\t\treturn false\n   209\t\t\t}\n   210\t\t}\n   211\t\treturn true\n   212\t}\n   213\t\n   214\tfunc moduleVersionMatches(module compatibility.ModuleEvidence, modules pinModules) bool {\n   215\t\tactual, found := modules.modules[module.Path]\n   216\t\treturn found && actual.version == module.Version\n   217\t}\n   218\t\n   219\tfunc readRuntimePins(root string) ([]PinResult, error) {\n   220\t\tcontents, err := os.ReadFile(filepath.Join(root, \"deterministicio/boundary/manifest.json\"))\n   221\t\tif err != nil {\n   222\t\t\treturn nil, errors.New(\"cannot read interception manifest\")\n   223\t\t}\n   224\t\tvar manifest struct {\n   225\t\t\tGoVersion  string `json:\"go_version\"`\n   226\t\t\tIntercepts []struct {\n   227\t\t\t\tPackage           string            `json:\"package\"`\n   228\t\t\t\tSymbol            string            `json:\"symbol\"`\n   229\t\t\t\tReceiver          *boundaryReceiver `json:\"receiver\"`\n   230\t\t\t\tDeclaration       string            `json:\"declaration_sha256\"`\n   231\t\t\t\tPlatformOverrides map[string]struct {\n   232\t\t\t\t\tDeclaration string `json:\"declaration_sha256\"`\n   233\t\t\t\t} `json:\"platform_overrides\"`\n   234\t\t\t} `json:\"intercepts\"`\n   235\t\t}\n   236\t\tif err := json.Unmarshal(contents, &manifest); err != nil || manifest.GoVersion != gomadversion.GoVersion || len(manifest.Intercepts) == 0 {\n   237\t\t\treturn nil, errors.New(\"invalid interception manifest\")\n   238\t\t}\n   239\t\tpins := make([]PinResult, 0, len(manifest.Intercepts))\n   240\t\tfor _, intercept := range manifest.Intercepts {\n   241\t\t\tsymbol := intercept.Symbol\n   242\t\t\tif intercept.Receiver != nil {\n   243\t\t\t\tsymbol = intercept.Receiver.Name + \".\" + symbol\n   244\t\t\t}\n   245\t\t\tpins = append(pins, PinResult{Class: \"interception_fingerprint\", ID: intercept.Package + \".\" + symbol, Version: manifest.GoVersion, SourceSetSHA256: intercept.Declaration, Platforms: gomadversion.SupportedPlatforms[:], Status: \"unaffected\", Reason: \"runtime_pin_dependency_bump_only\"})\n   246\t\t\tfor platform, override := range intercept.PlatformOverrides {\n   247\t\t\t\tpins = append(pins, PinResult{Class: \"interception_fingerprint\", ID: intercept.Package + \".\" + symbol + \"@\" + platform, Version: manifest.GoVersion, SourceSetSHA256: override.Declaration, Platforms: []string{platform}, Status: \"unaffected\", Reason: \"runtime_pin_dependency_bump_only\"})\n   248\t\t\t}\n   249\t\t}\n   250\t\tfile, err := parser.ParseFile(token.NewFileSet(), filepath.Join(root, \"toolchain/clock_inventory_test.go\"), nil, 0)\n   251\t\tif err != nil {\n   252\t\t\treturn nil, errors.New(\"cannot read clock inventory\")\n   253\t\t}\n   254\t\tfound := false\n   255\t\tfor _, decl := range file.Decls {\n   256\t\t\tgen, ok := decl.(*ast.GenDecl)\n   257\t\t\tif !ok {\n   258\t\t\t\tcontinue\n   259\t\t\t}\n   260\t\t\tfor _, spec := range gen.Specs {\n   261\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n   262\t\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != \"reviewedHostClockReferences\" || len(value.Values) != 1 {\n   263\t\t\t\t\tcontinue\n   264\t\t\t\t}\n   265\t\t\t\tinventory, ok := value.Values[0].(*ast.CompositeLit)\n   266\t\t\t\tif !ok {\n   267\t\t\t\t\treturn nil, errors.New(\"unknown clock inventory shape\")\n   268\t\t\t\t}\n   269\t\t\t\tfound = true\n   270\t\t\t\tfor _, entry := range inventory.Elts {\n   271\t\t\t\t\tliteral, ok := entry.(*ast.CompositeLit)\n   272\t\t\t\t\tif !ok || len(literal.Elts) != 6 {\n   273\t\t\t\t\t\treturn nil, errors.New(\"unknown clock reference shape\")\n   274\t\t\t\t\t}\n   275\t\t\t\t\tfields := make([]string, 3)\n   276\t\t\t\t\tfor index := 0; index < 3; index++ {\n   277\t\t\t\t\t\ttoken, ok := literal.Elts[index].(*ast.BasicLit)\n   278\t\t\t\t\t\tif !ok {\n   279\t\t\t\t\t\t\treturn nil, errors.New(\"unknown clock identity\")\n   280\t\t\t\t\t\t}\n   281\t\t\t\t\t\tfields[index], err = strconv.Unquote(token.Value)\n   282\t\t\t\t\t\tif err != nil {\n   283\t\t\t\t\t\t\treturn nil, errors.New(\"invalid clock identity\")\n   284\t\t\t\t\t\t}\n   285\t\t\t\t\t}\n   286\t\t\t\t\tpins = append(pins, PinResult{Class: \"clock_inventory_reference\", ID: strings.Join(fields, \" \"), Version: gomadversion.GoVersion, Platforms: []string{fields[0]}, Status: \"unaffected\", Reason: \"runtime_pin_dependency_bump_only\"})\n   287\t\t\t\t}\n   288\t\t\t}\n   289\t\t}\n   290\t\tif !found {\n   291\t\t\treturn nil, errors.New(\"clock inventory missing\")\n   292\t\t}\n   293\t\treturn pins, nil\n   294\t}\n","exit_code":0,"status":"completed"}}
