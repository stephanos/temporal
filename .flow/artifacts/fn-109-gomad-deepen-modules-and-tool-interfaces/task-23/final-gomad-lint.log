				return err
			}
		}
	default:
		return fmt.Errorf("unexpected delimiter %q", delimiter)
	}
	token, err = decoder.Token()
	if err != nil || token != closing {
		return fmt.Errorf("invalid JSON close")
	}
	return nil
}
