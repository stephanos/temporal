		if err != nil {
			return &HostError{Reason: "simulation_exploration_commit", Err: err}
		}
		if err := explorationJournal.CommitRound(staged, segment); err != nil {
			return &HostError{Reason: "simulation_exploration_commit", Err: err}
		}
