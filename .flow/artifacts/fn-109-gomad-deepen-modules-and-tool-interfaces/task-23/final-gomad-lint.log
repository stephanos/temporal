		final.Signal = status.Signal().String()
	} else {
		final.Termination = TerminationExit
		final.ExitCode = status.ExitStatus()
	}
	if err := encoder.Encode(final); err != nil {
		return fmt.Errorf("report target result: %w", err)
	}
