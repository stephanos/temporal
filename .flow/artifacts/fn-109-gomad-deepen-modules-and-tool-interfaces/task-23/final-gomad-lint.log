		"git", "diff", "--no-ext-diff", "--binary", fmt.Sprintf("--unified=%d", contextLines), "--src-prefix=a/", "--dst-prefix=b/", "--",
	}, nil, maximumPatchBytes)
	if err != nil {
		return fmt.Errorf("generate gomad3 patch: %w", err)
	}
