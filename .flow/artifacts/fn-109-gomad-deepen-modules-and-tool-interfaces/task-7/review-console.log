ity)\n   245\t\t\t\tif prepareErr == nil && prepared.evidence.ReplacementRoot != prepared.replacement {\n   246\t\t\t\t\tprepareErr = errors.New(\"deterministic I/O adapter replacement root mismatch\")\n   247\t\t\t\t}\n   248\t\t\t} else {\n   249\t\t\t\tprepared, prepareErr = prepareCachedAdapter(definition, moduleCache, cacheRoot)\n   250\t\t\t}\n   251\t\t\tif prepareErr != nil {\n   252\t\t\t\treturn target.Spec{}, nil, prepareErr\n   253\t\t\t}\n   254\t\t\tmoduleFile = append(moduleFile, []byte(\"\\nreplace \"+definition.identity.Module+\" \"+definition.identity.Version+\" => \"+prepared.replacement+\"\\n\")...)\n   255\t\t\tevidence = append(evidence, prepared.evidence)\n   256\t\t}\n   257\t\tmodFilePath := filepath.Join(root, \"gomad.mod\")\n   258\t\tif err := writeExclusive(modFilePath, moduleFile); err != nil {\n   259\t\t\treturn target.Spec{}, nil, err\n   260\t\t}\n   261\t\tif err := writeExclusive(filepath.Join(root, \"gomad.sum\"), sumFile); err != nil {\n   262\t\t\treturn target.Spec{}, nil, err\n   263\t\t}\n   264\t\tfor index := range evidence {\n   265\t\t\tevidence[index].BuildModFile = modFilePath\n   266\t\t}\n   267\t\tspec.BuildModFile = modFilePath\n   268\t\treturn spec, evidence, nil\n   269\t}\n   270\t\n   271\t// PrepareTargetBuildAdapters prepares spec's build adapters from the module\n   272\t// cache of spec's pinned toolchain after downloading each selected adapter's\n   273\t// pinned module into it, so a clean module cache prepares the same adapters.\n   274\tfunc (profile Spec) PrepareTargetBuildAdapters(ctx context.Context, spec target.Spec) (target.Spec, []BuildAdapter, error) {\n   275\t\tdefinition, err := profile.validated()\n   276\t\tif err != nil {\n   277\t\t\treturn target.Spec{}, nil, err\n   278\t\t}\n   279\t\tworkingDirectory, err := target.ModuleDirectory(spec)\n   280\t\tif err != nil {\n   281\t\t\treturn target.Spec{}, nil, invalidBuildAdapterConfiguration(fmt.Errorf(\"resolve target module directory: %w\", err))\n   282\t\t}\n   283\t\tselected, _, err := definition.adapters.selected(workingDirectory)\n   284\t\tif err != nil {\n   285\t\t\treturn target.Spec{}, nil, err\n   286\t\t}\n   287\t\tif len(selected) == 0 {\n   288\t\t\treturn profile.PrepareBuildAdapters(spec, \"\")\n   289\t\t}\n   290\t\tif _, err := requireAdapterSums(workingDirectory, selected); err != nil {\n   291\t\t\treturn target.Spec{}, nil, err\n   292\t\t}\n   293\t\tfor _, adapter := range selected {\n   294\t\t\tidentity := target.ModuleIdentity{Path: adapter.identity.Module, Version: adapter.identity.Version, Sum: adapter.identity.Sum}\n   295\t\t\tif err := target.DownloadModule(ctx, spec.ToolchainRoot, identity); err != nil {\n   296\t\t\t\treturn target.Spec{}, nil, err\n   297\t\t\t}\n   298\t\t}\n   299\t\tmoduleCache, err := target.ReadModuleCache(ctx, spec.ToolchainRoot)\n   300\t\tif err != nil {\n   301\t\t\treturn target.Spec{}, nil, err\n   302\t\t}\n   303\t\treturn profile.PrepareBuildAdapters(spec, moduleCache)\n   304\t}\n   305\t\n   306\tfunc (profile Spec) PrepareBuildAdapters(spec target.Spec, moduleCache string) (target.Spec, []BuildAdapter, error) {\n   307\t\tdefinition, err := profile.validated()\n   308\t\tif err != nil {\n   309\t\t\treturn target.Spec{}, nil, err\n   310\t\t}\n   311\t\tif len(spec.AdapterReplacements) != 0 {\n   312\t\t\treturn target.Spec{}, nil, invalidBuildAdapterConfiguration(errors.New(\"target specification already contains adapter replacement evidence\"))\n   313\t\t}\n   314\t\tprepared, adapters, err := definition.adapters.prepare(spec, moduleCache)\n   315\t\tif err != nil {\n   316\t\t\treturn target.Spec{}, nil, err\n   317\t\t}\n   318\t\tprofileIdentity := profile.Identity()\n   319\t\tprepared.AdapterReplacements = make([]target.AdapterReplacement, len(adapters))\n   320\t\tfor index, adapter := range adapters {\n   321\t\t\tprepared.AdapterReplacements[index] = projectAdapterReplacement(profileIdentity, adapter)\n   322\t\t}\n   323\t\treturn prepared, adapters, nil\n   324\t}\n   325\t\n   326\tfunc projectAdapterReplacement(profileIdentity Contract, adapter BuildAdapter) target.AdapterReplacement {\n   327\t\treturn target.AdapterReplacement{\n   328\t\t\tOriginal:        target.ModuleIdentity{Path: adapter.Module, Version: adapter.Version, Sum: adapter.Sum},\n   329\t\t\tReplacementPath: adapter.ReplacementRoot,\n   330\t\t\tPreparedPackage: adapter.PreparedPackage,\n   250\tfunc (profile Spec) ImplementationSHA256() Digest {\n   251\t\tif profile.definition == nil {\n   252\t\t\treturn \"\"\n   253\t\t}\n   254\t\treturn profile.definition.implementationSHA256\n   255\t}\n   256\t\n   257\tfunc (profile Spec) TargetContract() TargetContract {\n   258\t\tif profile.definition == nil {\n   259\t\t\treturn TargetContract{}\n   260\t\t}\n   261\t\treturn profile.definition.target\n   262\t}\n   263\t\n   264\tfunc (profile Spec) validated() (*profileDefinition, error) {\n   265\t\tif profile.definition == nil || profile.definition != deterministicProfile.definition {\n   266\t\t\treturn nil, fmt.Errorf(\"invalid I/O profile specification\")\n   267\t\t}\n   268\t\tif host := profile.definition.target.GOOS + \"/\" + profile.definition.target.GOARCH; !slices.Contains(generatedBoundaryPlatforms, host) {\n   269\t\t\treturn nil, fmt.Errorf(\"deterministic I/O requires one of %s; host is %s\", strings.Join(generatedBoundaryPlatforms, \", \"), host)\n   270\t\t}\n   271\t\treturn profile.definition, nil\n   272\t}\n   273\t\n   274\t// BoundaryPlatforms lists the GOOS/GOARCH pairs the boundary manifest qualifies.\n   275\tfunc BoundaryPlatforms() []string {\n   276\t\treturn append([]string(nil), generatedBoundaryPlatforms...)\n   277\t}\n   278\t\n   279\tfunc (profile Spec) ValidatePreparedTarget(spec target.Spec, prepared target.Prepared, environment []string) error {\n   280\t\tdefinition, err := profile.validated()\n   281\t\tif err != nil {\n   282\t\t\treturn err\n   283\t\t}\n   284\t\tif spec.Kind != prepared.Kind || spec.Source != prepared.Source {\n   285\t\t\treturn fmt.Errorf(\"deterministic I/O target identity does not match its build specification\")\n   286\t\t}\n   287\t\tif len(prepared.Argv) == 0 || prepared.Argv[0] != \"gomad3-target\" || !equalStrings(spec.Args, prepared.Argv[1:]) {\n   288\t\t\treturn fmt.Errorf(\"deterministic I/O target arguments do not match their build specification\")\n   289\t\t}\n   290\t\tif prepared.GoVersion != definition.target.GoVersion || prepared.TargetGOOS != definition.target.GOOS || prepared.TargetGOARCH != definition.target.GOARCH {\n   291\t\t\treturn fmt.Errorf(\"deterministic I/O requires Go %s on %s/%s; target was built with %s for %s/%s\", definition.target.GoVersion, definition.target.GOOS, definition.target.GOARCH, prepared.GoVersion, prepared.TargetGOOS, prepared.TargetGOARCH)\n   292\t\t}\n   293\t\tadapters := make([]Adapter, len(prepared.Adapters))\n   294\t\tfor index, adapter := range prepared.Adapters {\n   295\t\t\tadapters[index] = Adapter{Module: adapter.Module, Version: adapter.Version, Sum: adapter.Sum}\n   296\t\t}\n   297\t\tif err := profile.VerifyAdapters(adapters); err != nil {\n   298\t\t\treturn fmt.Errorf(\"deterministic I/O target adapters: %w\", err)\n   299\t\t}\n   300\t\treturn nil\n   301\t}\n   302\t\n   303\tfunc digest(value []byte) Digest {\n   304\t\tdigest := sha256.Sum256(value)\n   305\t\treturn Digest(\"sha256:\" + hex.EncodeToString(digest[:]))\n   306\t}\n   307\t\n   308\tfunc equalStrings(left, right []string) bool {\n   309\t\tif len(left) != len(right) {\n   310\t\t\treturn false\n   311\t\t}\n   312\t\tfor index := range left {\n   313\t\t\tif left[index] != right[index] {\n   314\t\t\t\treturn false\n   315\t\t\t}\n   316\t\t}\n   317\t\treturn true\n   318\t}\ntools/gomad3/runner/portable_plan.go:113:\tmounts, err := readonlymount.ParseMappings(config.IOROMounts, config.Target.WorkingDir)\ntools/gomad3/runner/portable_plan.go:122:\tconfig.Target.PreparationRoot = bundle\ntools/gomad3/runner/portable_plan.go:124:\t\tTarget: config.Target, Environment: config.Environment, Preparer: config.Preparer,\ntools/gomad3/runner/runner.go:432:\t\treadOnlyMounts, err = readonlymount.ParseMappings(config.IOROMounts, config.Target.WorkingDir)\ntools/gomad3/runner/runner.go:539:\tselectedProfile := deterministicio.Default()\ntools/gomad3/runner/runner.go:544:\t\tconfig.Target.PreparationRoot = journal.PreparedPath()\ntools/gomad3/runner/runner.go:546:\t\t\tTarget: config.Target, Environment: config.Environment, Preparer: config.Preparer,\ntools/gomad3/runner/runner.go:549:\t\t\tif preparation.StageOf(err) == preparation.StageTarget {\ntools/gomad3/runner/runner.go:625:\t\terr := runChoiceExplorationLocal(overallCtx, config, selection, baseEnvironment, readOnlyMounts, prepared, selectedProfile, journal, runID, resuming, resumedRuns, &summary, reportProgress)\ntools/gomad3/runner/runner.go:632:\t\terr := runSimulationExplorationLocal(overallCtx, config, selection, baseEnvironment, readOnlyMounts, prepared, selectedProfile, journal, runID, resuming, resumedRuns, &summary, reportProgress)\ntools/gomad3/runner/runner.go:746:\t\tgo runSeed(activeCtx, config, executor, prepared, baseEnvironment, selectedProfile, readOnlyMounts, journal, job, readiness, rawCompletions)\ntools/gomad3/runner/runner.go:1352:\t\tif config.Target.WorkingDir == \"\" {\ntools/gomad3/runner/runner.go:1355:\t\tif _, err := readonlymount.ParseMappings(config.IOROMounts, config.Target.WorkingDir); err != nil {\ntools/gomad3/runner/campaign_shard_execution.go:158:\tif err := os.MkdirAll(spec.PreparationRoot, 0o700); err != nil {\ntools/gomad3/runner/campaign_shard_execution.go:161:\tif err := os.Chmod(spec.PreparationRoot, 0o700); err != nil {\ntools/gomad3/runner/campaign_shard_execution.go:172:\tdestination := filepath.Join(spec.PreparationRoot, campaignPlanTargetFile)\n","exit_code":0,"status":"completed"}}
