ror{Reason: \"partial_cleanup\", Err: err}\n   599\t\t\t}\n   600\t\t}\n   601\t\tif resuming && config.Guide && config.PlanSHA256 == \"\" {\n   602\t\t\tguidance, err = openGuidance(overallCtx, config, prepared, baseEnvironment, runID)\n   603\t\t\tif err != nil {\n   604\t\t\t\treturn summary, &HostError{Reason: \"guided_corpus\", Err: err}\n   605\t\t\t}\n   606\t\t\tsnapshot := guidance.Snapshot()\n   607\t\t\tsummary.CorpusPath = guidance.corpus.Path()\n   608\t\t\tsummary.CorpusEntries = uint64(len(snapshot.Entries))\n   609\t\t}\n   610\t\texecutor := config.executor\n   611\t\tif executor == nil {\n   612\t\t\texecutor = processExecutor{}\n   613\t\t}\n   614\t\n   615\t\tif !resuming {\n   616\t\t\terr = journal.StartExecutions()\n   617\t\t}\n   618\t\tif err != nil {\n   619\t\t\treturn summary, &HostError{Reason: \"runs_create\", Err: err}\n   620\t\t}\n   621\t\tif err := reportProgress(ProgressRunning, 0); err != nil {\n   622\t\t\treturn summary, &HostError{Reason: \"progress_output\", Err: err}\n   623\t\t}\n   624\t\tif config.strategy() == StrategyChoiceExploration {\n   625\t\t\terr := runChoiceExplorationLocal(overallCtx, config, selection, baseEnvironment, readOnlyMounts, prepared, selectedProfile, journal, runID, resuming, resumedRuns, &summary, reportProgress)\n   626\t\t\tif err == nil {\n   627\t\t\t\tbatchComplete = true\n   628\t\t\t}\n   629\t\t\treturn summary, err\n   630\t\t}\n   631\t\tif config.strategy() == StrategySimulationExploration {\n   632\t\t\terr := runSimulationExplorationLocal(overallCtx, config, selection, baseEnvironment, readOnlyMounts, prepared, selectedProfile, journal, runID, resuming, resumedRuns, &summary, reportProgress)\n   633\t\t\tif err == nil {\n   634\t\t\t\tbatchComplete = true\n   635\t\t\t}\n    65\t}\n    66\t\n    67\tfunc CreateCampaignPlan(ctx context.Context, spec CampaignPlanSpec) (_ CampaignPlanResult, retErr error) {\n    68\t\treturn createCampaignPlanWith(ctx, spec, executionDependencies{})\n    69\t}\n    70\t\n    71\tfunc createCampaignPlanWith(ctx context.Context, spec CampaignPlanSpec, dependencies executionDependencies) (_ CampaignPlanResult, retErr error) {\n    72\t\tif ctx == nil {\n    73\t\t\tctx = context.Background()\n    74\t\t}\n    75\t\tconfig := campaignRequestFromSpecWith(spec.Campaign, dependencies)\n    76\t\tselection, environment, err := validateCampaignRequest(config)\n    77\t\tif err != nil {\n    78\t\t\treturn CampaignPlanResult{}, err\n    79\t\t}\n    80\t\tif config.strategy() != StrategySeed || config.OnFailure != PolicyAll {\n    81\t\t\treturn CampaignPlanResult{}, errors.New(\"portable campaign plans require a seed campaign with on-failure=all\")\n    82\t\t}\n    83\t\tif config.Shard.Count != 0 || config.PlanSHA256 != \"\" || config.ResumeCampaign != \"\" {\n    84\t\t\treturn CampaignPlanResult{}, errors.New(\"portable campaign plan input cannot already be a shard or resume\")\n    85\t\t}\n    86\t\toutput, err := filepath.Abs(spec.Output)\n    87\t\tif err != nil || spec.Output == \"\" {\n    88\t\t\treturn CampaignPlanResult{}, errors.Join(errors.New(\"resolve campaign plan output\"), err)\n    89\t\t}\n    90\t\tbundle := output + campaignPlanBundleSuffix\n    91\t\tfor _, path := range []string{output, bundle} {\n    92\t\t\tif _, err := os.Lstat(path); err == nil {\n    93\t\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"campaign plan output already exists: %s\", path)\n    94\t\t\t} else if !errors.Is(err, os.ErrNotExist) {\n    95\t\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"inspect campaign plan output: %w\", err)\n    96\t\t\t}\n    97\t\t}\n    98\t\tif err := os.MkdirAll(filepath.Dir(output), 0o700); err != nil {\n    99\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"create campaign plan parent: %w\", err)\n   100\t\t}\n   101\t\tif err := os.Mkdir(bundle, 0o700); err != nil {\n   102\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"create campaign plan bundle: %w\", err)\n   103\t\t}\n   104\t\tpublished := false\n   105\t\tdefer func() {\n   106\t\t\tif !published {\n   107\t\t\t\tretErr = errors.Join(retErr, os.RemoveAll(bundle))\n   108\t\t\t}\n   109\t\t}()\n   110\t\tif config.IOROMountLimits == (readonlymount.Limits{}) {\n   111\t\t\tconfig.IOROMountLimits = readonlymount.DefaultLimits()\n   112\t\t}\n   113\t\tmounts, err := readonlymount.ParseMappings(config.IOROMounts, config.Target.WorkingDir)\n   114\t\tif err != nil {\n   115\t\t\treturn CampaignPlanResult{}, err\n   116\t\t}\n   117\t\tmounts, portableMounts := canonicalCampaignPlanMounts(mounts)\n   118\t\tmountIdentity, capturedMounts, err := captureCampaignPlanMounts(mounts, config.IOROMountLimits)\n   119\t\tif err != nil {\n   120\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"capture campaign plan mount identity: %w\", err)\n   121\t\t}\n   122\t\tconfig.Target.PreparationRoot = bundle\n   123\t\tprepared, err := preparation.Prepare(ctx, preparation.Request{\n   124\t\t\tTarget: config.Target, Environment: config.Environment, Preparer: config.Preparer,\n   125\t\t})\n   126\t\tif err != nil {\n   127\t\t\treturn CampaignPlanResult{}, err\n   128\t\t}\n   129\t\ttargetPath := filepath.Join(bundle, campaignPlanTargetFile)\n   130\t\tif filepath.Clean(prepared.Path) != targetPath {\n   131\t\t\tpreparationDirectory := filepath.Dir(prepared.Path)\n   132\t\t\trelative, relativeErr := filepath.Rel(bundle, preparationDirectory)\n   133\t\t\tif relativeErr != nil || relative == \".\" || relative == \"..\" || filepath.IsAbs(relative) || len(relative) >= 3 && relative[:3] == \"..\"+string(filepath.Separator) {\n   134\t\t\t\treturn CampaignPlanResult{}, errors.Join(errors.New(\"prepared campaign target is outside its private preparation directory\"), relativeErr)\n   135\t\t\t}\n   136\t\t\tif err := os.Rename(prepared.Path, targetPath); err != nil {\n   137\t\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"publish prepared campaign target: %w\", err)\n   138\t\t\t}\n   139\t\t\tif err := os.RemoveAll(preparationDirectory); err != nil {\n   140\t\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"remove campaign target preparation files: %w\", err)\n   141\t\t\t}\n   142\t\t}\n   143\t\tif err := os.Chmod(targetPath, 0o500); err != nil {\n   144\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"make campaign target immutable: %w\", err)\n   145\t\t}\n   146\t\tprepared.Path = targetPath\n   147\t\tif err := prepared.Verify(); err != nil {\n   148\t\t\treturn CampaignPlanResult{}, err\n   149\t\t}\n   150\t\tif err := materializeCampaignPlanMounts(bundle, capturedMounts); err != nil {\n   151\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"materialize campaign plan mounts: %w\", err)\n   152\t\t}\n   153\t\tif config.Guide {\n   154\t\t\tconfig.Corpus, err = guidedCorpusPath(config.Corpus)\n   155\t\t\tif err != nil {\n   156\t\t\t\treturn CampaignPlanResult{}, err\n   157\t\t\t}\n   158\t\t\tguidance, err := openGuidance(ctx, config, prepared, environment, \"plan\")\n   159\t\t\tif err != nil {\n   160\t\t\t\treturn CampaignPlanResult{}, err\n   161\t\t\t}\n   162\t\t\tsnapshot := guidance.Snapshot()\n   163\t\t\tselection, config.guidancePlan, err = selectGuidedSeeds(selection, snapshot, config.Corpus, config.GuideRegression)\n   164\t\t\terr = errors.Join(err, guidance.Close())\n   165\t\t\tif err != nil {\n   166\t\t\t\treturn CampaignPlanResult{}, err\n   167\t\t\t}\n   168\t\t\tconfig.Seeds = selection.String()\n   169\t\t\tconfig.GuideSnapshotSHA256 = snapshot.SnapshotSHA256\n   170\t\t}\n   171\t\tjournalPlan, err := campaign.DeriveExecutionJournalPlan(string(StrategySeed), selection.Count(), 0, uint64(config.Parallel))\n   172\t\tif err != nil {\n   173\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"derive campaign journal capacity: %w\", err)\n   174\t\t}\n   175\t\tplan, err := campaignPlanRecord(config, journalPlan, \".prepared/target\", prepared, environment, portableMounts, selection.Count())\n   176\t\tif err != nil {\n   177\t\t\treturn CampaignPlanResult{}, err\n   178\t\t}\n   179\t\tif err := campaign.ValidateCampaignPlan(plan); err != nil {\n   180\t\t\treturn CampaignPlanResult{}, err\n   181\t\t}\n   182\t\tdocument := portableCampaignPlan{Schema: campaignPlanSchema, Mapping: campaignPlanMapping, Mounts: mountIdentity, Campaign: plan}\n   183\t\tencoded, err := canonicaljson.CanonicalJSON(document)\n   184\t\tif err != nil {\n   185\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"encode campaign plan: %w\", err)\n   186\t\t}\n   187\t\tif len(encoded) > maximumCampaignPlanBytes {\n   188\t\t\treturn CampaignPlanResult{}, fmt.Errorf(\"campaign plan exceeds its %d-byte capacity\", maximumCampaignPlanBytes)\n   189\t\t}\n   190\t\tif err := syncRegularFile(targetPath); err != nil {\n   191\t\t\treturn CampaignPlanResult{}, err\n   192\t\t}\n   193\t\tif err := syncDirectory(bundle); err != nil {\n   194\t\t\treturn CampaignPlanResult{}, err\n   195\t\t}\n   196\t\tif err := publishPlanFile(output, encoded); err != nil {\n   197\t\t\treturn CampaignPlanResult{}, err\n   198\t\t}\n   199\t\tpublished = true\n   200\t\treturn CampaignPlanResult{\n   201\t\t\tPath: output, BundlePath: bundle, SHA256: record.HashBytes(encoded), SelectionCount: selection.Count(), TargetSHA256: record.SHA256(prepared.SHA256),\n   202\t\t}, nil\n   203\t}\n   204\t\n   205\tfunc openCampaignPlan(path string) (_ openedCampaignPlan, retErr error) {\n","exit_code":0,"status":"completed"}}
