--- darwin/arm64/baseline/qualification/soak
+++ darwin/arm64/current/qualification/soak
@@ -0,0 +1,279 @@
+package soak // import "go.temporal.io/server/tools/gomad3/qualification/soak"
+
+Package soak runs the scheduled determinism soak: N fresh same-seed repetitions
+per seed of a named workload selection, in gomad qualify batches of at most 32,
+under bounded unrelated CPU load, with choice tracing and the diagnostic trace
+on.
+
+A qualify batch compares its repetitions only with its own first execution, so
+the soak also compares each batch's evidence baseline with the baseline of its
+cohort (workload, seed, platform, execution identity), within one run and across
+the retained runs of a cumulative ledger. Any disagreement is a divergence;
+a trace overflow, a target failure, and an infrastructure failure are reported
+separately and none of them is a pass.
+
+CONSTANTS
+
+const (
+	OutcomeClean          = "clean"
+	OutcomeDivergence     = "divergence"
+	OutcomeOverflow       = "overflow"
+	OutcomeTargetFailure  = "target_failure"
+	OutcomeInfrastructure = "infrastructure"
+)
+    Batch outcomes. Only a clean batch is a pass; overflow, target failure,
+    and infrastructure failure are kept apart from divergence because none of
+    them can support or refute a determinism claim.
+
+const (
+	ComparisonEstablished = "baseline_established"
+	ComparisonMatches     = "matches_baseline"
+	ComparisonDiffers     = "differs_from_baseline"
+)
+    Cross-batch comparisons of a clean batch with its cohort baseline.
+
+const (
+	GateStrict        = "strict"
+	GateInformational = "informational"
+)
+    Gates. A strict gate fails on any divergence; an informational gate reports
+    divergences without failing because an open finding names the channel.
+
+const LedgerSchema = "gomad3.determinism-soak-ledger/v1"
+const ManifestSchema = "gomad3.determinism-soak/v1"
+const ReportSchema = "gomad3.determinism-soak-report/v1"
+
+FUNCTIONS
+
+func ExitStatus(report Report) int
+    ExitStatus maps a report to gomadtool soak's status: 0 for a pass or an
+    informational divergence, 1 for a divergence or target failure, and 3 when
+    an overflow or infrastructure failure left the soak unable to conclude.
+
+func Summary(report Report) string
+    Summary renders the report as the Markdown a workflow step summary shows.
+
+func ValidateManifest(manifest Manifest) error
+
+TYPES
+
+type Baseline struct {
+	EvidenceDigest record.SHA256 `json:"evidence_digest"`
+	Evidence       string        `json:"evidence"`
+	Trace          string        `json:"trace,omitempty"`
+	Run            string        `json:"run"`
+	Batch          uint64        `json:"batch"`
+}
+    Baseline is the evidence every later batch of the cohort is compared with.
+    Its files are relative to the ledger directory and travel with the ledger.
+
+type BatchReport struct {
+	Workload    string              `json:"workload"`
