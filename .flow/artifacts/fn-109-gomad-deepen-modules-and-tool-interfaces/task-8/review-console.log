ticio.Default().PrepareTargetBuildAdapters(ctx, spec)\n    45\t\tif err != nil {\n    46\t\t\treturn Inspection{}, &stageError{stage: StageAdapters, err: err}\n    47\t\t}\n    48\t\treview, err := target.ReviewCapabilities(ctx, preparedSpec)\n    49\t\tif err != nil {\n    50\t\t\treturn Inspection{}, &stageError{stage: StageReview, err: err}\n    51\t\t}\n    52\t\tkeep = true\n    53\t\treturn Inspection{\n    54\t\t\tSpec: preparedSpec, Review: review, BuildAdapters: adapters,\n    55\t\t\tAdapters: deterministicio.SelectedAdapters(adapters), root: root, remove: remove,\n    56\t\t}, nil\n    57\t}\n    58\t\n    59\tfunc (inspected *Inspection) Close() error {\n    60\t\tif inspected == nil || inspected.root == \"\" {\n    61\t\t\treturn nil\n    62\t\t}\n    63\t\troot := inspected.root\n    64\t\tinspected.root = \"\"\n    65\t\treturn removeInspectionRoot(root, inspected.remove)\n    66\t}\n    67\t\n    68\tfunc removeInspectionRoot(root string, remove func(string) error) error {\n    69\t\tif err := remove(root); err != nil {\n    70\t\t\treturn &stageError{stage: StageCleanup, err: fmt.Errorf(\"remove capability review preparation directory: %w\", err)}\n    71\t\t}\n    72\t\treturn nil\n    73\t}\n","exit_code":0,"status":"completed"}}
