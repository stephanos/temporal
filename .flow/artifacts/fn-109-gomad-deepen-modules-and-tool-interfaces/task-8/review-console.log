tion\n    41\t\ttarget         targetInput\n    42\t}\n    43\t\n    44\tfunc runAnalyze(arguments []string, stdout, stderr io.Writer) int {\n    45\t\treturn runAnalyzeWithApplication(arguments, stdout, stderr, newApplication())\n    46\t}\n    47\t\n    48\tfunc runAnalyzeWithApplication(arguments []string, stdout, stderr io.Writer, app *application) int {\n    49\t\treturn runAnalyzeWith(arguments, stdout, stderr, analyzeDependencies{\n    50\t\t\ttoolchain: func(explicit string) (string, error) {\n    51\t\t\t\troot, _, _, err := app.identity(explicit)\n    52\t\t\t\treturn root, err\n    53\t\t\t},\n    54\t\t\tidentity: target.ReadToolchainIdentity, workingDirectory: os.Getwd,\n    55\t\t\tinspect: preparation.Inspect, build: capabilityanalysis.Build,\n    56\t\t})\n    57\t}\n    58\t\n    59\tfunc runAnalyzeWith(arguments []string, stdout, stderr io.Writer, dependencies analyzeDependencies) (status int) {\n    60\t\tparsed, status := parseAnalyzeArguments(arguments, stderr)\n    61\t\tif status != 0 {\n    62\t\t\treturn status\n    63\t\t}\n    64\t\tspec, identity, status := resolveAnalyzeTarget(parsed, stderr, dependencies)\n    65\t\tif status != 0 {\n    66\t\t\treturn status\n    67\t\t}\n    68\t\tctx, cancel := context.WithTimeout(context.Background(), parsed.timeout)\n    69\t\tdefer cancel()\n    70\t\treturn executeAnalysis(ctx, stdout, stderr, parsed.format, spec, identity, dependencies)\n    71\t}\n    72\t\n    73\tfunc capabilityAnalysisTimeoutForMode(mode target.CapabilityMode) time.Duration {\n    74\t\tif mode == target.CapabilityModeLinked || mode == target.CapabilityModeGuarded {\n    75\t\t\treturn linkedCapabilityAnalysisTimeout\n    76\t\t}\n    77\t\treturn capabilityAnalysisTimeout\n    78\t}\n    79\t\n    80\tfunc resolveCapabilityAnalysisTimeout(mode target.CapabilityMode, requested time.Duration) (time.Duration, error) {\n    81\t\tif requested < 0 || requested > maximumCapabilityAnalysisTimeout {\n    82\t\t\treturn 0, fmt.Errorf(\"analysis timeout must be non-negative and no greater than %s\", maximumCapabilityAnalysisTimeout)\n    83\t\t}\n    84\t\tif requested == 0 {\n    85\t\t\treturn capabilityAnalysisTimeoutForMode(mode), nil\n    86\t\t}\n    87\t\treturn requested, nil\n    88\t}\n    89\t\n    90\tfunc parseAnalyzeArguments(arguments []string, stderr io.Writer) (analyzeArguments, int) {\n    91\t\tflags := flag.NewFlagSet(\"gomad analyze\", flag.ContinueOnError)\n    92\t\tflags.SetOutput(stderr)\n    93\t\tformat := flags.String(\"format\", \"text\", \"text or json\")\n    94\t\ttoolchainRoot := flags.String(\"toolchain-root\", \"\", \"absolute pinned toolchain root\")\n    95\t\tcapabilityMode := flags.String(\"capability-mode\", string(target.CapabilityModeClosure), \"closure, linked, or guarded capability assessment\")\n    96\t\ttimeout := flags.Duration(\"timeout\", 0, \"analysis wall-time bound\")\n    97\t\tvar buildTags stringList\n    98\t\tflags.Var(&buildTags, \"build-tag\", \"validated Go build tag\")\n    99\t\tworkingDir := flags.String(\"working-dir\", \"\", \"absolute target module root (default: the current directory)\")\n   100\t\tif err := flags.Parse(arguments); err != nil {\n   101\t\t\treturn analyzeArguments{}, 2\n   102\t\t}\n   103\t\tif *format != \"text\" && *format != \"json\" {\n   104\t\t\treturn analyzeArguments{}, writeCommandError(stderr, 2, \"invalid analysis format %q\\n\", *format)\n   105\t\t}\n   106\t\tmode, err := parseCapabilityMode(*capabilityMode)\n   107\t\tif err != nil {\n   108\t\t\treturn analyzeArguments{}, writeCommandError(stderr, 2, \"%v\\n\", err)\n   109\t\t}\n   110\t\tresolvedTimeout, err := resolveCapabilityAnalysisTimeout(mode, *timeout)\n   111\t\tif err != nil {\n   112\t\t\treturn analyzeArguments{}, writeCommandError(stderr, 2, \"%v\\n\", err)\n   113\t\t}\n   114\t\tparsed, err := parseTarget(flags.Args())\n   115\t\tif err != nil {\n   116\t\t\treturn analyzeArguments{}, writeCommandError(stderr, 2, \"%v\\n\", err)\n   117\t\t}\n   118\t\tif parsed.kind == target.KindExec {\n   119\t\t\treturn analyzeArguments{}, writeCommandError(stderr, 2, \"gomad analyze requires a go-run or go-test target\\n\")\n   120\t\t}\n   121\t\treturn analyzeArguments{format: *format, toolchainRoot: *toolchainRoot, workingDir: *workingDir, buildTags: buildTags, capabilityMode: mode, timeout: resolvedTimeout, target: parsed}, 0\n   122\t}\n   123\t\n   124\tfunc resolveAnalyzeTarget(parsed analyzeArguments, stderr io.Writer, dependencies analyzeDependencies) (target.Spec, target.ToolchainIdentity, int) {\n   125\t\tworkingDirectory, err := resolveWorkingDirectory(parsed.workingDir, dependencies.workingDirectory)\n   126\t\tif err != nil {\n   127\t\t\tvar invalid invalidWorkingDirectoryError\n   128\t\t\tif errors.As(err, &invalid) {\n   129\t\t\t\treturn target.Spec{}, target.ToolchainIdentity{}, writeCommandError(stderr, 2, \"%v\\n\", err)\n   130\t\t\t}\n   131\t\t\treturn target.Spec{}, target.ToolchainIdentity{}, writeCommandError(stderr, 3, \"resolve working directory: %v\\n\", err)\n   132\t\t}\n   133\t\tresolvedRoot, err := dependencies.toolchain(parsed.toolchainRoot)\n   134\t\tif err != nil {\n   135\t\t\treturn target.Spec{}, target.ToolchainIdentity{}, writeCommandError(stderr, 3, \"resolve Gomad toolchain: %v\\n\", err)\n   136\t\t}\n   137\t\tidentity, err := dependencies.identity(resolvedRoot)\n   138\t\tif err != nil {\n   139\t\t\treturn target.Spec{}, target.ToolchainIdentity{}, writeCommandError(stderr, 3, \"read Gomad toolchain identity: %v\\n\", err)\n   140\t\t}\n   141\t\tspec := target.Spec{Kind: parsed.target.kind, Source: parsed.target.source, Args: parsed.target.arguments, BuildTags: parsed.buildTags, WorkingDir: workingDirectory, ToolchainRoot: resolvedRoot, CapabilityMode: parsed.capabilityMode}\n   142\t\treturn spec, identity, 0\n   143\t}\n   144\t\n   145\tfunc executeAnalysis(ctx context.Context, stdout, stderr io.Writer, format string, spec target.Spec, identity target.ToolchainIdentity, dependencies analyzeDependencies) (status int) {\n   146\t\tadapters := []deterministicio.Adapter{}\n   147\t\tvar err error\n   148\t\tvar reviewed target.CapabilityReview\n   149\t\tif dependencies.inspect != nil {\n   150\t\t\tinspected, inspectErr := dependencies.inspect(ctx, spec)\n   151\t\t\tif inspectErr != nil {\n   152\t\t\t\tif preparation.StageOf(inspectErr) == preparation.StageReview {\n   153\t\t\t\t\treturn reportAnalyzeError(stderr, inspectErr)\n   154\t\t\t\t}\n   155\t\t\t\tif deterministicio.IsInvalidBuildAdapterConfiguration(inspectErr) {\n   156\t\t\t\t\treturn writeCommandError(stderr, 2, \"prepare capability analysis: %v\\n\", inspectErr)\n   157\t\t\t\t}\n   158\t\t\t\treturn writeCommandError(stderr, 3, \"prepare capability analysis: %v\\n\", inspectErr)\n   159\t\t\t}\n   160\t\t\tspec, reviewed, adapters = inspected.Spec, inspected.Review, inspected.Adapters\n   161\t\t\tdefer func() {\n   162\t\t\t\tif cleanupErr := inspected.Close(); cleanupErr != nil {\n   163\t\t\t\t\tif _, writeErr := fmt.Fprintf(stderr, \"clean capability analysis preparation: %v\\n\", cleanupErr); writeErr != nil || status == 0 {\n   164\t\t\t\t\t\tstatus = 3\n   165\t\t\t\t\t}\n   166\t\t\t\t}\n   167\t\t\t}()\n   168\t\t} else if dependencies.prepare != nil {\n   169\t\t\tvar cleanup func() error\n   170\t\t\tspec, adapters, cleanup, err = dependencies.prepare(ctx, spec)\n   171\t\t\tif err != nil {\n   172\t\t\t\tif deterministicio.IsInvalidBuildAdapterConfiguration(err) {\n   173\t\t\t\t\treturn writeCommandError(stderr, 2, \"prepare capability analysis: %v\\n\", err)\n   174\t\t\t\t}\n   175\t\t\t\treturn writeCommandError(stderr, 3, \"prepare capability analysis: %v\\n\", err)\n   176\t\t\t}\n   177\t\t\tif cleanup != nil {\n   178\t\t\t\tdefer func() {\n   179\t\t\t\t\tif cleanupErr := cleanup(); cleanupErr != nil {\n   180\t\t\t\t\t\tif _, writeErr := fmt.Fprintf(stderr, \"clean capability analysis preparation: %v\\n\", cleanupErr); writeErr != nil || status == 0 {\n   181\t\t\t\t\t\t\tstatus = 3\n   182\t\t\t\t\t\t}\n   183\t\t\t\t\t}\n   184\t\t\t\t}()\n   185\t\t\t}\n   186\t\t}\n   187\t\tvar report capabilityanalysis.Report\n   188\t\tif dependencies.inspect != nil {\n   189\t\t\treport, err = dependencies.build(capabilityanalysis.Input{Spec: spec, Review: reviewed, Toolchain: identity, IOProfile: deterministicio.Default(), Adapters: adapters})\n   190\t\t} else if dependencies.analyze != nil {\n   191\t\t\treport, err = dependencies.analyze(ctx, capabilityanalysis.Spec{\n   192\t\t\t\tTarget: spec, Toolchain: identity, IOProfile: deterministicio.Default(), Adapters: adapters,\n   193\t\t\t})\n   194\t\t} else {\n   195\t\t\tvar review target.CapabilityReview\n   196\t\t\treview, err = dependencies.review(ctx, spec)\n   197\t\t\tif err == nil {\n   198\t\t\t\treport, err = dependencies.build(capabilityanalysis.Input{Spec: spec, Review: review, Toolchain: identity, IOProfile: deterministicio.Default(), Adapters: adapters})\n   199\t\t\t}\n   200\t\t}\n   201\t\tif err != nil {\n   202\t\t\treturn reportAnalyzeError(stderr, err)\n   203\t\t}\n   204\t\treturn writeAnalysis(stdout, stderr, format, report)\n   205\t}\n   206\t\n   207\tfunc reportAnalyzeError(stderr io.Writer, err error) int {\n   208\t\tvar capacity *target.UnsupportedCapabilityCapacityError\n   209\t\tif errors.As(err, &capacity) {\n   210\t\t\treturn writeCommandError(stderr, 1, \"analyze target capabilities: %v\\n\", err)\n   211\t\t}\n   212\t\tif target.IsInvalidCapabilityReview(err) {\n   213\t\t\treturn writeCommandError(stderr, 2, \"analyze target capabilities: %v\\n\", err)\n   214\t\t}\n   215\t\treturn writeCommandError(stderr, 3, \"analyze target capabilities: %v\\n\", err)\n   216\t}\n   217\t\n   218\tfunc writeAnalysis(stdout, stderr io.Writer, format string, report capabilityanalysis.Report) int {\n   219\t\tif format == \"json\" {\n   220\t\t\tencoded, err := canonicaljson.CanonicalJSON(report)\n   221\t\t\tif err != nil {\n   222\t\t\t\treturn writeCommandError(stderr, 3, \"encode capability analysis: %v\\n\", err)\n   223\t\t\t}\n   224\t\t\tif _, err := fmt.Fprintf(stdout, \"%s\\n\", encoded); err != nil {\n   225\t\t\t\treturn writeCommandError(stderr, 3, \"write capability analysis: %v\\n\", err)\n   226\t\t\t}\n   227\t\t} else {\n   228\t\t\tif _, err := fmt.Fprint(stdout, capabilityanalysis.FormatText(report)); err != nil {\n   229\t\t\t\treturn writeCommandError(stderr, 3, \"write capability analysis: %v\\n\", err)\n   230\t\t\t}\n   231\t\t}\n   232\t\tif report.Classification == capabilityanalysis.ClassificationUnsupported {\n   233\t\t\treturn 1\n   234\t\t}\n   235\t\treturn 0\n   236\t}\n   237\t\n   238\tfunc writeCommandError(output io.Writer, status int, format string, arguments ...any) int {\n   239\t\tif _, err := fmt.Fprintf(output, format, arguments...); err != nil {\n   240\t\t\treturn 3\n   241\t\t}\n   242\t\treturn status\n   243\t}\n","exit_code":0,"status":"completed"}}
