al.io/server/tools/gomad3/target\"\n    15\t)\n    16\t\n    17\tconst (\n    18\t\tAnalysisSchema = \"gomad3.capability-analysis/v1\"\n    19\t)\n    20\t\n    21\tconst MaximumAnalysisReportBytes = 16 << 20\n    22\t\n    23\ttype Classification string\n    24\t\n    25\tconst (\n    26\t\tClassificationSupported   Classification = \"supported\"\n    27\t\tClassificationUnsupported Classification = \"unsupported\"\n    28\t)\n    29\t\n    30\ttype Input struct {\n    31\t\tSpec      target.Spec\n    32\t\tReview    target.CapabilityReview\n    33\t\tToolchain target.ToolchainIdentity\n    34\t\tIOProfile deterministicio.Spec\n    35\t\tAdapters  []deterministicio.Adapter\n    36\t}\n    37\t\n    38\ttype Spec struct {\n    39\t\tTarget    target.Spec\n    40\t\tToolchain target.ToolchainIdentity\n    41\t\tIOProfile deterministicio.Spec\n    42\t\tAdapters  []deterministicio.Adapter\n    43\t}\n    44\t\n    45\tfunc Analyze(ctx context.Context, spec Spec) (Report, error) {\n    46\t\treturn analyzeWith(ctx, spec, target.ReviewCapabilities)\n    47\t}\n    48\t\n    49\tfunc analyzeWith(ctx context.Context, spec Spec, reviewCapabilities func(context.Context, target.Spec) (target.CapabilityReview, error)) (Report, error) {\n    50\t\treview, err := reviewCapabilities(ctx, spec.Target)\n    51\t\tif err != nil {\n    52\t\t\treturn Report{}, err\n    53\t\t}\n    54\t\treturn Build(Input{\n    55\t\t\tSpec: spec.Target, Review: review, Toolchain: spec.Toolchain, IOProfile: spec.IOProfile, Adapters: spec.Adapters,\n    56\t\t})\n    57\t}\n    58\t\n    59\ttype Report struct {\n    60\t\tSchema             string                             `json:\"schema\"`\n    61\t\tClassification     Classification                     `json:\"classification\"`\n    62\t\tTarget             Target                             `json:\"target\"`\n    63\t\tToolchain          Toolchain                          `json:\"toolchain\"`\n    64\t\tClosure            Closure                            `json:\"closure\"`\n    65\t\tIOProfile          deterministicio.Contract           `json:\"io_profile\"`\n    66\t\tPacks              []target.CompatibilityPackEvidence `json:\"packs\"`\n    67\t\tRequirements       []deterministicio.Requirement      `json:\"requirements\"`\n    68\t\tBlockers           []Blocker                          `json:\"blockers\"`\n    69\t\tGuardedBlockers    []Blocker                          `json:\"guarded_blockers\"`\n    70\t\tEliminatedBlockers []Blocker                          `json:\"eliminated_blockers\"`\n    71\t}\n    72\t\n    73\ttype Target struct {\n    74\t\tKind               target.Kind                      `json:\"kind\"`\n    75\t\tSource             string                           `json:\"source\"`\n    76\t\tArguments          []string                         `json:\"arguments\"`\n    77\t\tBuildTags          []string                         `json:\"build_tags\"`\n    78\t\tCapabilityMode     target.CapabilityMode            `json:\"capability_mode,omitempty\"`\n    79\t\tCapabilityManifest *record.TargetCapabilityManifest `json:\"capability_manifest,omitempty\"`\n    80\t}\n    81\t\n    82\ttype Toolchain struct {\n    83\t\tGoVersion               string        `json:\"go_version\"`\n    84\t\tBuildKey                string        `json:\"build_key\"`\n    85\t\tTargetGOOS              string        `json:\"target_goos\"`\n    86\t\tTargetGOARCH            string        `json:\"target_goarch\"`\n    87\t\tBoundaryManifestVersion string        `json:\"boundary_manifest_version\"`\n    88\t\tBoundaryManifestSHA256  record.SHA256 `json:\"boundary_manifest_sha256\"`\n    89\t}\n    90\t\n    91\ttype Closure struct {\n    92\t\tSHA256       record.SHA256                       `json:\"sha256\"`\n    93\t\tPackageCount record.Uint64String                 `json:\"package_count\"`\n    94\t\tRoots        []target.CapabilityPackageReference `json:\"roots\"`\n    95\t}\n    96\t\n    97\ttype Blocker struct {\n    98\t\ttarget.CapabilityFinding\n    99\t\tDependencyPath []target.CapabilityPackageReference `json:\"dependency_path\"`\n   100\t}\n   101\t\n   102\tfunc Build(input Input) (Report, error) {\n   103\t\tif input.Spec.Kind != target.KindGoRun && input.Spec.Kind != target.KindGoTest {\n   104\t\t\treturn Report{}, errors.New(\"capability analysis requires a go-run or go-test target\")\n   105\t\t}\n   106\t\tif input.Review.Schema != target.CapabilityReviewSchema || input.Review.Closure.Schema != target.CapabilityClosureSchema || input.Review.Roots == nil || input.Review.Packs == nil || input.Review.Findings == nil || input.Review.GuardedFindings == nil || input.Review.EliminatedFindings == nil {\n   107\t\t\treturn Report{}, errors.New(\"capability analysis review evidence is incomplete\")\n   108\t\t}\n   109\t\tif len(input.Review.Roots) == 0 || len(input.Review.Closure.Packages) == 0 {\n   110\t\t\treturn Report{}, errors.New(\"capability analysis closure has no roots or packages\")\n   111\t\t}\n   112\t\tclosureBytes, err := canonicaljson.CanonicalJSON(input.Review.Closure)\n   113\t\tif err != nil {\n   114\t\t\treturn Report{}, fmt.Errorf(\"encode target capability closure: %w\", err)\n   115\t\t}\n   116\t\trequirements, err := input.IOProfile.Requirements(input.Review.Closure, input.Adapters)\n   117\t\tif err != nil {\n   118\t\t\treturn Report{}, fmt.Errorf(\"project deterministic I/O requirements: %w\", err)\n   119\t\t}\n   120\t\tpaths, err := shortestPaths(input.Review.Closure.Packages, input.Review.Roots)\n   121\t\tif err != nil {\n   122\t\t\treturn Report{}, err\n   123\t\t}\n   124\t\tblockers, err := projectAnalysisBlockers(input.Review.Findings, paths)\n   125\t\tif err != nil {\n   126\t\t\treturn Report{}, err\n   127\t\t}\n   128\t\tguarded, err := projectAnalysisBlockers(input.Review.GuardedFindings, paths)\n   129\t\tif err != nil {\n   130\t\t\treturn Report{}, err\n   131\t\t}\n   132\t\teliminated, err := projectAnalysisBlockers(input.Review.EliminatedFindings, paths)\n   133\t\tif err != nil {\n   134\t\t\treturn Report{}, err\n   135\t\t}\n   136\t\tmode := input.Review.CapabilityMode\n   137\t\tif mode == \"\" {\n   138\t\t\tmode = target.CapabilityModeClosure\n   139\t\t}\n   140\t\tspecMode := input.Spec.CapabilityMode\n   141\t\tif specMode == \"\" {\n   142\t\t\tspecMode = target.CapabilityModeClosure\n   143\t\t}\n   144\t\tif mode != specMode {\n   145\t\t\treturn Report{}, errors.New(\"capability analysis mode does not match the review\")\n   146\t\t}\n   147\t\tcapabilityTarget := record.Target{CapabilityMode: string(mode)}\n   148\t\tif input.Review.CapabilityManifest != nil {\n   149\t\t\tcapabilityTarget.CapabilityManifest = input.Review.CapabilityManifest.Record()\n   150\t\t}\n   151\t\tif err := record.ValidateCurrentTargetCapability(capabilityTarget); err != nil {\n   152\t\t\treturn Report{}, fmt.Errorf(\"capability analysis target: %w\", err)\n   153\t\t}\n   154\t\tclassification := ClassificationSupported\n   155\t\tif len(blockers) != 0 {\n   156\t\t\tclassification = ClassificationUnsupported\n   157\t\t}\n   158\t\tboundaryVersion, boundaryDigest := deterministicio.BoundaryManifestIdentity()\n   159\t\treturn Report{\n   160\t\t\tSchema: AnalysisSchema, Classification: classification,\n   161\t\t\tTarget: Target{\n   162\t\t\t\tKind: input.Spec.Kind, Source: safeSource(input.Spec.Source), Arguments: safeArguments(input.Spec.Args),\n   163\t\t\t\tBuildTags: append([]string{}, input.Review.BuildTags...), CapabilityMode: mode,\n   164\t\t\t\tCapabilityManifest: capabilityTarget.CapabilityManifest,\n   165\t\t\t},\n   166\t\t\tToolchain: Toolchain{\n   167\t\t\t\tGoVersion: input.Toolchain.GoVersion, BuildKey: input.Toolchain.BuildKey,\n   168\t\t\t\tTargetGOOS: input.Toolchain.TargetGOOS, TargetGOARCH: input.Toolchain.TargetGOARCH,\n   169\t\t\t\tBoundaryManifestVersion: boundaryVersion, BoundaryManifestSHA256: record.SHA256(boundaryDigest),\n   170\t\t\t},\n   171\t\t\tClosure: Closure{\n   172\t\t\t\tSHA256: record.HashBytes(closureBytes), PackageCount: record.Uint64String(len(input.Review.Closure.Packages)),\n   173\t\t\t\tRoots: append([]target.CapabilityPackageReference{}, input.Review.Roots...),\n   174\t\t\t},\n   175\t\t\tIOProfile: input.IOProfile.Identity(), Packs: append([]target.CompatibilityPackEvidence{}, input.Review.Packs...),\n   176\t\t\tRequirements: requirements, Blockers: blockers, GuardedBlockers: guarded, EliminatedBlockers: eliminated,\n   177\t\t}, nil\n   178\t}\n   179\t\n   180\t// ForArguments rebinds the report to another argument list for the same\n   181\t// target: a go target's arguments reach its process, never its build, so the\n   182\t// capability evidence does not depend on them.\n   183\tfunc (report Report) ForArguments(arguments []string) Report {\n   184\t\treport.Target.Arguments = safeArguments(arguments)\n   185\t\treturn report\n   186\t}\n   187\t\n   188\tfunc projectAnalysisBlockers(findings []target.CapabilityFinding, paths map[target.CapabilityPackageReference][]target.CapabilityPackageReference) ([]Blocker, error) {\n   189\t\tblockers := make([]Blocker, len(findings))\n   190\t\tfor index, finding := range findings {\n   191\t\t\tpath, found := paths[finding.Package]\n   192\t\t\tif !found {\n   193\t\t\t\treturn nil, fmt.Errorf(\"capability finding package %s is not reachable from a target root\", finding.Package.ImportPath)\n   194\t\t\t}\n   195\t\t\tblockers[index] = Blocker{CapabilityFinding: copyFinding(finding), DependencyPath: append([]target.CapabilityPackageReference{}, path...)}\n   196\t\t}\n   197\t\treturn blockers, nil\n   198\t}\n   199\t\n   200\tfunc Decode(data []byte) (Report, error) {\n   201\t\tif len(data) == 0 || len(data) > MaximumAnalysisReportBytes {\n   202\t\t\treturn Report{}, fmt.Errorf(\"capability analysis report must be between 1 and %d bytes\", MaximumAnalysisReportBytes)\n   203\t\t}\n   204\t\tvar report Report\n   205\t\tif err := canonicaljson.DecodeCanonicalJSON(data, &report); err != nil {\n   206\t\t\treturn Report{}, fmt.Errorf(\"decode capability analysis report: %w\", err)\n   207\t\t}\n   208\t\tif err := validateAnalysisReport(report); err != nil {\n   209\t\t\treturn Report{}, err\n   210\t\t}\n   211\t\treturn report, nil\n   212\t}\n   213\t\n   214\tfunc validateAnalysisReport(report Report) error {\n   215\t\tif report.Schema != AnalysisSchema || report.Target.Kind != target.KindGoRun && report.Target.Kind != target.KindGoTest || report.Target.Source == \"\" {\n   216\t\t\treturn errors.New(\"capability analysis identity is invalid\")\n   217\t\t}\n   218\t\tif report.Target.Arguments == nil || report.Target.BuildTags == nil || report.Closure.Roots == nil || len(report.Closure.Roots) == 0 || report.Packs == nil || report.Requirements == nil || report.Blockers == nil || report.GuardedBlockers == nil || report.EliminatedBlockers == nil || uint64(report.Closure.PackageCount) == 0 {\n   219\t\t\treturn errors.New(\"capability analysis evidence is incomplete\")\n   220\t\t}\n   221\t\tif err := record.ValidateCurrentTargetCapability(record.Target{CapabilityMode: string(report.Target.CapabilityMode), CapabilityManifest: report.Target.CapabilityManifest}); err != nil {\n   222\t\t\treturn fmt.Errorf(\"capability analysis target: %w\", err)\n   223\t\t}\n   224\t\tfor _, digest := range []record.SHA256{\n   225\t\t\treport.Closure.SHA256, report.Toolchain.BoundaryManifestSHA256,\n   226\t\t\trecord.SHA256(report.IOProfile.ImplementationSHA256), record.SHA256(report.IOProfile.InventorySHA256),\n   227\t\t} {\n   228\t\t\tif _, err := digest.Bytes(); err != nil {\n   229\t\t\t\treturn fmt.Errorf(\"capability analysis digest is invalid: %w\", err)\n   230\t\t\t}\n","exit_code":0,"status":"completed"}}
