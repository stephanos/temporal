=>x.OutputType?.startsWith('error')).map(x=>({test:x.Test,output:x.Output}));\nif(JSON.stringify(errors('ordinary-package-final-offline-proxy'))!==JSON.stringify(errors('ordinary-package-baseline-offline-proxy')))throw Error('worker full diagnostic bytes differ');\nconsole.log(JSON.stringify({receipts,streams,bindings,sealed_worker_receipts:e.receipts.length+1,source_inputs:JSON.parse(b(seal.source.manifest)).length,tools:JSON.parse(b(seal.tools.manifest)).length,controls:JSON.parse(b(seal.controls.manifest)).length,root_lint_byte_equal:true,root_full_package_errors:errors('root-generator-ordinary-package'),historical_proof_controls:e.final_proof_controls.sha256,current_sealing_controls:seal.controls.sha256}));
