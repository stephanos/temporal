func processSimulationExplorationCompletion(
	ctx context.Context,
	config campaignRequest,
	prepared target.Prepared,
	baseEnvironment []record.Environment,
	readOnlyMounts []readonlymount.Mapping,
	runID string,
	batchPath string,
