	if err != nil {
		return Bundle{}, fmt.Errorf("encode initial World snapshot: %w", err)
	}
	finalBytes, err := world.EncodeSnapshot(final)
	if err != nil {
		return Bundle{}, fmt.Errorf("encode final World snapshot: %w", err)
	}
