8fe1f\",\n      \"tools/gomad3/runner/campaign_test.go\": \"f34a5e236c0f880e4fb9e4e2339f985c5c98f054d523531a1ce136bc1743f885\",\n      \"tools/gomad3/runner/seed_completion_characterization_test.go\": \"f6118cfcb23a456ac456e442ba1a7c86d6d23da247d0d4d8ff7d27a1a013ebed\"\n    }\n  }\n}\ndiff --git a/tools/gomad3/runner/internal/campaign/controller.go b/tools/gomad3/runner/internal/campaign/controller.go\n--- a/tools/gomad3/runner/internal/campaign/controller.go\n+++ b/tools/gomad3/runner/internal/campaign/controller.go\n@@ -115,19 +115,17 @@\n \tif controller.active == 0 {\n \t\tpanic(\"gomad3: completed an inactive campaign attempt\")\n \t}\n-\tif completion.Kind > CompletionFailure {\n-\t\tpanic(\"gomad3: invalid campaign completion\")\n-\t}\n \tcontroller.active--\n \tcontroller.statistics.Attempted++\n-\tswitch completion.Kind {\n-\tcase CompletionUnclassified:\n-\t\treturn false\n-\tcase CompletionSuccess:\n+\tif completion.Kind == CompletionSuccess {\n \t\tcontroller.statistics.Succeeded++\n \t\treturn false\n-\tcase CompletionCancelled:\n+\t}\n+\tif completion.Kind == CompletionCancelled {\n \t\tcontroller.statistics.Cancelled++\n+\t\treturn false\n+\t}\n+\tif completion.Kind != CompletionFailure {\n \t\treturn false\n \t}\n \tcontroller.statistics.Failures++\n","exit_code":0,"status":"completed"}}
