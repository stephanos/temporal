{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tools/gomad3/runner/internal/campaign/controller.go | sed -n '1,230p'; nl -ba tools/gomad3/runner/internal/campaign/controller_test.go | sed -n '1,260p'\"","aggregated_output":"     1\tpackage campaign\n     2\t\n     3\timport \"errors\"\n     4\t\n     5\ttype FailurePolicy string\n     6\t\n     7\tconst (\n     8\t\tFailurePolicyFirst  FailurePolicy = \"first\"\n     9\t\tFailurePolicyBudget FailurePolicy = \"budget\"\n    10\t\tFailurePolicyAll    FailurePolicy = \"all\"\n    11\t)\n    12\t\n    13\ttype ControllerStopReason string\n    14\t\n    15\tconst (\n    16\t\tStopSeedsExhausted ControllerStopReason = \"seeds_exhausted\"\n    17\t\tStopFirstFailure   ControllerStopReason = \"first_failure\"\n    18\t\tStopFailureBudget  ControllerStopReason = \"failure_budget\"\n    19\t)\n    20\t\n    21\ttype SeedJob struct {\n    22\t\tOrdinal uint64\n    23\t\tSeed    uint64\n    24\t}\n    25\t\n    26\ttype CompletionKind uint8\n    27\t\n    28\tconst (\n    29\t\tCompletionUnclassified CompletionKind = iota\n    30\t\tCompletionSuccess\n    31\t\tCompletionCancelled\n    32\t\tCompletionFailure\n    33\t)\n    34\t\n    35\ttype Completion struct {\n    36\t\tKind             CompletionKind\n    37\t\tDomain           string\n    38\t\tReason           string\n    39\t\tDistinctFailures uint64\n    40\t}\n    41\t\n    42\ttype CampaignStatistics struct {\n    43\t\tAttempted         uint64\n    44\t\tSucceeded         uint64\n    45\t\tFailures          uint64\n    46\t\tWatchdogs         uint64\n    47\t\tReplayDivergences uint64\n    48\t\tCancelled         uint64\n    49\t\tDistinctFailures  uint64\n    50\t\tStopReason        ControllerStopReason\n    51\t}\n    52\t\n    53\ttype SeedControllerConfig struct {\n    54\t\tNext          func() (SeedJob, bool)\n    55\t\tParallel      int\n    56\t\tPolicy        FailurePolicy\n    57\t\tFailureBudget uint64\n    58\t\tInitial       CampaignStatistics\n    59\t}\n    60\t\n    61\ttype SeedController struct {\n    62\t\tnext          func() (SeedJob, bool)\n    63\t\tparallel      int\n    64\t\tpolicy        FailurePolicy\n    65\t\tfailureBudget uint64\n    66\t\tstatistics    CampaignStatistics\n    67\t\tactive        int\n    68\t\texhausted     bool\n    69\t\tstopped       bool\n    70\t}\n    71\t\n    72\tfunc NewSeedController(config SeedControllerConfig) (*SeedController, error) {\n    73\t\tif config.Next == nil || config.Parallel <= 0 {\n    74\t\t\treturn nil, errors.New(\"seed campaign controller requires a source and positive parallelism\")\n    75\t\t}\n    76\t\tif config.Policy == FailurePolicyBudget && config.FailureBudget == 0 {\n    77\t\t\treturn nil, errors.New(\"seed campaign failure budget must be positive\")\n    78\t\t}\n    79\t\tif config.Policy != FailurePolicyFirst && config.Policy != FailurePolicyBudget && config.Policy != FailurePolicyAll {\n    80\t\t\treturn nil, errors.New(\"seed campaign failure policy is invalid\")\n    81\t\t}\n    82\t\tcontroller := &SeedController{\n    83\t\t\tnext: config.Next, parallel: config.Parallel, policy: config.Policy,\n    84\t\t\tfailureBudget: config.FailureBudget, statistics: config.Initial,\n    85\t\t}\n    86\t\tswitch config.Policy {\n    87\t\tcase FailurePolicyFirst:\n    88\t\t\tif config.Initial.Failures != 0 {\n    89\t\t\t\tcontroller.statistics.StopReason = StopFirstFailure\n    90\t\t\t\tcontroller.stopped = true\n    91\t\t\t}\n    92\t\tcase FailurePolicyBudget:\n    93\t\t\tif config.Initial.DistinctFailures >= config.FailureBudget {\n    94\t\t\t\tcontroller.statistics.StopReason = StopFailureBudget\n    95\t\t\t\tcontroller.stopped = true\n    96\t\t\t}\n    97\t\t}\n    98\t\treturn controller, nil\n    99\t}\n   100\t\n   101\tfunc (controller *SeedController) Next() (SeedJob, bool) {\n   102\t\tif controller.stopped || controller.exhausted || controller.active >= controller.parallel {\n   103\t\t\treturn SeedJob{}, false\n   104\t\t}\n   105\t\tjob, ok := controller.next()\n   106\t\tif !ok {\n   107\t\t\tcontroller.exhausted = true\n   108\t\t\treturn SeedJob{}, false\n   109\t\t}\n   110\t\tcontroller.active++\n   111\t\treturn job, true\n   112\t}\n   113\t\n   114\tfunc (controller *SeedController) Complete(completion Completion) bool {\n   115\t\tif controller.active == 0 {\n   116\t\t\tpanic(\"gomad3: completed an inactive campaign attempt\")\n   117\t\t}\n   118\t\tcontroller.active--\n   119\t\tcontroller.statistics.Attempted++\n   120\t\tif completion.Kind == CompletionSuccess {\n   121\t\t\tcontroller.statistics.Succeeded++\n   122\t\t\treturn false\n   123\t\t}\n   124\t\tif completion.Kind == CompletionCancelled {\n   125\t\t\tcontroller.statistics.Cancelled++\n   126\t\t\treturn false\n   127\t\t}\n   128\t\tif completion.Kind != CompletionFailure {\n   129\t\t\treturn false\n   130\t\t}\n   131\t\tcontroller.statistics.Failures++\n   132\t\tif completion.Domain == \"watchdog\" {\n   133\t\t\tcontroller.statistics.Watchdogs++\n   134\t\t}\n   135\t\tif completion.Reason == \"world_replay_divergence\" {\n   136\t\t\tcontroller.statistics.ReplayDivergences++\n   137\t\t}\n   138\t\tcontroller.statistics.DistinctFailures = completion.DistinctFailures\n   139\t\tif controller.stopped {\n   140\t\t\treturn false\n   141\t\t}\n   142\t\tswitch controller.policy {\n   143\t\tcase FailurePolicyFirst:\n   144\t\t\tcontroller.statistics.StopReason = StopFirstFailure\n   145\t\t\tcontroller.stopped = true\n   146\t\t\treturn true\n   147\t\tcase FailurePolicyBudget:\n   148\t\t\tif completion.DistinctFailures >= controller.failureBudget {\n   149\t\t\t\tcontroller.statistics.StopReason = StopFailureBudget\n   150\t\t\t\tcontroller.stopped = true\n   151\t\t\t}\n   152\t\t}\n   153\t\treturn false\n   154\t}\n   155\t\n   156\tfunc (controller *SeedController) Stop() {\n   157\t\tcontroller.stopped = true\n   158\t}\n   159\t\n   160\tfunc (controller *SeedController) Stopped() bool {\n   161\t\treturn controller.stopped\n   162\t}\n   163\t\n   164\tfunc (controller *SeedController) Active() int {\n   165\t\treturn controller.active\n   166\t}\n   167\t\n   168\tfunc (controller *SeedController) Done() bool {\n   169\t\treturn controller.active == 0 && (controller.exhausted || controller.stopped)\n   170\t}\n   171\t\n   172\tfunc (controller *SeedController) Finalize() {\n   173\t\tif controller.statistics.StopReason == \"\" {\n   174\t\t\tcontroller.statistics.StopReason = StopSeedsExhausted\n   175\t\t}\n   176\t}\n   177\t\n   178\tfunc (controller *SeedController) Statistics() CampaignStatistics {\n   179\t\treturn controller.statistics\n   180\t}\n     1\tpackage campaign\n     2\t\n     3\timport \"testing\"\n     4\t\n     5\tfunc TestSeedControllerSchedulesAndAggregatesDeterministically(t *testing.T) {\n     6\t\tjobs := []SeedJob{{Ordinal: 0, Seed: 10}, {Ordinal: 2, Seed: 12}, {Ordinal: 3, Seed: 13}}\n     7\t\tnext := 0\n     8\t\tcontroller, err := NewSeedController(SeedControllerConfig{\n     9\t\t\tNext: func() (SeedJob, bool) {\n    10\t\t\t\tif next == len(jobs) {\n    11\t\t\t\t\treturn SeedJob{}, false\n    12\t\t\t\t}\n    13\t\t\t\tjob := jobs[next]\n    14\t\t\t\tnext++\n    15\t\t\t\treturn job, true\n    16\t\t\t},\n    17\t\t\tParallel: 2, Policy: FailurePolicyAll, FailureBudget: 1,\n    18\t\t})\n    19\t\tif err != nil {\n    20\t\t\tt.Fatal(err)\n    21\t\t}\n    22\t\tfirst, ok := controller.Next()\n    23\t\tif !ok || first != jobs[0] {\n    24\t\t\tt.Fatalf(\"first job = %#v, %t\", first, ok)\n    25\t\t}\n    26\t\tsecond, ok := controller.Next()\n    27\t\tif !ok || second != jobs[1] {\n    28\t\t\tt.Fatalf(\"second job = %#v, %t\", second, ok)\n    29\t\t}\n    30\t\t_, ok = controller.Next()\n    31\t\tif ok {\n    32\t\t\tt.Fatal(\"controller exceeded parallelism\")\n    33\t\t}\n    34\t\tcontroller.Complete(Completion{Kind: CompletionSuccess})\n    35\t\t_, ok = controller.Next()\n    36\t\tif !ok {\n    37\t\t\tt.Fatal(\"third job was not scheduled\")\n    38\t\t}\n    39\t\tcontroller.Complete(Completion{Kind: CompletionFailure, Domain: \"watchdog\", Reason: \"world_replay_divergence\", DistinctFailures: 1})\n    40\t\tcontroller.Complete(Completion{Kind: CompletionCancelled})\n    41\t\t_, ok = controller.Next()\n    42\t\tif ok || !controller.Done() {\n    43\t\t\tt.Fatal(\"controller did not exhaust\")\n    44\t\t}\n    45\t\tcontroller.Finalize()\n    46\t\twant := CampaignStatistics{\n    47\t\t\tAttempted: 3, Succeeded: 1, Failures: 1, Watchdogs: 1, ReplayDivergences: 1,\n    48\t\t\tCancelled: 1, DistinctFailures: 1, StopReason: StopSeedsExhausted,\n    49\t\t}\n    50\t\tif got := controller.Statistics(); got != want {\n    51\t\t\tt.Fatalf(\"statistics = %#v, want %#v\", got, want)\n    52\t\t}\n    53\t}\n    54\t\n    55\tfunc TestSeedControllerAppliesFailurePolicies(t *testing.T) {\n    56\t\tfor _, test := range []struct {\n    57\t\t\tname       string\n    58\t\t\tpolicy     FailurePolicy\n    59\t\t\tbudget     uint64\n    60\t\t\tdistinct   uint64\n    61\t\t\twantReason ControllerStopReason\n    62\t\t\twantCancel bool\n    63\t\t}{\n    64\t\t\t{name: \"first\", policy: FailurePolicyFirst, budget: 1, distinct: 1, wantReason: StopFirstFailure, wantCancel: true},\n    65\t\t\t{name: \"budget\", policy: FailurePolicyBudget, budget: 2, distinct: 2, wantReason: StopFailureBudget},\n    66\t\t\t{name: \"all\", policy: FailurePolicyAll, budget: 1, distinct: 1},\n    67\t\t} {\n    68\t\t\tt.Run(test.name, func(t *testing.T) {\n    69\t\t\t\tcontroller, err := NewSeedController(SeedControllerConfig{\n    70\t\t\t\t\tNext:     func() (SeedJob, bool) { return SeedJob{}, true },\n    71\t\t\t\t\tParallel: 2, Policy: test.policy, FailureBudget: test.budget,\n    72\t\t\t\t})\n    73\t\t\t\tif err != nil {\n    74\t\t\t\t\tt.Fatal(err)\n    75\t\t\t\t}\n    76\t\t\t\t_, ok := controller.Next()\n    77\t\t\t\tif !ok {\n    78\t\t\t\t\tt.Fatal(\"first job was not scheduled\")\n    79\t\t\t\t}\n    80\t\t\t\t_, ok = controller.Next()\n    81\t\t\t\tif !ok {\n    82\t\t\t\t\tt.Fatal(\"second job was not scheduled\")\n    83\t\t\t\t}\n    84\t\t\t\tif cancel := controller.Complete(Completion{Kind: CompletionFailure, Domain: \"watchdog\", Reason: \"world_replay_divergence\", DistinctFailures: test.distinct}); cancel != test.wantCancel {\n    85\t\t\t\t\tt.Fatalf(\"cancel = %t, want %t\", cancel, test.wantCancel)\n    86\t\t\t\t}\n    87\t\t\t\twant := CampaignStatistics{\n    88\t\t\t\t\tAttempted: 1, Failures: 1, Watchdogs: 1, ReplayDivergences: 1,\n    89\t\t\t\t\tDistinctFailures: test.distinct, StopReason: test.wantReason,\n    90\t\t\t\t}\n    91\t\t\t\tif got := controller.Statistics(); controller.Stopped() != (test.wantReason != \"\") || got != want || controller.Active() != 1 {\n    92\t\t\t\t\tt.Fatalf(\"controller stopped = %t, statistics = %#v, want %#v\", controller.Stopped(), got, want)\n    93\t\t\t\t}\n    94\t\t\t\t_, ok = controller.Next()\n    95\t\t\t\tif ok != (test.wantReason == \"\") {\n    96\t\t\t\t\tt.Fatal(\"stopped controller scheduled another job\")\n    97\t\t\t\t}\n    98\t\t\t\tif test.wantReason == \"\" {\n    99\t\t\t\t\tcontroller.Complete(Completion{Kind: CompletionUnclassified})\n   100\t\t\t\t}\n   101\t\t\t\tcontroller.Complete(Completion{Kind: CompletionUnclassified})\n   102\t\t\t\tif test.wantReason == \"\" {\n   103\t\t\t\t\tcontroller.Stop()\n   104\t\t\t\t}\n   105\t\t\t\tif !controller.Done() {\n   106\t\t\t\t\tt.Fatal(\"stopped controller did not drain\")\n   107\t\t\t\t}\n   108\t\t\t})\n   109\t\t}\n   110\t}\n   111\t\n   112\tfunc TestSeedControllerCompletesUnclassifiedAndDuplicateFailureAtomically(t *testing.T) {\n   113\t\tinitial := CampaignStatistics{Attempted: 4, Succeeded: 2, Failures: 2, DistinctFailures: 1}\n   114\t\tcontroller, err := NewSeedController(SeedControllerConfig{\n   115\t\t\tNext:     func() (SeedJob, bool) { return SeedJob{Ordinal: 4, Seed: 14}, true },\n   116\t\t\tParallel: 2, Policy: FailurePolicyBudget, FailureBudget: 2, Initial: initial,\n   117\t\t})\n   118\t\tif err != nil {\n   119\t\t\tt.Fatal(err)\n   120\t\t}\n   121\t\tcontroller.Next()\n   122\t\tcontroller.Next()\n   123\t\tif cancel := controller.Complete(Completion{Kind: CompletionUnclassified}); cancel {\n   124\t\t\tt.Fatal(\"unclassified completion cancelled active work\")\n   125\t\t}\n   126\t\twant := CampaignStatistics{Attempted: 5, Succeeded: 2, Failures: 2, DistinctFailures: 1}\n   127\t\tif got := controller.Statistics(); got != want || controller.Active() != 1 {\n   128\t\t\tt.Fatalf(\"statistics = %#v, active = %d, want %#v and 1\", got, controller.Active(), want)\n   129\t\t}\n   130\t\tif cancel := controller.Complete(Completion{Kind: CompletionFailure, Domain: \"target\", Reason: \"exit_nonzero\", DistinctFailures: 1}); cancel {\n   131\t\t\tt.Fatal(\"duplicate failure cancelled active work\")\n   132\t\t}\n   133\t\twant = CampaignStatistics{Attempted: 6, Succeeded: 2, Failures: 3, DistinctFailures: 1}\n   134\t\tif got := controller.Statistics(); got != want || controller.Active() != 0 || controller.Stopped() {\n   135\t\t\tt.Fatalf(\"statistics = %#v, active = %d, stopped = %t, want %#v\", got, controller.Active(), controller.Stopped(), want)\n   136\t\t}\n   137\t}\n   138\t\n   139\tfunc TestSeedControllerRejectsInactiveCompletionBeforeChangingStatistics(t *testing.T) {\n   140\t\tcontroller, err := NewSeedController(SeedControllerConfig{\n   141\t\t\tNext: func() (SeedJob, bool) { return SeedJob{}, false }, Parallel: 1, Policy: FailurePolicyAll,\n   142\t\t})\n   143\t\tif err != nil {\n   144\t\t\tt.Fatal(err)\n   145\t\t}\n   146\t\tdefer func() {\n   147\t\t\tif recovered := recover(); recovered != \"gomad3: completed an inactive campaign attempt\" {\n   148\t\t\t\tt.Fatalf(\"panic = %#v\", recovered)\n   149\t\t\t}\n   150\t\t\tif got := controller.Statistics(); got != (CampaignStatistics{}) {\n   151\t\t\t\tt.Fatalf(\"statistics after rejected completion = %#v\", got)\n   152\t\t\t}\n   153\t\t}()\n   154\t\tcontroller.Complete(Completion{Kind: CompletionSuccess})\n   155\t}\n   156\t\n   157\tfunc TestSeedControllerRestoresSatisfiedPolicy(t *testing.T) {\n   158\t\tcontroller, err := NewSeedController(SeedControllerConfig{\n   159\t\t\tNext: func() (SeedJob, bool) { return SeedJob{}, true }, Parallel: 1,\n   160\t\t\tPolicy: FailurePolicyFirst, FailureBudget: 1,\n   161\t\t\tInitial: CampaignStatistics{Failures: 1, DistinctFailures: 1},\n   162\t\t})\n   163\t\tif err != nil {\n   164\t\t\tt.Fatal(err)\n   165\t\t}\n   166\t\tif !controller.Stopped() || !controller.Done() || controller.Statistics().StopReason != StopFirstFailure {\n   167\t\t\tt.Fatalf(\"restored controller = %#v\", controller)\n   168\t\t}\n   169\t}\n   170\t\n   171\tfunc TestSeedControllerRejectsInvalidConfiguration(t *testing.T) {\n   172\t\tvalidNext := func() (SeedJob, bool) { return SeedJob{}, false }\n   173\t\tfor _, config := range []SeedControllerConfig{\n   174\t\t\t{},\n   175\t\t\t{Next: validNext},\n   176\t\t\t{Next: validNext, Parallel: 1, Policy: FailurePolicyBudget},\n   177\t\t\t{Next: validNext, Parallel: 1, Policy: \"unknown\"},\n   178\t\t} {\n   179\t\t\t_, err := NewSeedController(config)\n   180\t\t\tif err == nil {\n   181\t\t\t\tt.Fatalf(\"NewSeedController(%#v) succeeded\", config)\n   182\t\t\t}\n   183\t\t}\n   184\t}\n","exit_code":0,"status":"completed"}}
