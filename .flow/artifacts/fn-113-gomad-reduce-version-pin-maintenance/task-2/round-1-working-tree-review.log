{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba tools/gomad3/cmd/gomadtool/adapter_publication.go'","aggregated_output":"     1\tpackage main\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"encoding/json\"\n     6\t\t\"errors\"\n     7\t\t\"fmt\"\n     8\t\t\"os\"\n     9\t\t\"path/filepath\"\n    10\t\t\"slices\"\n    11\t\t\"strings\"\n    12\t\n    13\t\t\"go.temporal.io/server/tools/gomad3/internal/hostfs\"\n    14\t)\n    15\t\n    16\ttype publicationContent struct {\n    17\t\tPresent bool   `json:\"present\"`\n    18\t\tBytes   []byte `json:\"bytes,omitempty\"`\n    19\t}\n    20\t\n    21\ttype adapterPublicationFile struct {\n    22\t\tPath string             `json:\"path\"`\n    23\t\tOld  publicationContent `json:\"old\"`\n    24\t\tNew  publicationContent `json:\"new\"`\n    25\t}\n    26\t\n    27\ttype adapterPublication struct {\n    28\t\tSchema string                   `json:\"schema\"`\n    29\t\tFiles  []adapterPublicationFile `json:\"files\"`\n    30\t}\n    31\t\n    32\tfunc adapterPublicationMarker(root string) string {\n    33\t\treturn filepath.Join(root, \"tools\", \"gomad3\", \".toolchain\", \"adapter-regenerate\", \"transaction.json\")\n    34\t}\n    35\t\n    36\tfunc withAdapterPublicationLock(root string, operation func() error) (retErr error) {\n    37\t\tlockPath := filepath.Join(root, \"tools\", \"gomad3\", \".toolchain\", \"adapter-regenerate.lock\")\n    38\t\tif err := os.MkdirAll(filepath.Dir(lockPath), 0o700); err != nil {\n    39\t\t\treturn err\n    40\t\t}\n    41\t\tlock, err := hostfs.Try(lockPath)\n    42\t\tif err != nil {\n    43\t\t\treturn fmt.Errorf(\"lock adapter regeneration: %w\", err)\n    44\t\t}\n    45\t\tdefer func() { retErr = errors.Join(retErr, lock.Release()) }()\n    46\t\treturn operation()\n    47\t}\n    48\t\n    49\tfunc readPublicationFile(root, relative string) (publicationContent, error) {\n    50\t\tif relative == \"\" || filepath.IsAbs(relative) || filepath.Clean(relative) != relative || relative == \"..\" || strings.HasPrefix(relative, \"..\"+string(filepath.Separator)) {\n    51\t\t\treturn publicationContent{}, fmt.Errorf(\"invalid publication path %q\", relative)\n    52\t\t}\n    53\t\tpath := filepath.Join(root, relative)\n    54\t\tinfo, err := os.Lstat(path)\n    55\t\tif errors.Is(err, os.ErrNotExist) {\n    56\t\t\treturn publicationContent{}, nil\n    57\t\t}\n    58\t\tif err != nil {\n    59\t\t\treturn publicationContent{}, err\n    60\t\t}\n    61\t\tif !info.Mode().IsRegular() || info.Size() > 64<<20 {\n    62\t\t\treturn publicationContent{}, fmt.Errorf(\"publication path is not a bounded regular file: %s\", relative)\n    63\t\t}\n    64\t\tcontents, err := os.ReadFile(path)\n    65\t\tif err != nil {\n    66\t\t\treturn publicationContent{}, err\n    67\t\t}\n    68\t\treturn publicationContent{Present: true, Bytes: contents}, nil\n    69\t}\n    70\t\n    71\tfunc samePublicationContent(a, b publicationContent) bool {\n    72\t\treturn a.Present == b.Present && bytes.Equal(a.Bytes, b.Bytes)\n    73\t}\n    74\t\n    75\tfunc writePublicationFile(root, relative string, content publicationContent) error {\n    76\t\tpath := filepath.Join(root, relative)\n    77\t\tif !content.Present {\n    78\t\t\tif err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {\n    79\t\t\t\treturn err\n    80\t\t\t}\n    81\t\t\treturn syncPublicationDirectory(filepath.Dir(path))\n    82\t\t}\n    83\t\tmode := os.FileMode(0o644)\n    84\t\tif strings.Contains(relative, string(filepath.Separator)+\"requests\"+string(filepath.Separator)) {\n    85\t\t\tmode = 0o600\n    86\t\t}\n    87\t\treturn hostfs.Replace(path, content.Bytes, mode)\n    88\t}\n    89\t\n    90\tfunc syncPublicationDirectory(path string) error {\n    91\t\tdir, err := os.Open(path)\n    92\t\tif err != nil {\n    93\t\t\treturn err\n    94\t\t}\n    95\t\treturn errors.Join(dir.Sync(), dir.Close())\n    96\t}\n    97\t\n    98\tfunc recordAdapterPublication(root string, files []adapterPublicationFile) error {\n    99\t\tmarker := adapterPublicationMarker(root)\n   100\t\tif err := os.MkdirAll(filepath.Dir(marker), 0o700); err != nil {\n   101\t\t\treturn err\n   102\t\t}\n   103\t\tif _, err := os.Lstat(marker); !errors.Is(err, os.ErrNotExist) {\n   104\t\t\treturn errors.New(\"adapter regeneration transaction already exists\")\n   105\t\t}\n   106\t\tencoded, err := json.Marshal(adapterPublication{Schema: \"gomad3.adapter-regeneration-transaction/v1\", Files: files})\n   107\t\tif err != nil {\n   108\t\t\treturn err\n   109\t\t}\n   110\t\treturn hostfs.Replace(marker, encoded, 0o600)\n   111\t}\n   112\t\n   113\tfunc clearAdapterPublication(root string) error {\n   114\t\tmarker := adapterPublicationMarker(root)\n   115\t\tif err := os.Remove(marker); err != nil {\n   116\t\t\treturn err\n   117\t\t}\n   118\t\treturn syncPublicationDirectory(filepath.Dir(marker))\n   119\t}\n   120\t\n   121\tfunc recoverAdapterPublication(root string) error {\n   122\t\tmarker := adapterPublicationMarker(root)\n   123\t\tinfo, err := os.Lstat(marker)\n   124\t\tif errors.Is(err, os.ErrNotExist) {\n   125\t\t\treturn nil\n   126\t\t}\n   127\t\tif err != nil {\n   128\t\t\treturn err\n   129\t\t}\n   130\t\tif !info.Mode().IsRegular() || info.Size() > 64<<20 {\n   131\t\t\treturn errors.New(\"adapter regeneration marker is invalid\")\n   132\t\t}\n   133\t\tencoded, err := os.ReadFile(marker)\n   134\t\tif err != nil {\n   135\t\t\treturn err\n   136\t\t}\n   137\t\tvar pending adapterPublication\n   138\t\tif err := json.Unmarshal(encoded, &pending); err != nil {\n   139\t\t\treturn err\n   140\t\t}\n   141\t\tif pending.Schema != \"gomad3.adapter-regeneration-transaction/v1\" || len(pending.Files) == 0 {\n   142\t\t\treturn errors.New(\"adapter regeneration marker has invalid schema or files\")\n   143\t\t}\n   144\t\tseen := make(map[string]bool, len(pending.Files))\n   145\t\tfor _, file := range pending.Files {\n   146\t\t\tif seen[file.Path] {\n   147\t\t\t\treturn errors.New(\"adapter regeneration marker has duplicate paths\")\n   148\t\t\t}\n   149\t\t\tseen[file.Path] = true\n   150\t\t\tcurrent, err := readPublicationFile(root, file.Path)\n   151\t\t\tif err != nil {\n   152\t\t\t\treturn err\n   153\t\t\t}\n   154\t\t\tif !samePublicationContent(current, file.Old) && !samePublicationContent(current, file.New) {\n   155\t\t\t\treturn fmt.Errorf(\"adapter regeneration interrupted checkout changed externally: %s\", file.Path)\n   156\t\t\t}\n   157\t\t}\n   158\t\tfor _, file := range pending.Files {\n   159\t\t\tif err := writePublicationFile(root, file.Path, file.Old); err != nil {\n   160\t\t\t\treturn fmt.Errorf(\"restore interrupted adapter regeneration %s: %w\", file.Path, err)\n   161\t\t\t}\n   162\t\t}\n   163\t\treturn clearAdapterPublication(root)\n   164\t}\n   165\t\n   166\tfunc publishAdapterFiles(root string, files []adapterPublicationFile) error {\n   167\t\treturn publishAdapterFilesWithSnapshot(root, files, nil)\n   168\t}\n   169\t\n   170\tfunc validateAdapterPublicationSnapshot(root string, files []adapterPublicationFile, snapshot map[string]publicationContent) error {\n   171\t\tfor path, old := range snapshot {\n   172\t\t\tcurrent, err := readPublicationFile(root, path)\n   173\t\t\tif err != nil {\n   174\t\t\t\treturn err\n   175\t\t\t}\n   176\t\t\tif !samePublicationContent(current, old) {\n   177\t\t\t\treturn fmt.Errorf(\"checkout changed since staging: %s\", path)\n   178\t\t\t}\n   179\t\t}\n   180\t\tfor _, file := range files {\n   181\t\t\tcurrent, err := readPublicationFile(root, file.Path)\n   182\t\t\tif err != nil {\n   183\t\t\t\treturn err\n   184\t\t\t}\n   185\t\t\tif !samePublicationContent(current, file.Old) {\n   186\t\t\t\treturn fmt.Errorf(\"checkout changed since staging: %s\", file.Path)\n   187\t\t\t}\n   188\t\t}\n   189\t\treturn nil\n   190\t}\n   191\t\n   192\tfunc publishAdapterFilesWithSnapshot(root string, files []adapterPublicationFile, snapshot map[string]publicationContent) error {\n   193\t\tif len(files) == 0 {\n   194\t\t\treturn errors.New(\"adapter regeneration has no changed files\")\n   195\t\t}\n   196\t\tslices.SortFunc(files, func(a, b adapterPublicationFile) int { return strings.Compare(a.Path, b.Path) })\n   197\t\treturn withAdapterPublicationLock(root, func() error {\n   198\t\t\tif err := recoverAdapterPublication(root); err != nil {\n   199\t\t\t\treturn err\n   200\t\t\t}\n   201\t\t\tif err := validateAdapterPublicationSnapshot(root, files, snapshot); err != nil {\n   202\t\t\t\treturn err\n   203\t\t\t}\n   204\t\t\tif err := recordAdapterPublication(root, files); err != nil {\n   205\t\t\t\treturn err\n   206\t\t\t}\n   207\t\t\tfor _, file := range files {\n   208\t\t\t\tif err := writePublicationFile(root, file.Path, file.New); err != nil {\n   209\t\t\t\t\treturn errors.Join(fmt.Errorf(\"publish adapter regeneration %s: %w\", file.Path, err), recoverAdapterPublication(root))\n   210\t\t\t\t}\n   211\t\t\t}\n   212\t\t\treturn clearAdapterPublication(root)\n   213\t\t})\n   214\t}\n","exit_code":0,"status":"completed"}}
