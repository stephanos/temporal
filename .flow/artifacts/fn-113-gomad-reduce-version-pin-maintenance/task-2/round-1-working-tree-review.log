rorf(\\\"gomad: DNS resolution is unavailable; use a literal IP target\\\")\\n}\\n\")},\n   128\t\t\t},\n   129\t\t},\n   130\t}\n   131\t\n   132\tvar grpcPreparedInternalSourceSetSHA256 = hostPin(map[string]string{\n   133\t\t\"darwin/arm64\": \"sha256:59a97baa8db98487dac40abe058ac89865e1ea2cf3d66c6d94cb622e7119d2a7\",\n   134\t\t\"linux/amd64\":  \"sha256:59a97baa8db98487dac40abe058ac89865e1ea2cf3d66c6d94cb622e7119d2a7\",\n   135\t})\n   136\t\n   137\tfunc prepareGRPC(moduleCache, root string, identity gomadversion.AdapterIdentity) (adapterPreparation, error) {\n   138\t\tif identity.Module != grpcModulePath || identity.Version != grpcVersion || identity.Sum != grpcSum {\n   139\t\t\treturn adapterPreparation{}, errors.New(\"gRPC adapter identity mismatch\")\n   140\t\t}\n   141\t\tmoduleSource, err := filepath.EvalSymlinks(filepath.Join(moduleCache, \"google.golang.org\", \"grpc@\"+identity.Version))\n   142\t\tif err != nil {\n   143\t\t\treturn adapterPreparation{}, fmt.Errorf(\"resolve pinned gRPC module: %w\", err)\n   144\t\t}\n   145\t\tif err := verifyGRPCModule(moduleSource); err != nil {\n   146\t\t\treturn adapterPreparation{}, err\n   147\t\t}\n   148\t\tsource := filepath.Join(moduleSource, filepath.FromSlash(grpcKeepalivePath))\n   149\t\tcontents, err := readGRPCAdapterSource(moduleSource, grpcKeepalivePath)\n   150\t\tif err != nil {\n   151\t\t\treturn adapterPreparation{}, err\n   152\t\t}\n   153\t\trewritten, err := rewriteGRPCKeepalive(contents)\n   154\t\tif err != nil {\n   155\t\t\treturn adapterPreparation{}, err\n   156\t\t}\n   157\t\treplacements := map[string][]byte{grpcKeepalivePath: rewritten}\n   158\t\tfor _, rewrite := range grpcLinuxRewrites {\n   159\t\t\tlinuxSource, err := readGRPCAdapterSource(moduleSource, rewrite.linuxPath)\n   160\t\t\tif err != nil {\n   161\t\t\t\treturn adapterPreparation{}, err\n   162\t\t\t}\n   163\t\t\tnonLinuxSource, err := readGRPCAdapterSource(moduleSource, rewrite.nonLinuxPath)\n   164\t\t\tif err != nil {\n   165\t\t\t\treturn adapterPreparation{}, err\n   166\t\t\t}\n   167\t\t\treplacements[rewrite.linuxPath], err = rewriteGRPCLinuxSource(rewrite, linuxSource, nonLinuxSource)\n   168\t\t\tif err != nil {\n   169\t\t\t\treturn adapterPreparation{}, err\n   170\t\t\t}\n   171\t\t}\n   172\t\tfor _, rewrites := range [][]sourceRewrite{grpcSyscallRewrites, grpcDNSRewrites} {\n   173\t\t\tfor _, rewrite := range rewrites {\n   174\t\t\t\tportableSource, err := readGRPCAdapterSource(moduleSource, rewrite.path)\n   175\t\t\t\tif err != nil {\n   176\t\t\t\t\treturn adapterPreparation{}, err\n   177\t\t\t\t}\n   178\t\t\t\treplacements[rewrite.path], err = rewriteAdapterSource(grpcModulePath, rewrite, portableSource)\n   179\t\t\t\tif err != nil {\n   180\t\t\t\t\treturn adapterPreparation{}, err\n   181\t\t\t\t}\n   182\t\t\t}\n   183\t\t}\n   184\t\tmoduleReplacement := filepath.Join(root, \"google-grpc\")\n   185\t\tif err := copyAdapterModule(moduleSource, moduleReplacement, replacements, defaultAdapterCopyLimits); err != nil {\n   186\t\t\treturn adapterPreparation{}, fmt.Errorf(\"copy gRPC adapter module: %w\", err)\n   187\t\t}\n   188\t\treplacementInventory, err := digestAdapterSourceInventory(moduleReplacement)\n   189\t\tif err != nil {\n   190\t\t\treturn adapterPreparation{}, fmt.Errorf(\"hash gRPC replacement inventory: %w\", err)\n   191\t\t}\n   192\t\tif replacementInventory != grpcReplacementSourceInventorySHA256 {\n   193\t\t\treturn adapterPreparation{}, fmt.Errorf(\"gRPC replacement inventory identity mismatch: got %s, want %s\", replacementInventory, grpcReplacementSourceInventorySHA256)\n   194\t\t}\n   195\t\treturn adapterPreparation{\n   196\t\t\treplacement: moduleReplacement,\n   197\t\t\tevidence: BuildAdapter{\n   198\t\t\t\tModule: identity.Module, Version: identity.Version, Sum: identity.Sum,\n   199\t\t\t\tSource: source, ReplacementRoot: moduleReplacement, Replacement: filepath.Join(moduleReplacement, filepath.FromSlash(grpcKeepalivePath)),\n   200\t\t\t\tPreparedPackage:                  grpcModulePath + \"/internal\",\n   201\t\t\t\tSourceSHA256:                     grpcKeepaliveSourceSHA256,\n   202\t\t\t\tReplacementSHA256:                grpcKeepaliveReplacementSHA256,\n   203\t\t\t\tOriginalSourceInventorySHA256:    grpcOriginalSourceInventorySHA256,\n   204\t\t\t\tReplacementSourceInventorySHA256: replacementInventory,\n   205\t\t\t\tPreparedSourceSetSHA256:          grpcPreparedInternalSourceSetSHA256,\n   206\t\t\t},\n   207\t\t}, nil\n   208\t}\n   209\t\n   210\tfunc verifyGRPCModule(moduleRoot string) error {\n   211\t\tinventory, err := digestAdapterSourceInventory(moduleRoot)\n   212\t\tif err != nil {\n   213\t\t\treturn fmt.Errorf(\"hash pinned gRPC source inventory: %w\", err)\n   214\t\t}\n   215\t\tif inventory != grpcOriginalSourceInventorySHA256 {\n   216\t\t\treturn fmt.Errorf(\"pinned gRPC source inventory identity mismatch: got %s, want %s\", inventory, grpcOriginalSourceInventorySHA256)\n   217\t\t}\n   218\t\treturn nil\n   219\t}\n   220\t\n   221\tfunc readGRPCAdapterSource(moduleRoot, relative string) ([]byte, error) {\n   222\t\tpath := filepath.Join(moduleRoot, filepath.FromSlash(relative))\n   223\t\tinfo, err := os.Lstat(path)\n   224\t\tif err != nil || !info.Mode().IsRegular() {\n   225\t\t\treturn nil, fmt.Errorf(\"pinned gRPC source is not a regular file: %s\", relative)\n   226\t\t}\n   227\t\tcontents, err := os.ReadFile(path)\n   228\t\tif err != nil {\n   229\t\t\treturn nil, fmt.Errorf(\"read pinned gRPC source %s: %w\", relative, err)\n   230\t\t}\n   231\t\treturn contents, nil\n   232\t}\n   233\t\n   234\tfunc rewriteGRPCLinuxSource(rewrite grpcLinuxRewrite, linuxSource, nonLinuxSource []byte) ([]byte, error) {\n   235\t\tif digestBytes(linuxSource) != rewrite.linuxSHA256 || digestBytes(nonLinuxSource) != rewrite.nonLinuxSHA256 {\n   236\t\t\treturn nil, fmt.Errorf(\"pinned gRPC source identity mismatch for %s\", rewrite.linuxPath)\n   237\t\t}\n   238\t\trewritten, err := regenerateGRPCLinuxSource(rewrite, nonLinuxSource)\n   239\t\tif err != nil {\n   240\t\t\treturn nil, err\n   241\t\t}\n   242\t\tif got := digestBytes(rewritten); got != rewrite.replacementSHA256 {\n   243\t\t\treturn nil, fmt.Errorf(\"gRPC replacement identity mismatch for %s: got %s, want %s\", rewrite.linuxPath, got, rewrite.replacementSHA256)\n   244\t\t}\n   245\t\treturn rewritten, nil\n   246\t}\n   247\t\n   248\tfunc regenerateGRPCLinuxSource(rewrite grpcLinuxRewrite, nonLinuxSource []byte) ([]byte, error) {\n   249\t\treturn regenerateSourceRewrite(grpcModulePath, sourceRewrite{path: rewrite.nonLinuxPath, rewrites: []anchorRewrite{{anchor: rewrite.constraint, replacement: rewrite.replacement}}}, nonLinuxSource)\n   250\t}\n   251\t\n   252\tfunc rewriteGRPCKeepalive(contents []byte) ([]byte, error) {\n   253\t\tif digestBytes(contents) != grpcKeepaliveSourceSHA256 {\n   254\t\t\treturn nil, errors.New(\"pinned gRPC keepalive source identity mismatch\")\n   255\t\t}\n   256\t\trewritten, err := rewriteGRPCKeepaliveSource(contents)\n   257\t\tif err != nil {\n   258\t\t\treturn nil, err\n   259\t\t}\n   260\t\tif digestBytes(rewritten) != grpcKeepaliveReplacementSHA256 {\n     1\tpackage deterministicio\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t_ \"embed\"\n     6\t\t\"errors\"\n     7\t\t\"fmt\"\n     8\t\t\"go/ast\"\n     9\t\t\"go/parser\"\n    10\t\t\"go/token\"\n    11\t\t\"os\"\n    12\t\t\"path/filepath\"\n    13\t\t\"slices\"\n    14\t\t\"strings\"\n    15\t\n    16\t\tgomadversion \"go.temporal.io/server/tools/gomad3/toolchain/version\"\n    17\t)\n    18\t\n    19\tconst (\n    20\t\tlibcModulePath         = \"modernc.org/libc\"\n    21\t\tlibcDarwinSHA256       = \"sha256:46fc04624c96033980a81d8eeb9b4d73daff0c6cae511931456f2c72a75fcb7e\"\n    22\t\tlibcDarwinArm64SHA256  = \"sha256:6c725881029bda79d32b8e29be850b45ec8e359a0d5d2f52bc634f93dcae4e99\"\n    23\t\tlibcUnixSHA256         = \"sha256:b4350edb7222f6f4e2a8f8eb079ab0fbbc18e2be74762b68b17205ac3ead4f4a\"\n    24\t\tgomadLibcAdapterSHA256 = \"sha256:a9014a11afc7a01ae9bb2ca3dee617f29046ec012d7ea6867c3f0f47d9468a8f\"\n    25\t\t// The linux/amd64 build is a musl translation that reaches the kernel only\n    26\t\t// through the trampolines in syscall_musl.go, so the Linux model hooks the\n    27\t\t// syscall number there instead of individual libc functions.\n    28\t\tlibcSyscallMuslSHA256       = \"sha256:16a646a7d874493b0145fb13a45458c5b59eb9a131b975c93392a3f44b605578\"\n    29\t\tlibcMuslSHA256              = \"sha256:2ae49f1d62addfa66305cd75b1ed67cee20cd0adb7bbff52ddf166b2e0e82d92\"\n    30\t\tlibcMuslLinuxAmd64SHA256    = \"sha256:97cd9c7f1c6f1063e29685cf115c8f3f0530b3b9ce992935035dd52800fca8b1\"\n    31\t\tgomadLibcLinuxAdapterSHA256 = \"sha256:0bb1c8c9679070bd824ad53510742a6a1ee3177bd5b70162859c5d0ebfacf2c0\"\n    32\t)\n    33\t\n    34\t// Both platforms' sources are rewritten in every copy; the prepared source set\n    35\t// differs because each platform compiles its own file set.\n    36\tvar libcPreparedSourceSetSHA256 = hostPin(map[string]string{\n    37\t\t\"darwin/arm64\": \"sha256:a28d47a51089e7cb3766f0997e472feb1e7cadfca43248a3e5b06f332df47935\",\n    38\t\t\"linux/amd64\":  \"sha256:2fd5cdb4987b3319011b56c1244100a8479a51a65ad561357aaea93db4c9aa9b\",\n    39\t})\n    40\t\n    41\tfunc prepareModerncLibc(moduleCache, root string, identity gomadversion.AdapterIdentity) (adapterPreparation, error) {\n    42\t\tmoduleSource, err := filepath.EvalSymlinks(filepath.Join(moduleCache, \"modernc.org\", \"libc@\"+identity.Version))\n    43\t\tif err != nil {\n    44\t\t\treturn adapterPreparation{}, fmt.Errorf(\"resolve pinned modernc libc module: %w\", err)\n    45\t\t}\n    46\t\toriginalInventory, err := digestAdapterSourceInventory(moduleSource)\n    47\t\tif err != nil {\n    48\t\t\treturn adapterPreparation{}, fmt.Errorf(\"hash pinned modernc libc source inventory: %w\", err)\n    49\t\t}\n    50\t\trewrites, source, err := rewriteLibcModule(moduleSource)\n    51\t\tif err != nil {\n    52\t\t\treturn adapterPreparation{}, err\n    53\t\t}\n    54\t\tmoduleReplacement := filepath.Join(root, \"modernc-libc\")\n    55\t\treplacement, err := copyLibcModule(moduleSource, moduleReplacement, rewrites)\n    56\t\tif err != nil {\n    57\t\t\treturn adapterPreparation{}, err\n    58\t\t}\n    59\t\treplacementInventory, err := digestAdapterSourceInventory(moduleReplacement)\n    60\t\tif err != nil {\n    61\t\t\treturn adapterPreparation{}, fmt.Errorf(\"hash modernc libc replacement inventory: %w\", err)\n    62\t\t}\n    63\t\treturn adapterPreparation{\n    64\t\t\treplacement: moduleReplacement,\n    65\t\t\tevidence: BuildAdapter{\n    66\t\t\t\tModule: identity.Module, Version: identity.Version, Sum: identity.Sum,\n    67\t\t\t\tSource: source, ReplacementRoot: moduleReplacement, Replacement: replacement, SourceSHA256: libcDarwinSHA256,\n    68\t\t\t\tPreparedPackage:                  libcModulePath,\n    69\t\t\t\tReplacementSHA256:                digestBytes(rewrites[\"libc_darwin.go\"]),\n    70\t\t\t\tOriginalSourceInventorySHA256:    originalInventory,\n    71\t\t\t\tReplacementSourceInventorySHA256: replacementInventory,\n    72\t\t\t\tPreparedSourceSetSHA256:          libcPreparedSourceSetSHA256,\n    73\t\t\t},\n    74\t\t}, nil\n    75\t}\n    76\t\n    77\tfunc rewriteLibcModule(moduleSource string) (map[string][]byte, string, error) {\n    78\t\treturn rewriteLibcModuleWithIdentity(moduleSource, true)\n    79\t}\n    80\t\n    81\tfunc rewriteLibcModuleUnpinned(moduleSource string) (map[string][]byte, string, error) {\n    82\t\treturn rewriteLibcModuleWithIdentity(moduleSource, false)\n    83\t}\n    84\t\n    85\tfunc rewriteLibcModuleWithIdentity(moduleSource string, verifyIdentity bool) (map[string][]byte, string, error) {\n    86\t\tif digestBytes([]byte(gomadLibcAdapterSource)) != gomadLibcAdapterSHA256 || digestBytes([]byte(gomadLibcLinuxAdapterSource)) != gomadLibcLinuxAdapterSHA256 {\n    87\t\t\treturn nil, \"\", errors.New(\"modernc libc adapter template identity mismatch\")\n    88\t\t}\n    89\t\tidentities := map[string]string{\n    90\t\t\t\"libc_darwin.go\":           libcDarwinSHA256,\n    91\t\t\t\"libc_darwin_arm64.go\":     libcDarwinArm64SHA256,\n    92\t\t\t\"libc_unix.go\":             libcUnixSHA256,\n    93\t\t\t\"syscall_musl.go\":          libcSyscallMuslSHA256,\n    94\t\t\t\"libc_musl.go\":             libcMuslSHA256,\n    95\t\t\t\"libc_musl_linux_amd64.go\": libcMuslLinuxAmd64SHA256,\n    96\t\t}\n    97\t\trewrites := make(map[string][]byte, len(identities)+2)\n    98\t\tfor relative, identity := range identities {\n    99\t\t\tpath := filepath.Join(moduleSource, relative)\n   100\t\t\tinfo, err := os.Lstat(path)\n   101\t\t\tif err != nil || !info.Mode().IsRegular() {\n   102\t\t\t\treturn nil, \"\", fmt.Errorf(\"pinned modernc libc source %q is not a regular file\", relative)\n   103\t\t\t}\n   104\t\t\tcontents, err := os.ReadFile(path)\n   105\t\t\tif err != nil {\n   106\t\t\t\treturn nil, \"\", fmt.Errorf(\"read pinned modernc libc source %q: %w\", relative, err)\n   107\t\t\t}\n   108\t\t\tif verifyIdentity && digestBytes(contents) != identity {\n   109\t\t\t\treturn nil, \"\", fmt.Errorf(\"pinned modernc libc source %q identity mismatch\", relative)\n   110\t\t\t}\n   111\t\t\trewrites[relative] = contents\n   112\t\t}\n   113\t\tfor relative, refusal := range libcHostRefusals {\n   114\t\t\trefused, err := refuseLibcHostFunctions(rewrites[relative], refusal)\n   115\t\t\tif err != nil {\n   116\t\t\t\treturn nil, \"\", fmt.Errorf(\"rewrite pinned modernc libc source %q: %w\", relative, err)\n   117\t\t\t}\n   118\t\t\trewrites[relative] = refused\n   119\t\t}\n   120\t\tvar err error\n   121\t\trewrites[\"libc_darwin.go\"], err = rewriteLibcDarwin(rewrites[\"libc_darwin.go\"])\n   122\t\tif err != nil {\n   123\t\t\treturn nil, \"\", err\n   124\t\t}\n   125\t\trewrites[\"libc_darwin_arm64.go\"], err = rewriteLibcDarwinArm64(rewrites[\"libc_darwin_arm64.go\"])\n   126\t\tif err != nil {\n   127\t\t\treturn nil, \"\", err\n   128\t\t}\n   129\t\trewrites[\"libc_unix.go\"], err = rewriteLibcUnix(rewrites[\"libc_unix.go\"])\n   130\t\tif err != nil {\n   131\t\t\treturn nil, \"\", err\n   132\t\t}\n   133\t\trewrites[\"syscall_musl.go\"], err = rewriteLibcSyscallMusl(rewrites[\"syscall_musl.go\"])\n   134\t\tif err != nil {\n   135\t\t\treturn nil, \"\", err\n   136\t\t}\n   137\t\tfor _, relative := range []string{\"libc_musl.go\", \"libc_musl_linux_amd64.go\"} {\n   138\t\t\trewrites[relative], err = denyHostCapabilityCalls(rewrites[relative])\n   139\t\t\tif err != nil {\n   140\t\t\t\treturn nil, \"\", err\n   141\t\t\t}\n   142\t\t}\n   143\t\trewrites[\"gomad_darwin.go\"] = []byte(gomadLibcAdapterSource)\n   144\t\trewrites[\"gomad_linux.go\"] = []byte(gomadLibcLinuxAdapterSource)\n   145\t\tif err := rejectLibcHostImports(rewrites); err != nil {\n   146\t\t\treturn nil, \"\", err\n   147\t\t}\n   148\t\treturn rewrites, filepath.Join(moduleSource, \"libc_darwin.go\"), nil\n   149\t}\n   150\t\n   151\t// libcHostRefusal names the functions of one pinned source whose whole body is\n   152\t// replaced by an unconditional refusal, and the imports only those bodies used.\n   153\ttype libcHostRefusal struct {\n   154\t\tfunctions []string\n   155\t\timports   []string\n   156\t}\n   157\t\n   158\t// libcHostRefusals detach the prepared module from subprocesses and signal\n   159\t// delivery: a deterministic target has no host command to run and no signal\n   160\t// to receive, so system, pause, and signal refuse instead of importing\n   161\t// os/exec or os/signal.\n   162\tvar libcHostRefusals = map[string]libcHostRefusal{\n   163\t\t\"libc_darwin.go\": {functions: []string{\"Xpause\", \"Xsystem\"}, imports: []string{\"os/exec\", \"os/signal\"}},\n   164\t\t\"libc_unix.go\":   {functions: []string{\"Xsignal\"}, imports: []string{\"modernc.org/libc/signal\", \"os/signal\"}},\n   165\t\t\"libc_musl.go\":   {functions: []string{\"Xsignal\", \"Xsystem\"}, imports: []string{\"os/exec\", \"os/signal\"}},\n   166\t}\n   167\t\n   168\t// libcForbiddenHostImports are never admitted by a compatibility pack, so no\n   169\t// rewritten libc source may keep them.\n   170\tvar libcForbiddenHostImports = []string{\"os/exec\", \"os/signal\", \"os/user\"}\n   171\t\n   172\tfunc refuseLibcHostFunctions(contents []byte, refusal libcHostRefusal) ([]byte, error) {\n   173\t\tfiles := token.NewFileSet()\n   174\t\tparsed, err := parser.ParseFile(files, \"libc.go\", contents, parser.ImportsOnly|parser.ParseComments)\n   175\t\tif err != nil {\n   176\t\t\treturn nil, fmt.Errorf(\"parse imports: %w\", err)\n   177\t\t}\n   178\t\ttype edit struct {\n   179\t\t\tstart, end int\n   180\t\t\ttext       string\n   181\t\t}\n   182\t\tvar edits []edit\n   183\t\tfor _, path := range refusal.imports {\n   184\t\t\tmatches := 0\n   185\t\t\tfor _, spec := range parsed.Imports {\n   186\t\t\t\tif strings.Trim(spec.Path.Value, \"\\\"\") != path {\n   187\t\t\t\t\tcontinue\n   188\t\t\t\t}\n   189\t\t\t\tmatches++\n   190\t\t\t\tstart := files.Position(spec.Pos()).Offset\n   191\t\t\t\tstart = bytes.LastIndexByte(contents[:start], '\\n') + 1\n   192\t\t\t\tend := files.Position(spec.End()).Offset\n   193\t\t\t\tnewline := bytes.IndexByte(contents[end:], '\\n')\n   194\t\t\t\tif newline < 0 {\n   195\t\t\t\t\treturn nil, fmt.Errorf(\"import %q is not on its own line\", path)\n   196\t\t\t\t}\n   197\t\t\t\tedits = append(edits, edit{start: start, end: end + newline + 1})\n   198\t\t\t}\n   199\t\t\tif matches != 1 {\n   200\t\t\t\treturn nil, fmt.Errorf(\"import %q occurs %d times, want 1\", path, matches)\n   201\t\t\t}\n   202\t\t}\n   203\t\tparsed, err = parser.ParseFile(files, \"libc.go\", contents, 0)\n   204\t\tif err != nil {\n   205\t\t\treturn nil, fmt.Errorf(\"parse source: %w\", err)\n   206\t\t}\n   207\t\tfor _, name := range refusal.functions {\n   208\t\t\tmatches := 0\n   209\t\t\tfor _, declaration := range parsed.Decls {\n   210\t\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n   211\t\t\t\tif !ok || function.Recv != nil || function.Name.Name != name || function.Body == nil {\n   212\t\t\t\t\tcontinue\n   213\t\t\t\t}\n   214\t\t\t\tmatches++\n   215\t\t\t\tedits = append(edits, edit{\n   216\t\t\t\t\tstart: files.Position(function.Body.Lbrace).Offset + 1,\n   217\t\t\t\t\tend:   files.Position(function.Body.Rbrace).Offset,\n   218\t\t\t\t\ttext:  \"\\n\\tpanic(\\\"gomad: unsupported modernc libc host capability: \" + name + \"\\\")\\n\",\n   219\t\t\t\t})\n   220\t\t\t}\n   221\t\t\tif matches != 1 {\n   222\t\t\t\treturn nil, fmt.Errorf(\"function %s occurs %d times, want 1\", name, matches)\n   223\t\t\t}\n   224\t\t}\n   225\t\tslices.SortFunc(edits, func(a, b edit) int { return a.start - b.start })\n   226\t\tvar result bytes.Buffer\n   227\t\tprevious := 0\n   228\t\tfor _, edit := range edits {\n   229\t\t\tif edit.start < previous {\n   230\t\t\t\treturn nil, errors.New(\"host refusal edits overlap\")\n   231\t\t\t}\n   232\t\t\tresult.Write(contents[previous:edit.start])\n   233\t\t\tresult.WriteString(edit.text)\n   234\t\t\tprevious = edit.end\n   235\t\t}\n   236\t\tresult.Write(contents[previous:])\n   237\t\treturn result.Bytes(), nil\n   238\t}\n   239\t\n   240\tfunc rejectLibcHostImports(rewrites map[string][]byte) error {\n   241\t\tfor relative, contents := range rewrites {\n   242\t\t\tparsed, err := parser.ParseFile(token.NewFileSet(), relative, contents, parser.ImportsOnly)\n   243\t\t\tif err != nil {\n   244\t\t\t\treturn fmt.Errorf(\"parse rewritten modernc libc source %q: %w\", relative, err)\n   245\t\t\t}\n   246\t\t\tfor _, spec := range parsed.Imports {\n   247\t\t\t\tif path := strings.Trim(spec.Path.Value, \"\\\"\"); slices.Contains(libcForbiddenHostImports, path) {\n   248\t\t\t\t\treturn fmt.Errorf(\"rewritten mode