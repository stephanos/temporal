otelSDKVersion, sum: otelSDKSum, replacementDirectory: \"otel-sdk\", originalInventorySHA256: otelSDKOriginalSourceInventorySHA256, replacementInventorySHA256: otelSDKReplacementSourceInventorySHA256, preparedPackage: otelSDKModulePath + \"/resource\", rewrites: otelSDKRewrites}\n    65\t\tcase sockaddrModulePath:\n    66\t\t\tspec = rewrittenModule{module: module, version: sockaddrVersion, sum: sockaddrSum, replacementDirectory: \"go-sockaddr\", originalInventorySHA256: sockaddrOriginalSourceInventorySHA256, replacementInventorySHA256: sockaddrReplacementSourceInventorySHA256, preparedPackage: sockaddrModulePath, rewrites: sockaddrRewrites}\n    67\t\tcase memoryModulePath:\n    68\t\t\tspec = rewrittenModule{module: module, version: memoryVersion, sum: memorySum, replacementDirectory: \"modernc-memory\", originalInventorySHA256: memoryOriginalSourceInventorySHA256, replacementInventorySHA256: memoryReplacementSourceInventorySHA256, preparedPackage: memoryModulePath, rewrites: memoryRewrites}\n    69\t\tcase grpcModulePath:\n    70\t\t\treturn regenerateGRPC(moduleRoot, workRoot, version, sum)\n    71\t\tcase xnetModulePath:\n    72\t\t\treturn regenerateXNet(moduleRoot, workRoot, version, sum)\n    73\t\tcase libcModulePath:\n    74\t\t\treturn regenerateLibc(moduleRoot, workRoot, version, sum)\n    75\t\tdefault:\n    76\t\t\treturn AdapterRegeneration{}, fmt.Errorf(\"adapter %s is not registered\", module)\n    77\t\t}\n    78\t\tresult, err := regenerateRewrittenModule(moduleRoot, workRoot, spec)\n    79\t\tif err != nil {\n    80\t\t\treturn AdapterRegeneration{}, err\n    81\t\t}\n    82\t\tresult.Version, result.Sum = version, sum\n    83\t\treturn result, nil\n    84\t}\n    85\t\n    86\tfunc regenerateRewrittenModule(moduleRoot, workRoot string, spec rewrittenModule) (AdapterRegeneration, error) {\n    87\t\tresult := AdapterRegeneration{Module: spec.module, SourceFile: adapterSourceFile(spec.module), OldOriginalInventorySHA256: spec.originalInventorySHA256, OldReplacementInventorySHA256: spec.replacementInventorySHA256}\n    88\t\tvar err error\n    89\t\tresult.OriginalInventorySHA256, err = digestAdapterSourceInventory(moduleRoot)\n    90\t\tif err != nil {\n    91\t\t\treturn AdapterRegeneration{}, err\n    92\t\t}\n    93\t\treplacements := make(map[string][]byte, len(spec.rewrites))\n    94\t\tfor _, rewrite := range spec.rewrites {\n    95\t\t\tcontents, err := readAdapterSource(spec.module, moduleRoot, rewrite.path)\n    96\t\t\tif err != nil {\n    97\t\t\t\treturn AdapterRegeneration{}, err\n    98\t\t\t}\n    99\t\t\trewritten, err := regenerateSourceRewrite(spec.module, rewrite, contents)\n   100\t\t\tif err != nil {\n   101\t\t\t\treturn AdapterRegeneration{}, err\n   102\t\t\t}\n   103\t\t\treplacements[rewrite.path] = rewritten\n   104\t\t\tresult.Sources = append(result.Sources, RegeneratedSource{Path: rewrite.path, OldSourceSHA256: rewrite.sourceSHA256, SourceSHA256: digestBytes(contents), OldReplacementSHA256: rewrite.replacementSHA256, ReplacementSHA256: digestBytes(rewritten), Source: contents, Replacement: rewritten})\n   105\t\t}\n   106\t\treturn finishAdapterRegeneration(moduleRoot, workRoot, spec, result, replacements)\n   107\t}\n   108\t\n   109\tfunc finishAdapterRegeneration(moduleRoot, workRoot string, spec rewrittenModule, result AdapterRegeneration, replacements map[string][]byte) (AdapterRegeneration, error) {\n   110\t\tresult.ReplacementRoot = filepath.Join(workRoot, spec.replacementDirectory)\n   111\t\tif err := os.MkdirAll(workRoot, 0o700); err != nil {\n   112\t\t\treturn AdapterRegeneration{}, err\n   113\t\t}\n   114\t\tif err := copyAdapterModule(moduleRoot, result.ReplacementRoot, replacements, defaultAdapterCopyLimits); err != nil {\n   115\t\t\treturn AdapterRegeneration{}, err\n   116\t\t}\n   117\t\tvar err error\n   118\t\tresult.ReplacementInventorySHA256, err = digestAdapterSourceInventory(result.ReplacementRoot)\n   119\t\tif err != nil {\n   120\t\t\treturn AdapterRegeneration{}, err\n   121\t\t}\n   122\t\tresult.PreparedSourceSets = map[string]string{}\n   123\t\tfor _, platform := range []struct{ host, goos, goarch string }{{\"darwin/arm64\", \"darwin\", \"arm64\"}, {\"linux/amd64\", \"linux\", \"amd64\"}} {\n   124\t\t\tcontext := build.Default\n   125\t\t\tcontext.GOOS, context.GOARCH, context.CgoEnabled = platform.goos, platform.goarch, false\n   126\t\t\tcontext.BuildTags = []string{\"gomad\", \"hashicorpmetrics\", \"integration\", \"test_dep\"}\n   127\t\t\tpackageDir := filepath.Join(result.ReplacementRoot, strings.TrimPrefix(spec.preparedPackage, spec.module))\n   128\t\t\tpkg, err := context.ImportDir(packageDir, 0)\n   129\t\t\tif err != nil {\n   130\t\t\t\treturn AdapterRegeneration{}, fmt.Errorf(\"select %s source set on %s: %w\", spec.preparedPackage, platform.host, err)\n   131\t\t\t}\n   132\t\t\tnames := append([]string{}, pkg.GoFiles...)\n   133\t\t\tnames = append(names, pkg.CgoFiles...)\n   134\t\t\tslices.Sort(names)\n   135\t\t\tsources := make([]compatibility.Source, 0, len(names))\n   136\t\t\tfor _, name := range names {\n   137\t\t\t\tcontents, err := os.ReadFile(filepath.Join(packageDir, name))\n   138\t\t\t\tif err != nil {\n   139\t\t\t\t\treturn AdapterRegeneration{}, err\n   140\t\t\t\t}\n   141\t\t\t\tsources = append(sources, compatibility.Source{Name: name, SHA256: digestBytes(contents)})\n   142\t\t\t}\n   143\t\t\tresult.PreparedSourceSets[platform.host] = compatibility.DigestSources(sources)\n   144\t\t}\n   145\t\treturn result, nil\n   146\t}\n   147\t\n   148\tfunc adapterSourceFile(module string) string {\n   149\t\tswitch module {\n   150\t\tcase sprigModulePath:\n   151\t\t\treturn \"sprig_adapter.go\"\n   152\t\tcase validatorModulePath:\n   153\t\t\treturn \"validator_adapter.go\"\n   154\t\tcase pebbleModulePath:\n   155\t\t\treturn \"pebble_adapter.go\"\n   156\t\tcase cactusStatsDModulePath:\n   157\t\t\treturn \"cactusstatsd_adapter.go\"\n   158\t\tcase memberlistModulePath:\n   159\t\t\treturn \"memberlist_adapter.go\"\n   160\t\tcase sentryModulePath:\n   161\t\t\treturn \"sentry_adapter.go\"\n   162\t\tcase hashicorpMetricsModulePath:\n   163\t\t\treturn \"hashicorpmetrics_adapter.go\"\n   164\t\tcase fxModulePath:\n   165\t\t\treturn \"fx_adapter.go\"\n   166\t\tcase temporalSDKModulePath:\n   167\t\t\treturn \"temporalsdk_adapter.go\"\n   168\t\tcase otelSDKModulePath:\n   169\t\t\treturn \"otelsdk_adapter.go\"\n   170\t\tcase sockaddrModulePath:\n   171\t\t\treturn \"sockaddr_adapter.go\"\n   172\t\tcase memoryModulePath:\n   173\t\t\treturn \"memory_adapter.go\"\n   174\t\tcase grpcModulePath:\n   175\t\t\treturn \"grpc_adapter.go\"\n   176\t\tcase xnetModulePath:\n   177\t\t\treturn \"xnet_adapter.go\"\n   178\t\tcase libcModulePath:\n   179\t\t\treturn \"libc_adapter.go\"\n   180\t\tdefault:\n   181\t\t\treturn \"\"\n   182\t\t}\n   183\t}\n   184\t\n   185\tfunc addRegeneratedSource(result *AdapterRegeneration, path, oldSource, oldReplacement string, source, replacement []byte) {\n   186\t\tresult.Sources = append(result.Sources, RegeneratedSource{Path: path, OldSourceSHA256: oldSource, SourceSHA256: digestBytes(source), OldReplacementSHA256: oldReplacement, ReplacementSHA256: digestBytes(replacement), Source: source, Replacement: replacement})\n   187\t}\n   188\t\n   189\tfunc regenerateGRPC(moduleRoot, workRoot, version, sum string) (AdapterRegeneration, error) {\n   190\t\tresult := AdapterRegeneration{Module: grpcModulePath, SourceFile: adapterSourceFile(grpcModulePath), Version: version, Sum: sum, OldOriginalInventorySHA256: grpcOriginalSourceInventorySHA256, OldReplacementInventorySHA256: grpcReplacementSourceInventorySHA256}\n   191\t\tvar err error\n   192\t\tresult.OriginalInventorySHA256, err = digestAdapterSourceInventory(moduleRoot)\n   193\t\tif err != nil {\n   194\t\t\treturn AdapterRegeneration{}, err\n   195\t\t}\n   196\t\treplacements := map[string][]byte{}\n   197\t\tkeepalive, err := readAdapterSource(grpcModulePath, moduleRoot, grpcKeepalivePath)\n   198\t\tif err != nil {\n   199\t\t\treturn AdapterRegeneration{}, err\n   200\t\t}\n   201\t\treplacements[grpcKeepalivePath], err = rewriteGRPCKeepaliveSource(keepalive)\n   202\t\tif err != nil {\n   203\t\t\treturn AdapterRegeneration{}, err\n   204\t\t}\n   205\t\taddRegeneratedSource(&result, grpcKeepalivePath, grpcKeepaliveSourceSHA256, grpcKeepaliveReplacementSHA256, keepalive, replacements[grpcKeepalivePath])\n   206\t\tfor _, rewrite := range grpcLinuxRewrites {\n   207\t\t\tlinux, err := readAdapterSource(grpcModulePath, moduleRoot, rewrite.linuxPath)\n   208\t\t\tif err != nil {\n   209\t\t\t\treturn AdapterRegeneration{}, err\n   210\t\t\t}\n   211\t\t\tnonLinux, err := readAdapterSource(grpcModulePath, moduleRoot, rewrite.nonLinuxPath)\n   212\t\t\tif err != nil {\n   213\t\t\t\treturn AdapterRegeneration{}, err\n   214\t\t\t}\n   215\t\t\treplacements[rewrite.linuxPath], err = regenerateGRPCLinuxSource(rewrite, nonLinux)\n   216\t\t\tif err != nil {\n   217\t\t\t\treturn AdapterRegeneration{}, err\n   218\t\t\t}\n   219\t\t\taddRegeneratedSource(&result, rewrite.linuxPath, rewrite.linuxSHA256, rewrite.replacementSHA256, linux, replacements[rewrite.linuxPath])\n   220\t\t\taddRegeneratedSource(&result, rewrite.nonLinuxPath, rewrite.nonLinuxSHA256, \"\", nonLinux, nonLinux)\n   221\t\t}\n   222\t\tfor _, rewrites := range [][]sourceRewrite{grpcSyscallRewrites, grpcDNSRewrites} {\n   223\t\t\tfor _, rewrite := range rewrites {\n   224\t\t\t\tcontents, err := readAdapterSource(grpcModulePath, moduleRoot, rewrite.path)\n   225\t\t\t\tif err != nil {\n   226\t\t\t\t\treturn AdapterRegeneration{}, err\n   227\t\t\t\t}\n   228\t\t\t\treplacements[rewrite.path], err = regenerateSourceRewrite(grpcModulePath, rewrite, contents)\n   229\t\t\t\tif err != nil {\n   230\t\t\t\t\treturn AdapterRegeneration{}, err\n   231\t\t\t\t}\n   232\t\t\t\taddRegeneratedSource(&result, rewrite.path, rewrite.sourceSHA256, rewrite.replacementSHA256, contents, replacements[rewrite.path])\n   233\t\t\t}\n   234\t\t}\n   235\t\treturn finishAdapterRegeneration(moduleRoot, workRoot, rewrittenModule{module: grpcModulePath, replacementDirectory: \"google-grpc\", preparedPackage: grpcModulePath + \"/internal\"}, result, replacements)\n   236\t}\n   237\t\n   238\tfunc regenerateXNet(moduleRoot, workRoot, version, sum string) (AdapterRegeneration, error) {\n   239\t\tresult := AdapterRegeneration{Module: xnetModulePath, SourceFile: adapterSourceFile(xnetModulePath), Version: version, Sum: sum, OldOriginalInventorySHA256: xnetOriginalSourceInventorySHA256, OldReplacementInventorySHA256: xnetReplacementSourceInventorySHA256}\n   240\t\tvar err error\n   241\t\tresult.OriginalInventorySHA256, err = digestAdapterSourceInventory(moduleRoot)\n   242\t\tif err != nil {\n   243\t\t\treturn AdapterRegeneration{}, err\n   244\t\t}\n   245\t\tsocket, err := readAdapterSource(xnetModulePath, moduleRoot, xnetSocketPath)\n   246\t\tif err != nil {\n   247\t\t\treturn AdapterRegeneration{}, err\n   248\t\t}\n   249\t\tempty, err := readAdapterSource(xnetModulePath, moduleRoot, xnetEmptyPath)\n   250\t\tif err != nil {\n   251\t\t\treturn AdapterRegeneration{}, err\n   252\t\t}\n   253\t\trewrittenSocket, err := rewriteXNetSocketSource(socket)\n   254\t\tif err != nil {\n   255\t\t\treturn AdapterRegeneration{}, err\n   256\t\t}\n   257\t\trewrittenEmpty, err := replaceXNetAnchor(empty, []byte(\"//go:build darwin\"), []byte(\"//go:build ignore\"))\n   258\t\tif err != nil {\n   259\t\t\treturn AdapterRegeneration{}, err\n   260\t\t}\n   261\t\taddRegeneratedSource(&result, xnetSocketPath, xnetSocketSourceSHA256, xnetSocketReplacementSHA256, socket, rewrittenSocket)\n   262\t\taddRegeneratedSource(&result, xnetEmptyPath, xnetEmptySourceSHA256, xnetEmptyReplacementSHA256, empty, rewrittenEmpty)\n   263\t\treturn finishAdapterRegeneration(moduleRoot, workRoot, rewrittenModule{module: xnetModulePath, replacementDirectory: \"golang-x-net\", preparedPackage: xnetModulePath + \"/internal/socket\"}, result, map[string][]byte{xnetSocketPath: rewrittenSocket, xnetEmptyPath: rewrittenEmpty})\n   264\t}\n   265\t\n   266\tfunc regenerateLibc(moduleRoot, workRoot, version, sum string) (AdapterRegeneration, error) {\n   267\t\tresult := AdapterRegeneration{Module: libcModulePath, SourceFile: adapterSourceFile(libcModulePath), Version: version, Sum: sum}\n   268\t\tvar err error\n   269\t\tresult.OriginalInventorySHA256, err = digestAdapterSourceInventory(moduleRoot)\n   270\t\tif err != nil {\n   271\t\t\treturn AdapterRegeneration{}, err\n   272\t\t}\n   273\t\treplacements, _, err := rewriteLibcModuleUnpinned(moduleRoot)\n   274\t\tif err != nil {\n   275\t\t\treturn AdapterRegeneration{}, err\n   276\t\t}\n   277\t\tfor _, pin := range []struct{ path, old string }{\n   278\t\t\t{\"libc_darwin.go\", libcDarwinSHA256}, {\"libc_darwin_arm64.go\", libcDarwinArm64SHA256}, {\"libc_unix.go\", libcUnixSHA256},\n   279\t\t\t{\"syscall_musl.go\", libcSyscallMuslSHA256}, {\"libc_musl.go\", libcMuslSHA256}, {\"libc_musl_linux_amd64.go\", libcMuslLinuxAmd64SHA256},\n   280\t\t} {\n   281\t\t\tcontents, err := readAdapterSource(libcModulePath, moduleRoot, pin.path)\n   282\t\t\tif err != nil {\n   283\t\t\t\treturn AdapterRegeneration{}, err\n   284\t\t\t}\n   285\t\t\taddRegeneratedSource(&result, pin.path, pin.old, \"\", contents, replacements[pin.path])\n   286\t\t}\n   287\t\treturn finishAdapterRegeneration(moduleRoot, workRoot, rewrittenModule{module: libcModulePath, replacementDirectory: \"modernc-libc\", preparedPackage: libcModulePath}, result, replacements)\n   288\t}\n","exit_code":0,"status":"completed"}}
