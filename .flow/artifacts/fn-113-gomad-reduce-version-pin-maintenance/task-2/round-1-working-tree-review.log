eturn adapterRegenerationFailure(stderr, errors.New(\"adapter-regenerate requires --module and --version\"), 2)\n    48\t\t}\n    49\t\tabsRoot, err := filepath.Abs(*root)\n    50\t\tif err != nil {\n    51\t\t\treturn adapterRegenerationFailure(stderr, err, 2)\n    52\t\t}\n    53\t\tcheckoutRoot := filepath.Clean(filepath.Join(absRoot, \"..\", \"..\"))\n    54\t\tif _, err := os.Lstat(adapterPublicationMarker(checkoutRoot)); err == nil {\n    55\t\t\tif err := withAdapterPublicationLock(checkoutRoot, func() error { return recoverAdapterPublication(checkoutRoot) }); err != nil {\n    56\t\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n    57\t\t\t}\n    58\t\t} else if !errors.Is(err, os.ErrNotExist) {\n    59\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n    60\t\t}\n    61\t\tdescriptor, err := gomadversion.Load(absRoot)\n    62\t\tif err != nil {\n    63\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n    64\t\t}\n    65\t\toldVersion, oldSum := \"\", \"\"\n    66\t\tfor _, adapter := range descriptor.Adapters {\n    67\t\t\tif adapter.Module == *module {\n    68\t\t\t\toldVersion, oldSum = adapter.Version, adapter.Sum\n    69\t\t\t\tbreak\n    70\t\t\t}\n    71\t\t}\n    72\t\tif oldVersion == \"\" {\n    73\t\t\treturn adapterRegenerationFailure(stderr, fmt.Errorf(\"adapter %s is not in the version descriptor\", *module), 2)\n    74\t\t}\n    75\t\treturn runAdapterRegenerationForPin(absRoot, checkoutRoot, *module, *version, *approval, oldVersion, oldSum, stdout, stderr)\n    76\t}\n    77\t\n    78\tfunc runAdapterRegenerationForPin(absRoot, checkoutRoot, module, version, approval, oldVersion, oldSum string, stdout, stderr io.Writer) (status int) {\n    79\t\tprivate, err := os.MkdirTemp(\"\", \"gomad-adapter-download-*\")\n    80\t\tif err != nil {\n    81\t\t\treturn adapterRegenerationFailure(stderr, err, 3)\n    82\t\t}\n    83\t\tdefer func() {\n    84\t\t\tif err := removeAdapterPrivate(private); err != nil {\n    85\t\t\t\tst