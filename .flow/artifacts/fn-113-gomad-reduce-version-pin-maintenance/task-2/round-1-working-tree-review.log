rn os.MkdirAll(destination, 0o700)\n   487\t\t\t}\n   488\t\t\tif entry.IsDir() {\n   489\t\t\t\tif relative == \".toolchain\" || relative == \".bin\" {\n   490\t\t\t\t\treturn filepath.SkipDir\n   491\t\t\t\t}\n   492\t\t\t\treturn os.MkdirAll(filepath.Join(destination, relative), 0o700)\n   493\t\t\t}\n   494\t\t\tif !entry.Type().IsRegular() {\n   495\t\t\t\treturn fmt.Errorf(\"adapter stage input is not a regular file: %s\", relative)\n   496\t\t\t}\n   497\t\t\tcontents, err := os.ReadFile(path)\n   498\t\t\tif err != nil {\n   499\t\t\t\treturn err\n   500\t\t\t}\n   501\t\t\tinfo, err := entry.Info()\n   502\t\t\tif err != nil {\n   503\t\t\t\treturn err\n   504\t\t\t}\n   505\t\t\tif err := os.WriteFile(filepath.Join(destination, relative), contents, info.Mode().Perm()); err != nil {\n   506\t\t\t\treturn err\n   507\t\t\t}\n   508\t\t\tsnapshot[relative] = publicationContent{Present: true, Bytes: contents}\n   509\t\t\treturn nil\n   510\t\t})\n   511\t\treturn snapshot, err\n   512\t}\n   513\t\n   514\tfunc editAdapterDescriptor(path, module, oldVersion, oldSum, version, sum string) error {\n   515\t\tcontents, err := os.ReadFile(path)\n   516\t\tif err != nil {\n   517\t\t\treturn err\n   518\t\t}\n   519\t\tvar descriptor gomadversion.Descriptor\n   520\t\tif err := json.Unmarshal(contents, &descriptor); err != nil {\n   521\t\t\treturn err\n   522\t\t}\n   523\t\thits := 0\n   524\t\tfor index := range descriptor.Adapters {\n   525\t\t\tadapter := &descriptor.Adapters[index]\n   526\t\t\tif adapter.Module != module {\n   527\t\t\t\tcontinue\n   528\t\t\t}\n   529\t\t\tif adapter.Version != oldVersion || adapter.Sum != oldSum {\n   530\t\t\t\treturn errors.New(\"adapter descriptor changed since planning\")\n   531\t\t\t}\n   532\t\t\tadapter.Version, adapter.Sum = version, sum\n   533\t\t\thits++\n   534\t\t}\n   535\t\tif hits != 1 {\n   536\t\t\treturn fmt.Errorf(\"adapter descriptor has %d entries for %s\", hits, module)\n   537\t\t}\n   538\t\tupdated, err := json.MarshalIndent(descriptor, \"\", \"  \")\n   539\t\tif err != nil {\n   540\t\t\treturn err\n   541\t\t}\n   542\t\treturn os.WriteFile(path, append(updated, '\\n'), 0o644)\n   543\t}\n   544\t\n   545\tfunc editAdapterFixtures(root, module, oldVersion, oldSum, oldGoModSum, version, sum, newGoModSum, privateCache string) error {\n   546\t\tvar changedModules []string\n   547\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, visitErr error) error {\n   548\t\t\tif visitErr != nil {\n   549\t\t\t\treturn visitErr\n   550\t\t\t}\n   551\t\t\tif entry.IsDir() {\n   552\t\t\t\treturn nil\n   553\t\t\t}\n   554\t\t\tif entry.Name() != \"go.mod\" && entry.Name() != \"go.sum\" {\n   555\t\t\t\treturn nil\n   556\t\t\t}\n   557\t\t\tcontents, err := os.ReadFile(path)\n   558\t\t\tif err != nil {\n   559\t\t\t\treturn err\n   560\t\t\t}\n   561\t\t\tupdated := string(contents)\n   562\t\t\tif entry.Name() == \"go.mod\" {\n   563\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion, module+\" \"+version)\n   564\t\t\t} else {\n   565\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion+\" \"+oldSum, module+\" \"+version+\" \"+sum)\n   566\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion+\"/go.mod \"+oldGoModSum, module+\" \"+version+\"/go.mod \"+newGoModSum)\n   567\t\t\t}\n   568\t\t\tif updated == string(contents) {\n   569\t\t\t\treturn nil\n   570\t\t\t}\n   571\t\t\tif entry.Name() == \"go.mod\" {\n   572\t\t\t\tchangedModules = append(changedModules, filepath.Dir(path))\n   573\t\t\t}\n   574\t\t\treturn os.WriteFile(path, []byte(updated), 0o644)\n   575\t\t})\n   576\t\tif err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tfor _, directory := range changedModules {\n   580\t\t\tcommand := exec.CommandContext(context.Background(), \"go\", \"mod\", \"tidy\")\n   581\t\t\tcommand.Dir = directory\n   582\t\t\tcommand.Env = append(os.Environ(), \"GOMODCACHE=\"+privateCache, \"GOW