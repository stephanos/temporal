prepends its GOROOT/bin to PATH.\ntest-host: toolchain\n\t@stock_go=\"$${GOMAD3_STOCK_GO:-}\"; \\\n\tif test -z \"$$stock_go\"; then \\\n\t\tstock_root=\"$$(env -u GOROOT -u GOMADSEED -u GOMAD3_CHILD_SEED GOENV=off GOFLAGS= GOWORK=off GOTOOLCHAIN=$(GOMAD3_GO_VERSION) go env GOROOT)\" || exit 1; \\\n\t\tstock_go=\"$$stock_root/bin/go\"; \\\n\tfi; \\\n\tenv -u GOMADSEED -u GOMAD3_CHILD_SEED GOMAD3_STOCK_GO=\"$$stock_go\" GOEXPERIMENT=nogreenteagc GOWORK=off .toolchain/bin/go test -tags test_dep \\\n\t\t. ./cmd/... ./runner/... ./qualification/... ./target/... ./record/... ./artifact/... ./choice/... \\\n\t\t./deterministicio/... ./world/... ./toolchain/version ./upgrade/... ./internal/...\n\n# internal/gomadsim keeps its tests external because testing reaches the\n# package through os.\noverlay-test: toolchain\n\t.toolchain/bin/go test -tags test_dep internal/gomadfs internal/gomadwire internal/gomadchoicewire internal/gomadmodelwire \\\n\t\tinternal/gomadsim internal/gomadio internal/gomadio/mount os cmd/internal/gomadcap\n\n# The gomad3_toolchain tests of the root module's tools/gomad3sim need a seeded\n# runtime, so they run through the exec wrapper. The tests that need the\n# Runner's simulation transport skip there; the integration-tagged Runner test\n# is their executor. The node-clock delay test has a recorded watchdog failure\n# and remains a finding; every other subtest runs here.\ntest-simulation: toolchain\n\tcd $(CURDIR)/../.. && env -u GOMADSEED CGO_ENABLED=0 GOEXPERIMENT=nogreenteagc GOTOOLCHAIN=local GOWORK=off TZ=UTC GOMAD3_CHILD_SEED=89 \\\n\t\t$(CURDIR)/.toolchain/bin/go test -exec $(CURDIR)/internal/gomadtool/conformance/scripts/exec.sh \\\n\t\t-count=1 -tags test_dep,gomad3_toolchain ./tools/gomad3sim\n\tenv -u GOMADSEED -u GOMAD3_CHILD_SEED GOWORK=off .toolchain/bin/go test -count=1 -tags test_dep,integration \\\n\t\t-run '^TestRootProcessSimulationUsesRunnerTransport$$/^Test(Scenario|ProcessExploration|ProcessAndInProcess|ProcessBackend(Resets|Routes|Preserves|Crash|Model))' ./runner/internal/execution\n\nworld-test:\n\tenv -u GOMADSEED -u GOMAD3_CHILD_SEED GOWORK=off go test -race -tags test_dep ./world/...\n\nvalidate: validate-toolchain validate-compatibility validate-qualification\n\nvalidate-toolchain:\n\tGOCACHE=$(CURDIR)/.toolchain/generator-cache go run ./cmd/gomadtool version-generate -check\n\tGOCACHE=$(CURDIR)/.toolchain/generator-cache go run ./cmd/gomadtool protocol-generate -check\n\tGOCACHE=$(CURDIR)/.toolchain/generator-cache go run ./cmd/gomadtool boundary-generate -check\n\tGOCACHE=$(CURDIR)/.toolchain/generator-cache go run ./cmd/gomadtool boundary-generate -check-compiler-tests\n     1\tpackage main\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"io/fs\"\n     6\t\t\"maps\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\t\"strings\"\n    10\t\t\"sync\"\n    11\t\t\"testing\"\n    12\t\n    13\t\t\"go.temporal.io/server/tools/gomad3/deterministicio\"\n    14\t)\n    15\t\n    16\tfunc TestAdapterRegenerationDryRunLeavesCheckoutUntouched(t *testing.T) {\n    17\t\tcheckout := t.TempDir()\n    18\t\troot := filepath.Join(checkout, \"tools\", \"gomad3\")\n    19\t\tpath := filepath.Join(root, \"toolchain\", \"version\", \"version.json\")\n    20\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n    21\t\t\tt.Fatal(err)\n    22\t\t}\n    23\t\tdescriptor, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"toolchain\", \"version\", \"version.json\"))\n    24\t\tif err != nil {\n    25\t\t\tt.Fatal(err)\n    26\t\t}\n    27\t\tif err := os.WriteFile(path, descriptor, 0o600); err != nil {\n    28\t\t\tt.Fatal(err)\n    29\t\t}\n    30\t\tbefore := readAdapterCheckoutTree(t, checkout)\n    31\t\tvar stdout, stderr bytes.Buffer\n    32\t\tstatus := runAdapterRegenerate([]string{\"--root=\" + root, \"--module=github.com/Masterminds/sprig/v3\", \"--version=v3.3.0\"}, &stdout, &stderr)\n    33\t\tif status != 0 {\n    34\t\t\tt.Fatalf(\"dry run status=%d: %s\", status, stderr.String())\n    35\t\t}\n    36\t\tif !strings.Contains(stdout.String(), \"Approval SHA-256:\") {\n    37\t\t\tt.Fatalf(\"dry run report = %s\", stdout.String())\n    38\t\t}\n    39\t\tupdated, err := os.ReadFile(path)\n    40\t\tif err != nil || !bytes.Equal(updated, descriptor) {\n    41\t\t\tt.Fatalf(\"dry run changed descriptor: %v\", err)\n    42\t\t}\n    43\t\tif after := readAdapterCheckoutTree(t, checkout); !maps.Equal(after, before) {\n    44\t\t\tt.Fatalf(\"dry run changed checkout tree: before=%v after=%v\", before, after)\n    45\t\t}\n    46\t\tstdout.Reset()\n    47\t\tstderr.Reset()\n    48\t\tstatus = runAdapterRegenerate([]string{\"--root=\" + root, \"--module=github.com/Masterminds/sprig/v3\", \"--version=v3.3.0\", \"--approve=sha256:wrong\"}, &stdout, &stderr)\n    49\t\tif status == 0 || !strings.Contains(stderr.String(), \"approval does not match\") {\n    50\t\t\tt.Fatalf(\"wrong approval status=%d: %s\", status, stderr.String())\n    51\t\t}\n    52\t\tif after := readAdapterCheckoutTree(t, checkout); !maps.Equal(after, before) {\n    53\t\t\tt.Fatalf(\"wrong approval changed checkout tree: before=%v after=%v\", before, after)\n    54\t\t}\n    55\t}\n    56\t\n    57\tfunc readAdapterCheckoutTree(t *testing.T, root string) map[string]string {\n    58\t\tt.Helper()\n    59\t\tentries := map[string]string{}\n    60\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, visitErr error) error {\n    61\t\t\tif visitErr != nil {\n    62\t\t\t\treturn visitErr\n    63\t\t\t}\n    64\t\t\trelative, err := filepath.Rel(root, path)\n    65\t\t\tif err != nil {\n    66\t\t\t\treturn err\n    67\t\t\t}\n    68\t\t\tif entry.IsDir() {\n    69\t\t\t\tentries[relative] = \"directory\"\n    70\t\t\t\treturn nil\n    71\t\t\t}\n    72\t\t\tcontents, err := os.ReadFile(path)\n    73\t\t\tif err != nil {\n    74\t\t\t\treturn err\n    75\t\t\t}\n    76\t\t\tentries[relative] = string(contents)\n    77\t\t\treturn nil\n    78\t\t})\n    79\t\tif err != nil {\n    80\t\t\tt.Fatal(err)\n    81\t\t}\n    82\t\treturn entries\n    83\t}\n    84\t\n    85\tfunc TestAdapterApprovalBindsUpstreamSourceAndAnchors(t *testing.T) {\n    86\t\tresult := deterministicio.AdapterRegeneration{Module: \"example.com/module\", Version: \"v1.2.3\", Sum: \"h1:example\", Sources: []deterministicio.RegeneratedSource{{Path: \"source.go\", Source: []byte(\"original\"), Replacement: []byte(\"adapted\"), SourceSHA256: \"sha256:source\", ReplacementSHA256: \"sha256:replacement\"}}}\n    87\t\tbaseline, err := adapterRegenerationApproval(result)\n    88\t\tif err != nil {\n    89\t\t\tt.Fatal(err)\n    90\t\t}\n    91\t\tresult.Sources[0].Source = []byte(\"changed upstream source\")\n    92\t\tchangedSource, err := adapterRegenerationApproval(result)\n    93\t\tif err != nil {\n    94\t\t\tt.Fatal(err)\n    95\t\t}\n    96\t\tresult.Sources[0].Source = []byte(\"original\")\n    97\t\tresult.Sources[0].Replacement = []byte(\"changed replacement\")\n    98\t\tchangedAnchor, err := adapterRegenerationApproval(result)\n    99\t\tif err != nil {\n   100\t\t\tt.Fatal(err)\n   101\t\t}\n   102\t\tif baseline == changedSource || baseline == changedAnchor {\n   103\t\t\tt.Fatalf(\"approval did not bind source and rewrite: %s, %s, %s\", baseline, changedSource, changedAnchor)\n   104\t\t}\n   105\t}\n   106\t\n   107\tfunc TestEditAdapterPinsPreservesCommentsAndRequiresOldPin(t *testing.T) {\n   108\t\tsource := []byte(\"package test\\n\\n// Preserve this comment.\\nconst old = \\\"sha256:old\\\"\\nvar prepared = map[string]string{\\\"darwin/arm64\\\": \\\"sha256:hostold\\\", \\\"linux/amd64\\\": \\\"sha256:hostold\\\"}\\n\")\n   109\t\tregenerated := deterministicio.AdapterRegeneration{Sources: []deterministicio.RegeneratedSource{{OldSourceSHA256: \"sha256:old\", SourceSHA256: \"sha256:new\"}}, PreparedSourceSets: map[string]string{\"darwin/arm64\": \"sha256:darwin\", \"linux/amd64\": \"sha256:linux\"}}\n   110\t\tresult, err := editAdapterPins(source, regenerated, \"\", \"\")\n   111\t\tif err != nil {\n   112\t\t\tt.Fatal(err)\n   113\t\t}\n   114\t\tif !strings.Contains(string(result), \"// Preserve this comment.\") || !strings.Contains(string(result), \"sha256:new\") || !strings.Contains(string(result), \"sha256:darwin\") || !strings.Contains(string(result), \"sha256:linux\") {\n   115\t\t\tt.Fatalf(\"edited source = %s\", result)\n   116\t\t}\n   117\t\tregenerated.Sources[0].OldSourceSHA256 = \"sha256:missing\"\n   118\t\tif _, err := editAdapterPins(source, regenerated, \"\", \"\"); err == nil || !strings.Contains(err.Error(), \"missing pin\") {\n   119\t\t\tt.Fatalf(\"missing pin error = %v\", err)\n   120\t\t}\n   121\t\tregenerated.Sources[0].OldSourceSHA256 = \"sha256:old\"\n   122\t\tduplicate := append(append([]byte{}, source...), []byte(\"const second = \\\"sha256:old\\\"\\n\")...)\n   123\t\tif _, err := editAdapterPins(duplicate, regenerated, \"\", \"\"); err == nil || !strings.Contains(err.Error(), \"duplicate pin\") {\n   124\t\t\tt.Fatalf(\"duplicate pin error = %v\", err)\n   125\t\t}\n   126\t}\n   127\t\n   128\tfunc TestAdapterPublicationRejectsCheckoutDrift(t *testing.T) {\n   129\t\troot := t.TempDir()\n   130\t\tpath := filepath.Join(root, \"source.go\")\n   131\t\tif err := os.WriteFile(path, []byte(\"old\"), 0o600); err != nil {\n   132\t\t\tt.Fatal(err)\n   133\t\t}\n   134\t\tbefore, err := readPublicationFile(root, \"source.go\")\n   135\t\tif err != nil {\n   136\t\t\tt.Fatal(err)\n   137\t\t}\n   138\t\tif err := os.WriteFile(path, []byte(\"other\"), 0o600); err != nil {\n   139\t\t\tt.Fatal(err)\n   140\t\t}\n   141\t\terr = publishAdapterFiles(root, []adapterPublicationFile{{Path: \"source.go\", Old: before, New: publicationContent{Present: true, Bytes: []byte(\"new\")}}})\n   142\t\tif err == nil || !strings.Contains(err.Error(), \"changed since staging\") {\n   143\t\t\tt.Fatalf(\"publishAdapterFiles() error = %v\", err)\n   144\t\t}\n   145\t\tcontents, err := os.ReadFile(path)\n   146\t\tif err != nil || string(contents) != \"other\" {\n   147\t\t\tt.Fatalf(\"checkout = %q, %v\", contents, err)\n   148\t\t}\n   149\t}\n   150\t\n   151\tfunc TestAdapterPublicationRejectsUnchangedInputDrift(t *testing.T) {\n   152\t\troot := t.TempDir()\n   153\t\tinput := filepath.Join(root, \"go.mod\")\n   154\t\tif err := os.WriteFile(input, []byte(\"old\"), 0o600); err != nil {\n   155\t\t\tt.Fatal(err)\n   156\t\t}\n   157\t\tbefore, err := readPublicationFile(root, \"go.mod\")\n   158\t\tif err != nil {\n   159\t\t\tt.Fatal(err)\n   160\t\t}\n   161\t\tif err := os.WriteFile(input, []byte(\"changed\"), 0o600); err != nil {\n   162\t\t\tt.Fatal(err)\n   163\t\t}\n   164\t\terr = publishAdapterFilesWithSnapshot(root, []adapterPublicationFile{{Path: \"generated.go\", New: publicationContent{Present: true, Bytes: []byte(\"generated\")}}}, map[string]publicationContent{\"go.mod\": before})\n   165\t\tif err == nil || !strings.Contains(err.Error(), \"checkout changed since staging: go.mod\") {\n   166\t\t\tt.Fatalf(\"unchanged input drift error = %v\", err)\n   167\t\t}\n   168\t\tif _, err := os.Stat(filepath.Join(root, \"generated.go\")); !os.IsNotExist(err) {\n   169\t\t\tt.Fatalf(\"generated output unexpectedly published: %v\", err)\n   170\t\t}\n   171\t}\n   172\t\n   173\tfunc TestAdapterPublicationRecoversInterruptedSet(t *testing.T) {\n   174\t\troot := t.TempDir()\n   175\t\tnames := []string{filepath.Join(\"tools\", \"gomad3\", \"deterministicio\", \"sprig_adapter.go\"), filepath.Join(\"tools\", \"gomad3integration\", \"qualification\", \"tests.json\")}\n   176\t\tfor _, name := range names {\n   177\t\t\tif err := os.MkdirAll(filepath.Dir(filepath.Join(root, name)), 0o700); err != nil {\n   178\t\t\t\tt.Fatal(err)\n   179\t\t\t}\n   180\t\t\tif err := os.WriteFile(filepath.Join(root, name), []byte(\"old\"), 0o600); err != nil {\n   181\t\t\t\tt.Fatal(err)\n   182\t\t\t}\n   183\t\t}\n   184\t\tfiles := []adapterPublicationFile{}\n   185\t\tfor _, name := range names {\n   186\t\t\tfiles = append(files, adapterPublicationFile{Path: name, Old: publicationContent{Present: true, Bytes: []byte(\"old\")}, New: publicationContent{Present: true, Bytes: []byte(\"new\")}})\n   187\t\t}\n   188\t\tif err := recordAdapterPublication(root, files); err != nil {\n   189\t\t\tt.Fatal(err)\n   190\t\t}\n   191\t\tif err := os.WriteFile(filepath.Join(root, names[0]), []byte(\"new\"), 0o600); err != nil {\n   192\t\t\tt.Fatal(err)\n   193\t\t}\n   194\t\tif err := recoverAdapterPublication(root); err != nil {\n   195\t\t\tt.Fatal(err)\n   196\t\t}\n   197\t\tfor _, name := range names {\n   198\t\t\tcontents, err := os.ReadFile(filepath.Join(root, name))\n   199\t\t\tif err != nil || string(contents) != \"old\" {\n   200\t\t\t\tt.Fatalf(\"recovered %s = %q, %v\", name, contents, err)\n   201\t\t\t}\n   202\t\t}\n   203\t\tif _, err := os.Stat(adapterPublicationMarker(root)); !os.IsNotExist(err) {\n   204\t\t\tt.Fatalf(\"recovery marker remains: %v\", err)\n   205\t\t}\n   206\t}\n   207\t\n   208\tfunc TestReportStaleLibcAdapterPacks(t *testing.T) {\n   209\t\tvar output bytes.Buffer\n   210\t\tif err := reportStaleAdapterPacks(&output, \"modernc.org/libc\", \"v1.72.4\"); err != nil {\n   211\t\t\tt.Fatal(err)\n   212\t\t}\n   213\t\tif !strings.Contains(output.String(), \"Stale adapter-bound pack: modernc-libc\") {\n   214\t\t\tt.Fatalf(\"stale libc pack report = %s\", output.String())\n   215\t\t}\n   216\t}\n   217\t\n   218\tfunc TestAdapterPublicationSerializesCompetingApplies(t *testing.T) {\n   219\t\troot := t.TempDir()\n   220\t\tpath := filepath.Join(root, \"source.go\")\n   221\t\tif err := os.WriteFile(path, []byte(\"old\"), 0o600); err != nil {\n   222\t\t\tt.Fatal(err)\n   223\t\t}\n   224\t\tstart := make(chan struct{})\n   225\t\tresults := make(chan error, 2)\n   226\t\tvar workers sync.WaitGroup\n   227\t\tfor _, next := range []string{\"first\", \"second\"} {\n   228\t\t\tworkers.Add(1)\n   229\t\t\tgo func(next string) {\n   230\t\t\t\tdefer workers.Done()\n   231\t\t\t\t<-start\n   232\t\t\t\tresults <- publishAdapterFiles(root, []adapterPublicationFile{{Path: \"source.go\", Old: publicationContent{Present: true, Bytes: []byte(\"old\")}, New: publicationContent{Present: true, Bytes: []byte(next)}}})\n   233\t\t\t}(next)\n   234\t\t}\n   235\t\tclose(start)\n   236\t\tworkers.Wait()\n   237\t\tclose(results)\n   238\t\tsuccesses, failures := 0, 0\n   239\t\tfor err := range results {\n   240\t\t\tif err == nil {\n   241\t\t\t\tsuccesses++\n   242\t\t\t} else {\n   243\t\t\t\tfailures++\n   244\t\t\t}\n   245\t\t}\n   246\t\tcontents, err := os.ReadFile(path)\n   247\t\tif err != nil || successes != 1 || failures != 1 || string(contents) != \"first\" && string(contents) != \"second\" {\n   248\t\t\tt.Fatalf(\"competing publications: successes=%d failures=%d contents=%q error=%v\", successes, failures, contents, err)\n   249\t\t}\n   250\t}\n   251\t\n   252\tfunc TestAdapterGenerationFailureLeavesCheckoutUnchanged(t *testing.T) {\n   253\t\tcheckout := t.TempDir()\n   254\t\tmoduleRoot := filepath.Join(checkout, \"tools\", \"gomad3\")\n   255\t\tfor _, directory := range []string{filepath.Join(moduleRoot, \"deterministicio\", \"testdata\"), filepath.Join(moduleRoot, \"toolchain\", \"version\"), filepath.Join(checkout, \"tools\", \"gomad3integration\", \"qualification\"), filepath.Join(checkout, \"tests\")} {\n   256\t\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n   257\t\t\t\tt.Fatal(err)\n   258\t\t\t}\n   259\t\t}\n   260\t\twrite := func(path, contents string) {\n   261\t\t\tt.Helper()\n   262\t\t\tif err := os.WriteFile(path, []byte(contents), 0o600); err != nil {\n   263\t\t\t\tt.Fatal(err)\n   264\t\t\t}\n   265\t\t}\n   266\t\twrite(filepath.Join(checkout, \"go.mod\"), \"module example.com/root\\n\")\n   267\t\twrite(filepath.Join(checkout, \"go.sum\"), \"\")\n   268\t\twrite(filepath.Join(checkout, \"tools\", \"gomad3