 1)\n   123\t\t}\n   124\t\tif err := publishAdapterFilesWithSnapshot(checkoutRoot, files, snapshot); err != nil {\n   125\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n   126\t\t}\n   127\t\tif _, err := fmt.Fprintf(stdout, \"regenerated %s@%s with approval %s\\n\", module, version, digest); err != nil {\n   128\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n   129\t\t}\n   130\t\tif _, err := io.Copy(stdout, &staleReport); err != nil {\n   131\t\t\treturn adapterRegenerationFailure(stderr, err, 1)\n   132\t\t}\n   133\t\treturn 0\n   134\t}\n   135\t\n   136\tfunc removeAdapterPrivate(root string) error {\n   137\t\tif err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, visitErr error) error {\n   138\t\t\tif visitErr != nil {\n   139\t\t\t\treturn visitErr\n   140\t\t\t}\n   141\t\t\tif entry.IsDir() {\n   142\t\t\t\treturn os.Chmod(path, 0o700)\n   143\t\t\t}\n   144\t\t\treturn nil\n   145\t\t}); err != nil {\n   146\t\t\treturn err\n   147\t\t}\n   148\t\treturn os.RemoveAll(root)\n   149\t}\n   150\t\n   151\tfunc downloadAdapterModule(module, version, private string) (directory, moduleSum, goModSum string, retErr error) {\n   152\t\tcache := filepath.Join(private, \"cache\")\n   153\t\tif err := os.MkdirAll(cache, 0o700); err != nil {\n   154\t\t\treturn \"\", \"\", \"\", err\n   155\t\t}\n   156\t\tcommand := exec.CommandContext(context.Background(), \"go\", \"mod\", \"download\", \"-json\", module+\"@\"+version)\n   157\t\tcommand.Dir = private\n   158\t\tcommand.Env = append(os.Environ(), \"GOMODCACHE=\"+cache, \"GOWORK=off\", \"GOFLAGS=\", \"GOTOOLCHAIN=local\")\n   159\t\toutput, err := command.CombinedOutput()\n   160\t\tif err != nil {\n   161\t\t\treturn \"\", \"\", \"\", fmt.Errorf(\"download %s@%s: %w: %s\", module, version, err, output)\n   162\t\t}\n   163\t\tvar result struct{ Path, Version, Sum, GoModSum, Dir, Error string }\n   164\t\tif err := json.Unmarshal(output, &result); err != nil {\n   165\t\t\treturn \"\", \"\", \"\", fmt.Errorf(\"decode module download: %w\", err)\n   166\t\t}\n   167\t\tif result.Error != \"\" || result.Path != module || result.Version != version || result.Sum == \"\" || result.GoModSum == \"\" || result.Dir == \"\" {\n   168\t\t\treturn \"\", \"\", \"\", fmt.Errorf(\"module download identity mismatch or failure: %s\", result.Error)\n   169\t\t}\n   170\t\treturn result.Dir, result.Sum, result.GoModSum, nil\n   171\t}\n   172\t\n   173\tfunc adapterRegenerationApproval(result deterministicio.AdapterRegeneration) (string, error) {\n   174\t\tencoded, err := canonicaljson.CanonicalJSON(result)\n   175\t\tif err != nil {\n   176\t\t\treturn \"\", err\n   177\t\t}\n   178\t\treturn string(record.DomainHash(\"gomad3.adapter-regeneration-review/v1\", encoded)), nil\n   179\t}\n   180\t\n   181\tfunc writeAdapterRegenerationReview(output io.Writer, oldRoot string, result deterministicio.AdapterRegeneration, digest string) error {\n   182\t\tif _, err := fmt.Fprintf(output, \"Adapter: %s@%s\\nModule sum: %s\\nOriginal inventory: %s\\nReplacement inventory: %s\\n\", result.Module, result.Version, result.Sum, result.OriginalInventorySHA256, result.ReplacementInventorySHA256); err != nil {\n   183\t\t\treturn err\n   184\t\t}\n   185\t\tfor _, source := range result.Sources {\n   186\t\t\told, err := os.ReadFile(filepath.Join(oldRoot, filepath.FromSlash(source.Path)))\n   187\t\t\tif err != nil && !errors.Is(err, os.ErrNotExist) {\n   188\t\t\t\treturn err\n   189\t\t\t}\n   190\t\t\tif _, err := fmt.Fprintf(output, \"\\nSource: %s\\nOld source: %s\\nNew source: %s\\nNew replacement: %s\\n\", source.Path, source.OldSourceSHA256, source.SourceSHA256, source.ReplacementSHA256); err != nil {\n   191\t\t\t\treturn err\n   192\t\t\t}\n   193\t\t\tif !bytes.Equal(old, source.Source) {\n   194\t\t\t\tif _, err := fmt.Fprintf(output, \"Changed upstream source %s:\\n%s\\n\", source.Path, source.Source); err != nil {\n   195\t\t\t\t\treturn err\n   196\t\t\t\t}\n   197\t\t\t}\n   198\t\t}\n   199\t\tfor _, host := range []string{\"darwin/arm64\", \"linux/amd64\"} {\n   200\t\t\tif _, err := fmt.Fprintf(output, \"Prepared source set %s: %s\\n\", host, result.PreparedSourceSets[host]); err != nil {\n   201\t\t\t\treturn err\n   202\t\t\t}\n   203\t\t}\n   204\t\tif _, err := fmt.Fprintf(output, \"Approval SHA-256: %s\\n\", digest); err != nil {\n   205\t\t\treturn err\n   206\t\t}\n   207\t\treturn reportStaleAdapterPacks(output, result.Module, result.Version)\n   208\t}\n   209\t\n   210\tfunc reportStaleAdapterPacks(output io.Writer, module, version string) error {\n   211\t\tpacks, err := compatibility.PinEvidence()\n   212\t\tif err != nil {\n   213\t\t\treturn err\n   214\t\t}\n   215\t\tfor _, pack := range packs {\n   216\t\t\tstale := false\n   217\t\t\tfor _, item := range pack.Activation {\n   218\t\t\t\tstale = stale || item.Path == module && item.Version != version || item.Adapter != nil && item.Adapter.Module == module && item.Adapter.Version != version\n   219\t\t\t}\n   220\t\t\tfor _, rule := range pack.Rules {\n   221\t\t\t\titem := rule.Module\n   222\t\t\t\tstale = stale || item.Path == module && item.Version != version || item.Adapter != nil && item.Adapter.Module == module && item.Adapter.Version != version\n   223\t\t\t}\n   224\t\t\tif stale {\n   225\t\t\t\tif _, err := fmt.Fprintf(output, \"Stale adapter-bound pack: %s\\n\", pack.ID); err != nil {\n   226\t\t\t\t\treturn err\n   227\t\t\t\t}\n   228\t\t\t}\n   229\t\t}\n   230\t\treturn nil\n   231\t}\n   232\t\n   233\ttype goPinEdit struct {\n   234\t\tstart, end int\n   235\t\tvalue      string\n   236\t}\n   237\t\n   238\tfunc editAdapterPins(contents []byte, result deterministicio.AdapterRegeneration, oldVersion, oldSum string) ([]byte, error) {\n   239\t\treplacements, err := adapterPinReplacements(result, oldVersion, oldSum)\n   240\t\tif err != nil {\n   241\t\t\treturn nil, err\n   242\t\t}\n   243\t\tedits, hits, hostHits, err := adapterPinEdits(contents, result.PreparedSourceSets, replacements)\n   244\t\tif err != nil {\n   245\t\t\treturn nil, err\n   246\t\t}\n   247\t\tfor old := range replacements {\n   248\t\t\tlibcVersionOrSum := result.Module == \"modernc.org/libc\" && (old == oldVersion || old == oldSum)\n   249\t\t\tif hits[old] != 1 && (!libcVersionOrSum || hits[old] != 0) {\n   250\t\t\t\treturn nil, fmt.Errorf(\"missing pin or duplicate pin %s: %d\", old, hits[old])\n   251\t\t\t}\n   252\t\t}\n   253\t\tfor host := range result.PreparedSourceSets {\n   254\t\t\tif hostHits[host] != 1 {\n   255\t\t\t\treturn nil, fmt.Errorf(\"missing prepared source-set pin for %s: %d\", host, hostHits[host])\n   256\t\t\t}\n   257\t\t}\n   258\t\tslices.SortFunc(edits, func(a, b goPinEdit) int { return b.start - a.start })\n   259\t\tupdated := append([]byte{}, contents...)\n   260\t\tfor _, edit := range edits {\n   261\t\t\tupdated = append(append(append([]byte{}, updated[:edit.start]...), edit.value...), updated[edit.end:]...)\n   262\t\t}\n   263\t\treturn updated, nil\n   264\t}\n   265\t\n   266\tfunc adapterPinReplacements(result deterministicio.AdapterRegeneration, oldVersion, oldSum string) (map[string]string, error) {\n   267\t\treplacements := map[string]string{}\n   268\t\tadd := func(old, next string) error {\n   269\t\t\tif old == \"\" || old == next {\n   270\t\t\t\treturn nil\n   271\t\t\t}\n   272\t\t\tif other, found := replacements[old]; found && other != next {\n   273\t\t\t\treturn fmt.Errorf(\"conflicting proposed pin for %s\", old)\n   274\t\t\t}\n   275\t\t\treplacements[old] = next\n   276\t\t\treturn nil\n   277\t\t}\n   278\t\tfor _, pair := range [][2]string{{result.OldOriginalInventorySHA256, result.OriginalInventorySHA256}, {result.OldReplacementInventorySHA256, result.ReplacementInventorySHA256}, {oldVersion, result.Version}, {oldSum, result.Sum}} {\n   279\t\t\tif err := add(pair[0], pair[1]); err != nil {\n   280\t\t\t\treturn nil, err\n   281\t\t\t}\n   282\t\t}\n   283\t\tfor _, source := range result.Sources {\n   284\t\t\tif err := add(source.OldSourceSHA256, source.SourceSHA256); err != nil {\n   285\t\t\t\treturn nil, err\n   286\t\t\t}\n   287\t\t\tif err := add(source.OldReplacementSHA256, source.ReplacementSHA256); err != nil {\n   288\t\t\t\treturn nil, err\n   289\t\t\t}\n   290\t\t}\n   291\t\treturn replacements, nil\n   292\t}\n   293\t\n   294\tfunc adapterPinEdits(contents []byte, prepared map[string]string, replacements map[string]string) (edits []goPinEdit, hits, hostHits map[string]int, retErr error) {\n   295\t\tfiles := token.NewFileSet()\n   296\t\tparsed, err := parser.ParseFile(files, \"adapter.go\", contents, parser.ParseComments)\n   297\t\tif err != nil {\n   298\t\t\treturn nil, nil, nil, err\n   299\t\t}\n   300\t\thits = map[string]int{}\n   301\t\thostHits = map[string]int{}\n   302\t\tedits = []goPinEdit{}\n   303\t\tast.Inspect(parsed, func(node ast.Node) bool {\n   304\t\t\tif field, ok := node.(*ast.KeyValueExpr); ok {\n   305\t\t\t\tkey, keyOK := field.Key.(*ast.BasicLit)\n   306\t\t\t\tvalue, valueOK := field.Value.(*ast.BasicLit)\n   307\t\t\t\tif keyOK && valueOK && key.Kind == token.STRING && value.Kind == token.STRING {\n   308\t\t\t\t\thost, _ := strconv.Unquote(key.Value)\n   309\t\t\t\t\tif next, found := prepared[host]; found {\n   310\t\t\t\t\t\thostHits[host]++\n   311\t\t\t\t\t\tedits = append(edits, goPinEdit{start: files.Position(value.Pos()).Offset, end: files.Position(value.End()).Offset, value: strconv.Quote(next)})\n   312\t\t\t\t\t\treturn false\n   313\t\t\t\t\t}\n   314\t\t\t\t}\n   315\t\t\t}\n   316\t\t\tliteral, ok := node.(*ast.BasicLit)\n   317\t\t\tif !ok || literal.Kind != token.STRING {\n   318\t\t\t\treturn true\n   319\t\t\t}\n   320\t\t\told, err := strconv.Unquote(literal.Value)\n   321\t\t\tif err != nil {\n   322\t\t\t\treturn true\n   323\t\t\t}\n   324\t\t\tif next, found := replacements[old]; found {\n   325\t\t\t\thits[old]++\n   326\t\t\t\tedits = append(edits, goPinEdit{start: files.Position(literal.Pos()).Offset, end: files.Position(literal.End()).Offset, value: strconv.Quote(next)})\n   327\t\t\t}\n   328\t\t\treturn true\n   329\t\t})\n   330\t\treturn edits, hits, hostHits, nil\n   331\t}\n   332\t\n   333\tfunc stageAdapterRegeneration(root string, result deterministicio.AdapterRegeneration, oldVersion, oldSum, oldGoModSum, newGoModSum, privateCache string) (files []adapterPublicationFile, snapshot map[string]publicationContent, retErr error) {\n   334\t\twork, err := os.MkdirTemp(\"\", \"gomad-adapter-stage-*\")\n   335\t\tif err != nil {\n   336\t\t\treturn nil, nil, err\n   337\t\t}\n   338\t\tdefer func() { retErr = errors.Join(retErr, os.RemoveAll(work)) }()\n   339\t\tstage := filepath.Join(work, \"tools\", \"gomad3\")\n   340\t\tmoduleSnapshot, err := copyAdapterStageTree(root, stage)\n   341\t\tif err != nil {\n   342\t\t\treturn nil, nil, err\n   343\t\t}\n   344\t\tcheckoutRoot := filepath.Clean(filepath.Join(root, \"..\", \"..\"))\n   345\t\tqualification := filepath.Join(\"tools\", \"gomad3integration\", \"qualification\")\n   346\t\tqualificationSnapshot, err := copyAdapterStageTree(filepath.Join(checkoutRoot, qualification), filepath.Join(work, qualification))\n   347\t\tif err != nil {\n   348\t\t\treturn nil, nil, err\n   349\t\t}\n   350\t\ttestsSnapshot, err := copyAdapterStageTree(filepath.Join(checkoutRoot, \"tests\"), filepath.Join(work, \"tests\"))\n   351\t\tif err != nil {\n   352\t\t\treturn nil, nil, err\n   353\t\t}\n   354\t\tsnapshot = map[string]publicationContent{}\n   355\t\tfor relative, content := range moduleSnapshot {\n   356\t\t\tsnapshot[filepath.Join(\"tools\", \"gomad3\", relative)] = content\n   357\t\t}\n   358\t\tfor relative, content := range qualificationSnapshot {\n   359\t\t\tsnapshot[filepath.Join(qualification, relative)] = content\n   360\t\t}\n   361\t\tfor relative, content := range testsSnapshot {\n   362\t\t\tsnapshot[filepath.Join(\"tests\", relative)] = content\n   363\t\t}\n   364\t\tfor _, name := range []string{\"go.mod\", \"go.sum\"} {\n   365\t\t\tcontents, err := os.ReadFile(filepath.Join(checkoutRoot, name))\n   366\t\t\tif err != nil {\n   367\t\t\t\treturn nil, nil, err\n   368\t\t\t}\n   369\t\t\tif err := os.WriteFile(filepath.Join(work, name), contents, 0o600); err != nil {\n   370\t\t\t\treturn nil, nil, err\n   371\t\t\t}\n   372\t\t\tsnapshot[name] = publicationContent{Present: true, Bytes: contents}\n   373\t\t}\n   374\t\tcacheDir := filepath.Join(stage, \".toolchain\")\n   375\t\tif err := os.MkdirAll(cacheDir, 0o700); err != nil {\n   376\t\t\treturn nil, nil, err\n   377\t\t}\n   378\t\tif err := os.Symlink(filepath.Join(root, \".toolchain\", \"generator-cache\"), filepath.Join(cacheDir, \"generator-cache\")); err != nil {\n   379\t\t\treturn nil, nil, err\n   380\t\t}\n   381\t\tadapterFile := filepath.Join(stage, \"deterministicio\", result.SourceFile)\n   382\t\tcontents, err := os.ReadFile(adapterFile)\n   383\t\tif err != nil {\n   384\t\t\treturn nil, nil, err\n   385\t\t}\n   386\t\tupdated, err := editAdapterPins(contents, result, oldVersion, oldSum)\n   387\t\tif err != nil {\n   388\t\t\treturn nil, nil, err\n   389\t\t}\n   390\t\tif err := os.WriteFile(adapterFile, updated, 0o644); err != nil {\n   391\t\t\treturn nil, nil, err\n   392\t\t}\n   393\t\tif err := editAdapterDescriptor(filepath.Join(stage, \"toolchain\", \"version\", \"version.json\"), result.Module, oldVersion, oldSum, result.Version, result.Sum); err != nil {\n   394\t\t\treturn nil, nil, err\n   395\t\t}\n   396\t\tif err := editAdapterFixtures(filepath.Join(stage, \"deterministicio\", \"testdata\"), result.Module, oldVersion, oldSum, oldGoModSum, result.Version, result.Sum, newGoModSum, privateCache); err != nil {\n   397\t\t\treturn nil, nil, err\n   398\t\t}\n   399\t\tgenerate := exec.CommandContext(context.Background(), \"make\", \"-C\", stage, \"generate\")\n   400\t\tgenerate.Env = append(os.Environ(), \"GOTOOLCHAIN=local\", \"GOWORK=off\")\n   401\t\toutput, err := generate.CombinedOutput()\n   402\t\tif err != nil {\n   403\t\t\treturn nil, nil, fmt.Errorf(\"generate staged adapter artifacts: %w\\n%s\", err, output)\n   404\t\t}\n   405\t\tvalidate := exec.CommandContext(context.Background(), \"make\", \"-C\", stage, \"validate-toolchain\", \"validate-qualification\")\n   406\t\tvalidate.Env = append(os.Environ(), \"GOTOOLCHAIN=local\", \"GOWORK=off\")\n   407\t\toutput, err = validate.CombinedOutput()\n   408\t\tif err != nil {\n   409\t\t\treturn nil, nil, fmt.Errorf(\"validate staged adapter artifacts: %w\\n%s\", err, output)\n   410\t\t}\n   411\t\tcompile := exec.CommandContext(context.Background(), \"go\", \"test\", \"-tags\", \"test_dep\", \"-run\", \"^$\", \"./deterministicio\")\n   412\t\tcompile.Dir = stage\n   413\t\tcompile.Env = append(os.Environ(), \"GOTOOLCHAIN=local\", \"GOWORK=off\")\n   414\t\toutput, err = compile.CombinedOutput()\n   415\t\tif err != nil {\n   416\t\t\treturn nil, nil, fmt.Errorf(\"compile staged adapter: %w\\n%s\", err, output)\n   417\t\t}\n   418\t\tfiles = []adapterPublicationFile{}\n   419\t\tfor _, subtree := range []string{filepath.Join(\"tools\", \"gomad3\"), qualification} {\n   420\t\t\terr = collectAdapterStageChanges(filepath.Join(work, subtree), subtree, snapshot, &files)\n   421\t\t\tif err != nil {\n   422\t\t\t\treturn nil, nil, err\n   423\t\t\t}\n   424\t\t}\n   425\t\treturn files, snapshot, nil\n   426\t}\n   427\t\n   428\tfunc collectAdapterStageChanges(stage, prefix string, snapshot map[string]publicationContent, files *[]adapterPublicationFile) error {\n   429\t\terr := filepath.WalkDir(stage, func(path string, entry fs.DirEntry, visitErr error) error {\n   430\t\t\tif visitErr != nil {\n   431\t\t\t\treturn visitErr\n   432\t\t\t}\n   433\t\t\tif entry.IsDir() {\n   434\t\t\t\tif filepath.Base(path) == \".toolchain\" || filepath.Base(path) == \".bin\" {\n   435\t\t\t\t\treturn filepath.SkipDir\n   436\t\t\t\t}\n   437\t\t\t\treturn nil\n   438\t\t\t}\n   439\t\t\tif !entry.Type().IsRegular() {\n   440\t\t\t\treturn fmt.Errorf(\"staged adapter output is not a regular file: %s\", path)\n   441\t\t\t}\n   442\t\t\tlocal, err := filepath.Rel(stage, path)\n   443\t\t\tif err != nil {\n   444\t\t\t\treturn err\n   445\t\t\t}\n   446\t\t\trelative := filepath.Join(prefix, local)\n   447\t\t\tcontents, err := os.ReadFile(path)\n   448\t\t\tif err != nil {\n   449\t\t\t\treturn err\n   450\t\t\t}\n   451\t\t\tnewContent := publicationContent{Present: true, Bytes: contents}\n   452\t\t\told := snapshot[relative]\n   453\t\t\tif !samePublicationContent(old, newContent) {\n   454\t\t\t\t*files = append(*files, adapterPublicationFile{Path: relative, Old: old, New: newContent})\n   455\t\t\t}\n   456\t\t\treturn nil\n   457\t\t})\n   458\t\tif err != nil {\n   459\t\t\treturn err\n   460\t\t}\n   461\t\tfor relative, old := range snapshot {\n   462\t\t\tif !strings.HasPrefix(relative, prefix+string(filepath.Separator)) {\n   463\t\t\t\tcontinue\n   464\t\t\t}\n   465\t\t\tlocal := strings.TrimPrefix(relative, prefix+string(filepath.Separator))\n   466\t\t\tif _, err := os.Stat(filepath.Join(stage, local)); errors.Is(err, os.ErrNotExist) {\n   467\t\t\t\t*files = append(*files, adapterPublicationFile{Path: relative, Old: old})\n   468\t\t\t} else if err != nil {\n   469\t\t\t\treturn err\n   470\t\t\t}\n   471\t\t}\n   472\t\treturn nil\n   473\t}\n   474\t\n   475\tfunc copyAdapterStageTree(source, destination string) (map[string]publicationContent, error) {\n   476\t\tsnapshot := map[string]publicationContent{}\n   477\t\terr := filepath.WalkDir(source, func(path string, entry fs.DirEntry, visitErr error) error {\n   478\t\t\tif visitErr != nil {\n   479\t\t\t\treturn visitErr\n   480\t\t\t}\n   481\t\t\trelative, err := filepath.Rel(source, path)\n   482\t\t\tif err != nil {\n   483\t\t\t\treturn err\n   484\t\t\t}\n   485\t\t\tif relative == \".\" {\n   486\t\t\t\treturn os.MkdirAll(destination, 0o700)\n   487\t\t\t}\n   488\t\t\tif entry.IsDir() {\n   489\t\t\t\tif relative == \".toolchain\" || relative == \".bin\" {\n   490\t\t\t\t\treturn filepath.SkipDir\n   491\t\t\t\t}\n   492\t\t\t\treturn os.MkdirAll(filepath.Join(destination, relative), 0o700)\n   493\t\t\t}\n   494\t\t\tif !entry.Type().IsRegular() {\n   495\t\t\t\treturn fmt.Errorf(\"adapter stage input is not a regular file: %s\", relative)\n   496\t\t\t}\n   497\t\t\tcontents, err := os.ReadFile(path)\n   498\t\t\tif err != nil {\n   499\t\t\t\treturn err\n   500\t\t\t}\n   501\t\t\tinfo, err := entry.Info()\n   502\t\t\tif err != nil {\n   503\t\t\t\treturn err\n   504\t\t\t}\n   505\t\t\tif err := os.WriteFile(filepath.Join(destination, relative), contents, info.Mode().Perm()); err != nil {\n   506\t\t\t\treturn err\n   507\t\t\t}\n   508\t\t\tsnapshot[relative] = publicationContent{Present: true, Bytes: contents}\n   509\t\t\treturn nil\n   510\t\t})\n   511\t\treturn snapshot, err\n   512\t}\n   513\t\n   514\tfunc editAdapterDescriptor(path, module, oldVersion, oldSum, version, sum string) error {\n   515\t\tcontents, err := os.ReadFile(path)\n   516\t\tif err != nil {\n   517\t\t\treturn err\n   518\t\t}\n   519\t\tvar descriptor gomadversion.Descriptor\n   520\t\tif err := json.Unmarshal(contents, &descriptor); err != nil {\n   521\t\t\treturn err\n   522\t\t}\n   523\t\thits := 0\n   524\t\tfor index := range descriptor.Adapters {\n   525\t\t\tadapter := &descriptor.Adapters[index]\n   526\t\t\tif adapter.Module != module {\n   527\t\t\t\tcontinue\n   528\t\t\t}\n   529\t\t\tif adapter.Version != oldVersion || adapter.Sum != oldSum {\n   530\t\t\t\treturn errors.New(\"adapter descriptor changed since planning\")\n   531\t\t\t}\n   532\t\t\tadapter.Version, adapter.Sum = version, sum\n   533\t\t\thits++\n   534\t\t}\n   535\t\tif hits != 1 {\n   536\t\t\treturn fmt.Errorf(\"adapter descriptor has %d entries for %s\", hits, module)\n   537\t\t}\n   538\t\tupdated, err := json.MarshalIndent(descriptor, \"\", \"  \")\n   539\t\tif err != nil {\n   540\t\t\treturn err\n   541\t\t}\n   542\t\treturn os.WriteFile(path, append(updated, '\\n'), 0o644)\n   543\t}\n   544\t\n   545\tfunc editAdapterFixtures(root, module, oldVersion, oldSum, oldGoModSum, version, sum, newGoModSum, privateCache string) error {\n   546\t\tvar changedModules []string\n   547\t\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, visitErr error) error {\n   548\t\t\tif visitErr != nil {\n   549\t\t\t\treturn visitErr\n   550\t\t\t}\n   551\t\t\tif entry.IsDir() {\n   552\t\t\t\treturn nil\n   553\t\t\t}\n   554\t\t\tif entry.Name() != \"go.mod\" && entry.Name() != \"go.sum\" {\n   555\t\t\t\treturn nil\n   556\t\t\t}\n   557\t\t\tcontents, err := os.ReadFile(path)\n   558\t\t\tif err != nil {\n   559\t\t\t\treturn err\n   560\t\t\t}\n   561\t\t\tupdated := string(contents)\n   562\t\t\tif entry.Name() == \"go.mod\" {\n   563\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion, module+\" \"+version)\n   564\t\t\t} else {\n   565\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion+\" \"+oldSum, module+\" \"+version+\" \"+sum)\n   566\t\t\t\tupdated = strings.ReplaceAll(updated, module+\" \"+oldVersion+\"/go.mod \"+oldGoModSum, module+\" \"+version+\"/go.mod \"+newGoModSum)\n   567\t\t\t}\n   568\t\t\tif updated == string(contents) {\n   569\t\t\t\treturn nil\n   570\t\t\t}\n   571\t\t\tif entry.Name() == \"go.mod\" {\n   572\t\t\t\tchangedModules = append(changedModules, filepath.Dir(path))\n   573\t\t\t}\n   574\t\t\treturn os.WriteFile(path, []byte(updated), 0o644)\n   575\t\t})\n   576\t\tif err != nil {\n   577\t\t\treturn err\n   578\t\t}\n   579\t\tfor _, directory := range changedModules {\n   580\t\t\tcommand := exec.CommandContext(context.Background(), \"go\", \"mod\", \"tidy\")\n   581\t\t\tcommand.Dir = directory\n   582\t\t\tcommand.Env = append(os.Environ(), \"GOMODCACHE=\"+privateCache, \"GOWORK=off\", \"GOFLAGS=\", \"GOTOOLCHAIN=local\")\n   583\t\t\toutput, err := command.CombinedOutput()\n   584\t\t\tif err != nil {\n   585\t\t\t\treturn fmt.Errorf(\"refresh staged adapter fixture %s: %w\\n%s\", directory, err, output)\n   586\t\t\t}\n   587\t\t}\n   588\t\treturn nil\n   589\t}\n","exit_code":0,"status":"completed"}}
