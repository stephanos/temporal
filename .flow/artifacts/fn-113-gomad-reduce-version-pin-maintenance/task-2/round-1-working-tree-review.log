 string, identity gomadversion.AdapterIdentity, spec rewrittenModule) (adapterPreparation, error) {\n    43\t\tif identity.Module != spec.module || identity.Version != spec.version || identity.Sum != spec.sum {\n    44\t\t\treturn adapterPreparation{}, fmt.Errorf(\"%s adapter identity mismatch\", spec.module)\n    45\t\t}\n    46\t\tif len(spec.rewrites) == 0 {\n    47\t\t\treturn adapterPreparation{}, fmt.Errorf(\"%s adapter has no rewrites\", spec.module)\n    48\t\t}\n    49\t\tmoduleSource, err := filepath.EvalSymlinks(filepath.Join(append([]string{moduleCache}, spec.cacheElements...)...))\n    50\t\tif err != nil {\n    51\t\t\treturn adapterPreparation{}, fmt.Errorf(\"resolve pinned %s module: %w\", spec.module, err)\n    52\t\t}\n    53\t\tif err := verifyAdapterModuleInventory(spec.module, moduleSource, spec.originalInventorySHA256); err != nil {\n    54\t\t\treturn adapterPreparation{}, err\n    55\t\t}\n    56\t\treplacements := make(map[string][]byte, len(spec.rewrites))\n    57\t\tfor _, rewrite := range spec.rewrites {\n    58\t\t\tcontents, err := readAdapterSource(spec.module, moduleSource, rewrite.path)\n    59\t\t\tif err != nil {\n    60\t\t\t\treturn adapterPreparation{}, err\n    61\t\t\t}\n    62\t\t\treplacements[rewrite.path], err = rewriteAdapterSource(spec.module, rewrite, contents)\n    63\t\t\tif err != nil {\n    64\t\t\t\treturn adapterPreparation{}, err\n    65\t\t\t}\n    66\t\t}\n    67\t\tmoduleReplacement := filepath.Join(root, spec.replacementDirectory)\n    68\t\tif err := copyAdapterModule(moduleSource, moduleReplacement, replacements, defaultAdapterCopyLimits); err != nil {\n    69\t\t\treturn adapterPreparation{}, fmt.Errorf(\"copy %s adapter module: %w\", spec.module, err)\n    70\t\t}\n    71\t\treplacementInventory, err := digestAdapterSourceInventory(moduleReplacement)\n    72\t\tif err != nil {\n    73\t\t\treturn adapterPreparation{}, fmt.Errorf(\"hash %s replacement inventory: %w\", spec.module, err)\n    74\t\t}\n    75\t\tif replacementInventory != spec.replacementInventorySHA256 {\n    76\t\t\treturn adapterPreparation{}, fmt.Errorf(\"%s replacement inventory identity mismatch: got %s, want %s\", spec.module, replacementInventory, spec.replacementInventorySHA256)\n    77\t\t}\n    78\t\tprimary := spec.rewrites[0]\n    79\t\treturn adapterPreparation{\n    80\t\t\treplacement: moduleReplacement,\n    81\t\t\tevidence: BuildAdapter{\n    82\t\t\t\tModule: identity.Module, Version: identity.Version, Sum: identity.Sum,\n    83\t\t\t\tSource: filepath.Join(moduleSource, filepath.FromSlash(primary.path)), ReplacementRoot: moduleReplacement, Replacement: filepath.Join(moduleReplacement, filepath.FromSlash(primary.path)),\n    84\t\t\t\tPreparedPackage:                  spec.preparedPackage,\n    85\t\t\t\tSourceSHA256:                     primary.sourceSHA256,\n    86\t\t\t\tReplacementSHA256:                primary.replacementSHA256,\n    87\t\t\t\tOriginalSourceInventorySHA256:    spec.originalInventorySHA256,\n    88\t\t\t\tReplacementSourceInventorySHA256: replacementInventory,\n    89\t\t\t\tPreparedSourceSetSHA256:          spec.preparedSourceSetSHA256,\n    90\t\t\t},\n    91\t\t}, nil\n    92\t}\n    93\t\n    94\tfunc verifyAdapterModuleInventory(module, moduleRoot, want string) error {\n    95\t\tinventory, err := digestAdapterSourceInventory(moduleRoot)\n    96\t\tif err != nil {\n    97\t\t\treturn fmt.Errorf(\"hash pinned %s source inventory: %w\", module, err)\n    98\t\t}\n    99\t\tif inventory != want {\n   100\t\t\treturn fmt.Errorf(\"pinned %s source inventory identity mismatch: got %s, want %s\", module, inventory, want)\n   101\t\t}\n   102\t\treturn nil\n   103\t}\n   104\t\n   105\tfunc readAdapterSource(module, moduleRoot, relative string) ([]byte, error) {\n   106\t\tpath := filepath.Join(moduleRoot, filepath.FromSlash(relative))\n   107\t\tinfo, err := os.Lstat(path)\n   108\t\tif err != nil || !info.Mode().IsRegular() {\n   109\t\t\treturn nil, fmt.Errorf(\"pinned %s source is not a regular file: %s\", module, relative)\n   110\t\t}\n   111\t\tcontents, err := os.ReadFile(path)\n   112\t\tif err != nil {\n   113\t\t\treturn nil, fmt.Errorf(\"read pinned %s source %s: %w\", module, relative, err)\n   114\t\t}\n   115\t\treturn contents, nil\n   116\t}\n   117\t\n   118\tfunc rewriteAdapterSource(module string, rewrite sourceRewrite, contents []byte) ([]byte, error) {\n   119\t\tif digestBytes(contents) != rewrite.sourceSHA256 {\n   120\t\t\treturn nil, fmt.Errorf(\"pinned %s source identity mismatch for %s\", module, rewrite.path)\n   121\t\t}\n   122\t\tresult, err := regenerateSourceRewrite(module, rewrite, contents)\n   123\t\tif err != nil {\n   124\t\t\treturn nil, err\n   125\t\t}\n   126\t\tif got := digestBytes(result); got != rewrite.replacementSHA256 {\n   127\t\t\treturn nil, fmt.Errorf(\"%s replacement identity mismatch for %s: got %s, want %s\", module, rewrite.path, got, rewrite.replacementSHA256)\n   128\t\t}\n   129\t\treturn result, nil\n   130\t}\n   131\t\n   132\tfunc regenerateSourceRewrite(module string, rewrite sourceRewrite, contents []byte) ([]byte, error) {\n   133\t\tif len(rewrite.rewrites) == 0 {\n   134\t\t\treturn nil, errors.New(\"adapter source rewrite has no anchors\")\n   135\t\t}\n   136\t\tresult := append([]byte(nil), contents...)\n   137\t\tfor _, step := range rewrite.rewrites {\n   138\t\t\tif bytes.Count(result, step.anchor) != 1 {\n   139\t\t\t\treturn nil, fmt.Errorf(\"pinned %s rewrite anchor mismatch for %s: %q\", module, rewrite.path, step.anchor)\n   140\t\t\t}\n   141\t\t\tresult = bytes.Replace(result, step.anchor, step.replacement, 1)\n   142\t\t}\n   143\t\treturn result, nil\n   144\t}\n     1\tpackage deterministicio\n     2\t\n     3\timport (\n     4\t\t\"bytes\"\n     5\t\t\"errors\"\n     6\t\t\"fmt\"\n     7\t\t\"os\"\n     8\t\t\"path/filepath\"\n     9\t\n    10\t\tgomadversion \"go.temporal.io/server/tools/gomad3/toolchain/version\"\n    11\t)\n    12\t\n    13\tconst (\n    14\t\tgrpcModulePath                        = \"google.golang.org/grpc\"\n    15\t\tgrpcVersion                           = \"v1.83.2\"\n    16\t\tgrpcSum                               = \"h1:EManeRomTObA0BU7I8vXgg/78uE5MJ9M8B39EX2WscU=\"\n    17\t\tgrpcOriginalSourceInventorySHA256     = \"sha256:53960aeb3f1d34cfe2340c30365456689710cd7bf32b6faf6e39d6f5306fc9a9\"\n    18\t\tgrpcKeepaliveSourceSHA256             = \"sha256:e8bfe03234b391d24006a3a274590111f0f8705fc5b25d9a78391bfdde3df32c\"\n    19\t\tgrpcKeepaliveReplacementSHA256        = \"sha256:8705566fa6ba58f69d8c8215227ddadad46794c333bca38fe6d5399d6be24e8c\"\n    20\t\tgrpcReplacementSourceInventorySHA256  = \"sha256:9098668e7b66e1d82f5ecbb302556cf9723775b19aa2db68ede45aa1a166adbf\"\n    21\t\tgrpcKeepalivePath                     = \"internal/tcp_keepalive_unix.go\"\n    22\t\tgrpcChannelzLinuxPath                 = \"internal/channelz/syscall_linux.go\"\n    23\t\tgrpcChannelzNonLinuxPath              = \"internal/channelz/syscall_nonlinux.go\"\n    24\t\tgrpcChannelzLinuxSourceSHA256         = \"sha256:6b90796f288344124b635c90237961789ca452ddf78e4b7f9c0417d0b458f61c\"\n    25\t\tgrpcChannelzNonLinuxSourceSHA256      = \"sha256:1be23873d86f82b13b2c7d8d2534b5380215120d15ce3e47bf8d25c9fbdf983c\"\n    26\t\tgrpcChannelzLinuxReplacementSHA256    = \"sha256:caa7ee7b9b6e324d88ad72047b1a5ff1120d82ebb4256243b4910aebedc9e287\"\n    27\t\tgrpcSyscallLinuxPath                  = \"internal/syscall/syscall_linux.go\"\n    28\t\tgrpcSyscallNonLinuxPath               = \"internal/syscall/syscall_nonlinux.go\"\n    29\t\tgrpcSyscallLinuxSourceSHA256          = \"sha256:91096efdaa61581ac7b9d2d8076635d8ca5ac7ef3064094dab2f8efb70f003b2\"\n    30\t\tgrpcSyscallNonLinuxSourceSHA256       = \"sha256:3b74e0c3889ed8a826963f5f3bf9e7bf2bab3ee05f6d2739c9f1bb75cca8d490\"\n    31\t\tgrpcSyscallLinuxReplacementSHA256     = \"sha256:94aa678a38c485bfcdeb79f3e43a4df6db3d2755eadb15101acdc06579d222f0\"\n    32\t\tgrpcReadyReaderLinuxPath              = \"internal/transport/readyreader/raw_conn_linux.go\"\n    33\t\tgrpcReadyReaderNonLinuxPath           = \"internal/transport/readyreader/raw_conn_nonlinux.go\"\n    34\t\tgrpcReadyReaderLinuxSourceSHA256      = \"sha256:05a068012fd512ce4ad3c5471f9546349b4e9acdad30dde5df0f02917af58d3f\"\n    35\t\tgrpcReadyReaderNonLinuxSourceSHA256   = \"sha256:b9f0cf777d60fa3acfb2c22d263738a361b30ed484885b039db1c555a8f53256\"\n    36\t\tgrpcReadyReaderLinuxReplacementSHA256 = \"sha256:00d8188fbf97bb5b6d63c19a36dfce662d3486f344854c10b55b3041dac1d4ce\"\n    37\t)\n    38\t\n    39\t// grpcLinuxRewrites names the gRPC files that exist only for Linux hosts and\n    40\t// reach the kernel through raw connections or x/sys/unix: channelz socket\n    41\t// introspection, the TCP user-timeout and CPU-time helpers, and the\n    42\t// non-blocking ready reader. The adapter replaces each with the module's own\n    43\t// non-Linux implementation under a Linux build constraint, so linux/amd64\n    44\t// targets take the path darwin already takes.\n    45\tvar grpcLinuxRewrites = []grpcLinuxRewrite{\n    46\t\t{\n    47\t\t\tlinuxPath: grpcReadyReaderLinuxPath, nonLinuxPath: grpcReadyReaderNonLinuxPath,\n    48\t\t\tlinuxSHA256: grpcReadyReaderLinuxSourceSHA256, nonLinuxSHA256: grpcReadyReaderNonLinuxSourceSHA256, replacementSHA256: grpcReadyReaderLinuxReplacementSHA256,\n    49\t\t\tconstraint: []byte(\"//go:build !linux\\n\"), replacement: []byte(\"//go:build linux\\n\"),\n    50\t\t},\n    51\t\t{\n    52\t\t\tlinuxPath: grpcChannelzLinuxPath, nonLinuxPath: grpcChannelzNonLinuxPath,\n    53\t\t\tlinuxSHA256: grpcChannelzLinuxSourceSHA256, nonLinuxSHA256: grpcChannelzNonLinuxSourceSHA256, replacementSHA256: grpcChannelzLinuxReplacementSHA256,\n    54\t\t\tconstraint: []byte(\"//go:build !linux\\n\"), replacement: []byte(\"//go:build linux\\n\"),\n    55\t\t},\n    56\t\t{\n    57\t\t\tlinuxPath: grpcSyscallLinuxPath, nonLinuxPath: grpcSyscallNonLinuxPath,\n    58\t\t\tlinuxSHA256: grpcSyscallLinuxSourceSHA256, nonLinuxSHA256: grpcSyscallNonLinuxSourceSHA256, replacementSHA256: grpcSyscallLinuxReplacementSHA256,\n    59\t\t\tconstraint: []byte(\"//go:build !linux\\n// +build !linux\\n\"), replacement: []byte(\"//go:build linux\\n// +build linux\\n\"),\n    60\t\t},\n    61\t}\n    62\t\n    63\ttype grpcLinuxRewrite struct {\n    64\t\tlinuxPath, nonLinuxPath                        string\n    65\t\tlinuxSHA256, nonLinuxSHA256, replacementSHA256 string\n    66\t\tconstraint, replacement                        []byte\n    67\t}\n    68\t\n    69\t// grpcSyscallRewrites names the portable gRPC files that reach the syscall\n    70\t// package on every platform: errno classification for the disconnect metric\n    71\t// label, the syscall.Conn wrapper credentials install around TLS connections,\n    72\t// and the raw-connection reader. Each rewrite keeps the exported surface and\n    73\t// takes the path the module already takes when the connection is not a\n    74\t// syscall.Conn, so the adapted module never asks the kernel for a descriptor.\n    75\tvar grpcSyscallRewrites = []sourceRewrite{\n    76\t\t{\n    77\t\t\tpath:              \"clientconn_disconnect_reason_noplan9.go\",\n    78\t\t\tsourceSHA256:      \"sha256:23f1d780ca5185a832b94dc81111af6ea8916360631b450268adf288fad0e68a\",\n    79\t\t\treplacementSHA256: \"sha256:308091ae5dc8440b748302f3ba47442bec3f0e203b0d7707b444764b9bff5a6e\",\n    80\t\t\trewrites: []anchorRewrite{\n    81\t\t\t\t{anchor: []byte(\"\\t\\\"syscall\\\"\\n\")},\n    82\t\t\t\t{anchor: []byte(\"\\tvar sysErr syscall.Errno\\n\")},\n    83\t\t\t\t{anchor: []byte(\"\\tcase errors.Is(err, syscall.ECONNRESET):\\n\\t\\treturn \\\"connection reset\\\"\\n\")},\n    84\t\t\t\t{\n    85\t\t\t\t\tanchor:      []byte(\"\\tcase errors.Is(err, syscall.ETIMEDOUT), errors.Is(err, context.DeadlineExceeded), errors.Is(err, os.ErrDeadlineExceeded):\\n\"),\n    86\t\t\t\t\treplacement: []byte(\"\\tcase errors.Is(err, context.DeadlineExceeded), errors.Is(err, os.ErrDeadlineExceeded):\\n\"),\n    87\t\t\t\t},\n    88\t\t\t\t{anchor: []byte(\"\\tcase errors.Is(err, syscall.ECONNABORTED):\\n\\t\\treturn \\\"connection aborted\\\"\\n\")},\n    89\t\t\t\t{anchor: []byte(\"\\tcase errors.As(err, &sysErr):\\n\\t\\treturn \\\"socket error\\\"\\n\")},\n    90\t\t\t},\n    91\t\t},\n    92\t\t{\n    93\t\t\tpath:              \"internal/credentials/syscallconn.go\",\n    94\t\t\tsourceSHA256:      \"sha256:47cb93c2b159a3d1e9373a49a44dc50744e51f40ff3f16414cd15c7ceb390ef7\",\n    95\t\t\treplacementSHA256: \"sha256:47138dcc61cefa213a4172c426bbf8230e22f0a6f59d8eb2cdef5d763aded021\",\n    96\t\t\trewrites: []anchorRewrite{\n    97\t\t\t\t{anchor: []byte(\"import (\\n\\t\\\"net\\\"\\n\\t\\\"syscall\\\"\\n)\\n\"), replacement: []byte(\"import (\\n\\t\\\"net\\\"\\n)\\n\")},\n    98\t\t\t\t{anchor: []byte(\"type sysConn = syscall.Conn\\n\\n\")},\n    99\t\t\t\t{anchor: []byte(\"type syscallConn struct {\\n\\tnet.Conn\\n\\t// sysConn is a type alias of syscall.Conn. It's necessary because the name\\n\\t// `Conn` collides with `net.Conn`.\\n\\tsysConn\\n}\\n\\n\")},\n   100\t\t\t\t{\n   101\t\t\t\t\tanchor:      []byte(\"func WrapSyscallConn(rawConn, newConn net.Conn) net.Conn {\\n\\tsysConn, ok := rawConn.(syscall.Conn)\\n\\tif !ok {\\n\\t\\treturn newConn\\n\\t}\\n\\treturn &syscallConn{\\n\\t\\tConn:    newConn,\\n\\t\\tsysConn: sysConn,\\n\\t}\\n}\\n\"),\n   102\t\t\t\t\treplacement: []byte(\"func WrapSyscallConn(_, newConn net.Conn) net.Conn {\\n\\treturn newConn\\n}\\n\"),\n   103\t\t\t\t},\n   104\t\t\t},\n   105\t\t},\n   106\t\t{\n   107\t\t\tpath:              \"internal/transport/readyreader/ready_reader.go\",\n   108\t\t\tsourceSHA256:      \"sha256:aefa4f5b55e10c0ff86d5cf5b5d77a44eb79ca00c412dc9218087f23537fdb00\",\n   109\t\t\treplacementSHA256: \"sha256:0d7d71fc3c499a71b9489fe1ebbe6f970af76636e2a8f4100341a965059e1510\",\n   110\t\t\trewrites: []anchorRewrite{\n   111\t\t\t\t{ancho