        state: &activity::Model,
        seed: u64,
    ) -> Result<
        ::umpire_runtime::Proposal<<activity::World as ::umpire_dsl::Machine>::Action>,
        ::umpire_runtime::protocol::Refusal,
    > {
        self.proposal(state, seed)
    }
    fn matches(
        &self,
        request: &::umpire_runtime::prost_types::Any,
        observation: &::umpire_runtime::prost_types::Any,
    ) -> Result<(), ::umpire_runtime::protocol::Refusal> {
        self.matches_proposal(request, observation)
    }
    fn continue_polling(
        &self,
        observation: &::umpire_runtime::prost_types::Any,
        state: &activity::Model,
        action: Option<&<activity::World as ::umpire_dsl::Machine>::Action>,
    ) -> Result<bool, ::umpire_runtime::protocol::Refusal> {
        self.polling(observation, state, action)
    }
    fn observe(
        &self,
        observation: &::umpire_runtime::prost_types::Any,
        state: &activity::Model,
    ) -> Result<
        ::umpire_runtime::Projection<
            <activity::World as ::umpire_dsl::Machine>::Action,
            <activity::World as ::umpire_dsl::Machine>::Outcome,
            Self::Target,
        >,
        ::umpire_runtime::protocol::Refusal,
    > {
        let _ = state;
        let __observed = ::umpire_temporal::support::Observed::new(observation)?;
        if __observed.method
            == "/temporal.api.workflowservice.v1.WorkflowService/RequestCancelActivityExecution"
        {
            let __response: Result<
                ::umpire_temporal_api::temporal::api::workflowservice::v1::RequestCancelActivityExecutionResponse,
                i32,
            > = if let Some(code) = __observed.code()? {
                Err(code)
            } else {
                let __response: ::umpire_temporal_api::temporal::api::workflowservice::v1::RequestCancelActivityExecutionResponse = __observed
                    .response()
                    .map_err(|error| ::umpire_runtime::protocol::Refusal::malformed(
                        error.message,
                    ))?;
                Ok(__response)
            };
            return Self::cancel(__response);
        }
        if __observed.method
            == "/temporal.api.workflowservice.v1.WorkflowService/DescribeActivityExecution"
        {
            let __response: ::umpire_temporal_api::temporal::api::workflowservice::v1::DescribeActivityExecutionResponse = __observed
                .response()?;
            return self.describe(__response, state);
        }
        Err(
            ::umpire_runtime::protocol::Refusal::unsupported(
                "unsupported observation method",
            ),
        )
    }
}
