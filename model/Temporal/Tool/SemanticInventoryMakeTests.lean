/-! Isolated process regressions for the repository semantic-inventory Make recipes. -/

namespace Temporal.Tool.SemanticInventoryMakeTests

private def fail (message : String) : IO α :=
  throw <| IO.userError message

private def require (condition : Bool) (message : String) : IO Unit :=
  unless condition do fail message

private def writeExecutable (path : System.FilePath) (body : String) : IO Unit := do
  IO.FS.writeFile path ("#!/bin/sh\nset -eu\n" ++ body)
  let output ← IO.Process.output { cmd := "chmod", args := #["0755", path.toString] }
  require (output.exitCode == 0) s!"could not make renderer executable: {output.stderr}"

private def runMake
    (target : String)
    (document renderer : System.FilePath) : IO IO.Process.Output :=
  IO.Process.output {
    cmd := "make"
    args := #[
      "-C", "..", "--no-print-directory", target,
      "_UMPIRE_SEMANTIC_INVENTORY_DOCUMENT=" ++ document.toString,
      "_UMPIRE_SEMANTIC_INVENTORY_RENDERER=" ++ renderer.toString
    ]
  }

private def requireNoSiblingTemp (root : System.FilePath) : IO Unit := do
  let entries ← root.readDir
  require (entries.toList.all fun entry =>
      !entry.fileName.startsWith ".semantic-inventory.md.")
    "semantic-inventory recipe retained a sibling temporary file"

private def requireMode0644 (path : System.FilePath) : IO Unit := do
  let output ← IO.Process.output {
    cmd := "sh"
    args := #["-c", "mode=$(stat -c %a \"$1\" 2>/dev/null || stat -f %Lp \"$1\"); test \"$mode\" = 644", "sh", path.toString]
  }
  require (output.exitCode == 0) "generated document permissions were not 0644"

private def generationRegressions (root : System.FilePath) : IO Unit := do
  let document := root / "semantic-inventory.md"
  let renderer := root / "renderer"
  IO.FS.writeFile document "old bytes\n"
  writeExecutable renderer "printf 'generated bytes\\n'\n"
  let success ← runMake "umpire-gen-semantic-inventory" document renderer
  require (success.exitCode == 0) s!"generation failed: {success.stderr}"
  require ((← IO.FS.readFile document) == "generated bytes\n")
    "generation did not install complete renderer bytes"
  requireMode0644 document
  requireNoSiblingTemp root

  IO.FS.writeFile document "old bytes\n"
  writeExecutable renderer "printf 'partial bytes\\n'\nexit 9\n"
  let partialOutput ← runMake "umpire-gen-semantic-inventory" document renderer
  require (partialOutput.exitCode != 0) "generation accepted a partial renderer failure"
  require ((← IO.FS.readFile document) == "old bytes\n")
    "partial renderer failure replaced the prior document"
  requireNoSiblingTemp root

  writeExecutable renderer "printf 'partial bytes\\n'\nkill -TERM \"$$\"\n"
  let terminated ← runMake "umpire-gen-semantic-inventory" document renderer
  require (terminated.exitCode != 0) "generation accepted a terminated renderer"
  require ((← IO.FS.readFile document) == "old bytes\n")
    "terminated renderer replaced the prior document"
  requireNoSiblingTemp root

private def checkFailure
    (root document renderer : System.FilePath)
    (contents : Option String)
    (label expectedDiffLine : String) : IO Unit := do
  match contents with
  | none =>
      if ← document.pathExists then IO.FS.removeFile document
  | some value => IO.FS.writeFile document value
  let before ← if ← document.pathExists then some <$> IO.FS.readFile document else pure none
  let first ← runMake "umpire-check-semantic-inventory" document renderer
  let second ← runMake "umpire-check-semantic-inventory" document renderer
  require (first.exitCode != 0 && second.exitCode != 0) s!"check accepted {label} content"
  require (first.stdout == second.stdout && first.stderr == second.stderr)
    s!"check produced a nondeterministic {label} diff"
  require (first.stdout.contains ("--- " ++ document.toString ++ " (checked)") &&
      first.stdout.contains ("+++ " ++ document.toString ++ " (generated)") &&
      first.stdout.contains expectedDiffLine)
    s!"check did not report the expected {label} diff"
  let after ← if ← document.pathExists then some <$> IO.FS.readFile document else pure none
  require (after == before) s!"check mutated {label} content"
  requireNoSiblingTemp root

private def checkRegressions (root : System.FilePath) : IO Unit := do
  let document := root / "semantic-inventory.md"
  let renderer := root / "renderer"
  writeExecutable renderer "printf 'generated bytes\\n'\n"
  IO.FS.writeFile document "generated bytes\n"
  let clean ← runMake "umpire-check-semantic-inventory" document renderer
  require (clean.exitCode == 0) s!"check rejected current content: {clean.stderr}"
  require ((← IO.FS.readFile document) == "generated bytes\n")
    "successful check mutated the document"
  requireNoSiblingTemp root
  checkFailure root document renderer none "missing" "+generated bytes"
  checkFailure root document renderer (some "stale bytes\n") "stale" "-stale bytes"
  checkFailure root document renderer (some "generated bytes\nextra bytes\n") "extra"
    "-extra bytes"

/-- Exercise the real Make generation and check recipes in one isolated directory. -/
def runIO : IO Unit := do
  let root ← IO.FS.createTempDir
  try
    generationRegressions root
    checkRegressions root
  finally
    IO.FS.removeDirAll root

end Temporal.Tool.SemanticInventoryMakeTests
