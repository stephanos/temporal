---- MODULE Job ----
EXTENDS Integers, TLC, Sequences
CONSTANTS __umpire_world_attempts
__umpire_Div(__umpire_a, __umpire_b) ==
    IF Assert(__umpire_b # 0, "Rust integer division by zero") /\ Assert(~(__umpire_a = (-2147483647 - 1) /\ __umpire_b = -1), "Rust integer division overflow")
    THEN IF __umpire_b = (-2147483647 - 1)
         THEN IF __umpire_a = (-2147483647 - 1) THEN 1 ELSE 0
         ELSE IF __umpire_a < 0
              THEN LET __umpire_d == IF __umpire_b < 0 THEN -__umpire_b ELSE __umpire_b
                       __umpire_n == -(__umpire_a + 1)
                       __umpire_q == __umpire_n \div __umpire_d
                       __umpire_r == __umpire_n - __umpire_q * __umpire_d
                       __umpire_negative == -__umpire_q - (IF __umpire_r = __umpire_d - 1 THEN 1 ELSE 0)
                   IN IF __umpire_b < 0 THEN -__umpire_negative ELSE __umpire_negative
              ELSE IF __umpire_b < 0 THEN -(__umpire_a \div (-__umpire_b)) ELSE __umpire_a \div __umpire_b
    ELSE 0

VARIABLES phase, attempt, __umpire_edge_tick, __umpire_pending, __umpire_steps, __umpire_action, __umpire_choice, __umpire_outcome, __umpire_facts, __umpire_input
vars == <<phase, attempt, __umpire_edge_tick, __umpire_pending, __umpire_steps, __umpire_action, __umpire_choice, __umpire_outcome, __umpire_facts, __umpire_input>>
ModelVars == <<phase, attempt>>

Init == (((phase = "Phase::Queued") /\ (attempt = 1))) /\ (__umpire_edge_tick = FALSE) /\ (__umpire_pending = 0) /\ (__umpire_steps = 0) /\ (__umpire_action = "") /\ (__umpire_choice = 0) /\ (__umpire_outcome = "Outcome::Accepted") /\ (__umpire_facts = <<>>) /\ (__umpire_input = 0)

Worker_Claim_Inputs == <<<<0, 1>>, <<1, 2>>>>
Worker_Claim_At(__umpire_i) == LET __umpire_input_0 == Worker_Claim_Inputs[__umpire_i][2] IN ((((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Claim") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Rejected(NotFound)") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = Worker_Claim_Inputs[__umpire_i][1])) \/ ((((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) /\ (((__umpire_input_0) # (attempt))))) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Claim") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Rejected(FailedPrecondition)") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = Worker_Claim_Inputs[__umpire_i][1])) \/ ((((~(((((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) \/ (((__umpire_input_0) # (attempt)))))) /\ (((phase) = ("Phase::Queued"))))) /\ (("Phase::Running") = ("Phase::Running")) /\ (("Phase::Running" # phase) \/ (attempt # attempt)) /\ (phase' = "Phase::Running") /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Claim") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = Worker_Claim_Inputs[__umpire_i][1])) \/ ((((~(((((((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) \/ (((__umpire_input_0) # (attempt))))) \/ (((phase) = ("Phase::Queued")))))) /\ (TRUE))) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Claim") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = Worker_Claim_Inputs[__umpire_i][1]))
Worker_Claim == \E __umpire_i \in DOMAIN Worker_Claim_Inputs : Worker_Claim_At(__umpire_i)
Worker_Finish == ((((phase) = ("Phase::Running"))) /\ (("Phase::Done") = ("Phase::Done")) /\ (("Phase::Done" # phase) \/ (attempt # attempt)) /\ (phase' = "Phase::Done") /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Finish") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 2)) \/ ((((~(((phase) = ("Phase::Running")))) /\ (TRUE))) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Finish") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 2))
Worker_Reopen == ((((((phase) = ("Phase::Dropped"))) /\ (((attempt) < (__umpire_world_attempts))))) /\ (("Phase::Queued") = ("Phase::Queued")) /\ (((IF Assert(((attempt) + (1)) \in (0..255), "checked Rust integer overflow") THEN ((attempt) + (1)) ELSE ((attempt) + (1)))) = ((IF Assert(((attempt) + (1)) \in (0..255), "checked Rust integer overflow") THEN ((attempt) + (1)) ELSE ((attempt) + (1))))) /\ (("Phase::Queued" # phase) \/ ((IF Assert(((attempt) + (1)) \in (0..255), "checked Rust integer overflow") THEN ((attempt) + (1)) ELSE ((attempt) + (1))) # attempt)) /\ (phase' = "Phase::Queued") /\ (attempt' = (IF Assert(((attempt) + (1)) \in (0..255), "checked Rust integer overflow") THEN ((attempt) + (1)) ELSE ((attempt) + (1)))) /\ (__umpire_action' = "Worker::Reopen") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 3)) \/ ((((~(((((phase) = ("Phase::Dropped"))) /\ (((attempt) < (__umpire_world_attempts)))))) /\ (TRUE))) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Worker::Reopen") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 3))
Client_Drop == ((TRUE) /\ (((IF ~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) THEN "Phase::Dropped" ELSE "Phase::Queued")) = ((IF ~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) THEN "Phase::Dropped" ELSE "Phase::Queued"))) /\ (Assert(((IF ((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))) THEN "Outcome::Rejected(NotFound)" ELSE "Outcome::Accepted") = "Outcome::Accepted") \/ (((IF ~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) THEN "Phase::Dropped" ELSE phase) = phase)), "rejecting step changed state")) /\ (((IF ~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) THEN "Phase::Dropped" ELSE phase) # phase) \/ (attempt # attempt) \/ ((IF ((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))) THEN "Outcome::Rejected(NotFound)" ELSE "Outcome::Accepted") # "Outcome::Accepted")) /\ (phase' = (IF ~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) THEN "Phase::Dropped" ELSE phase)) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Drop") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = (IF ((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))) THEN "Outcome::Rejected(NotFound)" ELSE "Outcome::Accepted")) /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 4)) \/ ((FALSE) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Drop") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 4))
Client_Touch == ((((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Touch") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 5)) \/ ((((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) /\ (TRUE))) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Touch") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 5))
Client_Recheck == ((((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped"))))) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Recheck") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Rejected(Unavailable)") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 6)) \/ ((((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) /\ (TRUE))) /\ ((phase # phase) \/ (attempt # attempt)) /\ (phase' = phase) /\ (attempt' = attempt) /\ (__umpire_action' = "Client::Recheck") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>) /\ (__umpire_input' = 6))
ModelNext == (Worker_Claim) \/ (Worker_Finish) \/ (Worker_Reopen) \/ (Client_Drop) \/ (Client_Touch) \/ (Client_Recheck)
ModelEdge == __umpire_edge_tick' # __umpire_edge_tick
Edge == ModelNext /\ (__umpire_edge_tick' = ~__umpire_edge_tick) /\ UNCHANGED <<__umpire_pending, __umpire_steps>>
Complete == ~ENABLED ModelNext /\ UNCHANGED vars
Next == Edge \/ Complete
Spec == Init /\ [][Next]_vars

Post_terminal_remains == [][~(ModelEdge) \/ ((<<(<<((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) \/ ((<<((phase') = (phase))>> = <<TRUE>>)))>> = <<TRUE>>)>> = <<TRUE>>))]_vars
Post_closed_rejects == [][~(ModelEdge) \/ ((<<(<<((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) \/ ((<<((((phase') = (phase))) /\ (((attempt') = (attempt)))), ((__umpire_outcome') = ("Outcome::Rejected(NotFound)"))>> = <<TRUE, TRUE>>)))>> = <<TRUE>>)>> = <<TRUE>>))]_vars
Post_drop_rejects == [][~(ModelEdge /\ (__umpire_action' = "Client::Drop")) \/ ((<<(<<((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) \/ ((<<((((phase') = (phase))) /\ (((attempt') = (attempt)))), ((__umpire_outcome') = ("Outcome::Rejected(NotFound)"))>> = <<TRUE, TRUE>>)))>> = <<TRUE>>)>> = <<TRUE>>))]_vars
Post_reopen_remains == [][~(ModelEdge /\ (__umpire_action' = "Worker::Reopen")) \/ ((<<(<<((~(((((phase) = ("Phase::Done"))) \/ (((phase) = ("Phase::Dropped")))))) \/ ((<<((phase') = (phase))>> = <<TRUE>>)))>> = <<TRUE>>)>> = <<TRUE>>))]_vars
