Act_UserPressButton == ((((~(heating_on)) /\ (TRUE))) /\ (temperature' = temperature) /\ (heating_on' = TRUE) /\ (beeping' = FALSE) /\ (__umpire_action' = "Act::UserPressButton") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = <<>>) /\ (__umpire_facts' = <<>>))
Act_UserDepressButton == ((((heating_on) /\ (TRUE))) /\ (temperature' = temperature) /\ (heating_on' = FALSE) /\ (beeping' = FALSE) /\ (__umpire_action' = "Act::UserDepressButton") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = <<>>) /\ (__umpire_facts' = <<>>))
Act_HeaterHeat == ((((((heating_on) /\ (((temperature) < (100))))) /\ (TRUE))) /\ (temperature' = (IF Assert(((temperature) + (1)) \in ((-2147483647 - 1)..2147483647), "checked Rust integer overflow") THEN ((temperature) + (1)) ELSE ((temperature) + (1)))) /\ (heating_on' = heating_on) /\ (beeping' = beeping) /\ (__umpire_action' = "Act::HeaterHeat") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = <<>>) /\ (__umpire_facts' = <<>>))
Act_HeaterFailover == ((((((heating_on) /\ (((temperature) >= (100))))) /\ (TRUE))) /\ (temperature' = temperature) /\ (heating_on' = FALSE) /\ (beeping' = TRUE) /\ (__umpire_action' = "Act::HeaterFailover") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = <<>>) /\ (__umpire_facts' = <<>>))
ModelNext == (Act_UserPressButton) \/ (Act_UserDepressButton) \/ (Act_HeaterHeat) \/ (Act_HeaterFailover)
ModelEdge == __umpire_edge_tick' # __umpire_edge_tick
Edge == ModelNext /\ (__umpire_edge_tick' = ~__umpire_edge_tick) /\ UNCHANGED <<__umpire_pending, __umpire_steps>>
Complete == ~ENABLED ModelNext /\ UNCHANGED vars
Next == Edge \/ Complete
Spec == Init /\ [][Next]_vars

Invariant_beeps_only_when_off == ((~(beeping)) \/ (~(heating_on)))
Post_warms_only_when_on == [][~(ModelEdge) \/ (((heating_on) \/ (((temperature') <= (temperature)))))]_vars
Post_fails_over_at_boiling == [][~(ModelEdge /\ (__umpire_action' = "Act::HeaterFailover")) \/ (((((temperature') = (100))) /\ (beeping')))]_vars
Scoped_boils == (Act_UserPressButton) \/ (Act_HeaterHeat) \/ (Act_HeaterFailover)
Activate_boils == (__umpire_pending = 0) /\ (heating_on) /\ ~(beeping) /\ (__umpire_pending' = 1) /\ (__umpire_steps' = 0) /\ UNCHANGED <<ModelVars, __umpire_edge_tick, __umpire_action, __umpire_choice, __umpire_outcome, __umpire_facts>>
Monitor_boils == (__umpire_edge_tick' = ~__umpire_edge_tick) /\ (__umpire_pending' = (IF beeping' THEN 2 ELSE 1)) /\ (__umpire_steps' = 0)
ActiveEdge_boils == (__umpire_pending = 1) /\ Scoped_boils /\ Monitor_boils
PrefixEdge_boils == (__umpire_pending = 0) /\ Edge
Complete_boils == ((__umpire_pending = 2) \/ ((__umpire_pending = 1) /\ ~ENABLED Scoped_boils) \/ ((__umpire_pending = 0) /\ ~ENABLED ModelNext)) /\ UNCHANGED vars
ProgressNext_boils == PrefixEdge_boils \/ Activate_boils \/ ActiveEdge_boils \/ Complete_boils
ProgressSpec_boils == Init /\ [][ProgressNext_boils]_vars
Maximal_boils == (([]<>__umpire_edge_tick) /\ ([]<>(~__umpire_edge_tick))) \/ (<>[]((__umpire_pending = 1) /\ ~ENABLED Scoped_boils))
Progress_boils == (Maximal_boils => ((__umpire_pending = 1) ~> (__umpire_pending = 2)))
