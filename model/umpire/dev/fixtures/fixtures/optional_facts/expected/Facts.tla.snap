\* @type: Bool;
Signal_UnchangedSome == ((TRUE) /\ ((value # value)) /\ (value' = value) /\ (__umpire_action' = "Signal::UnchangedSome") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<"Fact::D">>)) \/ ((FALSE) /\ ((value # value)) /\ (value' = value) /\ (__umpire_action' = "Signal::UnchangedSome") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>))
