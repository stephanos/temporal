\* @type: Bool;
Signal_Overlap == ((((value) = (0))) /\ ((1) = (1)) /\ ((__umpire_world_selector) = (__umpire_world_selector)) /\ ((1 # value)) /\ (value' = 1) /\ (__umpire_action' = "Signal::Overlap") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = (IF __umpire_world_selector THEN <<"Fact::B">> ELSE <<"Fact::A">>))) \/ ((((~(((value) = (0)))) /\ (((value) = (0))))) /\ ((4) = (4)) /\ ((4 # value)) /\ (value' = 4) /\ (__umpire_action' = "Signal::Overlap") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<"Fact::D">>)) \/ ((((~(((((value) = (0))) \/ (((value) = (0)))))) /\ (TRUE))) /\ ((value # value)) /\ (value' = value) /\ (__umpire_action' = "Signal::Overlap") /\ (__umpire_choice' = 0) /\ (__umpire_outcome' = "Outcome::Accepted") /\ (__umpire_facts' = <<>>))
