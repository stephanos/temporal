{
  "schema": "gomad3.qualification-set-generator/v1",
  "package": "./tests",
  "build_tags": [
    "disable_grpc_modules",
    "gomad",
    "test_dep"
  ],
  "platforms": [
    "darwin/arm64",
    "linux/amd64"
  ],
  "id_prefix": "tests",
  "manifest": {
    "name": "temporal-tests",
    "description": "Every top-level test of the Temporal ./tests package, generated from its test list",
    "module": "go.temporal.io/server",
    "seeds": [
      11,
      17
    ],
    "repeat": 2,
    "run_timeout": "2m",
    "overall_timeout": "5m",
    "terminate_grace": "2s",
    "output_bytes": 8388608,
    "world_transition_bytes": 67108864
  },
  "workload": {
    "tier": 3,
    "capability_mode": "closure",
    "invariant": "passes through the one-box cluster under virtual time",
    "read_only_mounts": [
      {
        "source": "./schema",
        "target": "/go.temporal.io/server/schema"
      }
    ],
    "choice_bytes": 67108864,
    "replay_successes": true,
    "success_artifact_limit": 1,
    "success_bytes_limit": 1073741824,
    "overall_timeout": "20m",
    "expectation": {
      "classification": "qualified"
    },
    "test_parallel": 8
  },
  "tests": {
    "TestActivityTestSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestCancelWorkflowSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestChildWorkflowSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestClientMiscTestSuite": {
      "choice_bytes": 0,
      "replay_successes": false,
      "reason": "Its choice tape overflows the 64 MiB bound on both seeds (choice_trace_overflow, darwin/arm64 2026-09-28); seed repeatability is proven without a retained success replay."
    },
    "TestCompletionCallbacksSuite": {
      "execution_timeout": "8m",
      "overall_timeout": "30m",
      "reason": "Boots a dedicated cluster for each execution-type and callback-target combination; 95 s of virtual time took more than the 2 m wall budget on darwin/arm64 2026-09-28 with no watchdog spin found (the sampled hot path is the cluster-metadata refresh loop)."
    },
    "TestContinueAsNewTestSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestCronTestSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestDescribeTestSuite": {
      "skip_subtests": {
        "TestDescribeTaskQueue": {
          "owner": "stephanos",
          "date": "2026-09-28",
          "reason": "Asserts the poller's LastAccessTime is strictly after a time.Now() read before the poll; under virtual time both reads fall in one instant and no server ordering can separate them (describe_test.go:294)."
        }
      }
    },
    "TestQueryWorkflowSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestSignalWorkflowTestSuiteChasm": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestWorkflowTestSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestWorkflowTimerTestSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    },
    "TestWorkflowUpdateSuite": {
      "required_probes": [
        "stdlib.net.interfaces",
        "stdlib.os.newfile",
        "stdlib.os.openfile"
      ]
    }
  }
}
