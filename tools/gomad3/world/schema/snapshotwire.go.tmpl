		transition.Kind, transition.Ready = "ready", &ReadyTransition{Readiness: readiness, EventID: EventID(eventID)}
		{{else if eq .Kind "cancel"}}
		{{range .Fields}}
		{{if eq . "request-id"}}
		requestID, err := r.uint64("transition.cancel.request-id")
		if err != nil {
			return Transition{}, err
