		{{end}}
		{{end}}
		transition.Kind, transition.Cancel = "cancel", &CancelTransition{RequestID: RequestID(requestID), Cancellation: Cancellation{RequestID: RequestID(cancelRequestID), EventID: EventID(eventID), Status: CancelStatus(status)}}
		{{else if eq .Kind "quiesce"}}
		{{range .Fields}}
		{{if eq . "result"}}
		result, err := r.quiescence(depth + 1)
		if err != nil {
