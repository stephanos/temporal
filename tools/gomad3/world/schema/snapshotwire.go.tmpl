func (r *compressedWireReader) quiescence(depth int) (Quiescence, error) {
	if depth > maximumCompressedWireDepth {
		return Quiescence{}, invalidSnapshot("compressed.wire.depth")
	}
	var result Quiescence
	{{range .Schema.Layouts.Quiescence}}
	{{if eq . "kind"}}
	kind, err := r.enum("quiescence.kind")
	if err != nil || !validCompressedQuiescenceKind(QuiescenceKind(kind)) {
		return Quiescence{}, invalidSnapshot("compressed.wire.quiescence.kind")
	}
	result.Kind = QuiescenceKind(kind)
	{{else if eq . "before"}}
	before, err := r.uint64("quiescence.before")
	if err != nil {
		return Quiescence{}, err
	}
	result.Before = LogicalTime(int64(before))
	{{else if eq . "after"}}
	after, err := r.uint64("quiescence.after")
	if err != nil {
		return Quiescence{}, err
	}
	result.After = LogicalTime(int64(after))
	{{else if eq . "deliveries"}}
	deliveryCount, err := r.uint64("quiescence.deliveries.count")
	if err != nil || deliveryCount > r.limits.MaxEvents {
		return Quiescence{}, invalidSnapshot("compressed.wire.quiescence.deliveries.count")
	}
	result.Deliveries = make([]Delivery, 0, int(deliveryCount))
	for range deliveryCount {
		{{range $.Schema.Layouts.Delivery}}
		{{if eq . "request-id"}}
		requestID, err := r.uint64("delivery.request-id")
		if err != nil {
			return Quiescence{}, err
		}
		{{else if eq . "event-id"}}
		eventID, err := r.uint64("delivery.event-id")
		if err != nil {
			return Quiescence{}, err
		}
		{{else if eq . "at"}}
		at, err := r.uint64("delivery.at")
		if err != nil {
			return Quiescence{}, err
		}
		{{else if eq . "kind"}}
		kind, err := r.text("delivery.kind", false)
		if err != nil {
			return Quiescence{}, err
		}
		{{else if eq . "payload"}}
		payload, err := r.bytes("delivery.payload")
		if err != nil {
			return Quiescence{}, err
		}
		{{end}}
		{{end}}
		result.Deliveries = append(result.Deliveries, Delivery{RequestID: RequestID(requestID), EventID: EventID(eventID), At: LogicalTime(int64(at)), Kind: kind, Payload: payload})
	}
	{{else if eq . "blocked"}}
	blockedCount, err := r.uint64("quiescence.blocked.count")
	if err != nil || blockedCount > r.limits.MaxRequests {
		return Quiescence{}, invalidSnapshot("compressed.wire.quiescence.blocked.count")
	}
	result.Blocked = make([]RequestID, 0, int(blockedCount))
	for range blockedCount {
		blocked, err := r.uint64("quiescence.blocked")
		if err != nil || blocked == 0 {
			return Quiescence{}, invalidSnapshot("compressed.wire.quiescence.blocked")
		}
		result.Blocked = append(result.Blocked, RequestID(blocked))
	}
	{{end}}
	{{end}}
	return result, nil
}

func validCompressedRequestState(value RequestState) bool {
	return value == RequestPending || value == RequestQueued || value == RequestCanceled || value == RequestDelivered
}

func validCompressedEventState(value EventState) bool {
	return value == EventQueued || value == EventCanceled || value == EventDelivered
}

func validCompressedCancelStatus(value CancelStatus) bool {
	return value == CancelWon || value == CancelAlreadyCanceled || value == CancelAlreadyDelivered
}

func validCompressedQuiescenceKind(value QuiescenceKind) bool {
	return value == QuiescenceDelivered || value == QuiescenceDeadlock || value == QuiescenceIdle
}
