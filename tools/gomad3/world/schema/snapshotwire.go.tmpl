		{{end}}
		transition.Kind, transition.Register = "register", &RegisterTransition{Request: request, RequestID: RequestID(requestID)}
		{{else if eq .Kind "ready"}}
		{{range .Fields}}
		{{if eq . "readiness"}}
		readiness, err := r.readiness()
		if err != nil {
			return Transition{}, err
