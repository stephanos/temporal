      "required_probes": [
        "stdlib.os.openfile",
        "stdlib.os.rename"
      ],
      "expectation": {
        "classification": "qualified"
      }
    },
    {
      "name": "loopback-tcp-roundtrip",
      "package": "./basic/network",
      "test": "TestLoopbackRoundTripPreservesMessage",
      "required_probes": [
        "stdlib.net.dialtcp",
        "stdlib.net.listentcp",
        "stdlib.net.tcplistener.accepttcp"
      ],
      "expectation": {
        "classification": "qualified"
      }
    },
    {
      "name": "modernc-libc-boundary",
      "package": "./thirdparty/libc",
