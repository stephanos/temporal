+def _validate_cost_review(data: Any, spec_id: str) -> None:
+    def text(row, key):
+        if not isinstance(row.get(key), str) or not row[key].strip():
+            raise ValueError(f"{key} must be a nonempty string")
+
+    def bounded(value, depth=0):
+        if depth > 32:
+            raise ValueError("report nesting exceeds 32 levels")
+        if isinstance(value, (dict, list)):
+            if len(value) > 128:
+                raise ValueError("report collections must contain at most 128 entries")
+            for item in (value.values() if isinstance(value, dict) else value):
+                bounded(item, depth + 1)
+
+    bounded(data)
+    if not isinstance(data, dict) or type(data.get("schema_version")) is not int or data["schema_version"] != 1:
+        raise ValueError("expected a report object with schema_version=1")
+    if data.get("spec_id") != spec_id:
+        raise ValueError(f"spec_id must be {spec_id}")
+    gates = data.get("gates")
+    if not isinstance(gates, list):
+        raise ValueError("gates must be an array")
+    if not gates:
+        text(data, "no_validation_reason")
+    for gate in gates:
+        if not isinstance(gate, dict):
+            raise ValueError("each gate must be an object")
+        for key in ("command", "mode", "coverage"):
+            text(gate, key)
+        evidence = gate.get("evidence")
+        if not isinstance(evidence, list) or any(not isinstance(item, str) or not item.strip() for item in evidence):
+            raise ValueError("gate evidence must be an array of nonempty strings (empty when unavailable)")
+        cost = gate.get("cost")
+        if not isinstance(cost, dict) or cost.get("kind") not in ("measured", "estimated", "unknown"):
+            raise ValueError("gate cost.kind must be measured, estimated or unknown")
+        if cost["kind"] == "unknown":
+            text(cost, "reason")
+        else:
+            seconds = cost.get("seconds")
+            if type(seconds) not in (int, float) or not math.isfinite(seconds) or seconds < 0:
+                raise ValueError("gate cost.seconds must be finite and nonnegative")
+    decisions = data.get("speedup_decisions")
+    if not isinstance(decisions, list) or not decisions:
+        raise ValueError("speedup_decisions must be a nonempty array")
+    for decision in decisions:
+        if not isinstance(decision, dict):
+            raise ValueError("each speedup decision must be an object")
+        for key in ("opportunity", "decision", "rationale", "coverage_preserved"):
+            text(decision, key)
+
+
+def _cost_review_parent(repo_root: Path, relative: Path, *, create: bool = False) -> int:
+    if relative.is_absolute() or not relative.parts or any(part in ("..", ".") for part in relative.parts):
+        raise ValueError("validation review path must stay inside the repository")
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    fd = os.open(repo_root, flags)
+    try:
+        for part in relative.parts[:-1]:
+            if create:
+                try:
+                    os.mkdir(part, dir_fd=fd)
+                except FileExistsError:
+                    pass
+            child = os.open(part, flags, dir_fd=fd)
+            os.close(fd)
+            fd = child
+        return fd
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def _read_cost_review_at(parent: int, name: str) -> bytes:
+    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+    with os.fdopen(fd, "rb") as source:
+        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
+            raise ValueError("validation review must be a regular file")
+        raw = source.read(256 * 1024 + 1)
+    if len(raw) > 256 * 1024:
+        raise ValueError("validation review exceeds 256 KiB")
+    return raw
+
+
+def _publish_cost_review(repo_root: Path, relative: Path, raw: bytes) -> None:
+    parent = _cost_review_parent(repo_root, relative, create=True)
+    temporary = None
+    try:
+        try:
+            existing = _read_cost_review_at(parent, relative.name)
+        except FileNotFoundError:
+            existing = None
+        if existing is None:
+            temporary = ".validation-review-" + uuid.uuid4().hex + ".tmp"
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=parent)
+            with os.fdopen(fd, "wb") as output:
+                output.write(raw)
+                output.flush()
+                os.fsync(output.fileno())
+            try:
+                os.link(temporary, relative.name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
+            except FileExistsError:
+                pass
+            existing = _read_cost_review_at(parent, relative.name)
+        if existing != raw:
+            raise ValueError(f"existing validation artifact {relative} has different bytes; restore or remove the corrupt file")
+    finally:
+        if temporary is not None:
+            os.unlink(temporary, dir_fd=parent)
+        os.close(parent)
+
+
+def _prepare_cost_review(flow_dir: Path, spec_id: str, filename: str) -> tuple[dict, Path]:
+    repo_root = get_repo_root().resolve()
+    source = Path(filename)
+    relative = source.relative_to(repo_root) if source.is_absolute() else Path.cwd().relative_to(repo_root) / source
+    parent = _cost_review_parent(repo_root, relative)
+    try:
+        raw = _read_cost_review_at(parent, relative.name)
+    finally:
+        os.close(parent)
+    def invalid_constant(value):
+        raise ValueError(f"nonfinite JSON number {value}")
+    data = json.loads(raw, parse_constant=invalid_constant)
+    _validate_cost_review(data, spec_id)
+    digest = hashlib.sha256(raw).hexdigest()
+    artifact = flow_dir.relative_to(repo_root) / "artifacts" / spec_id / f"validation-cost-review-{digest}.json"
+    _publish_cost_review(repo_root, artifact, raw)
+    return {"path": artifact.as_posix(), "sha256": digest, "schema_version": 1}, repo_root / artifact
+
