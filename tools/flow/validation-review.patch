+def _spec_close_validation_required(flow_dir: Path) -> bool:
+    config = _read_flow_config_file(flow_dir / CONFIG_FILE)
+    settings = (config or {}).get("specClose", {})
+    if not isinstance(settings, dict):
+        raise ValueError("config specClose must be an object")
+    required = settings.get("validationReviewRequired", False)
+    if type(required) is not bool:
+        raise ValueError("config specClose.validationReviewRequired must be a boolean")
+    return required
