# running gomad
! exec gomad test -run=Other -v .
stdout 'metatest cannot be used from within gomad'

! exec gomad test -run=Self -v .
stdout 'metatest cannot be used from within gomad'

-- machinecrash_test.go --
package behavior_test

import (
	"testing"

    "github.com/temporalio/gomad/metatesting"
)

func TestSelf(t *testing.T) {
    mt := metatesting.ForCurrentPackage(t)
    metatesting.CheckDeterministic(t, mt)
}

func TestOther(t *testing.T) {
    mt := metatesting.ForOtherPackage(t, "foo")
    metatesting.CheckDeterministic(t, mt)
}