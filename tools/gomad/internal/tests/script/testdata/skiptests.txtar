# This tests verifies that broken tests in dependencies are ignored.

exec gomad test -v .
stdout Hello

! exec gomad test -v ./bad
stderr badmarkerhere

-- ok_test.go --
package good

import (
    "testing"

    "test/bad"
)

func TestDeps(t *testing.T) {
    t.Log(bad.Public)
}
