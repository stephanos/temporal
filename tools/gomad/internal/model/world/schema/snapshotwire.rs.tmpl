//! Expanded World snapshot writer for the Rust World model. It emits exactly
//! the `{{.Schema.Magic}}` stream Go's generated codec reads; Go wraps it in the
//! compressed envelope and validates it. Rust never decodes World evidence.

use super::{Model, Readiness, Request, Transition, TransitionBody};
use std::io::{Error, ErrorKind, Result, Write};

pub const MAGIC: [u8; 8] = [{{hexbytes .Schema.Magic}}];
#[allow(dead_code, reason = "Shared wire schema limit retained for codec conformance.")]
pub const MAXIMUM_DEPTH: usize = {{.Schema.Limits.Depth}};
#[allow(dead_code, reason = "Shared wire schema limit retained for codec conformance.")]
pub const MAXIMUM_ENUM_BYTES: usize = {{.Schema.Limits.EnumBytes}};

struct Writer<'a> {
    output: &'a mut dyn Write,
}

impl Writer<'_> {
    fn raw(&mut self, data: &[u8]) -> Result<()> {
        self.output.write_all(data)
    }

    fn uint8(&mut self, value: u8) -> Result<()> {
        self.raw(&[value])
    }

    fn uint16(&mut self, value: u16) -> Result<()> {
        self.raw(&value.to_be_bytes())
    }

    fn uint32(&mut self, value: u32) -> Result<()> {
        self.raw(&value.to_be_bytes())
    }

    fn uint64(&mut self, value: u64) -> Result<()> {
        self.raw(&value.to_be_bytes())
    }

    fn digest(&mut self, value: &[u8; 32]) -> Result<()> {
        self.raw(value)
    }

    fn text(&mut self, value: &str) -> Result<()> {
        let length = u32::try_from(value.len())
            .map_err(|_| Error::new(ErrorKind::InvalidInput, "compressed.wire.string"))?;
        self.uint32(length)?;
        self.raw(value.as_bytes())
    }

    fn bytes(&mut self, value: &[u8]) -> Result<()> {
        self.uint64(value.len() as u64)?;
        self.raw(value)
    }

    fn request(&mut self, request: &Request) -> Result<()> {
{{- range .Schema.Layouts.Request}}
{{- if eq . "kind"}}
        self.text(&request.kind)?;
{{- else if eq . "resource.adapter"}}
        self.text(&request.resource.adapter)?;
{{- else if eq . "resource.kind"}}
        self.text(&request.resource.kind)?;
{{- else if eq . "resource.key"}}
        self.text(&request.resource.key)?;
{{- else if eq . "priority"}}
        self.uint16(request.priority)?;
{{- else if eq . "payload"}}
        self.bytes(&request.payload)?;
{{- end}}
{{- end}}
        Ok(())
    }

    fn readiness(&mut self, readiness: &Readiness) -> Result<()> {
{{- range .Schema.Layouts.Readiness}}
{{- if eq . "request-id"}}
        self.uint64(readiness.request_id)?;
{{- else if eq . "at"}}
        self.uint64(readiness.at.cast_unsigned())?;
{{- else if eq . "kind"}}
        self.text(&readiness.kind)?;
{{- else if eq . "payload"}}
        self.bytes(&readiness.payload)?;
{{- else if eq . "equivalence-class"}}
        self.text(&readiness.equivalence_class)?;
{{- end}}
{{- end}}
        Ok(())
    }

    fn transition(&mut self, transition: &Transition) -> Result<()> {
{{- range .Schema.Layouts.Transition}}
{{- if eq . "sequence"}}
        self.uint64(transition.sequence)?;
{{- else if eq . "previous-digest"}}
        self.digest(&transition.previous_digest)?;
{{- else if eq . "digest"}}
        self.digest(&transition.digest)?;
{{- end}}
{{- end}}
        match &transition.body {
{{- range .Schema.Transitions}}
{{- if eq .Kind "register"}}
            TransitionBody::Register {
                request,
                request_id,
            } => {
                self.uint8({{.Tag}})?;
{{- range .Fields}}
{{- if eq . "request"}}
                self.request(request)?;
{{- else if eq . "request-id"}}
                self.uint64(*request_id)?;
{{- end}}
{{- end}}
            }
{{- else if eq .Kind "ready"}}
            TransitionBody::Ready {
                readiness,
                event_id,
            } => {
                self.uint8({{.Tag}})?;
{{- range .Fields}}
{{- if eq . "readiness"}}
                self.readiness(readiness)?;
{{- else if eq . "event-id"}}
                self.uint64(*event_id)?;
{{- end}}
{{- end}}
            }
{{- else if eq .Kind "cancel"}}
            TransitionBody::Cancel {
                request_id,
                cancellation,
            } => {
                self.uint8({{.Tag}})?;
{{- range .Fields}}
{{- if eq . "request-id"}}
                self.uint64(*request_id)?;
{{- else if eq . "result.request-id"}}
                self.uint64(cancellation.request_id)?;
{{- else if eq . "result.event-id"}}
                self.uint64(cancellation.event_id)?;
{{- else if eq . "status"}}
                self.text(cancellation.status.as_str())?;
{{- end}}
{{- end}}
            }
{{- else if eq .Kind "quiesce"}}
            TransitionBody::Quiesce { result } => {
                self.uint8({{.Tag}})?;
{{- range .Fields}}
{{- if eq . "result"}}
{{- range $.Schema.Layouts.Quiescence}}
{{- if eq . "kind"}}
                self.text(result.kind.as_str())?;
{{- else if eq . "before"}}
                self.uint64(result.before.cast_unsigned())?;
{{- else if eq . "after"}}
                self.uint64(result.after.cast_unsigned())?;
{{- else if eq . "deliveries"}}
                self.uint64(result.deliveries.len() as u64)?;
                for delivery in &result.deliveries {
{{- range $.Schema.Layouts.Delivery}}
{{- if eq . "request-id"}}
                    self.uint64(delivery.request_id)?;
{{- else if eq . "event-id"}}
                    self.uint64(delivery.event_id)?;
{{- else if eq . "at"}}
                    self.uint64(delivery.at.cast_unsigned())?;
{{- else if eq . "kind"}}
                    self.text(&delivery.kind)?;
{{- else if eq . "payload"}}
                    self.bytes(&delivery.payload)?;
{{- end}}
{{- end}}
                }
{{- else if eq . "blocked"}}
                self.uint64(result.blocked.len() as u64)?;
                for blocked in &result.blocked {
                    self.uint64(*blocked)?;
                }
{{- end}}
{{- end}}
{{- end}}
{{- end}}
            }
{{- end}}
{{- end}}
        }
        Ok(())
    }
}

/// Writes the model's expanded snapshot wire. A model has no replay plan, so
/// replay progress is zero, as in Go's snapshot of a model without one.
pub fn write_snapshot(model: &Model, output: &mut dyn Write) -> Result<()> {
    write_snapshot_head(model, output)?;
    write_transitions(model.transitions(), output)
}

/// Encodes transitions exactly as the snapshot wire's transition section,
/// which ends the wire: an append-only history can reuse earlier output.
pub fn write_transitions(transitions: &[Transition], output: &mut dyn Write) -> Result<()> {
    let mut w = Writer { output };
    for transition in transitions {
        w.transition(transition)?;
    }
    Ok(())
}

/// Writes the snapshot wire up to and including its transition count; the
/// transitions follow as [`write_transitions`] encodes them.
pub fn write_snapshot_head(model: &Model, output: &mut dyn Write) -> Result<()> {
    let mut w = Writer { output };
    w.raw(&MAGIC)?;
    let config = model.config();
    let (next_request_id, next_event_id, next_transition) = model.next_ids();
{{- range .Schema.Layouts.Snapshot}}
{{- if eq . "schema-version"}}
    w.uint32(super::SCHEMA_VERSION)?;
{{- else if eq . "config.seed"}}
    w.uint64(config.seed)?;
{{- else if eq . "config.max-requests"}}
    w.uint64(config.limits.max_requests)?;
{{- else if eq . "config.max-events"}}
    w.uint64(config.limits.max_events)?;
{{- else if eq . "config.max-queued-events"}}
    w.uint64(config.limits.max_queued_events)?;
{{- else if eq . "config.max-transitions"}}
    w.uint64(config.limits.max_transitions)?;
{{- else if eq . "config.max-payload-bytes"}}
    w.uint64(config.limits.max_payload_bytes)?;
{{- else if eq . "config.max-string-bytes"}}
    w.uint32(config.limits.max_string_bytes)?;
{{- else if eq . "now"}}
    w.uint64(model.now().cast_unsigned())?;
{{- else if eq . "next-request-id"}}
    w.uint64(next_request_id)?;
{{- else if eq . "next-event-id"}}
    w.uint64(next_event_id)?;
{{- else if eq . "next-transition"}}
    w.uint64(next_transition)?;
{{- else if eq . "payload-bytes"}}
    w.uint64(model.payload_bytes())?;
{{- else if eq . "replay.cursor"}}
    w.uint64(0)?;
{{- else if eq . "replay.expected"}}
    w.uint64(0)?;
{{- else if eq . "transcript-digest"}}
    w.digest(model.transcript_digest())?;
{{- else if eq . "state-digest"}}
    w.digest(&model.state_digest())?;
{{- end}}
{{- end}}
    let requests = model.requests();
    w.uint64(requests.len() as u64)?;
    for (id, entry) in requests {
        w.uint64(id)?;
        w.request(&entry.request)?;
        w.text(entry.state.as_str())?;
        w.uint64(entry.event_id)?;
    }
    let events = model.events();
    w.uint64(events.len() as u64)?;
    for (id, event) in events {
        w.uint64(id)?;
        w.readiness(&event.readiness)?;
        w.text(event.state.as_str())?;
    }
    w.uint64(model.transitions().len() as u64)?;
    Ok(())
}
