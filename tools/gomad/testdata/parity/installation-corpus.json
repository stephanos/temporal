    "compiler-missing",
    "compiler-version",
    "publication-collision",
    "go-lineage",
    "explicit-precedence",
    "environment-precedence",
    "sibling",
    "invalid-explicit",
    "invalid-environment",
    "removed-build-inputs",
    "changed-compiler",
    "configured-limits",
    "temporal-policy",
    "captured-payload-mismatch",
    "captured-descriptor-mismatch",
    "schema-symlink",
    "changed-runtime",
