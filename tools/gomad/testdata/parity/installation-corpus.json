{
  "schema": "gomad.installation-corpus/v1",
  "grammar": [
    {
      "name": "missing-output",
      "argv": [
        "install"
      ],
      "status": 2,
      "stderr_contains": "install requires --output"
    },
    {
      "name": "unknown-flag",
      "argv": [
        "install",
        "--unknown"
      ],
      "status": 2,
      "stderr_contains": "flag provided but not defined"
    },
    {
      "name": "discover-arguments",
      "argv": [
        "discover",
        "extra"
      ],
      "status": 2,
      "stderr_contains": "discover accepts no command arguments"
    },
    {
      "name": "analyze-bare",
      "argv": [
        "analyze"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    },
    {
      "name": "analyze-help",
      "argv": [
        "analyze",
        "--help"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    },
    {
      "name": "analyze-arguments",
      "argv": [
        "analyze",
        "--json"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    },
    {
      "name": "doctor-bare",
      "argv": [
        "doctor"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    },
    {
      "name": "doctor-help",
      "argv": [
        "doctor",
        "--help"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    },
    {
      "name": "doctor-arguments",
      "argv": [
        "doctor",
        "--json"
      ],
      "status": 2,
      "selected": true,
      "unsupported": true
    }
  ],
