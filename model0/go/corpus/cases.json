      }
    ],
    "go": [
      {
        "file": "model/go/nexuscaller/claims.go",
        "old": "Actions(schedule.With(Unset, Unset, Unset), handlerReply.With(SyncSuccess{}))",
        "new": "Actions(schedule.With(Unset, Unset, Unset), handlerReply.With(ResolvedSucceeded))"
      }
    ],
    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/Claims.scala",
        "old": ".actions(schedule(unset, unset, unset), handlerReply(Reply.syncSuccess))",
        "new": ".actions(schedule(unset, unset, unset), handlerReply(Resolution.succeeded))"
      }
