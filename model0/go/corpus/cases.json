    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/Model.scala",
        "old": "      handlerReply ~> Protocol.handlerReplyStep,",
        "new": "      handlerReply ~> Protocol.completeStep,"
      }
    ]
  },
  {
    "id": "03-scenario-input-type",
    "mistake": "A Scenario passes an input of the wrong type",
    "lean": [
