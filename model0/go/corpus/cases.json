  {
    "id": "10-stuck-state",
    "mistake": "A machine has a stuck state",
    "lean": [
      {
        "file": "model/lean/Temporal/Feature/Nexus/Caller/Model.lean",
        "old": "  if productTerminal state then\n    [{ outcome := .notFound, state, facts := [] }]",
        "new": "  if productTerminal state then\n    []"
      },
      {
        "file": "model/lean/Temporal/Feature/Nexus/Caller/Model.lean",
        "old": "  starts: [scheduled]\n  ends: [succeeded, failed, canceled, timedOut]",
        "new": "  starts: [scheduled]\n  ends: [succeeded, failed, canceled]"
      }
    ],
    "go": [
      {
        "file": "model/go/nexuscaller/model.go",
        "old": "\tif ProductTerminal(s) {\n\t\treturn []ProductStep{{Outcome: CompletionMissing, State: s}}\n\t}",
        "new": "\tif ProductTerminal(s) {\n\t\treturn nil\n\t}"
      },
      {
        "file": "model/go/nexuscaller/model.go",
        "old": "\tEnds(ProductTerminal).",
        "new": "\tEnds(func(s ProductState) bool { return ProductTerminal(s) && s.Phase != ProductTimedOut })."
      }
    ],
    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/kernel/Nexus.scala",
        "old": "    if productTerminal(s) then one(step(Outcome.notFound, s, facts0))",
        "new": "    if productTerminal(s) then none"
      },
      {
        "file": "model/scala/temporal/nexuscaller/Model.scala",
        "old": "    ends(Product.productTerminal)",
        "new": "    ends(s => Product.productTerminal(s) && s.phase != ProductPhase.timedOut)"
      }
    ]
  },
