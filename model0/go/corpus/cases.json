[
  {
    "id": "01-undeclared-action",
    "mistake": "A step names an undeclared action",
    "lean": [
      {
        "file": "model/lean/Temporal/Feature/Nexus/Caller/Model.lean",
        "old": "    backoff: backoffStep\n",
        "new": "    backof: backoffStep\n"
      }
    ],
    "go": [
      {
        "file": "model/go/nexuscaller/model.go",
        "old": "Step0(backoff, backoffStep).",
        "new": "Step0(backof, backoffStep)."
      }
    ],
    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/Model.scala",
        "old": "      backoff ~> Protocol.backoffStep,",
        "new": "      backof ~> Protocol.backoffStep,"
      }
    ]
  },
  {
    "id": "02-step-input-type",
