  {
    "id": "05-outside-domain",
    "mistake": "A step moves the attempt count past its bound",
    "lean": [
      {
        "file": "model/lean/Temporal/Feature/Nexus/Caller/Model.lean",
        "old": "\n         state := { state with phase := .backingOff, attempts := saturatingSucc state.attempts }",
        "new": "\n         state := { state with phase := .backingOff, attempts := state.attempts + 1 }"
      },
      {
        "file": "model/lean/Temporal/Feature/Nexus/Caller/Model.lean",
        "old": "\n     state := { state with phase := .backingOff, attempts := saturatingSucc state.attempts }",
        "new": "\n     state := { state with phase := .backingOff, attempts := state.attempts + 1 }"
      }
    ],
    "go": [
      {
        "file": "model/go/nexuscaller/model.go",
        "old": "return min(a+1, AttemptBound)",
        "new": "return a + 1"
      }
    ],
    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/kernel/Nexus.scala",
        "old": "if a < attemptBound then a + 1 else a",
        "new": "a + 1"
      }
    ]
  },
