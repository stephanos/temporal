        "old": "| .succeeded => moves state .succeeded (startedFirst ++ [.nexusOperationCompleted])",
        "new": "| .succeeded => moves state .failed (startedFirst ++ [.nexusOperationCompleted])"
      }
    ],
    "go": [
      {
        "file": "model/go/nexuscaller/model.go",
        "old": "return moves(s, Succeeded, append(startedFirst, NexusOperationCompleted{})...)",
        "new": "return moves(s, Failed, append(startedFirst, NexusOperationCompleted{})...)"
      }
    ],
    "scala": [
      {
        "file": "model/scala/temporal/nexuscaller/kernel/Nexus.scala",
        "old": "case Resolution.succeeded => moves(s, Phase.succeeded, startedFirst ++ facts1(ProtocolFact.nexusOperationCompleted))",
        "new": "case Resolution.succeeded => moves(s, Phase.failed, startedFirst ++ facts1(ProtocolFact.nexusOperationCompleted))"
      }
    ]
  },
